            <!-- Fond herite de NovaPanelCardStyle (NovaChromeSurfaceRaisedBrush,
                 deja synchronise clair/sombre par MainWindow.SettingsTheme.cs) -
                 volontairement PAS de Background propre ici. Un essai precedent
                 avait introduit un brush statique dedie non branche sur le
                 moteur de theme : correct en sombre par coincidence, casse en
                 clair (jamais reecrit). Corrige avant meme la verification
                 visuelle en clair, en relisant SetBrush/ApplyAccessibilitySettings. -->
            <Style x:Key="NovaPanelShellCardStyle" TargetType="Border" BasedOn="{StaticResource NovaPanelCardStyle}">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaCompanionStrokeBrush}" />
            </Style>
            <Style x:Key="NovaPanelActionButtonStyle" TargetType="Button" BasedOn="{StaticResource NovaCompactButtonStyle}">
                <Setter Property="MinHeight" Value="36" />
