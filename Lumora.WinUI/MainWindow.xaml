                                        <TextBlock Text="Confidentialité" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SettingsNavVault"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
