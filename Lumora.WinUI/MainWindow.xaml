                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                  Foreground="{StaticResource NovaTileFamilyContentBrush}" />
                                        <TextBlock Text="Accessibilité" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SettingsNavStartup"
