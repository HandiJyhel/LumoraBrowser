                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Thumb
                x:Name="VerticalTabsResizeThumb"
                Grid.Column="1"
                Width="12"
                DragDelta="VerticalTabsResizeThumb_DragDelta"
                DragCompleted="VerticalTabsResizeThumb_DragCompleted"
                Visibility="Collapsed">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbRoot"
                                Background="Transparent"
                                ToolTipService.ToolTip="Faire glisser pour redimensionner">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ThumbLine.Opacity" Value="1" />
                                            <Setter Target="ThumbRoot.Background" Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ThumbLine.Opacity" Value="1" />
                                            <Setter Target="ThumbRoot.Background" Value="{ThemeResource SystemControlHighlightBaseLowBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="ThumbLine"
                                    Width="3" Height="48" CornerRadius="2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Opacity="0.45" />
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Grid x:Name="BrowserPanel" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- InfoBar affichée une seule fois, la première fois qu'une purge de
                     sessions a réellement lieu, pour expliquer le comportement. -->
                <InfoBar x:Name="SessionPurgeInfoBar" Grid.Row="0" Severity="Informational"
                         IsOpen="False" Title="Sessions de la visite precedente nettoyees"
                         Message="Les sites que vous n'avez pas marques comme sites de confiance repartent a zero a chaque demarrage de Lumora."
                         Closed="SessionPurgeInfoBar_Closed">
                    <InfoBar.ActionButton>
                        <Button Content="Gerer les sites connectes" Click="SessionsManageLink_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Barre de proposition d'enregistrement d'identifiants -->
                <Border x:Name="CredentialSaveBar" Grid.Row="1" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0" Symbol="Permissions" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CredentialSaveText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="CredentialSaveAccept" Grid.Column="2" Content="Enregistrer" Click="CredentialSaveAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="CredentialSaveDismiss" Grid.Column="3" Content="Ignorer" Click="CredentialSaveDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Barre de proposition de remplissage automatique -->
                <Border x:Name="AutoFillBar" Grid.Row="2" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0" Symbol="Contact" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AutoFillText" Grid.Column="1" VerticalAlignment="Center"/>
                        <Button x:Name="AutoFillAccept" Grid.Column="2" Content="Remplir" Click="AutoFillAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <!-- Visible uniquement quand plusieurs comptes existent pour ce site (ex. 2 comptes Google) -->
                        <Button x:Name="AutoFillChooseButton" Grid.Column="2" Content="Choisir un compte" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12">
                            <Button.Flyout>
                                <MenuFlyout x:Name="AutoFillAccountsFlyout" Placement="Bottom"/>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="AutoFillDismiss" Grid.Column="3" Content="Ignorer" Click="AutoFillDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Barre de proposition de remplissage d'une carte du portefeuille.
                     Remplissage UNIQUEMENT sur clic : jamais de pré-remplissage silencieux
                     (un script de page ne doit pas pouvoir aspirer la carte). -->
                <Border x:Name="WalletFillBar" Grid.Row="3" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WalletFillText" Grid.Column="1" VerticalAlignment="Center" Text="Page de paiement détectée — remplir avec une carte du portefeuille ?"/>
                        <Button x:Name="WalletFillAccept" Grid.Column="2" Content="Remplir" Click="WalletFillAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="WalletFillDismiss" Grid.Column="3" Content="Ignorer" Click="WalletFillDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Barre proposée après un login détecté, quand les sessions éphémères
                     sont actives et que le site n'est pas déjà connu (confiance ou refus). -->
                <Border x:Name="SessionKeepBar" Grid.Row="4" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0" Symbol="Keyboard" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SessionKeepText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="SessionKeepAccept" Grid.Column="2" Content="Conserver la session" Click="SessionKeepAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SessionKeepDismiss" Grid.Column="3" Content="Non merci" Click="SessionKeepDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Barre de suggestion de mot de passe fort, sur detection d'un champ
                     "nouveau mot de passe" (inscription, changement de mot de passe). -->
                <Border x:Name="SuggestPasswordBar" Grid.Row="5" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0" Symbol="Permissions" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Utiliser un mot de passe fort genere ?" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SuggestPasswordValueText" FontFamily="Consolas" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="SuggestPasswordAccept" Grid.Column="2" Content="Utiliser" Click="SuggestPasswordAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SuggestPasswordRegenerate" Grid.Column="3" Content="Regenerer" Click="SuggestPasswordRegenerate_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                        <Button x:Name="SuggestPasswordDismiss" Grid.Column="4" Content="Ignorer" Click="SuggestPasswordDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Bandeau de proposition de traduction locale de la page (modele
                     telecharge une fois puis mis en cache, traduction 100% hors ligne
                     ensuite). Jamais automatique : uniquement sur clic explicite. -->
                <Border x:Name="TranslateBar" Grid.Row="6" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xF2B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TranslateText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Cette page semble etre en anglais. La traduire en francais ?"/>
                        <Button x:Name="TranslateAccept" Grid.Column="2" Content="Traduire" Click="TranslateAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="TranslateDismiss" Grid.Column="3" Content="Non merci" Click="TranslateDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Garde-fou : quand on ferme ou dissout un groupe non enregistre,
                     propose de le ranger dans la bibliotheque avant qu'il disparaisse. -->
                <Border x:Name="SaveGroupBar" Grid.Row="7" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SaveGroupText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="SaveGroupAccept" Grid.Column="2" Content="Garder ce groupe" Click="SaveGroupAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SaveGroupDismiss" Grid.Column="3" Content="Non" Click="SaveGroupDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Reprise « site introuvable » : le domaine ne se resout plus (site
                     ferme, nom de domaine change, faute de frappe). Suggestion calculee
                     100% localement ; la recherche web ne part QUE sur clic explicite,
                     vers le moteur de recherche configure. -->
                <Border x:Name="SiteNotFoundBar" Grid.Row="8" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SiteNotFoundText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="SiteNotFoundTrySuggestion" Grid.Column="2" Visibility="Collapsed" Click="SiteNotFoundTrySuggestion_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                        <Button x:Name="SiteNotFoundSearch" Grid.Column="3" Content="Rechercher ce site sur le web" Click="SiteNotFoundSearch_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SiteNotFoundDismiss" Grid.Column="4" Content="Fermer" Click="SiteNotFoundDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Site demenage : une redirection permanente (301/308) vers un autre
                     domaine a ete observee et des favoris/raccourcis pointent encore
                     vers l'ancien. Proposition unique par demenagement ; apprentissage
                     100% local (SiteRelocationStore), rien n'est envoye nulle part. -->
                <Border x:Name="SiteMovedBar" Grid.Row="9" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SiteMovedText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="SiteMovedUpdate" Grid.Column="2" Content="Mettre a jour" Click="SiteMovedUpdate_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SiteMovedDismiss" Grid.Column="3" Content="Non merci" Click="SiteMovedDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- 0.78.3.1 : les navigations publicitaires/parasites sont
                     bloquees silencieusement (statut + bouclier), plus de barre
                     « Continuer quand meme ». Une adresse tapee dans la barre
                     n'est jamais bloquee ; la whitelist par site reste la
                     soupape durable. -->
                <Grid x:Name="BrowserHost" Grid.Row="11" />
            </Grid>

            <Grid x:Name="BookmarksPanel" Grid.Column="2" Padding="16" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Favoris Lumora" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Dossiers" Opacity="0.68" />
                    </StackPanel>
                    <ListView
                        x:Name="BookmarkFoldersList"
                        Grid.Row="1"
                        RightTapped="BookmarkFoldersList_RightTapped"
                        SelectionChanged="BookmarkFoldersList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="16" Height="16" Source="{Binding IconImageUri}" Visibility="{Binding IconImageVisibility}" />
                                    <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Visibility="{Binding IconGlyphVisibility}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Opacity="0.62" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid Grid.Column="2" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock x:Name="CurrentBookmarkFolderTitle" Text="Barre des favoris" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="BookmarkBreadcrumbText" Opacity="0.68" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Nouveau dossier" Click="NewBookmarkFolderButton_Click" />
                        <Button Grid.Column="2" Content="Renommer" Click="RenameBookmarkButton_Click" />
                        <Button Grid.Column="3" Content="Tout sélectionner" Click="SelectAllBookmarksButton_Click" />
                        <Button Grid.Column="4" Content="Supprimer sélection" Click="DeleteBookmarkButton_Click" />
                        <Button Grid.Column="5" Content="Vider" Click="ClearBookmarksButton_Click" />
                        <Button Grid.Column="6" Content="Importer" Click="ImportMenu_Click" />
                        <Button Grid.Column="7" Content="Exporter" Click="ExportHtmlButton_Click" />
                    </Grid>

                    <TextBox
                        x:Name="BookmarksSearchBox"
                        Grid.Row="1"
                        TextChanged="BookmarksSearchBox_TextChanged"
                        PlaceholderText="Rechercher dans les favoris..." />

                    <ListView
                        x:Name="BookmarksList"
                        Grid.Row="2"
                        SelectionMode="Extended"
                        DoubleTapped="BookmarksList_DoubleTapped"
                        RightTapped="BookmarksList_RightTapped"
                        SelectionChanged="BookmarksList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="16" Height="16" Source="{Binding IconImageUri}" Visibility="{Binding IconImageVisibility}" />
                                    <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Visibility="{Binding IconGlyphVisibility}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <Grid x:Name="ImportPanel" Grid.Column="2" Padding="28" Visibility="Collapsed">
                <StackPanel Spacing="14" MaxWidth="820">
                    <TextBlock Text="Importer et exporter" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.78"
                               Text="Lumora lit les profils Chromium detectes sur cette machine et peut aussi importer/exporter un fichier HTML de favoris. Les donnees restent dans le profil local Lumora." />
                    <TextBlock Text="Depuis un navigateur installe" FontWeight="SemiBold" />
                    <TextBlock x:Name="ImportSourcesStatusText" TextWrapping="Wrap" Opacity="0.72" />
                    <ListView x:Name="ImportSourcesList" MaxHeight="260" SelectionChanged="ImportSourcesList_SelectionChanged" />
                    <TextBlock x:Name="ImportComparisonText" TextWrapping="Wrap" Opacity="0.72" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Fusionner le navigateur selectionne" Click="ImportBrowserButton_Click" />
                        <Button Content="Remplacer par le navigateur selectionne" Click="ReplaceBrowserButton_Click" />
                    </StackPanel>
                    <TextBlock Text="Fichier HTML" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Importer un fichier HTML" Click="ImportHtmlButton_Click" />
                        <Button Content="Exporter en HTML" Click="ExportHtmlButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- SettingsPanel : sidebar gauche + contenu à droite -->
            <Grid x:Name="SettingsPanel" Grid.Column="2" Visibility="Collapsed"
                  Background="{StaticResource NovaPanelBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Barre de navigation des paramètres -->
                <Border Grid.RowSpan="2"
                        Grid.Column="0"
                        BorderThickness="0,0,1,0"
                        BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Background="{StaticResource NovaChromeSurfaceBrush}">
                    <StackPanel Padding="14,20,14,12" Spacing="4">
                        <TextBlock Text="Paramètres" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,12" />
                        <RadioButton x:Name="SettingsNavNavigation" Content="Navigation"
                                     GroupName="SettingsNav" IsChecked="True"
                                     Click="SettingsNav_Click" Tag="navigation" />
                        <RadioButton x:Name="SettingsNavAppearance" Content="Personnalisation"
                                     GroupName="SettingsNav"
                                     Click="SettingsNav_Click" Tag="appearance" />
                        <RadioButton x:Name="SettingsNavProfile" Content="Profil"
                                     GroupName="SettingsNav"
                                     Click="SettingsNav_Click" Tag="profile" />
                        <RadioButton x:Name="SettingsNavPrivacy" Content="Confidentialite"
                                     GroupName="SettingsNav"
                                     Click="SettingsNav_Click" Tag="privacy" />
                        <RadioButton x:Name="SettingsNavVault" Content="Coffre"
                                     GroupName="SettingsNav"
                                     Click="SettingsNav_Click" Tag="vault" />
                        <RadioButton x:Name="SettingsNavAccessibility" Content="Accessibilite"
                                     GroupName="SettingsNav"
                                     Click="SettingsNav_Click" Tag="accessibility" />
                        <RadioButton x:Name="SettingsNavStorage" Content="Stockage"
                                     GroupName="SettingsNav"
                                     Click="SettingsNav_Click" Tag="storage" />
                        <RadioButton x:Name="SettingsNavStartup" Content="Demarrage"
                                     GroupName="SettingsNav"
                                     Click="SettingsNav_Click" Tag="startup" />
                    </StackPanel>
                </Border>

                <!-- Zone de contenu des paramètres -->
                <ScrollViewer Grid.Row="0" Grid.Column="1" Padding="28,22,28,18">
                    <StackPanel Spacing="18" MaxWidth="760">

                        <!-- Section : Navigation -->
                        <StackPanel x:Name="SettingsSectionNavigation" Spacing="12">
                            <TextBlock Text="Navigation" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="Choisissez le moteur de recherche, le comportement des onglets et les raccourcis clavier utiles au quotidien."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <TextBlock Text="Recherche" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <ComboBox x:Name="SearchEngineCombo" Header="Moteur de recherche" Width="280"
                                      SelectionChanged="SearchEngineCombo_SelectionChanged">
                                <ComboBoxItem Content="Google" Tag="google" />
                                <ComboBoxItem Content="DuckDuckGo" Tag="duckduckgo" />
                                <ComboBoxItem Content="Brave Search" Tag="brave" />
                                <ComboBoxItem Content="Bing" Tag="bing" />
                            </ComboBox>
                            <ToggleSwitch x:Name="AddressSuggestionsSwitch" Header="Suggestions dans la barre d'adresse" Toggled="AddressSuggestionsSwitch_Toggled" />
                            <TextBlock Text="Pendant la frappe, propose vos onglets ouverts, favoris et pages deja visitees. Calcul 100% local sur cet appareil : ce que vous tapez n'est jamais envoye a un service de suggestions."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="TranslationEnabledSwitch" Header="Proposer de traduire les pages" Toggled="TranslationEnabledSwitch_Toggled" />
                            <TextBlock Text="Traduction neuronale locale (actuellement anglais vers francais). Le modele est telecharge une seule fois puis la traduction se fait entierement hors ligne, jamais de texte envoye a un serveur."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="SearchAssistEnabledSwitch" Header="Assistant IA pour preciser mes recherches" Toggled="SearchAssistEnabledSwitch_Toggled" />
                            <TextBlock Text="Desactive par defaut : necessite un telechargement unique d'environ 2,7 Go (modele de langage local Phi-3-mini). Une fois telechargee, la reformulation se fait hors ligne ; seule la requete finale que vous validez est envoyee a votre moteur de recherche, exactement comme aujourd'hui."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Onglets" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <ToggleSwitch x:Name="VerticalTabsSwitch" Header="Barre d'onglets verticale" Toggled="VerticalTabsSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Palette de commande" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Raccourci Ctrl+K" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="Ctrl+K ouvre une recherche rapide dans les onglets, favoris, historique et commandes de Lumora. Par defaut, le raccourci respecte les champs de saisie et les formulaires web."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Ouvrir Ctrl+K"
                                                Style="{StaticResource NovaCompactButtonStyle}"
                                                Click="SettingsOpenCommandPaletteButton_Click" />
                                        <Button Content="Demarrage"
                                                Style="{StaticResource NovaCompactButtonStyle}"
                                                Click="SettingsStartupShortcutButton_Click" />
                                        <Button Content="Accessibilite"
                                                Style="{StaticResource NovaCompactButtonStyle}"
                                                Click="SettingsAccessibilityShortcutButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ToggleSwitch x:Name="CommandPaletteEnabledSwitch"
                                          Header="Palette de commande Ctrl+K"
                                          Toggled="CommandPaletteEnabledSwitch_Toggled" />
                            <ToggleSwitch x:Name="CommandPaletteWebPagesSwitch"
                                          Header="Autoriser Ctrl+K depuis les pages web"
                                          Toggled="CommandPaletteContextSwitch_Toggled" />
                            <ToggleSwitch x:Name="CommandPaletteTextFieldsSwitch"
                                          Header="Autoriser Ctrl+K pendant la saisie dans un champ"
                                          Toggled="CommandPaletteContextSwitch_Toggled" />
                            <TextBlock Text="Activez ces deux autorisations uniquement si vous voulez que Lumora intercepte Ctrl+K meme quand une page ou un champ de texte a le focus."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                        </StackPanel>

                        <!-- Section : Personnalisation -->
                        <StackPanel x:Name="SettingsSectionAppearance" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Personnalisation" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="Adaptez l'apparence, la densite et le comportement des surfaces Lumora sans changer la logique locale du navigateur."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="64" Height="64" VerticalAlignment="Top">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="ProfileAvatarBrush" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Avatar Lumora" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Image locale visible dans le bandeau bas du navigateur. Elle reste dans ce profil et n'est jamais synchronisee."
                                                   Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Choisir une image"
                                                    Click="ChangeAvatarButton_Click"
                                                    Style="{StaticResource NovaCompactButtonStyle}" />
                                            <Button x:Name="RemoveAvatarButton"
                                                    Content="Supprimer"
                                                    Click="RemoveAvatarButton_Click"
                                                    Style="{StaticResource NovaCompactButtonStyle}"
                                                    Visibility="Collapsed" />
                                        </StackPanel>
                                        <TextBlock x:Name="AvatarPendingText"
                                                   Style="{StaticResource NovaPanelDescriptionStyle}"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="Apparence" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <ComboBox x:Name="ThemeModeCombo" Header="Theme" Width="220"
                                      SelectionChanged="ThemeModeCombo_SelectionChanged">
                                <ComboBoxItem Content="Sombre" Tag="dark" />
                                <ComboBoxItem Content="Clair" Tag="light" />
                                <ComboBoxItem Content="Systeme" Tag="system" />
                            </ComboBox>
                            <ComboBox x:Name="AccentPaletteCombo" Header="Palette Lumora" Width="260"
                                      SelectionChanged="AppearanceOption_Changed">
                                <ComboBoxItem Content="Lumora cyan" Tag="lumora" />
                                <ComboBoxItem Content="Ocean" Tag="ocean" />
                                <ComboBoxItem Content="Foret" Tag="forest" />
                                <ComboBoxItem Content="Ambre" Tag="ember" />
                            </ComboBox>
                            <ToggleSwitch x:Name="BookmarksBarSwitch" Header="Barre de favoris visible" IsOn="True" Toggled="BookmarksBarSwitch_Toggled" />
                            <ToggleSwitch x:Name="CompactModeSwitch" Header="Interface compacte" Toggled="CompactModeSwitch_Toggled" />
                            <ToggleSwitch x:Name="CompactModeHideBookmarksSwitch"
                                          Header="Masquer les favoris en interface compacte"
                                          Toggled="CompactModeHideBookmarksSwitch_Toggled" />
                            <ToggleSwitch x:Name="FullScreenAutoHideChromeSwitch"
                                          Header="Masquer les barres en plein ecran et les reveler au survol"
                                          Toggled="FullScreenAutoHideChromeSwitch_Toggled" />
                            <TextBlock Text="En plein ecran, approchez la souris du haut pour les actions principales, ou du bord gauche pour retrouver le rail lateral."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,8,0,0" />
                            <TextBlock Text="Nouvel onglet" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBox x:Name="NewTabTitleBox"
                                     Header="Titre affiche"
                                     MaxLength="32"
                                     TextChanged="NewTabTitleBox_TextChanged" />
                            <ComboBox x:Name="NewTabStyleCombo" Header="Style du nouvel onglet" Width="260"
                                      SelectionChanged="AppearanceOption_Changed">
                                <ComboBoxItem Content="Signature" Tag="signature" />
                                <ComboBoxItem Content="Calme" Tag="calm" />
                                <ComboBoxItem Content="Minimal" Tag="minimal" />
                            </ComboBox>
                            <ToggleSwitch x:Name="NewTabFocusSearchSwitch"
                                          Header="Placer le curseur dans la recherche du nouvel onglet"
                                          Toggled="NewTabFocusSearchSwitch_Toggled" />
                            <TextBlock Text="Desactive par defaut pour eviter qu'une saisie de connexion ou de PIN se retrouve dans la page d'accueil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="NewTabShortcutsSwitch"
                                          Header="Afficher les raccourcis"
                                          Toggled="NewTabShortcutsSwitch_Toggled" />
                            <TextBlock Text="Desactiver masque uniquement la liste des raccourcis deja ajoutes. Le bouton d'ajout rapide (+) reste toujours disponible sur la page nouvel onglet."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <TextBox x:Name="NewTabShortcutsBox"
                                     Header="Raccourcis"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Height="120"
                                     PlaceholderText="Nom | https://exemple.com"
                                     TextChanged="NewTabShortcutsBox_TextChanged" />
                            <TextBlock Text="Un raccourci par ligne : Nom | URL."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <TextBlock x:Name="AppearancePendingText"
                                       Text="Les changements de personnalisation sont appliques avec le bouton global en bas des parametres."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                        </StackPanel>

                        <!-- Section : Accessibilite -->
                        <StackPanel x:Name="SettingsSectionAccessibility" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Accessibilite" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="Ces reglages facilitent la lecture, le reperage au clavier et l'usage avec des aides techniques. Ils restent locaux a ce profil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <TextBlock Text="Affichage" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <ToggleSwitch x:Name="AccessibilityHighContrastSwitch"
                                          Header="Contraste renforce"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Augmente les contrastes de la chrome Lumora, des panneaux et de la page d'accueil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityLargeTextSwitch"
                                          Header="Texte plus lisible"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Agrandit les textes de navigation, de commande et les messages importants."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityReduceMotionSwitch"
                                          Header="Limiter les transitions visuelles"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Agit surtout sur les transitions de survol de l'accueil et des controles internes."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityVisibleFocusSwitch"
                                          Header="Focus clavier plus visible"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Renforce les contours visibles quand vous naviguez avec Tab, Entree ou les fleches."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Assistants vocaux" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <ToggleSwitch x:Name="AccessibilityVoiceDictationSwitch"
                                          Header="Dictee vocale (bouton micro)"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Ajoute un bouton micro dans la barre d'adresse qui rappelle le raccourci de la dictee Windows : cliquez dans un champ de texte puis appuyez sur Win+H. La voix est traitee par Windows selon vos parametres systeme, Lumora n'ouvre jamais le micro lui-meme."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="ReadAloudEnabledSwitch" Header="Lire les pages a voix haute" Toggled="ReadAloudEnabledSwitch_Toggled" />
                            <TextBlock Text="Ajoute un bouton dans la barre d'outils pour faire lire le texte de la page a voix haute (utile en cas de difficulte de lecture). Synthese vocale 100% locale (Windows), aucun texte de page envoye a un serveur externe."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Clavier et lecteurs d'ecran" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Navigation clavier" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="Ctrl+K ouvre la palette, Echap ferme les panneaux temporaires ou quitte le plein ecran, Tab parcourt les commandes visibles."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Les boutons, onglets, favoris et menus principaux exposent des noms lisibles aux lecteurs d'ecran."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                        </StackPanel>

                        <!-- Section : Démarrage -->
                        <StackPanel x:Name="SettingsSectionStartup" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Demarrage" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <RadioButtons x:Name="StartupModeRadio" Header="Page au demarrage" SelectionChanged="StartupModeRadio_SelectionChanged">
                                <RadioButton x:Name="StartupRestoreRadio" Content="Restaurer la session precedente" Tag="restore" />
                                <RadioButton x:Name="StartupHomeRadio" Content="Accueil Lumora" Tag="home" />
                                <RadioButton x:Name="StartupCustomRadio" Content="URL personnalisee" Tag="custom" />
                            </RadioButtons>
                            <TextBox x:Name="StartupUrlBox" Header="URL de demarrage"
                                     Visibility="Collapsed" PlaceholderText="https://..."
                                     TextChanged="StartupUrlBox_TextChanged" MaxWidth="400" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Section : Coffre -->
                        <StackPanel x:Name="SettingsSectionVault" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Coffre" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="vault.lumora reste local, chiffre et lie a votre profil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Text="La recuperation n'est possible qu'avec la cle de recuperation locale que vous avez notee. Sans mot de passe et sans cette cle, Lumora ne peut pas dechiffrer le coffre." />
                            </Border>
                            <TextBlock Text="Le mot de passe du coffre se change depuis Profil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="VaultMenu_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Permissions" />
                                        <TextBlock Text="Ouvrir les mots de passe" />
                                    </StackPanel>
                                </Button>
                                <Button Click="ImportPasswordsMenu_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Import" />
                                        <TextBlock Text="Importer un CSV" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                    Margin="0,8,0,0" />
                            <TextBlock Text="Portefeuille" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Cartes stockees dans le meme coffre. Remplissage uniquement sur clic explicite ; CVV jamais enregistre." />
                            <Button Click="WalletMenu_Click" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                    <TextBlock Text="Ouvrir le portefeuille" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Section : Profil -->
                        <StackPanel x:Name="SettingsSectionProfile" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Profil" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock x:Name="ProfileNameDisplay" Opacity="0.78" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Identite visible" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="L'avatar et les options visuelles sont regroupes dans Personnalisation. Ici, Lumora garde les actions sensibles du profil."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <Button Content="Ouvrir la personnalisation"
                                            Click="OpenPersonalizationFromProfileButton_Click"
                                            Style="{StaticResource NovaCompactButtonStyle}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Changer le nom" Click="ChangeProfileNameButton_Click" />
                                <Button Grid.Column="1" Content="Changer le mot de passe" Click="ChangeProfilePasswordButton_Click" />
                                <Button Grid.Column="2" Content="Nouvelle cle de recuperation"
                                        Click="CreateRecoveryKeyButton_Click" />
                            </Grid>
                            <ToggleSwitch x:Name="ProfilePinSwitch" Header="Code PIN rapide (6 chiffres)"
                                         Toggled="ProfilePinSwitch_Toggled" />
                            <ComboBox x:Name="SessionTimeoutCombo"
                                      Header="Verrouillage automatique de la session"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="SessionTimeoutCombo_SelectionChanged">
                                <ComboBoxItem Content="Jamais" Tag="0" />
                                <ComboBoxItem Content="10 minutes" Tag="10" />
                                <ComboBoxItem Content="1 heure" Tag="60" />
                                <ComboBoxItem Content="5 heures" Tag="300" />
                            </ComboBox>
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                    Margin="0,8,0,0" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Utilisateurs locaux" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="Profils detectes sur cet ordinateur." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Actualiser" Click="RefreshProfilesButton_Click" />
                                <Button Grid.Column="2" Content="Creer un profil" Click="CreateAnotherProfileFromSettingsButton_Click" />
                            </Grid>
                            <StackPanel x:Name="ProfileManagementPanel" Spacing="8" />
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                    Margin="0,8,0,0" />
                            <TextBlock Text="Reinitialisation" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Supprime definitivement toutes vos donnees : favoris, historique, onglets, parametres, coffre et identifiants de connexion. Operation irreversible." />
                            <Button Content="Reinitialiser le profil..."
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Click="ResetProfileButton_Click" />
                        </StackPanel>

                        <!-- Section : Stockage -->
                        <StackPanel x:Name="SettingsSectionStorage" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Stockage" Style="{StaticResource NovaPanelPageTitleStyle}" />

                            <TextBlock Text="Dossier actuel" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBox x:Name="StorageCurrentFolderText"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     Opacity="0.78" FontFamily="Consolas" FontSize="12" />
                            <Button Content="Changer de dossier..." Click="ChangeFolderButton_Click" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Les fichiers existants seront copies vers le nouvel emplacement. Redemarrage necessaire." />

                            <InfoBar x:Name="StorageRestartBar"
                                     Title="Redemarrage requis"
                                     Message="Le dossier de donnees a ete modifie. Redemarrez Lumora pour appliquer le changement."
                                     Severity="Warning"
                                     IsOpen="False">
                                <InfoBar.ActionButton>
                                    <Button Content="Fermer Lumora" Click="StorageRestartCloseButton_Click" />
                                </InfoBar.ActionButton>
                            </InfoBar>

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />

                            <TextBlock Text="Donnees de navigation" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Supprime cookies, sessions, cache et donnees des sites." />
                            <Button Content="Vider les donnees de navigation"
                                    Click="ClearBrowsingDataButton_Click" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />

                            <TextBlock Text="Sauvegarde" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Favoris, historique, onglets et parametres dans un fichier chiffre. Le coffre reste lie au compte Windows." />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Exporter une sauvegarde..." Click="ExportBackupButton_Click" />
                                <Button Content="Importer une sauvegarde..." Click="ImportBackupButton_Click" />
                            </StackPanel>

                            <InfoBar x:Name="StorageImportBar"
                                     Title="Restauration réussie"
                                     Message="Les données ont été importées. Redémarrez Lumora pour appliquer tous les changements."
                                     Severity="Success"
                                     IsOpen="False">
                                <InfoBar.ActionButton>
                                    <Button Content="Fermer Lumora" Click="StorageRestartCloseButton_Click" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </StackPanel>

                        <!-- Section : Confidentialité -->
                        <StackPanel x:Name="SettingsSectionPrivacy" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Confidentialité" Style="{StaticResource NovaPanelPageTitleStyle}" />

                            <!-- Compteur de blocages -->
                            <Border Style="{StaticResource NovaPanelCardStyle}"
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="PrivacyBlockedCountText"
                                               Text="0 requête bloquée"
                                               FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PrivacyRuleCountText"
                                               Text="Chargement des règles..."
                                               Opacity="0.7" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Bloqueur pub / trackers -->
                            <TextBlock Text="Pubs et trackers" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Bloque les serveurs publicitaires et de tracking avec des listes locales." />
                            <ToggleSwitch x:Name="NetworkBlockerSwitch"
                                         Header="Activer le bloqueur"
                                         Toggled="NetworkBlockerSwitch_Toggled" />
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
                                <Button x:Name="UpdatePrivacyListsButton"
                                        Content="Mettre à jour les listes maintenant"
                                        Click="UpdatePrivacyListsButton_Click" />
                                <TextBlock x:Name="PrivacyLastUpdateText"
                                           VerticalAlignment="Center"
                                           Opacity="0.65" FontSize="12" />
                            </StackPanel>
                            <TextBlock x:Name="PrivacyStatusText"
                                       Style="{StaticResource NovaPanelDescriptionStyle}"
                                       FontStyle="Italic" />
                            <InfoBar x:Name="PrivacyListsUpdateBar"
                                     Title="Listes mises à jour"
                                     Message="Les nouvelles règles de filtrage sont actives."
                                     Severity="Success"
                                     IsOpen="False" IsClosable="True" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Anti-télémétrie -->
                            <TextBlock Text="Anti-télémétrie" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Bloque la mesure d'audience, le replay de session, les rapports de crash et les métriques produit des sites." />
                            <ToggleSwitch x:Name="TelemetryBlockerSwitch"
                                         Header="Bloquer la télémétrie"
                                         Toggled="TelemetryBlockerSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Nettoyage URL -->
                            <TextBlock Text="Nettoyage des URL" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Retire les paramètres de tracking avant navigation." />
                            <ToggleSwitch x:Name="ParameterCleanerSwitch"
                                         Header="Nettoyer les URL"
                                         Toggled="ParameterCleanerSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- HTTPS enforcer -->
                            <TextBlock Text="HTTPS" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Tente HTTPS avant HTTP quand le site le permet." />
                            <ToggleSwitch x:Name="HttpsEnforcerSwitch"
                                         Header="Forcer HTTPS"
                                         Toggled="HttpsEnforcerSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- CNAME uncloaker -->
                            <TextBlock Text="CNAME cloaking" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Détecte les trackers cachés derrière un alias DNS." />
                            <ToggleSwitch x:Name="CnameUncloakerSwitch"
                                         Header="Détecter le CNAME cloaking"
                                         Toggled="CnameUncloakerSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Filtre cosmétique -->
                            <TextBlock Text="Masquage visuel" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Masque les emplacements publicitaires vides après filtrage réseau." />
                            <ToggleSwitch x:Name="CosmeticFilterSwitch"
                                         Header="Masquer les emplacements pub"
                                         Toggled="CosmeticFilterSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Gestionnaire de consentement cookies -->
                            <TextBlock Text="Cookies" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Refuse les bandeaux compatibles quand cela ne casse pas le site." />
                            <ToggleSwitch x:Name="ConsentManagerSwitch"
                                         Header="Refuser automatiquement les cookies"
                                         Toggled="ConsentManagerSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Sessions éphémères -->
                            <TextBlock Text="Sessions éphémères" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Purge les sessions au démarrage, sauf pour les sites que vous gardez connectés." />
                            <ToggleSwitch x:Name="SessionPurgeSwitch"
                                         Header="Purger les sessions au démarrage"
                                         Toggled="SessionPurgeSwitch_Toggled" />
                            <HyperlinkButton Content="Gérer les sites connectés"
                                             Click="SessionsManageLink_Click"
                                             HorizontalAlignment="Left"
                                             Padding="0" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- SmartScreen -->
                            <TextBlock Text="SmartScreen" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Protection Microsoft anti-phishing optionnelle. Désactivée par défaut." />
                            <ToggleSwitch x:Name="SmartScreenSwitch"
                                         Header="Activer SmartScreen (envoie les URL à Microsoft)"
                                         Toggled="SmartScreenSwitch_Toggled" />

                            <!-- Renforcement anti-publicité (0.77) : popups et détournements -->
