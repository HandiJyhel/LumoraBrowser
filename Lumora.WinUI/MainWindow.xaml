<Window
    x:Class="Lumora.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d"
    Title="Lumora">

    <Grid x:Name="RootShell" Background="#FF0D1422">
        <Grid.Resources>
            <!-- Valeurs de depart avant le premier ApplyAccessibilitySettings()
                 (constructeur) : elles restent ecrasees au demarrage, mais on
                 les garde alignees sur la base ardoise + cyan bleute de la
                 palette 0.84.0.13-dev pour eviter tout retour visuel verdatre
                 sur un ecran oublie. -->
            <SolidColorBrush x:Key="NovaAppBackgroundBrush" Color="#FF090D14" />
            <SolidColorBrush x:Key="NovaChromeSurfaceBrush" Color="#FF10151F" />
            <SolidColorBrush x:Key="NovaChromeSurfaceAltBrush" Color="#FF141A26" />
            <SolidColorBrush x:Key="NovaChromeSurfaceRaisedBrush" Color="#FF1A212E" />
            <SolidColorBrush x:Key="NovaChromeStrokeBrush" Color="#FF2F3848" />
            <SolidColorBrush x:Key="NovaChromeStrokeSoftBrush" Color="#FF1E2633" />
            <SolidColorBrush x:Key="NovaAddressBackgroundBrush" Color="#FF121925" />
            <SolidColorBrush x:Key="NovaAddressBorderBrush" Color="#FF434F65" />
            <SolidColorBrush x:Key="NovaAddressForegroundBrush" Color="#FFF2F5FA" />
            <SolidColorBrush x:Key="NovaChromeButtonBackgroundBrush" Color="#FF121925" />
            <SolidColorBrush x:Key="NovaChromeButtonBorderBrush" Color="#FF2F3848" />
            <SolidColorBrush x:Key="NovaChromeButtonForegroundBrush" Color="#FFF2F5FA" />
            <SolidColorBrush x:Key="NovaChromeButtonAccentBackgroundBrush" Color="#2438A4C3" />
            <SolidColorBrush x:Key="NovaChromeButtonAccentBorderBrush" Color="#FF56C2E4" />
            <SolidColorBrush x:Key="NovaChromeButtonAccentForegroundBrush" Color="#FFF2F5FA" />
            <SolidColorBrush x:Key="NovaModuleButtonBackgroundBrush" Color="#161A212E" />
            <SolidColorBrush x:Key="NovaModuleButtonBorderBrush" Color="#3343DBD1" />
            <SolidColorBrush x:Key="NovaModuleButtonForegroundBrush" Color="#FFF2F5FA" />
            <SolidColorBrush x:Key="NovaBookmarkButtonBackgroundBrush" Color="#FFF6F0E5" />
            <SolidColorBrush x:Key="NovaBookmarkButtonBorderBrush" Color="#FFE0CDAE" />
            <SolidColorBrush x:Key="NovaBookmarkButtonForegroundBrush" Color="#FF5E4E35" />
            <SolidColorBrush x:Key="NovaBookmarkButtonActiveBackgroundBrush" Color="#FFFFF1CC" />
            <SolidColorBrush x:Key="NovaBookmarkButtonActiveBorderBrush" Color="#FFE6AA48" />
            <SolidColorBrush x:Key="NovaBookmarkButtonActiveForegroundBrush" Color="#FF8A5400" />
            <SolidColorBrush x:Key="NovaTextMutedBrush" Color="#FFABB2BF" />
            <SolidColorBrush x:Key="NovaAccentBrush" Color="#FFE6AA48" />
            <SolidColorBrush x:Key="NovaAccentSoftBrush" Color="#2AE6AA48" />
            <SolidColorBrush x:Key="NovaCoolAccentBrush" Color="#FF56C2E4" />
            <SolidColorBrush x:Key="NovaCoolAccentSoftBrush" Color="#2456C2E4" />
            <SolidColorBrush x:Key="NovaCompanionGlassBrush" Color="#331A2731" />
            <SolidColorBrush x:Key="NovaCompanionStrokeBrush" Color="#3343DBD1" />
            <SolidColorBrush x:Key="NovaModeSelectorGlassBrush" Color="#331A2731" />
            <SolidColorBrush x:Key="NovaModeSelectorStrokeBrush" Color="#3340545B" />
            <SolidColorBrush x:Key="NovaModuleHubGlassBrush" Color="#331A2731" />
            <SolidColorBrush x:Key="NovaModuleHubStrokeBrush" Color="#3343DBD1" />
            <SolidColorBrush x:Key="NovaModuleHubNodeBrush" Color="#FFC3B9A5" />
            <SolidColorBrush x:Key="NovaModuleHubAccentBrush" Color="#FF43DBD1" />
            <SolidColorBrush x:Key="NovaFocusBrush" Color="#FFFFE668" />
            <SolidColorBrush x:Key="NovaFocusInnerBrush" Color="#FF0D1822" />
            <SolidColorBrush x:Key="NovaInfoSurfaceBrush" Color="#FF1D2E38" />
            <SolidColorBrush x:Key="NovaPanelBackgroundBrush" Color="#FF101D26" />
            <SolidColorBrush x:Key="NovaTextOnAccentBrush" Color="#FF0D1822" />
            <SolidColorBrush x:Key="NovaOverlayBrush" Color="#66000000" />
            <!-- Teinte plate : utilisee telle quelle sur les surfaces non rondes
                 (fond/trait de la barre d'adresse, pastilles de badge) - un
                 degrade radial y rendrait comme une tache lumineuse localisee
                 au lieu d'une teinte uniforme. -->
            <SolidColorBrush x:Key="NovaChromeHaloWarmBrush" Color="#26E6AA48" />
            <SolidColorBrush x:Key="NovaChromeHaloCoolBrush" Color="#2256C2E4" />
            <!-- Lueur en degrade radial, reservee aux vrais ronds (Ellipse) :
                 lue comme une lueur/nebuleuse qui s'estompe, pas comme une
                 pastille aux bords nets - direction "spatial" sans neon. -->
            <RadialGradientBrush x:Key="NovaChromeHaloWarmGlowBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#40E6AA48" Offset="0" />
                <GradientStop Color="#00E6AA48" Offset="1" />
            </RadialGradientBrush>
            <RadialGradientBrush x:Key="NovaChromeHaloCoolGlowBrush" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Color="#4056C2E4" Offset="0" />
                <GradientStop Color="#0056C2E4" Offset="1" />
            </RadialGradientBrush>
            <SolidColorBrush x:Key="NovaChromeMistBrush" Color="#22FFFFFF" />
            <!-- Verre plutot que peint : materiau in-app (pas le fond de
                 fenetre) pour la barre de navigation et les favoris, qui
                 flottent desormais au-dessus du fond de l'app au lieu d'etre
                 des bandes collees pleine largeur. -->
            <AcrylicBrush x:Key="NovaFloatingGlassBrush"
                          TintColor="#1A2230"
                          TintOpacity="0.72"
                          TintLuminosityOpacity="0.55"
                          FallbackColor="#F0141A26" />
            <SolidColorBrush x:Key="NovaBrandChipBackgroundBrush" Color="#CC16202E" />
            <SolidColorBrush x:Key="NovaBrandChipBorderBrush" Color="#7056C2E4" />
            <SolidColorBrush x:Key="NovaBrandChipForegroundBrush" Color="#FFF2F5FA" />
            <SolidColorBrush x:Key="NovaBrandChipMutedBrush" Color="#B0C6D2DD" />
            <SolidColorBrush x:Key="NovaChromeButtonShadowBrush" Color="#42000000" />
            <SolidColorBrush x:Key="NovaChromeButtonHighlightBrush" Color="#30FFFFFF" />
            <SolidColorBrush x:Key="NovaBookmarkBarButtonBackgroundBrush" Color="#1EF6F0E5" />
            <SolidColorBrush x:Key="NovaBookmarkBarButtonBorderBrush" Color="#40E0CDAE" />
            <SolidColorBrush x:Key="NovaBookmarkBarButtonForegroundBrush" Color="#FFF2F5FA" />
            <!-- Pastille d'onglet (TabHeaderContent + rail vertical) : source unique,
                 remplace les UiColor(...) codes en dur qui divergeaient legerement
                 entre onglet compact/normal/rail et ne suivaient pas les changements
                 de theme/accessibilite. -->
            <SolidColorBrush x:Key="NovaTabPillActiveBackgroundBrush" Color="#EC172334" />
            <SolidColorBrush x:Key="NovaTabPillInactiveBackgroundBrush" Color="#B8131B27" />
            <SolidColorBrush x:Key="NovaTabPillActiveBorderBrush" Color="#B456C2E4" />
            <SolidColorBrush x:Key="NovaTabPillInactiveBorderBrush" Color="#983D4758" />
            <!-- Texte des pastilles (titre/sous-titre/badge/cercle icone) :
                 memes valeurs de depart que ci-dessus, ecrasees par
                 ApplyAccessibilitySettings des le demarrage. -->
            <SolidColorBrush x:Key="NovaTabTitleActiveForegroundBrush" Color="#FFF2F5FA" />
            <SolidColorBrush x:Key="NovaTabTitleInactiveForegroundBrush" Color="#FFD6DDE5" />
            <SolidColorBrush x:Key="NovaTabSubtitleActiveForegroundBrush" Color="#FFC3DAE8" />
            <SolidColorBrush x:Key="NovaTabSubtitleInactiveForegroundBrush" Color="#FF9DABB8" />
            <SolidColorBrush x:Key="NovaTabBadgeActiveBackgroundBrush" Color="#2EFFE668" />
            <SolidColorBrush x:Key="NovaTabBadgeActiveBorderBrush" Color="#5CFFE668" />
            <SolidColorBrush x:Key="NovaTabBadgeActiveForegroundBrush" Color="#FFFFECAA" />
            <SolidColorBrush x:Key="NovaTabBadgeInactiveBackgroundBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="NovaTabBadgeInactiveBorderBrush" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="NovaTabBadgeInactiveForegroundBrush" Color="#FFD6DDE5" />
            <SolidColorBrush x:Key="NovaTabIconWrapActiveBackgroundBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="NovaTabIconWrapInactiveBackgroundBrush" Color="#10FFFFFF" />
            <!-- Neutralise l'habillage Fluent natif de TabViewItem (fond/bordure
                 neutres, CornerRadius generique) : sans ca, la coquille native
                 (trapeze gris + CornerRadius par defaut) restait visible sous la
                 pastille Nova arrondie de TabHeaderContent -> double relief. -->
            <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="Transparent" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver" ResourceKey="NovaChromeButtonHighlightBrush" />
            <StaticResource x:Key="TabViewItemHeaderBackgroundPressed" ResourceKey="NovaChromeButtonHighlightBrush" />
            <SolidColorBrush x:Key="TabViewItemHeaderBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="TabViewItemBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent" />
            <StaticResource x:Key="TabViewItemSeparator" ResourceKey="NovaChromeStrokeSoftBrush" />
            <LinearGradientBrush x:Key="NovaChromeGradientBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF10151F" Offset="0" />
                <GradientStop Color="#FF1A212E" Offset="0.55" />
                <GradientStop Color="#FF141A26" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NovaIdentityMarkBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF56C2E4" Offset="0" />
                <GradientStop Color="#FFE6AA48" Offset="0.56" />
                <GradientStop Color="#FFFF7F35" Offset="1" />
            </LinearGradientBrush>
            <ControlTemplate x:Key="NovaRaisedIconButtonTemplate" TargetType="Button">
                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="ShadowLayer.Opacity" Value="0.92" />
                                    <Setter Target="TopGloss.Opacity" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="ShadowLayer.Opacity" Value="0.16" />
                                    <Setter Target="SurfaceBorder.Margin" Value="0,1,0,-1" />
                                    <Setter Target="TopGloss.Opacity" Value="0.28" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="SurfaceBorder.Opacity" Value="0.44" />
                                    <Setter Target="ShadowLayer.Opacity" Value="0.10" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="ShadowLayer"
                            Margin="0,3,0,0"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{StaticResource NovaChromeButtonShadowBrush}"
                            Opacity="0.85" />
                    <Border x:Name="SurfaceBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Border x:Name="TopGloss"
                                    Height="10"
                                    Margin="1,1,1,0"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource NovaChromeButtonHighlightBrush}"
                                    Opacity="0.92" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>
                </Grid>
            </ControlTemplate>
            <ControlTemplate x:Key="NovaRaisedBookmarkBarButtonTemplate" TargetType="Button">
                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="ShadowLayer.Opacity" Value="0.78" />
                                    <Setter Target="TopGloss.Opacity" Value="0.94" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="ShadowLayer.Opacity" Value="0.14" />
                                    <Setter Target="SurfaceBorder.Margin" Value="0,1,0,-1" />
                                    <Setter Target="TopGloss.Opacity" Value="0.20" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="SurfaceBorder.Opacity" Value="0.42" />
                                    <Setter Target="ShadowLayer.Opacity" Value="0.08" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="ShadowLayer"
                            Margin="0,2,0,0"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{StaticResource NovaChromeButtonShadowBrush}"
                            Opacity="0.56" />
                    <Border x:Name="SurfaceBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Border x:Name="TopGloss"
                                    Height="9"
                                    Margin="1,1,1,0"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource NovaChromeButtonHighlightBrush}"
                                    Opacity="0.66" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>
                </Grid>
            </ControlTemplate>
            <Style x:Key="NovaChromeIconButtonStyle" TargetType="Button">
                <!-- 32px par defaut, taille compacte. Cible confort AAA (44px)
                     disponible en opt-in via ApplyIconButtonSizing() (voir
                     MainWindow.SettingsTheme.cs) - jamais imposee. -->
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{StaticResource NovaChromeButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaChromeButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource NovaChromeButtonForegroundBrush}" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource NovaFocusBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource NovaFocusInnerBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template" Value="{StaticResource NovaRaisedIconButtonTemplate}" />
            </Style>
            <Style x:Key="NovaChromeAccentIconButtonStyle" TargetType="Button" BasedOn="{StaticResource NovaChromeIconButtonStyle}">
                <Setter Property="Background" Value="{StaticResource NovaChromeButtonAccentBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource NovaChromeButtonAccentForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaChromeButtonAccentBorderBrush}" />
            </Style>
            <Style x:Key="NovaBookmarkIconButtonStyle" TargetType="Button" BasedOn="{StaticResource NovaChromeIconButtonStyle}">
                <Setter Property="Background" Value="{StaticResource NovaBookmarkButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaBookmarkButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{StaticResource NovaBookmarkButtonForegroundBrush}" />
            </Style>
            <Style x:Key="NovaChromeSymbolIconStyle" TargetType="SymbolIcon">
                <Setter Property="Foreground" Value="{StaticResource NovaChromeButtonForegroundBrush}" />
            </Style>
            <Style x:Key="NovaChromeFontIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{StaticResource NovaChromeButtonForegroundBrush}" />
            </Style>
            <Style x:Key="NovaChromeAccentSymbolIconStyle" TargetType="SymbolIcon">
                <Setter Property="Foreground" Value="{StaticResource NovaChromeButtonAccentForegroundBrush}" />
            </Style>
            <Style x:Key="NovaModuleSymbolIconStyle" TargetType="SymbolIcon">
                <Setter Property="Foreground" Value="{StaticResource NovaModuleButtonForegroundBrush}" />
            </Style>
            <Style x:Key="NovaModuleFontIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{StaticResource NovaModuleButtonForegroundBrush}" />
            </Style>
            <Style x:Key="NovaBookmarkFontIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{StaticResource NovaBookmarkButtonForegroundBrush}" />
            </Style>
            <Style x:Key="NovaModuleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource NovaChromeIconButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="36" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="{StaticResource NovaModuleButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaModuleButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource NovaModuleButtonForegroundBrush}" />
            </Style>
            <!-- Tuile epinglee du menu Demarrer : icone + libelle empiles, plus
                 large que NovaModuleIconButtonStyle (icone seule) pour porter
                 un vrai repere de lecture plutot qu'un glyphe nu identifiable
                 seulement au survol. -->
            <Style x:Key="NovaStartMenuPinnedTileStyle" TargetType="Button" BasedOn="{StaticResource NovaChromeIconButtonStyle}">
                <Setter Property="Width" Value="76" />
                <Setter Property="Height" Value="68" />
                <Setter Property="MinWidth" Value="76" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Background" Value="{StaticResource NovaModuleButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaModuleButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource NovaModuleButtonForegroundBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!-- Rail de navigation lateral (Centre Lumora/Parametres, panneau A
                 propos) : meme langage visuel que l'indicateur de selection
                 natif du rail de categories du Menu Demarrer (barre d'accent +
                 surface relevee), pour que "section active dans un rail
                 lateral" se lise pareil partout dans l'app plutot que via le
                 point radio natif generique. Style scope aux RadioButton de
                 navigation (SettingsNav*, AboutNav*) : ne touche pas les
                 autres RadioButton de choix (confort, demarrage, tri du
                 coffre...) qui restent volontairement au rendu natif, un vrai
                 choix parmi plusieurs valeurs plutot qu'une navigation. -->
            <Style x:Key="NovaSideRailNavRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="12,9,10,9" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="AccentBar" Grid.Column="0" Width="3"
                                           RadiusX="1.5" RadiusY="1.5" Margin="0,3,0,3"
                                           Fill="{StaticResource NovaAccentBrush}" Opacity="0" />
                                <ContentPresenter x:Name="SettingsNavContentPresenter" Grid.Column="1"
                                                  Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{StaticResource NovaChromeSurfaceRaisedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{StaticResource NovaChromeSurfaceRaisedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="SettingsNavContentPresenter.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{StaticResource NovaChromeSurfaceRaisedBrush}" />
                                                <Setter Target="AccentBar.Opacity" Value="1" />
                                                <Setter Target="SettingsNavContentPresenter.(TextElement.FontWeight)" Value="SemiBold" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NovaBookmarkBarButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="12,0,14,0" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="{StaticResource NovaBookmarkBarButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaBookmarkBarButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource NovaBookmarkBarButtonForegroundBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource NovaFocusBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource NovaFocusInnerBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template" Value="{StaticResource NovaRaisedBookmarkBarButtonTemplate}" />
            </Style>
            <Style x:Key="NovaModuleHubButtonStyle" TargetType="Button" BasedOn="{StaticResource NovaModuleIconButtonStyle}">
                <Setter Property="Background" Value="{StaticResource NovaModuleHubGlassBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaModuleHubStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="Foreground" Value="{StaticResource NovaAddressForegroundBrush}" />
            </Style>
            <Style x:Key="NovaModePillButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="MinWidth" Value="118" />
                <Setter Property="Padding" Value="11,0" />
                <Setter Property="CornerRadius" Value="17" />
                <Setter Property="Background" Value="{StaticResource NovaModeSelectorGlassBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaModeSelectorStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource NovaAddressForegroundBrush}" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource NovaFocusBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource NovaFocusInnerBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="NovaCompanionPillButtonStyle" TargetType="Button" BasedOn="{StaticResource NovaModePillButtonStyle}">
                <Setter Property="MinWidth" Value="136" />
                <Setter Property="Background" Value="{StaticResource NovaCompanionGlassBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaCompanionStrokeBrush}" />
            </Style>
            <Style x:Key="NovaStudioActionButtonStyle" TargetType="Button" BasedOn="{StaticResource NovaCompactButtonStyle}">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="{StaticResource NovaCompanionGlassBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaCompanionStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="NovaLoginHeroCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="CornerRadius" Value="16" />
