            <!-- ControlTemplate du TabView recopie de generic.xaml WinUI
                 (Microsoft.WindowsAppSDK.WinUI 1.8) avec deux changements
                 cibles seulement - le reste est identique a la version SDK,
                 pas une reinvention :
                 1) le conteneur du bouton "+" etait VerticalAlignment="Bottom"
                    dans une rangee Auto calee sur le plus grand contenu -
                    concu pour TabViewItemMinHeight=32, mais nos onglets
                    (pastille a deux lignes, TopTabsRow=52) font grandir la
                    rangee sans que le bouton suive : il restait colle en bas,
                    visuellement plus bas que le centre de la pastille (signale
                    par capture d'ecran utilisateur). Passe a "Center".
                 2) le glyph "+" plat (Segoe Fluent, gris systeme, non
                    theme-conscient) remplace par un petit plus trace a la
                    main avec NovaIdentityMarkBrush (dégradé cyan->ambre deja
                    utilise pour la pastille de marque juste a cote), pour
                    rester coherent avec l'identite visuelle plutot qu'un
                    glyph systeme generique (demande explicite utilisateur).
                    Le bouton n'utilise plus "{ThemeResource TabViewButtonStyle}"
                    (le Style nomme du SDK, introuvable en lookup depuis une
                    ControlTemplate copiee hors de generic.xaml - plante au
                    lancement) : couleurs/dimensions posees directement sur
                    l'element avec les memes brushes Nova que les autres
                    boutons du chrome. -->
            <Style TargetType="TabView">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Padding" Value="0,8,0,0" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="KeyboardAcceleratorPlacementMode" Value="Hidden" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabView">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="NormalBottomBorderLine" />
                                        <VisualState x:Name="SingleBottomBorderLine">
                                            <VisualState.Setters>
                                                <Setter Target="LeftBottomBorderLine.(Grid.ColumnSpan)" Value="4" />
                                                <Setter Target="RightBottomBorderLine.Visibility" Value="Collapsed" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid x:Name="TabContainerGrid" Background="{TemplateBinding Background}" XYFocusKeyboardNavigation="Enabled">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="2" x:Name="LeftContentColumn" />
                                        <ColumnDefinition Width="Auto" x:Name="TabColumn" />
                                        <ColumnDefinition Width="Auto" x:Name="AddButtonColumn" />
                                        <ColumnDefinition Width="*" x:Name="RightContentColumn" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="LeftBottomBorderLine" Background="{ThemeResource TabViewBorderBrush}" Height="1" VerticalAlignment="Bottom" />
                                    <Border x:Name="RightBottomBorderLine" Background="{ThemeResource TabViewBorderBrush}" Height="1" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Bottom" />
                                    <ContentPresenter Grid.Column="0" x:Name="LeftContentPresenter" Content="{TemplateBinding TabStripHeader}" ContentTemplate="{TemplateBinding TabStripHeaderTemplate}" />
                                    <primitives:TabViewListView Grid.Column="1" HorizontalAlignment="Stretch" x:Name="TabListView" Padding="{TemplateBinding Padding}" CanReorderItems="{TemplateBinding CanReorderTabs}" CanDragItems="{TemplateBinding CanDragTabs}" AllowDrop="{TemplateBinding AllowDropTabs}" ItemsSource="{TemplateBinding TabItemsSource}" ItemTemplate="{TemplateBinding TabItemTemplate}" ItemTemplateSelector="{TemplateBinding TabItemTemplateSelector}" />
                                    <Border Visibility="{Binding IsAddTabButtonVisible, RelativeSource={RelativeSource TemplatedParent}}" Grid.Column="2" Padding="3,0,0,0" VerticalAlignment="Center">
                                        <Button x:Name="AddButton" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Width="32" Height="24" Padding="0" CornerRadius="6"
                                                Background="{StaticResource NovaChromeButtonBackgroundBrush}"
                                                BorderThickness="0"
                                                IsTextScaleFactorEnabled="False"
                                                Command="{TemplateBinding AddTabButtonCommand}"
                                                CommandParameter="{TemplateBinding AddTabButtonCommandParameter}"
                                                HighContrastAdjustment="None">
                                            <Grid Width="12" Height="12">
                                                <Rectangle Width="12" Height="2.4" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource NovaIdentityMarkBrush}" VerticalAlignment="Center" />
                                                <Rectangle Width="2.4" Height="12" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource NovaIdentityMarkBrush}" HorizontalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </Border>
                                    <ContentPresenter Grid.Column="3" x:Name="RightContentPresenter" HorizontalAlignment="Stretch" Content="{TemplateBinding TabStripFooter}" ContentTemplate="{TemplateBinding TabStripFooterTemplate}" />
                                </Grid>
                                <ContentPresenter x:Name="TabContentPresenter" Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Menu Demarrer : tuiles pilotees par StartMenuTileRegistry +
                 _uiSettings (StartMenuTile_Click/StartMenuTilePin_Click dans
                 MainWindow.StartMenu.cs). StartMenuActionTileTemplate (2
                 colonnes, pleine largeur du flyout) sert a la recherche ;
                 StartMenuDetailTileTemplate (1 colonne, largeur du volet
                 detail plus etroit) sert au rail categories/Epingles/Recent
                 depuis la refonte maitre/detail 0.93.5.0-dev. Icones dans un
                 badge rond au degrade Lumora (NovaIdentityMarkBrush, meme
                 degrade que la marque) plutot qu'un glyphe nu sur fond
                 transparent - retour utilisateur : les tuiles etaient "trop
                 simplistes, ne correspondent pas a Lumora" (glyphes systeme
                 Segoe MDL2 monochromes, aucune identite visuelle propre). -->
            <DataTemplate x:Key="StartMenuActionTileTemplate">
                <Button Style="{StaticResource NovaPanelActionButtonStyle}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Margin="0,0,8,8" Width="278"
                        Tag="{Binding Id}" Click="StartMenuTile_Click"
                        AutomationProperties.Name="{Binding Title}">
                    <Button.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{Binding PinActionLabel}" Tag="{Binding Id}" Click="StartMenuTilePin_Click" />
                        </MenuFlyout>
                    </Button.ContextFlyout>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Grid Width="30" Height="30">
                            <Border CornerRadius="15" Background="{Binding FamilyKey, Converter={StaticResource StartMenuFamilyKeyToBrushConverter}, ConverterParameter={StaticResource NovaIdentityMarkBrush}}" />
                            <FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Opacity="0.62" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="StartMenuDetailTileTemplate">
                <Button Style="{StaticResource NovaPanelActionButtonStyle}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Margin="0,0,0,8"
                        Tag="{Binding Id}" Click="StartMenuTile_Click"
                        AutomationProperties.Name="{Binding Title}">
                    <Button.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{Binding PinActionLabel}" Tag="{Binding Id}" Click="StartMenuTilePin_Click" />
                        </MenuFlyout>
                    </Button.ContextFlyout>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Grid Width="30" Height="30">
                            <Border CornerRadius="15" Background="{Binding FamilyKey, Converter={StaticResource StartMenuFamilyKeyToBrushConverter}, ConverterParameter={StaticResource NovaIdentityMarkBrush}}" />
                            <FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Opacity="0.62" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </DataTemplate>

            <!-- Rail de categories (colonne de gauche) : Epingles + une entree
                 par section du registre. Bouton pleine largeur a l'interieur
                 d'un ListViewItem plutot qu'un ListViewItem stylise
                 directement, pour garder le meme motif clic/tooltip que le
                 reste du menu. Meme badge degrade que les tuiles pour rester
                 coherent (0.93.5.0-dev). -->
            <DataTemplate x:Key="StartMenuCategoryTemplate">
                <!-- Chevron ajoute (2026-08-08, inspire du menu Freebox OS montre par
                     l'utilisateur) : signale visuellement "ceci ouvre un sous-contenu",
                     comme un menu en cascade classique - absent jusqu'ici, la ligne de
                     categorie ne se distinguait pas d'un simple libelle.
                     Couleur par famille + largeur corrigee (2026-08-10, "choses a
                     revoir" - retour utilisateur : "la partie gauche a l'air beaucoup
                     moins quali que la partie droite"). Deux defauts reels distincts
                     dans CE rail, corriges ensemble : (1) le badge reutilisait tel
                     quel le degrade neutre NovaIdentityMarkBrush pour TOUTES les
                     categories, alors que les cartes Epingles juste a cote ont deja
                     une couleur par famille (StartMenuActionTileTemplate/
                     StartMenuDetailTileTemplate ci-dessus) - meme mecanisme applique
                     ici (StartMenuCategoryViewModel.FamilyKey, resolu par
                     StartMenuTileRegistry.ResolveFamilyKey depuis le nom de section,
                     MainWindow.StartMenu.cs). "Epingles" garde volontairement le
                     degrade neutre (FamilyKey null) : ce n'est pas une famille de
                     contenu, c'est l'entree "marque" du menu. (2) Le texte etait
                     tronque en ellipsis ("Lecture et co...", "Lumora et pr...") -
                     TextTrimming retire, colonne du rail elargie de 40px en
                     consequence (StartMenuRailAndDetail/ModulesFlyoutRoot). -->
                <Grid ColumnSpacing="10" Padding="10,9" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{Binding Title}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="26" Height="26">
                        <Border CornerRadius="13" Background="{Binding FamilyKey, Converter={StaticResource StartMenuFamilyKeyToBrushConverter}, ConverterParameter={StaticResource NovaIdentityMarkBrush}}" />
                        <FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                  Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" />
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                              Opacity="0.5" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition x:Name="TopTabsRow" Height="52" />
            <RowDefinition x:Name="NavigationRow" Height="72" />
            <RowDefinition x:Name="BookmarksRow" Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="BottomTabsRow" Height="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="FullScreenTopBar"
              Grid.RowSpan="7"
              Canvas.ZIndex="50"
              Height="44"
              VerticalAlignment="Top"
              Padding="10,0"
              ColumnSpacing="6"
              Visibility="Collapsed"
              Background="{StaticResource NovaChromeSurfaceBrush}"
              PointerEntered="FullScreenTopBar_PointerEntered"
              PointerExited="FullScreenTopBar_PointerExited">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7">
                    <Image Source="ms-appx:///Assets/LumoraLogoMark.png"
                           Width="24" Height="24"
                           Stretch="Uniform" />
                </Border>
                <TextBlock Text="Lumora" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="FullScreenAddressText"
                       Grid.Column="1"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Opacity="0.74"
                       TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="2"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Nouvel onglet"
                    AutomationProperties.Name="Nouvel onglet"
                    Click="NewTabMenu_Click">
                <SymbolIcon Symbol="Add" />
            </Button>
            <Button Grid.Column="3"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Accueil"
                    AutomationProperties.Name="Accueil"
                    Click="HomeMenu_Click">
                <SymbolIcon Symbol="Home" />
            </Button>
            <Button x:Name="FullScreenExitButton"
                    Grid.Column="4"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Quitter le plein écran"
                    AutomationProperties.Name="Quitter le plein ecran"
                    Click="CompactModeButton_Click">
                <SymbolIcon Symbol="BackToWindow" />
            </Button>
            <Button x:Name="MainMenuButton"
                    Grid.Column="5"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    AutomationProperties.Name="Menu Lumora"
                    ToolTipService.ToolTip="Menu Lumora">
                <SymbolIcon Symbol="More" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="LUMORA • lumière locale" IsEnabled="False">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE790;" FontFamily="Segoe MDL2 Assets" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <!-- Couleur par famille de sens (chantier identite visuelle,
                             2026-08-10), meme principe qu'au Menu Demarrer : Bibliotheque =
                             ambre (contenu personnel), Securite et donnees = rose
                             (protection), Navigation = cyan (outils/actions). Incognito
                             reste neutre - meme decision deja prise et documentee le
                             2026-08-09 pour son icone de barre d'outils (lance une fenetre
                             a part, n'est pas lui-meme "en session Incognito"), gardee
                             coherente ici plutot que contredite. -->
                        <MenuFlyoutSubItem Text="Navigation">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyToolsBrush}" />
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem Text="Nouvel onglet" Click="NewTabMenu_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Add" Foreground="{StaticResource NovaTileFamilyToolsBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Incognito" Click="IncognitoWindowMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Rouvrir l'onglet fermé" Click="ReopenTabMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyToolsBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Groupes enregistres" Click="SavedTabGroupsMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyToolsBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Accueil Lumora" Click="HomeMenu_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Home" Foreground="{StaticResource NovaTileFamilyToolsBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Arrêter le chargement" Click="StopButton_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Stop" Foreground="{StaticResource NovaTileFamilyToolsBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Plein écran" Click="CompactModeButton_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="FullScreen" Foreground="{StaticResource NovaTileFamilyToolsBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Bibliothèque">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyContentBrush}" />
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem Text="Favoris" Click="BookmarksMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE735;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyContentBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Importer / exporter les favoris" Click="ImportMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyContentBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Historique" Click="HistoryMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyContentBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Téléchargements" Click="DownloadsMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyContentBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Notes et annotations" Click="NotesMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyContentBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Flux RSS" Click="RssMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C1;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyContentBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Sécurité et données">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xEA18;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyProtectionBrush}" />
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem Text="Site actuel" Click="SiteControlMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyProtectionBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Sessions conservées" Click="SessionsManageLink_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyProtectionBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Mots de passe" Click="VaultMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyProtectionBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Importer des mots de passe" Click="ImportPasswordsMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyProtectionBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Clés d'accès" Click="PasskeysMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyProtectionBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Portefeuille" Click="WalletMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C7;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NovaTileFamilyProtectionBrush}" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Paramètres" Click="SettingsMenu_Click">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Setting" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="À propos" Click="AboutMenu_Click">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Help" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Fond permanent de la bande de titre, sous BrowserTabs : quand les onglets
             sont verticaux (BrowserTabs masqué), cette bande reste visible et doit
             avoir EXACTEMENT la même couleur que les boutons système (ApplyWindowTitleBarColors),
             sans quoi un liseré de couleur différente apparaît autour d'eux — c'est
             ce qui rend l'intégration "sale" comparé à Chrome.
             x:Name + RowSpan ajoutes (2026-08-09) : en Classique + onglets verticaux
             "aplati" (TopTabsRow a 0, voir ApplyVerticalTabsLayout), ce Grid doit
             continuer a peindre le fond derriere les boutons systeme meme si sa
             propre ligne (Row 1) n'a plus de hauteur - RowSpan bascule a 2 pour
             deborder sur NavigationRow dans ce cas precis (jamais en mode normal). -->
        <Grid x:Name="ChromeTitleBackdrop" Grid.Row="1" IsHitTestVisible="False">
            <Border Background="{StaticResource NovaChromeSurfaceBrush}" />
            <Ellipse Width="210"
                     Height="94"
                     Margin="18,-30,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Fill="{StaticResource NovaChromeHaloWarmGlowBrush}" />
            <Ellipse Width="260"
                     Height="116"
                     Margin="0,-42,96,0"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Fill="{StaticResource NovaChromeHaloCoolGlowBrush}" />
            <Border Height="1"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource NovaChromeMistBrush}"
                    Opacity="0.85" />
        </Grid>

        <TabView
            x:Name="BrowserTabs"
            Grid.Row="1"
            Background="{StaticResource NovaChromeSurfaceBrush}"
            BorderBrush="{StaticResource NovaChromeStrokeSoftBrush}"
            CanReorderTabs="True"
            TabWidthMode="SizeToContent"
            AddTabButtonClick="BrowserTabs_AddTabButtonClick"
            SelectionChanged="BrowserTabs_SelectionChanged"
            TabCloseRequested="BrowserTabs_TabCloseRequested"
            Tapped="BrowserTabs_Tapped">
            <TabView.TabStripHeader>
                <!-- Repere d'identite minimal : juste la marque, pour laisser
                     toute la largeur disponible aux onglets eux-memes. Le nom
                     complet "LUMORA - lumière locale" reste present ailleurs
                     (menu Lumora, a propos) - inutile de le repeter ici. -->
                <Border x:Name="TabStripBrandBadge"
                        Width="24"
                        Height="24"
                        Margin="10,14,8,14"
                        CornerRadius="12"
                        Background="{StaticResource NovaBrandChipBackgroundBrush}"
                        BorderBrush="{StaticResource NovaBrandChipBorderBrush}"
                        BorderThickness="1"
                        ToolTipService.ToolTip="Lumora"
                        AutomationProperties.Name="Lumora">
                    <Grid Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Polygon Points="6,0 12,6 6,12 0,6" Fill="{StaticResource NovaIdentityMarkBrush}" />
                        <Ellipse Width="4"
                                 Height="4"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource NovaChromeSurfaceBrush}"
                                 Opacity="0.38" />
                    </Grid>
                </Border>
            </TabView.TabStripHeader>
        </TabView>

        <Border x:Name="ModeChromeAccentStrip"
                Grid.Row="1"
                Height="2"
                VerticalAlignment="Top"
                Background="{StaticResource NovaIdentityMarkBrush}"
                Opacity="0.95" />

        <!-- Bouton menu Demarrer : point d'ancrage a gauche, hors de la
             capsule de la barre d'outils, comme le bouton Windows/Ubuntu
             ne se mele jamais aux autres icones de la barre des taches. -->
        <Button x:Name="ModulesButton"
                Grid.Row="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Width="40" Height="40"
                Margin="18,0,0,0"
                Style="{StaticResource NovaChromeIconButtonStyle}"
                AutomationProperties.Name="Menu Lumora"
                ToolTipService.ToolTip="Menu Lumora — modules, favoris, paramètres">
            <!-- Vraie marque Lumora (2026-08-10, retour utilisateur : l'ancien
                 tracé abstrait ne ressemblait a rien par rapport aux autres
                 icones, ET c'etait une marque differente de celle deja
                 utilisee sur la page d'accueil - LumoraLogoMark.png, la
                 goutte dégradée avec l'étoile, deja l'identite reelle de
                 l'app (NewTabHome.cs, LumoraLogoDataUri()). Reprise telle
                 quelle plutot que reinventee, pour que Demarrer et l'accueil
                 montrent enfin la meme marque. -->
            <!-- PNG remplace par un trace vectoriel (2026-08-12, retour
                 utilisateur : bords crenelés visibles sur ce bouton, seul endroit
                 de la barre d'outils avec une image bitmap au lieu d'une icone
                 nette). Meme geometrie/degrade que le mark de LoginOverlay
                 (MainWindow.xaml, plus bas) - repris tel quel, pas redessine. -->
            <Path x:Name="ModulesButtonMark" Width="22" Height="22" Stretch="Uniform"
                  Fill="{StaticResource NovaIdentityMarkBrush}"
                  Data="M32,10 C41,20 46,30 46,38 A14,14 0 1 1 18,38 C18,30 23,20 32,10 Z M35,15 L38,21.5 L45,24 L38,26.5 L35,33 L32,26.5 L25,24 L32,21.5 Z" />
            <Button.Flyout>
                <Flyout x:Name="ModulesFlyout" Placement="BottomEdgeAlignedLeft" FlyoutPresenterStyle="{StaticResource StartMenuFlyoutPresenterStyle}" Opening="ModulesFlyout_Opening">
                    <StackPanel x:Name="ModulesFlyoutRoot" Width="640" Spacing="0">

                        <!-- En-tete profil (0.93.5.0-dev, deplace depuis la barre de statut basse) :
                             photo + nom en tete du menu, comme un vrai menu demarrer Windows - clic
                             ouvre le meme ProfileStatusFlyout qu'avant (deplace avec lui, aucune
                             nouvelle logique de profil). -->
                        <Button x:Name="ProfileStatusButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="10,10"
                                Margin="0,0,0,12"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="12"
                                ToolTipService.ToolTip="Ouvrir le menu profil"
                                AutomationProperties.Name="Profil Lumora"
                                Click="ProfileStatusButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Ellipse x:Name="ProfileStatusAvatar" Width="38" Height="38" Visibility="Collapsed">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="ProfileStatusAvatarBrush" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock x:Name="ProfileStatusText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Opacity="0.92" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="ProfileStatusFlyout" Placement="TopEdgeAlignedRight">
                                    <StackPanel Width="340" Spacing="12">
                                        <Border Style="{StaticResource NovaFlyoutHeroCardStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="ProfileFlyoutTitleText"
                                                           Text="Profil Lumora"
                                                           FontWeight="SemiBold"
                                                           FontSize="18"
                                                           Foreground="{StaticResource NovaBrandChipForegroundBrush}" />
                                                <TextBlock x:Name="ProfileFlyoutSubtitleText"
                                                           Text="Gérez l'utilisateur local, les profils et les réglages de cette session."
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Opacity="0.82"
                                                           Foreground="{StaticResource NovaBrandChipMutedBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource NovaFlyoutSectionCardStyle}">
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="ProfileFlyoutCurrentUserText"
                                                           Text="Aucun profil actif"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="ProfileFlyoutCurrentStateText"
                                                           Text="Créer ou choisir un profil local pour garder vos données."
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Opacity="0.68" />
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="ProfileFlyoutSettingsButton"
                                                Style="{StaticResource NovaModuleFlyoutActionStyle}"
                                                Click="ProfileFlyoutSettingsButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Paramètres utilisateur" FontWeight="SemiBold" />
                                                    <TextBlock Text="Ouvrir les réglages du profil local, du PIN et des autres comptes." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ProfileFlyoutSwitchButton"
                                                Style="{StaticResource NovaModuleFlyoutActionStyle}"
                                                Click="ProfileFlyoutSwitchButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Changer d'utilisateur" FontWeight="SemiBold" />
                                                    <TextBlock Text="Afficher le choix des profils locaux sur cet ordinateur." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ProfileFlyoutCreateButton"
                                                Style="{StaticResource NovaModuleFlyoutActionStyle}"
                                                Click="ProfileFlyoutCreateButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Créer un utilisateur" FontWeight="SemiBold" />
                                                    <TextBlock Text="Ajouter un nouveau profil Lumora sur cet appareil." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- En-tete : mark + recherche en direct (filtre la grille sur place,
                             StartMenuSearchBox_TextChanged - ne delegue plus a la palette
                             de commande separee) + fermeture -->
                        <Grid ColumnSpacing="10" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Trace corrige (2026-08-12) : cet en-tete gardait encore
                                 l'ancien symbole "carre a coin coupe", jamais mis a jour
                                 quand le bouton Demarrer juste en dehors de ce volet est
                                 passe a la goutte le 10/08 - les deux montraient donc 2
                                 marques differentes a un clic d'intervalle. Meme trace que
                                 ModulesButtonMark/LoginOverlay desormais. -->
                            <Path Grid.Column="0" Width="24" Height="24" Stretch="Uniform"
                                  Fill="{StaticResource NovaIdentityMarkBrush}"
                                  Data="M32,10 C41,20 46,30 46,38 A14,14 0 1 1 18,38 C18,30 23,20 32,10 Z M35,15 L38,21.5 L45,24 L38,26.5 L35,33 L32,26.5 L25,24 L32,21.5 Z" />
                            <TextBox Grid.Column="1" x:Name="StartMenuSearchBox"
                                     Style="{StaticResource NovaCommandPaletteSearchBoxStyle}"
                                     PlaceholderText="Rechercher un module, un favori, un site..."
                                     TextChanged="StartMenuSearchBox_TextChanged"
                                     AutomationProperties.Name="Rechercher un module, un favori, un site" />
                            <Button Grid.Column="2" Style="{StaticResource NovaChromeIconButtonStyle}"
                                    ToolTipService.ToolTip="Fermer" AutomationProperties.Name="Fermer le menu" Click="ModulesFlyoutCloseButton_Click">
                                <SymbolIcon Symbol="Cancel" />
                            </Button>
                        </Grid>

                        <!-- Rail de categories (gauche) + volet detail (droite) : refonte
                             maitre/detail 0.93.5.0-dev (a la Windows 7, Panneau de configuration
                             en vue categories), demande explicite de l'utilisateur pour remplacer
                             l'ancien bascule Epingles-par-defaut/Toutes-les-applications qui
                             obligeait a naviguer entre deux ecrans. "Epingles" est desormais une
                             categorie comme les autres, toujours en tete du rail, selectionnee par
                             defaut a l'ouverture (ModulesFlyout_Opening) - comme un vrai menu
                             demarrer (Windows/GNOME), on y revient a chaque ouverture. -->
                        <Grid x:Name="StartMenuRailAndDetail" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="232" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ListView x:Name="StartMenuCategoryList"
                                      Grid.Column="0"
                                      SelectionMode="Single"
                                      ItemTemplate="{StaticResource StartMenuCategoryTemplate}"
                                      SelectionChanged="StartMenuCategoryList_SelectionChanged"
                                      AutomationProperties.Name="Catégories du menu Démarrer">
                                <!-- Categorie active mise en avant (2026-08-08, "vraiment tres beau") :
                                     cles de ressource standard reprises par le ControlTemplate par
                                     defaut de ListViewItem (Windows App SDK) - pas de retemplating
                                     complet, juste les couleurs de l'etat selectionne, sur les memes
                                     brushes "accent" deja correctes en tout theme et en Contraste
                                     renforce (consolidation du meme jour, MainWindow.SettingsTheme.cs). -->
                                <ListView.Resources>
                                    <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="NovaChromeButtonAccentBackgroundBrush" />
                                    <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="NovaChromeButtonAccentBackgroundBrush" />
                                    <StaticResource x:Key="ListViewItemForegroundSelected" ResourceKey="NovaChromeButtonAccentForegroundBrush" />
                                </ListView.Resources>
                            </ListView>

                            <Border Grid.Column="1" Width="1" HorizontalAlignment="Left"
                                    Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- x:Name pose ici expres (correctif molette defensif, meme motif que
                                 SettingsPanel_RootWheelDiagnostics/MainWindow.xaml.cs:489-566) : ce
                                 flyout bascule maintenant entre 2 contenus (rail+detail / recherche),
                                 le meme genre de changement dynamique qui avait fait "s'arreter" la
                                 molette sur Parametres apres un moment. -->
                            <ScrollViewer x:Name="StartMenuDetailScrollViewer" Grid.Column="1" Margin="14,0,0,0"
                                          MaxHeight="480" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="StartMenuDetailTitleIcon" FontFamily="Segoe MDL2 Assets" FontSize="12" Opacity="0.7" />
                                        <TextBlock x:Name="StartMenuDetailTitleText" Style="{StaticResource NovaPanelSectionTitleStyle}" FontSize="13" />
                                    </StackPanel>

                                    <!-- Tuiles epinglees (clic droit / appui long sur n'importe quelle
                                         tuile -> Epingler/Desepingler, dans n'importe quelle categorie) :
                                         visible uniquement quand la categorie Epingles est selectionnee. -->
                                    <StackPanel x:Name="StartMenuPinnedSection" Spacing="8">
                                        <ItemsRepeater x:Name="StartMenuPinnedRow" ItemTemplate="{StaticResource StartMenuDetailTileTemplate}" />
                                        <TextBlock x:Name="StartMenuPinnedEmptyText"
                                                   Text="Aucune tuile épinglée. Clic droit sur une tuile, dans n'importe quelle catégorie, pour l'ajouter ici."
                                                   Style="{StaticResource NovaPanelDescriptionStyle}"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed" />
                                    </StackPanel>

                                    <!-- Tuiles de la categorie selectionnee (source unique
                                         StartMenuTileRegistry.All) : visible pour toute categorie autre
                                         qu'Epingles. -->
                                    <ItemsRepeater x:Name="StartMenuDetailList" ItemTemplate="{StaticResource StartMenuDetailTileTemplate}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Recherche en direct : liste plate triee par score (meme forme
                             que ScoreCommandPaletteItem), visible uniquement pendant une
                             recherche active - remplace le rail+detail ci-dessus le temps
                             de la recherche (StartMenuRailAndDetail.Visibility=Collapsed). -->
                        <ScrollViewer x:Name="StartMenuFilteredScrollViewer" MaxHeight="480" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12" Width="600">
                                <ItemsRepeater x:Name="StartMenuFilteredList"
                                              Visibility="Collapsed"
                                              ItemTemplate="{StaticResource StartMenuActionTileTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout Orientation="Horizontal" MaximumRowsOrColumns="2" MinItemWidth="278" MinItemHeight="46" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <TextBlock x:Name="StartMenuNoResultsText"
                                           Text="Aucun résultat"
                                           Style="{StaticResource NovaPanelDescriptionStyle}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

        <Border x:Name="NavigationToolbarCapsule"
                Grid.Row="2"
                Margin="66,6,14,6"
                CornerRadius="22"
                Background="{StaticResource NovaFloatingGlassBrush}"
                BorderBrush="{StaticResource NovaChromeStrokeSoftBrush}"
                BorderThickness="1"
                Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
        <Grid x:Name="NavigationToolbar"
              SizeChanged="NavigationToolbar_SizeChanged"
              Padding="12,6,12,7"
              ColumnSpacing="6"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <!-- Colonne 7 : Incognito (2026-08-09, deplace depuis le flyout
                     "Mode et confort" de la barre du bas - demande explicite
                     utilisateur, entre Favoris et Bloqueur de pub). -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="NavigationMenuDividerColumn" Width="Auto" />
                <ColumnDefinition x:Name="NavigationMenuButtonColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse Grid.Column="4"
                     Grid.ColumnSpan="6"
                     Width="220"
                     Height="64"
                     Margin="-28,-6,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Fill="{StaticResource NovaChromeHaloWarmGlowBrush}"
                     IsHitTestVisible="False" />
            <Border Grid.Column="4"
                    Grid.ColumnSpan="14"
                    Margin="0,2,0,2"
                    CornerRadius="19"
                    Background="{StaticResource NovaChromeMistBrush}"
                    Opacity="0.16"
                    IsHitTestVisible="False" />
            <Border Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Margin="0,2,8,2"
                    CornerRadius="18"
                    Background="{StaticResource NovaCompanionGlassBrush}"
                    BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False" />
            <Border Grid.Column="4"
                    Grid.ColumnSpan="2"
                    Margin="8,0,10,0"
                    CornerRadius="22"
                    Background="{StaticResource NovaBrandChipBackgroundBrush}"
                    BorderBrush="{StaticResource NovaBrandChipBorderBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False" />
            <Border x:Name="NavigationToolbarToolsShell"
                    Grid.Column="6"
                    Grid.ColumnSpan="12"
                    Margin="6,2,8,2"
                    CornerRadius="18"
                    Background="{StaticResource NovaCompanionGlassBrush}"
                    BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False" />

            <!-- SymbolIcon -> FontIcon (2026-08-08, retour utilisateur "boutons pixelises"
                 en Taille de l'interface reduite) : ApplyIconButtonSizing (MainWindow.SettingsTheme.cs)
                 redimensionne le Button (Width/Height) selon la densite, mais SymbolIcon n'a pas
                 de propriete de taille propre - contrairement a FontIcon (FontSize), il ne se
                 redessine pas net a une taille reduite. Glyphs verifies contre l'usage deja
                 existant de LumoraIncognitoWindow.xaml (IncognitoBackButton/ForwardButton/
                 ReloadButton, memes glyphs E72B/E72A/E72C) plutot que devines - seul Cancel
                 (E711) n'a pas d'equivalent deja present dans ce depot, mais correspond au
                 mappage documente et stable de Symbol.Cancel dans Segoe MDL2 Assets. -->
            <Button Grid.Column="0" Style="{StaticResource NovaChromeIconButtonStyle}" ToolTipService.ToolTip="Retour" AutomationProperties.Name="Retour" Click="BackButton_Click">
                <FontIcon Style="{StaticResource NovaChromeFontIconStyle}" Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource NovaChromeIconButtonStyle}" ToolTipService.ToolTip="Avancer" AutomationProperties.Name="Avancer" Click="ForwardButton_Click">
                <FontIcon Style="{StaticResource NovaChromeFontIconStyle}" Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource NovaChromeIconButtonStyle}" ToolTipService.ToolTip="Recharger" AutomationProperties.Name="Recharger" Click="ReloadButton_Click">
                <FontIcon Style="{StaticResource NovaChromeFontIconStyle}" Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>
            <Button Grid.Column="3"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Stop"
                    AutomationProperties.Name="Stop"
                    Visibility="Collapsed"
                    Click="StopButton_Click">
                <FontIcon Style="{StaticResource NovaChromeFontIconStyle}" Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>
            <Grid Grid.Column="4" Margin="6,0">
                <!-- Retour utilisateur (2026-08-08) : "trait au centre" sur la
                     barre d'adresse, meme signalement qu'au 2026-08-06 -
                     structure a 3 couches (ce Border + AddressBoxTintBorder +
                     la bordure propre du TextBox AddressBox juste en dessous),
                     chacune avec son propre trait visible, jamais toutes les
                     deux retirees a l'epoque. Ce Border ne fournit plus que le
                     fond de la pilule (Background) : le seul trait visible
                     restant est celui du TextBox lui-meme, deja pilote par
                     l'accessibilite (AddressBox.BorderThickness suit
                     "Focus clavier plus visible", MainWindow.SettingsTheme.cs)
                     - garder ce chemin plutot que d'en dupliquer un 2e ici. -->
                <Border x:Name="AddressBoxOutlineBorder"
                        Margin="0,1,0,1"
                        VerticalAlignment="Center"
                        CornerRadius="22"
                        Background="{StaticResource NovaAddressBackgroundBrush}"
                        IsHitTestVisible="False" />
                <Border x:Name="AddressBoxTintBorder"
                        Margin="1"
                        VerticalAlignment="Center"
                        CornerRadius="21"
                        Background="{StaticResource NovaChromeHaloCoolBrush}"
                        Opacity="0.12"
                        IsHitTestVisible="False" />
                <TextBox
                    x:Name="AddressBox"
                    MinHeight="42"
                    Padding="54,8,18,8"
                    CornerRadius="22"
                    Background="Transparent"
                    BorderBrush="{StaticResource NovaAddressBorderBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource NovaAddressForegroundBrush}"
                    PlaceholderForeground="{StaticResource NovaTextMutedBrush}"
                    FocusVisualPrimaryBrush="{StaticResource NovaFocusBrush}"
                    FocusVisualSecondaryBrush="{StaticResource NovaFocusInnerBrush}"
                    AutomationProperties.Name="Adresse ou recherche"
                    VerticalAlignment="Center"
                    KeyDown="AddressBox_KeyDown"
                    TextChanged="AddressBox_TextChanged"
                    LostFocus="AddressBox_LostFocus"
                    PlaceholderText="Aller vers un site ou lancer une recherche" />
                <!-- Les deux filets "reflet de verre" (haut blanc/bas ambre) ont
                     ete retires ici (2026-08-06, retour utilisateur : "coupee en
                     2 par un trait au milieu", trouve trop date sur une pilule
                     aussi basse) - la barre reste en verre mat uni comme le
                     reste du chrome, sans cet artifice skeuomorphique. -->
                <Border x:Name="AddressIdentityBadge"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="30"
                        Height="30"
                        Margin="10,0,0,0"
                        Padding="0"
                        CornerRadius="15"
                        Background="{StaticResource NovaBrandChipBackgroundBrush}"
                        BorderBrush="{StaticResource NovaBrandChipBorderBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False">
                    <!-- Taille pilotee par densite (MainWindow.UiDensity.cs,
                         AddressIdentityIconSize) - restait figee a 12x12 quelle
                         que soit la taille du badge autour (30/26/22), d'ou un
                         losange trop grand/petit par rapport a son cadre en
                         "standard"/"dense" (retour utilisateur 2026-08-08).
                         Viewbox necessaire : le Polygon a des coordonnees
                         absolues (points bases sur un cadre 12x12) - redimensionner
                         juste le conteneur l'aurait rogne au lieu de le reduire. -->
                    <Viewbox x:Name="AddressIdentityIconGrid"
                             Width="12" Height="12"
                             Stretch="Uniform"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Grid Width="12" Height="12">
                            <Polygon Points="6,0 12,6 6,12 0,6" Fill="{StaticResource NovaIdentityMarkBrush}" />
                            <Ellipse Width="4"
                                     Height="4"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource NovaChromeSurfaceBrush}"
                                     Opacity="0.38" />
                        </Grid>
                    </Viewbox>
                </Border>
            </Grid>

            <!-- Suggestions locales pendant la frappe : onglets ouverts, favoris,
                 historique. Popup ancré sous la barre d'adresse via PlacementTarget
                 (rendu dans la couche popup, au-dessus du WebView2). Jamais de requête
                 réseau : tout vient des stores locaux du profil. -->
            <Popup x:Name="AddressSuggestionsPopup"
                   PlacementTarget="{x:Bind AddressBox}"
                   DesiredPlacement="Bottom"
                   IsLightDismissEnabled="False">
                <Border x:Name="AddressSuggestionsSurface"
                        Background="{StaticResource NovaBrandChipBackgroundBrush}"
                        BorderBrush="{StaticResource NovaBrandChipBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="8"
                        MaxHeight="420"
                        PointerEntered="AddressSuggestions_PointerEntered"
                        PointerExited="AddressSuggestions_PointerExited">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="Trajectoires Lumora"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource NovaPrimaryTextBrush}" />
                                <TextBlock Text="Tout reste local : onglets, favoris et historique."
                                           FontSize="11"
                                           Opacity="0.68"
                                           Foreground="{StaticResource NovaTextMutedBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Padding="8,3"
                                    CornerRadius="11"
                                    Background="{StaticResource NovaCompanionGlassBrush}"
                                    BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="local"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource NovaPrimaryTextBrush}" />
                            </Border>
                        </Grid>
                        <ListView x:Name="AddressSuggestionsList"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="AddressSuggestionsList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,9" ColumnSpacing="10"
                                          AutomationProperties.Name="{Binding AccessibleName}"
                                          ToolTipService.ToolTip="{Binding AccessibleName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                Background="{StaticResource NovaCompanionGlassBrush}"
                                                BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding Glyph}"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="13"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Foreground="{StaticResource NovaPrimaryTextBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding UrlDisplay}"
                                                       Opacity="0.62"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Padding="8,3"
                                                CornerRadius="11"
                                                Background="{StaticResource NovaChromeHaloWarmBrush}">
                                            <TextBlock Text="{Binding KindLabel}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource NovaPrimaryTextBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Popup>
            <Button Grid.Column="5"
                    Style="{StaticResource NovaChromeAccentIconButtonStyle}"
                    ToolTipService.ToolTip="Ouvrir l'adresse"
                    AutomationProperties.Name="Ouvrir l'adresse"
                    Click="GoButton_Click">
                <SymbolIcon Style="{StaticResource NovaChromeAccentSymbolIconStyle}" Symbol="Forward" />
            </Button>

            <!-- Icone Incognito (colonne 7, entre Favoris et Bloqueur de pub -
                 demande explicite utilisateur 2026-08-09, deplacee du flyout
                 "Mode et confort" de la barre du bas : action de confidentialite,
                 doit rester a un seul geste plutot qu'a 2 niveaux de profondeur.
                 Meme gestionnaire que le menu Lumora et le Menu Demarrer
                 (IncognitoWindowMenu_Click, MainWindow.Incognito.cs) - aucune
                 nouvelle logique de lancement.
                 Icone (2026-08-10, retour utilisateur "ca ressemble a rien") :
                 le glyphe systeme generique E727 est remplace par la marque
                 maison Incognito deja utilisee dans LumoraIncognitoWindow.xaml
                 et IncognitoWelcomeHtml.cs (silhouette de masque a 2 yeux) -
                 memes donnees de dessin, aucun nouveau graphisme invente.
                 Couleur neutre (NovaChromeButtonForegroundBrush, comme les
                 icones voisines Favoris/Bouclier) plutot que la teinte violette
                 propre a la fenetre Incognito : ce bouton lance une fenetre a
                 part, il n'est pas lui-meme "en session Incognito". -->
            <Button x:Name="IncognitoToolbarButton"
                    Grid.Column="7"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    AutomationProperties.Name="Incognito"
                    ToolTipService.ToolTip="Incognito : session ephemere, IP masquee en option via Tor (Ctrl+Shift+N)"
                    Click="IncognitoWindowMenu_Click">
                <Viewbox Width="19" Height="11.1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="48" Height="28">
                        <Path Data="M24 1c-10 0-18.3 5.7-22 13 3.7 7.3 12 13 22 13s18.3-5.7 22-13c-3.7-7.3-12-13-22-13Z"
                              Stroke="{StaticResource NovaChromeButtonForegroundBrush}" StrokeThickness="2.6" />
                        <Ellipse Width="6.4" Height="6.4" Fill="{StaticResource NovaChromeButtonForegroundBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12.3,0,0,0" />
                        <Ellipse Width="6.4" Height="6.4" Fill="{StaticResource NovaChromeButtonForegroundBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12.3,0" />
                    </Grid>
                </Viewbox>
            </Button>

            <!-- Bouton bouclier confidentialité (colonne 8, apres Favoris et
                 Incognito - ordre initial demande le 2026-08-08 : Favoris,
                 Bloqueur de pub, Coffre ; Incognito insere entre les deux le
                 2026-08-09) -->
            <Button x:Name="ShieldButton"
                    Grid.Column="8"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    AutomationProperties.Name="Confidentialité du site"
                    ToolTipService.ToolTip="Confidentialité">
                <!-- Teinte rose (2026-08-10, chantier identite visuelle) : meme
                     brush que la famille "Protection" du Menu Demarrer
                     (NovaTileFamilyProtectionBrush) - juste l'icone, pas toute
                     la capsule du bouton, pour rester discret dans la barre
                     d'outils (zone dense, contrairement aux tuiles). -->
                <Grid Width="22" Height="22">
                    <FontIcon Foreground="{StaticResource NovaTileFamilyProtectionBrush}" Glyph="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border x:Name="TelemetryActivityBadge"
                            MinWidth="16"
                            Height="16"
                            Padding="3,0"
                            CornerRadius="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-5,-7,0"
                            Background="{StaticResource NovaCoolAccentBrush}"
                            BorderBrush="{StaticResource NovaChromeSurfaceBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ShieldBlockedBadgeText"
                                   Text="0"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NovaTextOnAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <Button.Flyout>
                    <Flyout x:Name="ShieldFlyout"
                            Opening="ShieldFlyout_Opening"
                            Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="330" Spacing="12">
                            <TextBlock x:Name="ShieldDomainText"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ShieldBlockedCountText"
                                       Opacity="0.65"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ShieldSiteSummaryText"
                                       Opacity="0.65"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ShieldRecommendationText"
                                       Opacity="0.82"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <StackPanel x:Name="ShieldRecentBlocksPanel"
                                        Spacing="4" />
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                            <ToggleSwitch x:Name="ShieldSiteExcludeToggle"
                                          Header="Exclure ce site du bloqueur"
                                          Toggled="ShieldSiteExcludeToggle_Toggled" />
                            <Button x:Name="ShieldSiteCenterButton"
                                    Content="Centre du site"
                                    HorizontalAlignment="Stretch"
                                    Click="ShieldSiteCenterButton_Click" />
                            <HyperlinkButton Content="Paramètres de confidentialité"
                                             Click="ShieldSettingsLink_Click"
                                             HorizontalAlignment="Left"
                                             Padding="0" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Étoile d'état : pleine et accentuée quand la page courante est
                 déjà en favori, contour simple sinon. Rafraîchie à chaque
                 navigation, changement d'onglet et modification des favoris.
                 Colonne 6, premier du groupe Favoris/Incognito/Bloqueur de
                 pub/Coffre (ordre initial demande le 2026-08-08, Incognito
                 insere le 2026-08-09). -->
            <!-- Flyout ajoute (2026-08-12, retour utilisateur) : meme schema que
                 VaultQuickAccessButton - l'action principale (ajouter/modifier le
                 favori de la page courante, dialogue PromptBookmarkEditorAsync
                 inchange) reste au clic, avec en plus un lien "Gerer les favoris"
                 pour atteindre le panneau complet sans repasser par le Menu
                 Demarrer. -->
            <Button Grid.Column="6" x:Name="AddBookmarkButton" Style="{StaticResource NovaBookmarkIconButtonStyle}" ToolTipService.ToolTip="Ajouter aux favoris" AutomationProperties.Name="Ajouter aux favoris">
                <FontIcon x:Name="BookmarkStarIcon" Style="{StaticResource NovaBookmarkFontIconStyle}" Glyph="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="17" />
                <Button.Flyout>
                    <Flyout x:Name="AddBookmarkFlyout" Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="240" Spacing="10">
                            <Button Content="Ajouter cette page aux favoris"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Click="AddBookmarkButton_Click" />
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                            <Button Content="Gérer les favoris"
                                    Style="{StaticResource NovaCompactButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="BookmarksMenu_Click" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <!-- Acces rapide aux identifiants du site courant, sans ouvrir tout le
                 panneau coffre (meme esprit que les extensions de gestionnaire de
                 mots de passe type Proton Pass). -->
            <Button x:Name="VaultQuickAccessButton"
                    Grid.Column="9"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Identifiants de ce site"
                    AutomationProperties.Name="Identifiants de ce site">
                <!-- Meme teinte rose "Protection" que ShieldButton et le Coffre
                     du Menu Demarrer (2026-08-10). -->
                <FontIcon Foreground="{StaticResource NovaTileFamilyProtectionBrush}" Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                <Button.Flyout>
                    <Flyout x:Name="VaultQuickAccessFlyout"
                            Opening="VaultQuickAccessFlyout_Opening"
                            Placement="BottomEdgeAlignedRight">
                        <StackPanel x:Name="VaultQuickAccessPanel" Width="320" Spacing="10" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <!-- Historique (2026-08-10, "choses a revoir" - reponse explicite
                 utilisateur : "un bouton qui me donne acces a l'historique,
                 tout simplement") - meme groupe fixe, toujours visible, que
                 Favoris/Incognito/Bloqueur de pub/Coffre. Reprend le meme
                 point d'entree que HistoryMenu_Click (jusqu'ici accessible
                 uniquement via Menu Demarrer > Navigation > Historique),
                 aucune nouvelle logique. -->
            <Button x:Name="HistoryToolbarButton"
                    Grid.Column="10"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Historique"
                    AutomationProperties.Name="Historique"
                    Click="HistoryMenu_Click">
                <FontIcon Glyph="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>
            <!-- Telechargements (2026-08-10, "choses a revoir" - demande
                 explicite utilisateur) : deplace de ModulesQuickBar (modules
                 epinglables/desepinglables, voir plus bas) vers ce groupe
                 fixe - toujours visible desormais, plus jamais conditionne a
                 _hasSessionDownload (RefreshDownloadsIndicator,
                 MainWindow.DownloadsIndicator.cs). Flyout et badge inchanges,
                 juste deplaces avec le bouton. -->
            <Button x:Name="DownloadsIndicatorButton"
