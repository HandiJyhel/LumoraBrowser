                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Menu 2/3 : Compagnon - interrupteur simple (2026-08-10, demande
                     explicite utilisateur) : plus rattache a l'affichage d'un mode
                     precis ("peu importe le mode, il est toujours la"), juste
                     active ou pas. CompanionOffState/CompanionOnState basculent
                     via CompanionEnabled (UiSettings), memes x:Name ModeCompanionXxx
                     qu'avant pour le contenu active - meme logique C#, juste
                     conditionnee. -->
                <Button x:Name="CompanionButton"
                        MinHeight="30"
                        Padding="10,0"
                        Style="{StaticResource NovaFooterPillButtonStyle}"
                        AutomationProperties.Name="Compagnon"
                        ToolTipService.ToolTip="Compagnon">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border x:Name="CompanionAccentBar"
                                Width="2"
                                Height="14"
                                CornerRadius="1"
                                Background="{StaticResource NovaCompanionAccentBrush}"
                                Opacity="0.78" />
                        <FontIcon x:Name="CompanionIcon"
                                  Glyph="&#xE70B;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="11.5"
                                  Opacity="0.76"
                                  VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="CompanionLabelText" Text="Compagnon" FontSize="10.5" Opacity="0.56" VerticalAlignment="Center" />
                            <TextBlock x:Name="CompanionStateText" Text="Activé" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <FontIcon x:Name="CompanionChevronIcon" Glyph="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" Opacity="0.44" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="CompanionFlyout" Placement="TopEdgeAlignedRight" Opening="CompanionFlyout_Opening">
                            <StackPanel Width="340" Spacing="12">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Compagnon Lumie" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                                    <Button x:Name="CompanionToggleButton" Grid.Column="1"
                                            Style="{StaticResource NovaCompactButtonStyle}"
                                            Content="Désactiver"
                                            Click="CompanionToggleButton_Click"
                                            AutomationProperties.Name="Activer ou désactiver le compagnon" />
                                </Grid>

                                <!-- Etat desactive -->
                                <StackPanel x:Name="CompanionOffState" Spacing="8">
                                    <TextBlock Text="Aucun mémo ni action rapide tant qu'il n'est pas activé."
                                               TextWrapping="Wrap" FontSize="12" Opacity="0.68" />
                                </StackPanel>

                                <!-- Etat active : contenu de l'ancien Compagnon Lumie, inchange -->
                                <StackPanel x:Name="CompanionOnState" Spacing="12">
                                    <Border Style="{StaticResource NovaFlyoutHeroCardStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="46"
                                                    Height="46"
                                                    CornerRadius="23"
                                                    Background="{StaticResource NovaCompanionAccentSoftBrush}"
                                                    BorderBrush="{StaticResource NovaCompanionAccentBrush}"
                                                    BorderThickness="1.5">
                                                <FontIcon x:Name="ModeCompanionMascotIcon"
                                                          Glyph="&#xE70B;"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="20"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="ModeCompanionTitleText" Text="Lumie" FontWeight="SemiBold" FontSize="18"
                                                           Foreground="{StaticResource NovaBrandChipForegroundBrush}" />
                                                <TextBlock x:Name="ModeCompanionBodyText"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Opacity="0.82"
                                                           Foreground="{StaticResource NovaBrandChipMutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource NovaFlyoutSectionCardStyle}">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="ModeCompanionMemoryTitleText"
                                                       Text="Mémoire du mode"
                                                       FontWeight="SemiBold"
                                                       FontSize="13" />
                                            <TextBox x:Name="ModeCompanionMemoryBox"
                                                     MinHeight="84"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     PlaceholderText="Votre compagnon garde cela ici."
                                                     AutomationProperties.Name="Mémoire du compagnon" />
                                            <Button x:Name="ModeCompanionSaveButton"
                                                    Content="Garder dans Lumie"
                                                    Style="{StaticResource NovaCompactButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    Click="ModeCompanionSaveButton_Click" />
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="ModeCompanionPrimaryButton"
                                            Style="{StaticResource NovaModuleFlyoutActionStyle}"
                                            Click="ModeCompanionPrimaryButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon x:Name="ModeCompanionPrimaryIcon" Glyph="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="ModeCompanionPrimaryTitleText" Text="Ouvrir Notes" FontWeight="SemiBold" />
                                                <TextBlock x:Name="ModeCompanionPrimaryHintText" Text="Gardez l'outil du mode sous la main." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ModeCompanionSecondaryButton"
                                            Style="{StaticResource NovaModuleFlyoutActionStyle}"
                                            Click="ModeCompanionSecondaryButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon x:Name="ModeCompanionSecondaryIcon" Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="ModeCompanionSecondaryTitleText" Text="Action rapide" FontWeight="SemiBold" />
                                                <TextBlock x:Name="ModeCompanionSecondaryHintText" Text="Action liée au contexte actif." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="ModeCompanionPrivacyText"
                                               Text="Compagnon local : les notes et préférences restent dans ce profil Lumora."
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Opacity="0.62" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Menu 3/3 : Accessibilité -->
                <Button x:Name="AccessibilityMenuButton"
                        MinHeight="30"
                        Padding="10,0"
                        Style="{StaticResource NovaFooterPillButtonStyle}"
                        AutomationProperties.Name="Accessibilité"
                        ToolTipService.ToolTip="Accessibilité">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border x:Name="AccessibilityQuickAccentBar"
                                Width="2"
                                Height="14"
                                CornerRadius="1"
                                Background="{StaticResource NovaCoolAccentBrush}"
                                Opacity="0.82" />
                        <FontIcon x:Name="AccessibilityQuickIcon"
                                  Glyph="&#xE790;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="11.5"
                                  Opacity="0.76"
                                  VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="AccessibilityQuickLabelText" Text="Accessibilité" FontSize="10.5" Opacity="0.56" VerticalAlignment="Center" />
                            <TextBlock x:Name="AccessibilityQuickCurrentText" Text="Aucune aide" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <FontIcon x:Name="AccessibilityChevronIcon" Glyph="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" Opacity="0.44" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="AccessibilityMenuFlyout" Placement="TopEdgeAlignedRight" Opening="AccessibilityFlyout_Opening">
                            <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                            <StackPanel Width="340" Spacing="12">
                                <Border Style="{StaticResource NovaFlyoutHeroCardStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Accessibilité"
                                                   FontWeight="SemiBold"
                                                   FontSize="18"
                                                   Foreground="{StaticResource NovaBrandChipForegroundBrush}" />
                                        <TextBlock Text="Les aides de lecture et de confort. Raccourcis : Ctrl+Alt+6, Ctrl+Alt+8, Ctrl+Alt+S, Ctrl+Alt+X."
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Opacity="0.82"
                                                   Foreground="{StaticResource NovaBrandChipMutedBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="10"
                                        CornerRadius="8"
                                        Background="{StaticResource NovaChromeSurfaceAltBrush}"
                                        BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="AccessibilityQuickProfileTitleText"
                                                   Text="Profil courant"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock x:Name="AccessibilityQuickProfileSummaryText"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Opacity="0.72" />
                                        <TextBlock x:Name="AccessibilityQuickStateText"
                                                   TextWrapping="Wrap"
                                                   FontSize="11.5"
                                                   Opacity="0.62" />
                                        <TextBlock x:Name="AccessibilityQuickContextText"
                                                   TextWrapping="Wrap"
                                                   FontSize="11.5"
                                                   Opacity="0.62" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="AccessibilityQuickOpenSettingsButton"
                                        Style="{StaticResource NovaCompactButtonStyle}"
                                        Content="Ouvrir les réglages complets de Confort"
                                        HorizontalAlignment="Left"
                                        Click="AccessibilityQuickOpenSettingsButton_Click" />
                                <TextBlock Text="Mode secours (action d'urgence, pas un profil)" FontSize="11" Opacity="0.56" Margin="0,4,0,0" />
                                <Border Padding="10"
                                        CornerRadius="8"
                                        Background="{StaticResource NovaChromeSurfaceAltBrush}"
                                        BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="AccessibilityQuickRescueStatusText"
                                                   Text="Aucun retour memorise pour l'instant."
                                                   TextWrapping="Wrap"
                                                   FontSize="11.5"
                                                   Opacity="0.68" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="AccessibilityQuickRescueButton"
                                                    Grid.Column="0"
                                                    Style="{StaticResource NovaModuleFlyoutActionStyle}"
                                                    Click="AccessibilityQuickRescueButton_Click"
                                                    AutomationProperties.Name="Activer le mode secours"
                                                    AutomationProperties.HelpText="Renforce d'un coup la lisibilité et garde la possibilité de revenir à l'état précédent.">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                                    <StackPanel Spacing="2" Width="120">
                                                        <TextBlock Text="Activer" FontWeight="SemiBold" />
                                                        <TextBlock Text="Ctrl+Alt+S" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="AccessibilityQuickRestoreButton"
                                                    Grid.Column="1"
                                                    Style="{StaticResource NovaModuleFlyoutActionStyle}"
                                                    Click="AccessibilityQuickRestoreButton_Click"
                                                    AutomationProperties.Name="Restaurer l'etat de confort precedent"
                                                    AutomationProperties.HelpText="Revient à l'état de confort mémorisé avant le mode secours.">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                                    <StackPanel Spacing="2" Width="120">
                                                        <TextBlock Text="Revenir" FontWeight="SemiBold" />
                                                        <TextBlock Text="Ctrl+Alt+X" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                <TextBlock Text="Changer de profil de confort" FontSize="11" Opacity="0.56" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="AccessibilityQuickBalancedButton" Grid.Column="0" Tag="balanced" Style="{StaticResource NovaModuleFlyoutActionStyle}" Click="AccessibilityQuickPresetButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2" Width="140">
                                                <TextBlock Text="Aucune aide" FontWeight="SemiBold" />
                                                <TextBlock Text="Reinitialise le confort." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AccessibilityQuickVisionButton" Grid.Column="1" Tag="vision" Style="{StaticResource NovaModuleFlyoutActionStyle}" Click="AccessibilityQuickPresetButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2" Width="140">
                                                <TextBlock Text="Vision fatiguee" FontWeight="SemiBold" />
                                                <TextBlock Text="Teinte chaude, texte agrandi." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                <TextBlock Text="Aides individuelles (indépendantes du profil choisi)" FontSize="11" Opacity="0.56" />
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button x:Name="AccessibilityQuickGuideButton" Grid.Row="0" Grid.Column="0" Tag="guide" Style="{StaticResource NovaModuleFlyoutActionStyle}" Click="AccessibilityQuickToggleButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE8A3;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2" Width="140">
                                                <TextBlock Text="Guide de lecture" FontWeight="SemiBold" />
                                                <TextBlock x:Name="AccessibilityQuickGuideHintText" Text="Active ou désactive la bande de lecture immersive." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AccessibilityQuickLensButton" Grid.Row="0" Grid.Column="1" Tag="lens" Style="{StaticResource NovaModuleFlyoutActionStyle}" Click="AccessibilityQuickToggleButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE8A3;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2" Width="140">
                                                <TextBlock Text="Loupe de lecture" FontWeight="SemiBold" />
                                                <TextBlock x:Name="AccessibilityQuickLensHintText" Text="Affiche ou cache le bouton de loupe dans la barre." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AccessibilityQuickReadAloudButton" Grid.Row="1" Grid.Column="0" Tag="readaloud" Style="{StaticResource NovaModuleFlyoutActionStyle}" Click="AccessibilityQuickToggleButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2" Width="140">
                                                <TextBlock Text="Lecture a voix haute" FontWeight="SemiBold" />
                                                <TextBlock x:Name="AccessibilityQuickReadAloudHintText" Text="Affiche ou retire la lecture vocale locale." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AccessibilityQuickAnnounceButton" Grid.Row="1" Grid.Column="1"
                                            Style="{StaticResource NovaModuleFlyoutActionStyle}"
                                            Click="AccessibilityQuickAnnounceButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2" Width="140">
                                                <TextBlock Text="Relire l'etat" FontWeight="SemiBold" />
                                                <TextBlock Text="Annonce le profil et les aides actives." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Border x:Name="FullScreenTopRevealZone"
                Grid.RowSpan="7"
                Canvas.ZIndex="35"
                Height="10"
                VerticalAlignment="Top"
                Background="Transparent"
                Visibility="Collapsed"
                PointerEntered="FullScreenTopRevealZone_PointerEntered" />

        <Border x:Name="FullScreenLeftRevealZone"
                Grid.RowSpan="7"
                Canvas.ZIndex="35"
                Width="10"
                HorizontalAlignment="Left"
                Background="Transparent"
                Visibility="Collapsed"
                PointerEntered="FullScreenLeftRevealZone_PointerEntered" />

        <Border x:Name="FullScreenRightRevealZone"
                Grid.RowSpan="7"
                Canvas.ZIndex="35"
                Width="10"
                HorizontalAlignment="Right"
                Background="Transparent"
                Visibility="Collapsed"
                PointerEntered="FullScreenRightRevealZone_PointerEntered" />

        <!-- Palette de commande Ctrl+K -->
        <Grid x:Name="CommandPaletteOverlay"
              Grid.RowSpan="7"
              Visibility="Collapsed"
              Background="{StaticResource NovaOverlayBrush}">
            <Ellipse Width="420"
                     Height="180"
                     Margin="0,26,260,0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Fill="{StaticResource NovaChromeHaloWarmGlowBrush}"
                     IsHitTestVisible="False" />
            <Ellipse Width="500"
                     Height="220"
                     Margin="260,12,0,0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Top"
                     Fill="{StaticResource NovaChromeHaloCoolGlowBrush}"
                     IsHitTestVisible="False" />
            <Border x:Name="CommandPaletteCard"
                    Width="760"
                    MaxHeight="560"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,46,0,0"
                    Style="{StaticResource NovaCommandPaletteCardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource NovaFlyoutHeroCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="42"
                                    Height="42"
                                    CornerRadius="21"
                                    Background="{StaticResource NovaCoolAccentSoftBrush}"
                                    BorderBrush="{StaticResource NovaCoolAccentBrush}"
                                    BorderThickness="1.5">
                                <FontIcon Glyph="&#xE721;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="18"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{StaticResource NovaPrimaryTextBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Palette Lumora"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource NovaBrandChipForegroundBrush}" />
                                <TextBlock Text="Commandes, onglets, favoris et trajectoires locales au même endroit."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Opacity="0.82"
                                           Foreground="{StaticResource NovaBrandChipMutedBrush}" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Padding="8,3"
                                    CornerRadius="11"
                                    Background="{StaticResource NovaCompanionGlassBrush}"
                                    BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="Ctrl+K"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource NovaPrimaryTextBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                Background="{StaticResource NovaCompanionGlassBrush}"
                                BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE721;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="16"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{StaticResource NovaPrimaryTextBrush}" />
                        </Border>
                        <TextBox x:Name="CommandPaletteSearchBox"
                                 Grid.Column="1"
                                 Style="{StaticResource NovaCommandPaletteSearchBoxStyle}"
                                 AutomationProperties.Name="Recherche de commande"
                                 PlaceholderText="Chercher une commande, un onglet, un favori, une page..."
                                 TextChanged="CommandPaletteSearchBox_TextChanged"
                                 KeyDown="CommandPaletteSearchBox_KeyDown" />
                        <Button Grid.Column="2"
                                Style="{StaticResource NovaChromeIconButtonStyle}"
                                ToolTipService.ToolTip="Fermer"
                                AutomationProperties.Name="Fermer la palette de commande"
                                Click="CommandPaletteCloseButton_Click">
                            <SymbolIcon Symbol="Cancel" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="2"
                            Style="{StaticResource NovaFlyoutSectionCardStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CommandPaletteHintText"
                                       Grid.Column="0"
                                       Text="Entree pour ouvrir, Echap pour fermer."
                                       Opacity="0.66"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Padding="8,3"
                                    CornerRadius="11"
                                    Background="{StaticResource NovaChromeHaloWarmBrush}">
                                <TextBlock Text="local"
                                           FontSize="10.5"
                                           Foreground="{StaticResource NovaPrimaryTextBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <ListView x:Name="CommandPaletteList"
                              Grid.Row="3"
                              MaxHeight="440"
                              SelectionMode="Single"
                              Background="Transparent"
                              DoubleTapped="CommandPaletteList_DoubleTapped"
                              KeyDown="CommandPaletteList_KeyDown">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="12,12"
                                        CornerRadius="16"
                                        Background="{StaticResource NovaCompanionGlassBrush}"
                                        BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                                        BorderThickness="1"
                                        AutomationProperties.Name="{Binding AccessibleName}"
                                        ToolTipService.ToolTip="{Binding AccessibleName}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                Background="{StaticResource NovaBrandChipBackgroundBrush}"
                                                BorderBrush="{StaticResource NovaBrandChipBorderBrush}"
                                                BorderThickness="1">
                                            <FontIcon Glyph="{Binding Glyph}"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="13"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{StaticResource NovaPrimaryTextBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Opacity="0.62"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Padding="8,3"
                                                CornerRadius="11"
                                                Background="{StaticResource NovaChromeHaloCoolBrush}">
                                            <TextBlock Text="{Binding Kind}"
                                                       Opacity="0.82"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay de connexion. Trouve en usage reel le 2026-07-29 : "dernier
             enfant = au-dessus de tout" (commentaire d'origine) devient faux des
             qu'un frere porte un Canvas.ZIndex explicite - un ZIndex explicite
             gagne toujours sur l'ordre de declaration. La colonne identitaire et
             sa capsule (33-35) et FullScreenTopBar (50) restaient donc cliquables
             PAR-DESSUS cet ecran cense tout bloquer. ZIndex="90" : au-dessus de
             tous les autres freres de RootShell. Voir SetupWizardOverlay
             plus bas, qui doit rester au-dessus de CELUI-CI (affiche juste
             apres la connexion, cf. DismissLoginOverlay -> ShowSetupWizard). -->
        <Grid x:Name="LoginOverlay" Grid.RowSpan="7" Visibility="Collapsed"
              Canvas.ZIndex="90"
              Background="{StaticResource NovaAppBackgroundBrush}">
            <ScrollViewer HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{StaticResource NovaChromeSurfaceRaisedBrush}"
                        BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        BorderThickness="1" CornerRadius="18"
                        Padding="24" Margin="0,32,0,32">
                    <StackPanel Width="340" Spacing="16">

                        <Border Style="{StaticResource NovaLoginHeroCardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Vrai logo (2026-08-12, retour utilisateur avec captures a l'appui) :
                                     le trace vectoriel a la main (etoile en decoupe EvenOdd) rend flou et
                                     decolore a cette taille - confirme sur capture reelle, different du
                                     PNG utilise partout ailleurs (accueil, A propos, assistant). Remplace
                                     par LumoraLogoMark.png, agrandi 38->42px, meme asset que le reste de
                                     l'app. Ne touche pas ModulesButtonMark/StartMenu (ligne ~1221/1336) :
                                     ce trace y a ete choisi expres le meme jour pour eviter le crenelage
                                     du PNG a 22px, probleme distinct non signale sur cet ecran. -->
                                <Border Width="42" Height="42" CornerRadius="10" VerticalAlignment="Top">
                                    <Image Source="ms-appx:///Assets/LumoraLogoMark.png"
                                           Width="42" Height="42"
                                           Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Lumora"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource NovaBrandChipForegroundBrush}" />
                                    <TextBlock Text="Verrouillage local, profils séparés et ouverture rapide."
                                               FontSize="12"
                                               Opacity="0.82"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource NovaBrandChipMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Message de statut -->
                        <TextBlock x:Name="LoginStatusText"
                                   HorizontalAlignment="Center" Opacity="0.65"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   FontSize="13" />

                        <!-- Choix du profil -->
                        <StackPanel x:Name="ProfilePickerPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Choisir un profil" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Chaque profil garde ses favoris, son historique, ses sessions, son coffre et ses paramètres séparés."
                                       TextWrapping="Wrap" Opacity="0.65" TextAlignment="Center"
                                       FontSize="13" Margin="0,0,0,6" />
                            <ListBox x:Name="ProfilePickerList"
                                     MaxHeight="230"
                                     SelectionChanged="ProfilePickerList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="10" Margin="2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="36" Height="36" VerticalAlignment="Center">
                                                <Ellipse Fill="{Binding AvatarPath, Converter={StaticResource AvatarPathToBrushConverter}, ConverterParameter={StaticResource NovaChromeStrokeSoftBrush}}" />
                                                <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                          Foreground="{StaticResource NovaBrandChipMutedBrush}"
                                                          Visibility="{Binding AvatarPath, Converter={StaticResource AvatarPathToPlaceholderVisibilityConverter}}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="11" Opacity="0.6" />
                                            </StackPanel>
                                            <Border Grid.Column="2" VerticalAlignment="Center"
                                                    Background="{StaticResource NovaAccentSoftBrush}"
                                                    CornerRadius="999" Padding="8,3"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Actif" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="ProfilePickerContinueButton"
                                    Content="Continuer avec ce profil"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="ProfilePickerContinueButton_Click" />
                            <Button Content="Créer un autre profil"
                                    HorizontalAlignment="Stretch"
                                    Click="CreateAnotherProfileButton_Click" />
                            <!--
                                Trouve en usage reel le 2026-07-29 : ouvrir ce selecteur en cours de
                                session ("Changer de profil" depuis les Parametres) ne laissait aucun
                                moyen de revenir a la session active sans changer ou creer un profil,
                                ni sans passer en mode invite - l'ecran de connexion restait affiche
                                par-dessus la navigation en cours. Meme patron que
                                CreateProfileCancelButton : visible uniquement s'il y a une session
                                active (profil ou invite) vers laquelle revenir.
                            -->
                            <Button x:Name="ProfilePickerCancelButton" Content="Annuler"
                                    HorizontalAlignment="Stretch"
                                    Click="ProfilePickerCancelButton_Click"
                                    Visibility="Collapsed" />
                            <Border Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Margin="0,6,0,2" />
                            <HyperlinkButton Content="Continuer sans profil (mode invité)"
                                             HorizontalAlignment="Center" Opacity="0.6"
                                             Click="SkipProfileButton_Click" />
                        </StackPanel>

                        <!-- Connexion par mot de passe -->
                        <StackPanel x:Name="LoginPasswordPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock x:Name="LoginWelcomeText" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Margin="0,0,0,2" />
                            <PasswordBox x:Name="LoginPasswordBox" PlaceholderText="Mot de passe"
                                         KeyDown="LoginPasswordBox_KeyDown" />
                            <Button x:Name="LoginButton" Content="Se connecter"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Click="LoginButton_Click" />
                            <HyperlinkButton Content="Mot de passe oublie ?"
                                             HorizontalAlignment="Center"
                                             Click="ForgotPasswordButton_Click" />
                            <HyperlinkButton x:Name="ShowPinButton" Content="Utiliser le code PIN"
                                             HorizontalAlignment="Center" Visibility="Collapsed"
                                             Click="ShowPinButton_Click" />
                            <HyperlinkButton Content="Changer de profil"
                                             HorizontalAlignment="Center"
                                             Click="ShowProfilePickerButton_Click" />
                            <Border Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Margin="0,10,0,2" />
                            <HyperlinkButton Content="Continuer sans profil (mode invité)"
                                             HorizontalAlignment="Center" Opacity="0.6"
                                             Click="SkipProfileButton_Click" />
                        </StackPanel>

                        <!-- Connexion par code PIN -->
                        <StackPanel x:Name="LoginPinPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock x:Name="PinWelcomeText" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <Border Style="{StaticResource NovaLoginHeroCardStyle}" Padding="14,12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Code PIN"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource NovaBrandChipMutedBrush}" />
                                    <!-- Ronds pleins sur l'accent du Mode d'usage actif (2026-08-12,
                                         retour utilisateur : les losanges scintillants ne rappelaient
                                         rien de la charte). NovaAccentBrush est deja mis a jour en
                                         direct par ApplyUsageModeChrome (MainWindow.SettingsTheme.cs) -
                                         suivre ce StaticResource suffit, pas de nouvelle logique de
                                         theme. Rempli/vide bascule seulement l'Opacity (UpdatePinDots,
                                         MainWindow.Profile.cs), la brique reste la meme. -->
                                    <StackPanel x:Name="PinDotsPanel" Orientation="Horizontal" Spacing="10"
                                                HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Ellipse Width="11" Height="11" Fill="{StaticResource NovaAccentBrush}" Opacity="0.28" />
                                        <Ellipse Width="11" Height="11" Fill="{StaticResource NovaAccentBrush}" Opacity="0.28" />
                                        <Ellipse Width="11" Height="11" Fill="{StaticResource NovaAccentBrush}" Opacity="0.28" />
                                        <Ellipse Width="11" Height="11" Fill="{StaticResource NovaAccentBrush}" Opacity="0.28" />
                                        <Ellipse Width="11" Height="11" Fill="{StaticResource NovaAccentBrush}" Opacity="0.28" />
                                        <Ellipse Width="11" Height="11" Fill="{StaticResource NovaAccentBrush}" Opacity="0.28" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Grid ColumnSpacing="8" RowSpacing="8" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                </Grid.RowDefinitions>
                                <Button x:Name="PinDigit1Button" Content="1" Tag="1" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" Style="{StaticResource NovaPinDigitButtonStyle}" />
                                <Button Content="2" Tag="2" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" Style="{StaticResource NovaPinDigitButtonStyle}" />
                                <Button Content="3" Tag="3" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" Style="{StaticResource NovaPinDigitButtonStyle}" />
                                <Button Content="4" Tag="4" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" Style="{StaticResource NovaPinDigitButtonStyle}" />
                                <Button Content="5" Tag="5" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" Style="{StaticResource NovaPinDigitButtonStyle}" />
                                <Button Content="6" Tag="6" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" Style="{StaticResource NovaPinDigitButtonStyle}" />
                                <Button Content="7" Tag="7" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" Style="{StaticResource NovaPinDigitButtonStyle}" />
                                <Button Content="8" Tag="8" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" Style="{StaticResource NovaPinDigitButtonStyle}" />
                                <Button Content="9" Tag="9" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" Style="{StaticResource NovaPinDigitButtonStyle}" />
                                <Button Content="⌫" Tag="back" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" Style="{StaticResource NovaPinDigitButtonStyle}" FontSize="16" />
                                <Button Content="0" Tag="0" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" Style="{StaticResource NovaPinDigitButtonStyle}" />
                                <Button Content="✕" Tag="clear" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" Style="{StaticResource NovaPinDigitButtonStyle}" FontSize="15" />
                            </Grid>
                            <HyperlinkButton Content="Utiliser le mot de passe"
                                             HorizontalAlignment="Center"
                                             Click="ShowPasswordButton_Click" />
                            <HyperlinkButton Content="Changer de profil"
                                             HorizontalAlignment="Center"
                                             Click="ShowProfilePickerButton_Click" />
                            <Border Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Margin="0,6,0,2" />
                            <HyperlinkButton Content="Continuer sans profil (mode invité)"
                                             HorizontalAlignment="Center" Opacity="0.6"
                                             Click="SkipProfileButton_Click" />
                        </StackPanel>

                        <!-- Création de profil (premier lancement, ou "Créer un autre profil"
                             depuis le sélecteur/les Réglages). Parcours à 3 écrans chaînés
                             (Identité -> Emplacement -> Import) : pastilles d'étape répétées
                             statiquement dans chacun des 3 panneaux ci-dessous (pas de
                             contrôle partagé, juste 3 Grid identiques avec l'étape courante
                             en surbrillance) pour situer où on en est. -->
                        <StackPanel x:Name="CreateProfilePanel" Spacing="10" Visibility="Collapsed">
                            <Grid ColumnSpacing="6" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="3" CornerRadius="2" Background="{StaticResource NovaIdentityMarkBrush}" />
                                <Border Grid.Column="1" Height="3" CornerRadius="2" Background="{StaticResource NovaChromeStrokeBrush}" />
                                <Border Grid.Column="2" Height="3" CornerRadius="2" Background="{StaticResource NovaChromeStrokeBrush}" />
                            </Grid>
                            <TextBlock x:Name="CreateProfileTitleText" Text="Bienvenue" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock x:Name="CreateProfileSubtitleText" Text="Créez votre profil pour protéger vos données."
                                       TextWrapping="Wrap" Opacity="0.65" TextAlignment="Center"
                                       FontSize="13" Margin="0,0,0,6" />
                            <TextBox x:Name="ProfileNameBox" Header="Prénom ou pseudo"
                                     PlaceholderText="Jean" MaxLength="32" />
                            <PasswordBox x:Name="CreatePasswordBox" Header="Mot de passe (min. 8 caractères)"
                                         PlaceholderText="••••••••" />
                            <PasswordBox x:Name="ConfirmPasswordBox" Header="Confirmer le mot de passe"
                                         PlaceholderText="••••••••" />
                            <ToggleSwitch x:Name="EnablePinSwitch" Header="Connexion rapide par PIN"
                                          Toggled="EnablePinSwitch_Toggled" Margin="0,4,0,0" />
                            <PasswordBox x:Name="PinSetupBox" Header="Code PIN (6 chiffres)"
                                         PlaceholderText="● ● ● ● ● ●" MaxLength="6"
                                         Visibility="Collapsed" />
                            <PasswordBox x:Name="ConfirmPinBox" Header="Confirmer le code PIN"
                                         PlaceholderText="● ● ● ● ● ●" MaxLength="6"
                                         Visibility="Collapsed" />

                            <Button x:Name="CreateProfileButton" Content="Créer mon profil"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Click="CreateProfileButton_Click"
                                    Margin="0,6,0,0" />
                            <!--
                                Trouve en usage reel le 2026-07-22 : cet ecran n'avait ni bouton
                                Annuler (impossible de revenir a sa session en cours quand on cree un
                                profil supplementaire depuis les Parametres - il fallait fermer et
                                rouvrir Lumora), ni lien mode invite (au tout premier lancement, sur
                                un poste vierge, aucun moyen de tester Lumora sans creer de compte).
                                Visibilite calculee dans ShowLoginPanel selon le contexte (voir
                                MainWindow.Profile.cs) : Annuler seulement s'il y a une session ou un
                                profil existant vers lequel revenir, mode invite seulement si aucun
                                profil n'est encore choisi cette session.
                            -->
                            <Button x:Name="CreateProfileCancelButton" Content="Annuler"
                                    HorizontalAlignment="Stretch"
                                    Click="CreateProfileCancelButton_Click"
                                    Visibility="Collapsed" />
                            <Border Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Margin="0,6,0,2" />
                            <HyperlinkButton x:Name="CreateProfileGuestLink"
                                             Content="Continuer sans profil (mode invité)"
                                             HorizontalAlignment="Center" Opacity="0.6"
                                             Click="SkipProfileButton_Click"
                                             Visibility="Collapsed" />
                            <InfoBar x:Name="GuestModeInfoBar" IsOpen="False" IsClosable="False"
                                     Severity="Informational" Visibility="Collapsed"
                                     Message="En mode sans profil, rien ne sera enregistré à la fermeture." />
                        </StackPanel>

                        <!-- Emplacement du profil (étape 2 de la création) -->
                        <StackPanel x:Name="ProfileLocationPanel" Spacing="12" Visibility="Collapsed">
                            <Grid ColumnSpacing="6" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="3" CornerRadius="2" Background="{StaticResource NovaIdentityMarkBrush}" />
                                <Border Grid.Column="1" Height="3" CornerRadius="2" Background="{StaticResource NovaIdentityMarkBrush}" />
                                <Border Grid.Column="2" Height="3" CornerRadius="2" Background="{StaticResource NovaChromeStrokeBrush}" />
                            </Grid>
                            <TextBlock Text="Ou stocker votre profil ?"
                                       FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Votre profil contient tout ce qui vous appartient :"
                                       TextWrapping="Wrap" Opacity="0.65" TextAlignment="Center"
                                       FontSize="13" Margin="0,0,0,2" />

                            <Border CornerRadius="8" Padding="14,10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="• Favoris et historique de navigation" FontSize="13" />
                                    <TextBlock Text="• Mots de passe (coffre chiffré AES-256)" FontSize="13" />
                                    <TextBlock Text="• Onglets ouverts et sessions" FontSize="13" />
                                    <TextBlock Text="• Paramètres et préférences" FontSize="13" />
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="Emplacement de stockage"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12">
En choisissant un dossier personnalise (disque externe, dossier Documents...), votre profil restera accessible apres une reinstallation de Windows. Par defaut, le profil est dans %LOCALAPPDATA%\Lumora\profile.
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <TextBlock x:Name="ProfileLocationPathText"
                                               Text="Emplacement par defaut"
                                               FontSize="12" Opacity="0.72"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="200" />
                                    <Button x:Name="ChooseProfileLocationButton" Content="Changer"
                                            Click="ChooseProfileLocationButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="ProfileLocationContinueButton" Content="Continuer"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="ProfileLocationContinueButton_Click"
                                    Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Migration depuis un autre navigateur (après création du profil) -->
                        <StackPanel x:Name="MigrationPanel" Spacing="12" Visibility="Collapsed">
                            <Grid ColumnSpacing="6" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="3" CornerRadius="2" Background="{StaticResource NovaIdentityMarkBrush}" />
                                <Border Grid.Column="1" Height="3" CornerRadius="2" Background="{StaticResource NovaIdentityMarkBrush}" />
                                <Border Grid.Column="2" Height="3" CornerRadius="2" Background="{StaticResource NovaIdentityMarkBrush}" />
                            </Grid>
                            <TextBlock Text="Importer vos favoris ?" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Sélectionnez un navigateur pour récupérer vos favoris."
                                       TextWrapping="Wrap" Opacity="0.65" TextAlignment="Center" FontSize="13" />
                            <ListBox x:Name="MigrationSourcesList" MaxHeight="180" />
                            <TextBlock Text="Firefox : exportez d'abord vos favoris en HTML depuis Firefox (Signets › Afficher tous les signets › Importer et sauvegarder › Exporter en HTML), puis utilisez le bouton ci-dessous."
                                       TextWrapping="Wrap" Opacity="0.45" FontSize="11" />
                            <Button x:Name="MigrationImportButton" Content="Importer les favoris"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="MigrationImportButton_Click" />
                            <Button Content="Depuis un fichier HTML..."
                                    HorizontalAlignment="Stretch"
                                    Click="MigrationImportHtmlButton_Click" />
                            <Border Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Margin="0,4,0,0" />
                            <HyperlinkButton Content="Passer cette etape"
                                             HorizontalAlignment="Center" Opacity="0.6"
                                             Click="MigrationSkipButton_Click" />
                        </StackPanel>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Wizard premier lancement (visible une seule fois apres creation de compte).
             ZIndex="95" : doit rester au-dessus de LoginOverlay (90), affiche juste
             apres lui (DismissLoginOverlay -> ShowSetupWizard). -->
        <Grid x:Name="SetupWizardOverlay" Grid.RowSpan="7" Visibility="Collapsed"
              Canvas.ZIndex="95"
              Background="{StaticResource NovaAppBackgroundBrush}">
            <ScrollViewer HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{StaticResource NovaChromeSurfaceRaisedBrush}"
                        BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="40,36,40,36" Margin="0,32,0,32">
                    <StackPanel Width="440" Spacing="0">

                        <!-- Logo -->
                        <StackPanel Orientation="Horizontal" Spacing="12"
                                    HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Border Width="36" Height="36" CornerRadius="9">
                                <Image Source="ms-appx:///Assets/LumoraLogoMark.png"
                                       Width="36" Height="36"
                                       Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Lumora" FontSize="20" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Indicateur d'etape -->
                        <TextBlock x:Name="WizardStepIndicator" Text="Etape 1 / 6"
                                   HorizontalAlignment="Center" Opacity="0.5"
                                   FontSize="12" Margin="0,0,0,20" />

                        <!-- Etape 0 : Bienvenue -->
                        <StackPanel x:Name="WizardStep0" Spacing="14">
                            <TextBlock Text="Bienvenue !" FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Lumora démarre volontairement épuré : aucun module visible n'est imposé. Quelques réglages rapides permettent de construire votre expérience."
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="14" Opacity="0.72" Margin="0,0,0,6" />
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="16,14">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Modules visibles choisis par vous"
                                               FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="Accueil personnalisable selon votre mode d'usage"
                                               FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="Données stockées uniquement sur votre machine"
                                               FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Etape 1 : Profil existant ? -->
                        <StackPanel x:Name="WizardStep1" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Profil existant ?" FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Si vous avez déjà utilisé Lumora, importez une sauvegarde (.lumorabackup) pour retrouver vos favoris, onglets, coffre et réglages."
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="14" Opacity="0.72" Margin="0,0,0,6" />
                            <Button x:Name="WizardImportBackupButton" Content="Importer une sauvegarde..."
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="WizardImportBackupButton_Click" />
                            <TextBlock Text="Sinon, cliquez sur Suivant pour créer un profil neuf."
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="12" Opacity="0.55" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Etape 2 : Moteur de recherche -->
                        <StackPanel x:Name="WizardStep2" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Moteur de recherche" FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Quel moteur souhaitez-vous utiliser par défaut ?"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="14" Opacity="0.72" Margin="0,0,0,6" />
                            <RadioButton x:Name="WizardSearchGoogle" Content="Google"
                                         GroupName="WizardSearchGroup" IsChecked="True"
                                         Tag="google" Checked="WizardSearch_Checked" />
                            <RadioButton x:Name="WizardSearchDuckDuckGo" Content="DuckDuckGo"
                                         GroupName="WizardSearchGroup"
                                         Tag="duckduckgo" Checked="WizardSearch_Checked" />
                            <RadioButton x:Name="WizardSearchBrave" Content="Brave Search"
                                         GroupName="WizardSearchGroup"
                                         Tag="brave" Checked="WizardSearch_Checked" />
                            <RadioButton x:Name="WizardSearchBing" Content="Bing"
                                         GroupName="WizardSearchGroup"
                                         Tag="bing" Checked="WizardSearch_Checked" />
                        </StackPanel>

                        <!-- Etape 3 : Disposition des onglets -->
                        <StackPanel x:Name="WizardStep3" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Disposition des onglets" FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Où voulez-vous voir vos onglets ouverts ?"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="14" Opacity="0.72" Margin="0,0,0,6" />
                            <RadioButton x:Name="WizardTabsHorizontal" Content="Horizontaux, en haut de la fenêtre"
                                         GroupName="WizardTabsGroup" IsChecked="True"
                                         Tag="top" Checked="WizardTabsOrientation_Checked" />
                            <RadioButton x:Name="WizardTabsVertical" Content="Verticaux, sur le côté de la fenêtre"
                                         GroupName="WizardTabsGroup"
                                         Tag="left" Checked="WizardTabsOrientation_Checked" />
                        </StackPanel>

                        <!-- Etape 4 : Experience personnelle -->
                        <StackPanel x:Name="WizardStep4" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Votre Lumora" FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Choisissez un mode d'usage, puis les modules que vous voulez voir dans la barre. Vous pouvez tout laisser vide pour partir d'une interface nue."
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="14" Opacity="0.72" Margin="0,0,0,6" />
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="16,14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Mode d'usage" FontSize="13" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="10" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <RadioButton x:Name="WizardUsageNeutral" Grid.Row="0" Grid.Column="0" Content="Neutre" GroupName="WizardUsageGroup" Tag="neutral" Checked="WizardUsage_Checked" />
                                        <RadioButton x:Name="WizardUsageBalanced" Grid.Row="0" Grid.Column="1" Content="Equilibre" GroupName="WizardUsageGroup" Tag="balanced" Checked="WizardUsage_Checked" />
                                        <RadioButton x:Name="WizardUsageFocus" Grid.Row="1" Grid.Column="0" Content="Focus" GroupName="WizardUsageGroup" Tag="focus" Checked="WizardUsage_Checked" />
                                        <RadioButton x:Name="WizardUsageReading" Grid.Row="1" Grid.Column="1" Content="Lecture" GroupName="WizardUsageGroup" Tag="reading" Checked="WizardUsage_Checked" />
                                        <RadioButton x:Name="WizardUsageCreative" Grid.Row="2" Grid.Column="0" Content="Creation" GroupName="WizardUsageGroup" Tag="creative" Checked="WizardUsage_Checked" />
                                        <RadioButton x:Name="WizardUsageResearch" Grid.Row="2" Grid.Column="1" Content="Recherche" GroupName="WizardUsageGroup" Tag="research" Checked="WizardUsage_Checked" />
                                        <RadioButton x:Name="WizardUsageNight" Grid.Row="3" Grid.Column="0" Content="Nuit" GroupName="WizardUsageGroup" Tag="night" Checked="WizardUsage_Checked" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="16,14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Modules visibles au démarrage" FontSize="13" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="10" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <CheckBox x:Name="WizardModuleReader" Grid.Row="0" Grid.Column="0" Content="Lecture" Tag="reader" Checked="WizardModule_Checked" Unchecked="WizardModule_Checked" />
                                        <CheckBox x:Name="WizardModuleNotes" Grid.Row="0" Grid.Column="1" Content="Notes" Tag="notes" Checked="WizardModule_Checked" Unchecked="WizardModule_Checked" />
                                        <CheckBox x:Name="WizardModuleReadAloud" Grid.Row="1" Grid.Column="0" Content="Lire a voix haute" Tag="readAloud" Checked="WizardModule_Checked" Unchecked="WizardModule_Checked" />
                                        <CheckBox x:Name="WizardModuleVideoDownload" Grid.Row="1" Grid.Column="1" Content="Téléchargement vidéo" Tag="videoDownload" Checked="WizardModule_Checked" Unchecked="WizardModule_Checked" />
                                        <CheckBox x:Name="WizardModuleSearchAssist" Grid.Row="2" Grid.Column="0" Content="Assistant recherche" Tag="searchAssist" Checked="WizardModule_Checked" Unchecked="WizardModule_Checked" />
                                        <CheckBox x:Name="WizardModuleTranslate" Grid.Row="2" Grid.Column="1" Content="Traduction" Tag="translate" Checked="WizardModule_Checked" Unchecked="WizardModule_Checked" />
                                        <CheckBox x:Name="WizardModuleWebApps" Grid.Row="3" Grid.Column="0" Content="Applications web" Tag="webApps" Checked="WizardModule_Checked" Unchecked="WizardModule_Checked" />
                                        <CheckBox x:Name="WizardModuleDictation" Grid.Row="3" Grid.Column="1" Content="Dictée" Tag="dictation" Checked="WizardModule_Checked" Unchecked="WizardModule_Checked" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Etape 5 : Resume et confirmation -->
                        <StackPanel x:Name="WizardStep5" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Vous etes pret !" FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Lumora est configuré. Vous pouvez modifier ces réglages à tout moment dans le Centre Lumora."
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="14" Opacity="0.72" Margin="0,0,0,6" />
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="16,14">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="WizardSummarySearch"
                                               FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock x:Name="WizardSummaryTabs"
                                               FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock x:Name="WizardSummaryUsage"
                                               FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock x:Name="WizardSummaryModules"
                                               FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="Protection de la vie privée activée"
                                               FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Separateur -->
                        <Border Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Margin="0,24,0,20" />

                        <!-- Boutons de navigation -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="WizardPrevButton" Content="Précédent"
                                    Grid.Column="0" IsEnabled="False"
                                    Click="WizardPrevButton_Click" />
                            <Button x:Name="WizardNextButton" Content="Suivant"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Grid.Column="2"
                                    Click="WizardNextButton_Click" />
                        </Grid>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Slides de bienvenue : presentation du logiciel et de ses fonctions
             majeures, avant meme la creation du premier profil (meme logique
             qu'un ecran de premier lancement de telephone : bienvenue, tour
             rapide, puis creation du compte). ZIndex au-dessus de LoginOverlay
             (90) ET SetupWizardOverlay (95) : doit couvrir les deux au tout
             premier lancement. Egalement invocable a la demande depuis
             Parametres > Mon Lumora ("Revoir l'ecran de bienvenue"),
             independamment de tout premier lancement - voir
             MainWindow.WelcomeSlides.cs.
             Refonte visuelle (retour utilisateur : trop plat/statique pour 2026) :
             carte en verre depoli (NovaFloatingGlassBrush + ThemeShadow, meme
             materiau/elevation que NavigationToolbarCapsule) posee sur un fond
             ambiant a deux lueurs qui respirent lentement, anneau + halo
             respirants autour de l'icone de la fonction affichee, etiquette
             "eyebrow" + mot-cle accentue dans chaque titre, points de
             progression en pilules. -->
        <Grid x:Name="WelcomeOverlay" Grid.RowSpan="7" Visibility="Collapsed"
              Canvas.ZIndex="99"
              Background="{StaticResource NovaAppBackgroundBrush}">
            <Grid.Resources>
                <Storyboard x:Key="WelcomeAmbienceStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="WelcomeBlobWarm" Storyboard.TargetProperty="Opacity"
                                     From="0.30" To="0.75" Duration="0:00:07" />
                    <DoubleAnimation Storyboard.TargetName="WelcomeBlobCool" Storyboard.TargetProperty="Opacity"
                                     From="0.70" To="0.28" Duration="0:00:09" />
                </Storyboard>
                <Storyboard x:Key="Welcome0Pulse" RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="WelcomeHalo0" Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:00:02.6" />
                    <DoubleAnimation Storyboard.TargetName="WelcomeRing0" Storyboard.TargetProperty="Opacity" From="0.35" To="0.85" Duration="0:00:02.6" />
                </Storyboard>
                <Storyboard x:Key="Welcome1Pulse" RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="WelcomeHalo1" Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:00:02.6" />
                    <DoubleAnimation Storyboard.TargetName="WelcomeRing1" Storyboard.TargetProperty="Opacity" From="0.35" To="0.85" Duration="0:00:02.6" />
                </Storyboard>
                <Storyboard x:Key="Welcome2Pulse" RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="WelcomeHalo2" Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:00:02.6" />
                    <DoubleAnimation Storyboard.TargetName="WelcomeRing2" Storyboard.TargetProperty="Opacity" From="0.35" To="0.85" Duration="0:00:02.6" />
                </Storyboard>
                <Storyboard x:Key="Welcome3Pulse" RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="WelcomeHalo3" Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:00:02.6" />
                    <DoubleAnimation Storyboard.TargetName="WelcomeRing3" Storyboard.TargetProperty="Opacity" From="0.35" To="0.85" Duration="0:00:02.6" />
                </Storyboard>
                <Storyboard x:Key="Welcome4Pulse" RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="WelcomeHalo4" Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:00:02.6" />
                    <DoubleAnimation Storyboard.TargetName="WelcomeRing4" Storyboard.TargetProperty="Opacity" From="0.35" To="0.85" Duration="0:00:02.6" />
                </Storyboard>
            </Grid.Resources>

            <!-- Fond ambiant : deux lueurs larges qui respirent lentement,
                 direction "profondeur" derriere le verre depoli de la carte
                 (retour utilisateur : fond trop plat). -->
            <Ellipse x:Name="WelcomeBlobWarm" Width="480" Height="480" Opacity="0.45"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-160,-160,0,0"
                     Fill="{StaticResource NovaChromeHaloWarmGlowBrush}" />
            <Ellipse x:Name="WelcomeBlobCool" Width="420" Height="420" Opacity="0.55"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-140,-140"
                     Fill="{StaticResource NovaChromeHaloCoolGlowBrush}" />

            <ScrollViewer HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{StaticResource NovaFloatingGlassBrush}"
                        BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        BorderThickness="1" CornerRadius="20"
                        Padding="40,32,40,32" Margin="0,32,0,32"
                        Translation="0,0,32">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel Width="460" Spacing="0">

                        <!-- Lien "Passer", seul (le logo vit desormais dans chaque slide,
                             au-dessus de l'icone de fonction) -->
                        <Grid Margin="0,0,0,4" HorizontalAlignment="Stretch">
                            <HyperlinkButton x:Name="WelcomeSkipButton" Content="Passer"
                                             HorizontalAlignment="Right" VerticalAlignment="Center"
                                             Padding="8,4"
                                             Click="WelcomeSkipButton_Click" />
                        </Grid>

                        <!-- Les 5 diapositives partagent la meme cellule de Grid (superposees,
                             pas empilees) : c'est ce qui permet a l'ancienne et a la nouvelle
                             d'etre visibles en meme temps pendant le glissement anime en
                             code-behind (MainWindow.WelcomeSlides.cs::AnimateWelcomeStepTransition) -
                             une StackPanel classique les aurait empilees verticalement des que
                             les deux sont Visible simultanement. Chaque slide porte son propre
                             TranslateTransform (anime en X pour l'effet "page qui glisse"),
                             la transition EntranceThemeTransition d'origine est retiree : le
                             glissement est desormais entierement pilote a la main. -->
                        <Grid x:Name="WelcomeStepsHost">
                            <!-- Slide 0 : Bienvenue (accueil, pas une fonction) -->
                            <StackPanel x:Name="WelcomeStep0" Spacing="14" HorizontalAlignment="Center">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform />
                                </StackPanel.RenderTransform>
                                <Grid Width="96" Height="96" Margin="0,4,0,4">
                                    <Ellipse x:Name="WelcomeHalo0" Fill="{StaticResource NovaChromeHaloWarmGlowBrush}" />
                                    <Ellipse x:Name="WelcomeRing0" Width="76" Height="76"
                                             Stroke="{StaticResource NovaAccentBrush}" StrokeThickness="1.4" Opacity="0.6"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Width="64" Height="64" CornerRadius="32"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="ms-appx:///Assets/LumoraLogoMark.png" Stretch="Uniform" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="VOTRE NAVIGATEUR" FontSize="12" FontWeight="SemiBold" CharacterSpacing="60"
                                           HorizontalAlignment="Center" Foreground="{StaticResource NovaAccentBrush}" />
                                <TextBlock FontSize="24" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap">
                                    <Run Text="Bienvenue dans " /><Run Text="Lumora" Foreground="{StaticResource NovaAccentBrush}" />
                                </TextBlock>
                                <TextBlock Text="Un navigateur différent, pensé pour vous. Petit tour de ce qu'il sait faire, avant de créer votre identifiant."
                                           TextWrapping="Wrap" TextAlignment="Center" Width="340"
                                           FontSize="14" Opacity="0.72" />
                            </StackPanel>

                            <!-- Slide 1 : Coffre de mots de passe + portefeuille -->
                            <StackPanel x:Name="WelcomeStep1" Spacing="14" HorizontalAlignment="Center" Visibility="Collapsed">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform />
                                </StackPanel.RenderTransform>
                                <Grid Width="96" Height="96" Margin="0,4,0,4">
                                    <Ellipse x:Name="WelcomeHalo1" Fill="{StaticResource NovaChromeHaloWarmGlowBrush}" />
                                    <Ellipse x:Name="WelcomeRing1" Width="76" Height="76"
                                             Stroke="{StaticResource NovaAccentBrush}" StrokeThickness="1.4" Opacity="0.6"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Width="64" Height="64" CornerRadius="32"
                                            Background="{StaticResource NovaIdentityMarkBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="White" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="SÉCURITÉ" FontSize="12" FontWeight="SemiBold" CharacterSpacing="60"
                                           HorizontalAlignment="Center" Foreground="{StaticResource NovaAccentBrush}" />
                                <TextBlock FontSize="24" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="360">
                                    <Run Text="Un " /><Run Text="coffre" Foreground="{StaticResource NovaAccentBrush}" /><Run Text=" pour vos mots de passe" />
                                </TextBlock>
                                <TextBlock Text="Mots de passe et cartes bancaires chiffrés localement, jamais envoyés ailleurs. Lumora peut aussi générer et retenir vos mots de passe à votre place."
                                           TextWrapping="Wrap" TextAlignment="Center" Width="340"
                                           FontSize="14" Opacity="0.72" />
                            </StackPanel>

                            <!-- Slide 2 : Incognito + Tor -->
                            <StackPanel x:Name="WelcomeStep2" Spacing="14" HorizontalAlignment="Center" Visibility="Collapsed">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform />
                                </StackPanel.RenderTransform>
                                <Grid Width="96" Height="96" Margin="0,4,0,4">
                                    <Ellipse x:Name="WelcomeHalo2" Fill="{StaticResource NovaChromeHaloCoolGlowBrush}" />
                                    <Ellipse x:Name="WelcomeRing2" Width="76" Height="76"
                                             Stroke="{StaticResource NovaCoolAccentBrush}" StrokeThickness="1.4" Opacity="0.6"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Width="64" Height="64" CornerRadius="32"
                                            Background="{StaticResource NovaIdentityMarkBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="White" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="CONFIDENTIALITÉ" FontSize="12" FontWeight="SemiBold" CharacterSpacing="60"
                                           HorizontalAlignment="Center" Foreground="{StaticResource NovaCoolAccentBrush}" />
                                <TextBlock FontSize="24" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="360">
                                    <Run Text="Incognito" Foreground="{StaticResource NovaCoolAccentBrush}" /><Run Text=", et Tor si besoin" />
                                </TextBlock>
                                <TextBlock Text="Une fenêtre privée qui ne garde aucune trace, avec un bouton pour faire transiter votre trafic par le réseau Tor et masquer votre adresse IP en un geste."
                                           TextWrapping="Wrap" TextAlignment="Center" Width="340"
                                           FontSize="14" Opacity="0.72" />
                            </StackPanel>

                            <!-- Slide 3 : Lecture, traduction, recherche -->
                            <StackPanel x:Name="WelcomeStep3" Spacing="14" HorizontalAlignment="Center" Visibility="Collapsed">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform />
                                </StackPanel.RenderTransform>
                                <Grid Width="96" Height="96" Margin="0,4,0,4">
                                    <Ellipse x:Name="WelcomeHalo3" Fill="{StaticResource NovaChromeHaloWarmGlowBrush}" />
                                    <Ellipse x:Name="WelcomeRing3" Width="76" Height="76"
                                             Stroke="{StaticResource NovaAccentBrush}" StrokeThickness="1.4" Opacity="0.6"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Width="64" Height="64" CornerRadius="32"
                                            Background="{StaticResource NovaIdentityMarkBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="White" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="CONFORT DE LECTURE" FontSize="12" FontWeight="SemiBold" CharacterSpacing="60"
                                           HorizontalAlignment="Center" Foreground="{StaticResource NovaAccentBrush}" />
                                <TextBlock FontSize="24" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="360">
                                    <Run Text="Lu, écouté, " /><Run Text="traduit" Foreground="{StaticResource NovaAccentBrush}" /><Run Text=", retrouvé" />
                                </TextBlock>
                                <TextBlock Text="Lecture à voix haute, traduction hors-ligne, et une recherche dans votre historique qui comprend le sens de ce que vous cherchez, pas juste les mots exacts."
                                           TextWrapping="Wrap" TextAlignment="Center" Width="340"
                                           FontSize="14" Opacity="0.72" />
                            </StackPanel>

                            <!-- Slide 4 : Accessibilite -->
                            <StackPanel x:Name="WelcomeStep4" Spacing="14" HorizontalAlignment="Center" Visibility="Collapsed">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform />
                                </StackPanel.RenderTransform>
                                <Grid Width="96" Height="96" Margin="0,4,0,4">
                                    <Ellipse x:Name="WelcomeHalo4" Fill="{StaticResource NovaChromeHaloCoolGlowBrush}" />
                                    <Ellipse x:Name="WelcomeRing4" Width="76" Height="76"
                                             Stroke="{StaticResource NovaCoolAccentBrush}" StrokeThickness="1.4" Opacity="0.6"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Width="64" Height="64" CornerRadius="32"
                                            Background="{StaticResource NovaIdentityMarkBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="White" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="ACCESSIBILITÉ" FontSize="12" FontWeight="SemiBold" CharacterSpacing="60"
                                           HorizontalAlignment="Center" Foreground="{StaticResource NovaCoolAccentBrush}" />
                                <TextBlock FontSize="24" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Width="360">
                                    <Run Text="Confortable" Foreground="{StaticResource NovaCoolAccentBrush}" /><Run Text=" pour de vrai" />
                                </TextBlock>
                                <TextBlock Text="Profils de confort prêts à l'emploi, navigation complète au clavier, contrastes renforcés et guide de lecture : l'accessibilité est une priorité, pas une case cachée."
                                           TextWrapping="Wrap" TextAlignment="Center" Width="340"
                                           FontSize="14" Opacity="0.72" />
                            </StackPanel>
                        </Grid>

                        <!-- Points de progression : rail de 5 pastilles fixes + une "pilule"
                             mobile qui glisse d'une position a l'autre (Canvas.Left anime en
                             code-behind) au lieu de sauter d'un bloc - retour utilisateur :
                             "on ne la voit pas se deplacer". -->
                        <Canvas Width="84" Height="8" HorizontalAlignment="Center" Margin="0,24,0,18">
                            <Rectangle Canvas.Left="6" Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="{StaticResource NovaChromeStrokeBrush}" />
                            <Rectangle Canvas.Left="22" Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="{StaticResource NovaChromeStrokeBrush}" />
                            <Rectangle Canvas.Left="38" Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="{StaticResource NovaChromeStrokeBrush}" />
                            <Rectangle Canvas.Left="54" Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="{StaticResource NovaChromeStrokeBrush}" />
                            <Rectangle Canvas.Left="70" Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="{StaticResource NovaChromeStrokeBrush}" />
                            <Rectangle x:Name="WelcomeStepCursor" Canvas.Left="0" Width="20" Height="8" RadiusX="4" RadiusY="4"
                                       Fill="{StaticResource NovaAccentBrush}" />
                        </Canvas>
                        <!-- Texte equivalent pour le lecteur d'ecran (le rail de pastilles ne
                             porte aucune information a lui seul) -->
                        <TextBlock x:Name="WelcomeStepIndicator" Text="1 / 5"
                                   HorizontalAlignment="Center" Opacity="0.001" FontSize="1"
                                   AutomationProperties.Name="Étape 1 sur 5" />

                        <!-- Separateur -->
                        <Border Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Margin="0,0,0,20" />

                        <!-- Boutons de navigation -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="WelcomePrevButton" Content="Précédent"
                                    Grid.Column="0" IsEnabled="False"
                                    Click="WelcomePrevButton_Click" />
                            <Button x:Name="WelcomeNextButton" Content="Suivant"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Grid.Column="2"
                                    Click="WelcomeNextButton_Click" />
                        </Grid>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

    </Grid>
</Window>
