                        <FontIcon x:Name="AccessibilityQuickIcon"
                                  Grid.Column="5"
                                  Glyph="&#xE790;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="11.5"
                                  Opacity="0.76"
                                  VerticalAlignment="Center" />
                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Confort" FontSize="10.5" Opacity="0.56" VerticalAlignment="Center" />
                            <TextBlock x:Name="AccessibilityQuickCurrentText" Text="Aucune aide" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <FontIcon Grid.Column="7" Glyph="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" Opacity="0.44" VerticalAlignment="Center" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout x:Name="UsageModeFlyout" Placement="TopEdgeAlignedRight" Opening="AccessibilityQuickFlyout_Opening">
                            <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                            <StackPanel Width="380" Spacing="12">
                                <Border Style="{StaticResource NovaFlyoutHeroCardStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Mode et confort"
                                                   FontWeight="SemiBold"
                                                   FontSize="18"
                                                   Foreground="{StaticResource NovaBrandChipForegroundBrush}" />
                                        <TextBlock Text="Un seul endroit pour ajuster le rythme de Lumora (mode d'usage) et les aides de lecture (confort). Raccourcis confort : Ctrl+Alt+6 et Ctrl+Alt+8, Ctrl+Alt+S et Ctrl+Alt+X."
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Opacity="0.82"
                                                   Foreground="{StaticResource NovaBrandChipMutedBrush}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Mode d'usage" Style="{StaticResource NovaPanelSectionTitleStyle}" />

                                <!-- Grille 2 colonnes plutot qu'une pile pleine largeur : meme
                                     contenu (icone/titre/description) pour chaque posture, juste
                                     deux par ligne au lieu d'une - moitie moins de hauteur pour
                                     un menu juge trop imposant par l'utilisateur, sans retirer
                                     aucune information. -->
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button x:Name="UsageModeNeutralButton" Grid.Row="0" Grid.Column="0" Tag="neutral" Style="{StaticResource NovaModuleFlyoutActionStyle}" Click="UsageModeQuickButton_Click">
