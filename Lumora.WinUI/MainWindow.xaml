                            <ToggleSwitch x:Name="HttpsEnforcerSwitch"
                                         Header="Forcer HTTPS"
                                         Toggled="HttpsEnforcerSwitch_Toggled" />

                            <!-- SmartScreen : seule protection de cette page qui envoie des donnees a un tiers (Microsoft), contrairement au reste qui bloque/anonymise localement -->
