                                <InfoBar.ActionButton>
                                    <Button Content="Fermer Lumora" Style="{StaticResource NovaButtonStyle}" Click="StorageRestartCloseButton_Click" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </StackPanel>

                        <!-- Section : Vie privée locale -->
                        <StackPanel x:Name="SettingsSectionPrivacy" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Confidentialité" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="Publicités et traceurs, anti-pistage technique, sécurité de connexion et hygiène de session : tout tourne en local, sans tableau de bord distant."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <!-- Compteur de blocages : reflete surtout le bloqueur pub/trackers ci-dessous -->
                            <Border Style="{StaticResource NovaPanelCardStyle}"
                                    Background="{StaticResource NovaSuccessSurfaceBrush}">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="PrivacyBlockedCountText"
                                               Text="0 requête bloquée"
                                               FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PrivacyRuleCountText"
                                               Text="Chargement des règles..."
                                               Opacity="0.7" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <RadioButton x:Name="PrivacySubNavAds" Content="Publicités et traceurs" Tag="ads"
                                             GroupName="PrivacySubNav" IsChecked="True"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="PrivacySubNav_Click" />
                                <RadioButton x:Name="PrivacySubNavTracking" Content="Anti-pistage technique" Tag="tracking"
                                             GroupName="PrivacySubNav"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="PrivacySubNav_Click" />
                                <RadioButton x:Name="PrivacySubNavConnection" Content="Sécurité de connexion" Tag="connection"
                                             GroupName="PrivacySubNav"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="PrivacySubNav_Click" />
                                <RadioButton x:Name="PrivacySubNavHygiene" Content="Hygiène de session" Tag="hygiene"
                                             GroupName="PrivacySubNav"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="PrivacySubNav_Click" />
                                <RadioButton x:Name="PrivacySubNavExceptions" Content="Exceptions" Tag="exceptions"
                                             GroupName="PrivacySubNav"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="PrivacySubNav_Click" />
                            </StackPanel>
                            </ScrollViewer>
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,0,0,4" />

                            <StackPanel x:Name="PrivacyGroupAds" Spacing="14">
                            <TextBlock Text="Publicités, popups et traceurs" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />

                            <!-- Bloqueur pub / trackers -->
                            <TextBlock Text="Pubs et trackers" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <ToggleSwitch x:Name="NetworkBlockerSwitch"
                                         Header="Activer le bloqueur"
                                         Toggled="NetworkBlockerSwitch_Toggled"
                                         ToolTipService.ToolTip="Bloque les serveurs publicitaires et de tracking avec des listes locales." />
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
                                <Button x:Name="UpdatePrivacyListsButton"
                                        Content="Mettre à jour les listes maintenant"
                                        Style="{StaticResource NovaButtonStyle}"
                                        Click="UpdatePrivacyListsButton_Click" />
                                <TextBlock x:Name="PrivacyLastUpdateText"
                                           VerticalAlignment="Center"
                                           Opacity="0.65" FontSize="12" />
                            </StackPanel>
                            <TextBlock x:Name="PrivacyStatusText"
                                       Style="{StaticResource NovaPanelDescriptionStyle}"
                                       FontStyle="Italic" />
                            <InfoBar x:Name="PrivacyListsUpdateBar"
                                     Title="Listes mises à jour"
                                     Message="Les nouvelles règles de filtrage sont actives."
                                     Severity="Success"
                                     IsOpen="False" IsClosable="True" />

                            <!-- Filtre cosmétique -->
                            <TextBlock Text="Masquage visuel" Style="{StaticResource NovaPanelSectionTitleStyle}" Margin="0,10,0,0" />
                            <ToggleSwitch x:Name="CosmeticFilterSwitch"
                                         Header="Masquer les emplacements pub"
                                         Toggled="CosmeticFilterSwitch_Toggled"
                                         ToolTipService.ToolTip="Masque les emplacements publicitaires vides après filtrage réseau." />

                            <!-- Renforcement anti-publicité (0.77) : popups et détournements ;
                                 description partagee par les 2 interrupteurs suivants. -->
                            <TextBlock Text="Popups et redirections" Style="{StaticResource NovaPanelSectionTitleStyle}" Margin="0,10,0,0" />
                            <ToggleSwitch x:Name="PopupBlockerSwitch"
                                         Header="Bloquer les popups publicitaires et automatiques"
                                         Toggled="PopupBlockerSwitch_Toggled"
                                         ToolTipService.ToolTip="Les popups automatiques et les détournements de clic vers des domaines publicitaires sont bloqués. Les fenêtres de connexion (Google, OAuth...) restent toujours autorisées." />
                            <ToggleSwitch x:Name="StrictAdBlockSwitch"
                                         Header="Bloquer les redirections vers des domaines publicitaires"
                                         Toggled="StrictAdBlockSwitch_Toggled"
                                         ToolTipService.ToolTip="Les popups automatiques et les détournements de clic vers des domaines publicitaires sont bloqués. Les fenêtres de connexion (Google, OAuth...) restent toujours autorisées." />
                            </StackPanel>

                            <StackPanel x:Name="PrivacyGroupTracking" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Anti-pistage technique" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />

                            <!-- CNAME uncloaker -->
                            <TextBlock Text="CNAME cloaking" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <ToggleSwitch x:Name="CnameUncloakerSwitch"
                                         Header="Détecter le CNAME cloaking"
                                         Toggled="CnameUncloakerSwitch_Toggled"
                                         ToolTipService.ToolTip="Détecte les trackers cachés derrière un alias DNS." />

                            <!-- Anti-fuite WebRTC -->
                            <TextBlock Text="WebRTC" Style="{StaticResource NovaPanelSectionTitleStyle}" Margin="0,10,0,0" />
                            <ToggleSwitch x:Name="WebRtcLeakProtectionSwitch"
                                         Header="Bloquer les fuites d'IP WebRTC"
                                         Toggled="WebRtcLeakProtectionSwitch_Toggled"
                                         ToolTipService.ToolTip="Empêche les sites de révéler votre IP locale/publique réelle via WebRTC (utile même sans VPN actif). Nécessite un redémarrage de Lumora pour s'appliquer." />

                            <!-- Position fictive (geolocalisation) -->
                            <TextBlock Text="Géolocalisation" Style="{StaticResource NovaPanelSectionTitleStyle}" Margin="0,10,0,0" />
                            <ToggleSwitch x:Name="GeolocationSpoofingSwitch"
                                         Header="Position fictive"
                                         Toggled="GeolocationSpoofingSwitch_Toggled"
                                         ToolTipService.ToolTip="Renvoie une position fixe aux sites qui demandent votre localisation (cartes, météo, recherche « près de moi ») au lieu de la position réelle de l'appareil. Sans effet sur le catalogue des services de streaming, qui se base sur l'adresse IP, pas sur cette API. Un site autorisé explicitement (onglet Site actuel) reçoit toujours la vraie position." />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GeolocationLatitudeBox" Grid.Column="0" Header="Latitude" PlaceholderText="48.8566" />
                                <TextBox x:Name="GeolocationLongitudeBox" Grid.Column="1" Header="Longitude" PlaceholderText="2.3522" />
                                <Button Grid.Column="2" Content="Appliquer" Style="{StaticResource NovaButtonStyle}" VerticalAlignment="Bottom" Click="GeolocationSpoofApplyButton_Click" />
                            </Grid>

                            <!-- Anti-fingerprinting -->
                            <TextBlock Text="Empreinte du navigateur" Style="{StaticResource NovaPanelSectionTitleStyle}" Margin="0,10,0,0" />
                            <ToggleSwitch x:Name="FingerprintProtectionSwitch"
                                         Header="Brouiller l'empreinte du navigateur"
                                         Toggled="FingerprintProtectionSwitch_Toggled"
                                         ToolTipService.ToolTip="Ajoute un léger bruit à la lecture du Canvas, du WebGL et de l'AudioContext (les techniques de fingerprinting les plus courantes) pour rendre le pistage inter-sites plus difficile, sans casser l'affichage ni ralentir la navigation." />

                            <!-- Gestionnaire de consentement cookies -->
                            <TextBlock Text="Cookies" Style="{StaticResource NovaPanelSectionTitleStyle}" Margin="0,10,0,0" />
                            <ToggleSwitch x:Name="ConsentManagerSwitch"
                                         Header="Refuser automatiquement les cookies"
                                         Toggled="ConsentManagerSwitch_Toggled"
                                         ToolTipService.ToolTip="Refuse les bandeaux compatibles quand cela ne casse pas le site." />
                            </StackPanel>

                            <StackPanel x:Name="PrivacyGroupConnection" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Sécurité de connexion" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />

                            <!-- HTTPS enforcer -->
                            <TextBlock Text="HTTPS" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <ToggleSwitch x:Name="HttpsEnforcerSwitch"
                                         Header="Forcer HTTPS"
                                         Toggled="HttpsEnforcerSwitch_Toggled"
                                         ToolTipService.ToolTip="Tente HTTPS avant HTTP quand le site le permet." />

                            <!-- SmartScreen : seule protection de cette page qui envoie des donnees a un tiers (Microsoft), contrairement au reste qui bloque/anonymise localement -->
                            <TextBlock Text="SmartScreen" Style="{StaticResource NovaPanelSectionTitleStyle}" Margin="0,10,0,0" />
                            <ToggleSwitch x:Name="SmartScreenSwitch"
                                         Header="Activer SmartScreen (envoie les URL à Microsoft)"
                                         Toggled="SmartScreenSwitch_Toggled"
                                         ToolTipService.ToolTip="Protection Microsoft anti-phishing optionnelle. À la différence du reste de cette page (qui bloque ou anonymise en local), l'activer envoie les URL visitées à Microsoft. Désactivée par défaut." />
                            </StackPanel>

                            <StackPanel x:Name="PrivacyGroupHygiene" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Hygiène de session" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />

                            <!-- Anti-télémétrie -->
                            <TextBlock Text="Anti-télémétrie" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <ToggleSwitch x:Name="TelemetryBlockerSwitch"
                                         Header="Bloquer la télémétrie"
                                         Toggled="TelemetryBlockerSwitch_Toggled"
                                         ToolTipService.ToolTip="Bloque la mesure d'audience, le replay de session, les rapports de crash et les métriques produit des sites." />

                            <!-- Nettoyage URL -->
                            <TextBlock Text="Nettoyage des URL" Style="{StaticResource NovaPanelSectionTitleStyle}" Margin="0,10,0,0" />
                            <ToggleSwitch x:Name="ParameterCleanerSwitch"
                                         Header="Nettoyer les URL"
                                         Toggled="ParameterCleanerSwitch_Toggled"
                                         ToolTipService.ToolTip="Retire les paramètres de tracking avant navigation." />

                            <!-- Sessions éphémères -->
                            <TextBlock Text="Sessions éphémères" Style="{StaticResource NovaPanelSectionTitleStyle}" Margin="0,10,0,0" />
                            <ToggleSwitch x:Name="SessionPurgeSwitch"
                                         Header="Purger les sessions au démarrage"
                                         Toggled="SessionPurgeSwitch_Toggled"
                                         ToolTipService.ToolTip="Purge les sessions au démarrage, sauf pour les sites que vous gardez connectés." />
                            <HyperlinkButton Content="Gérer les sites connectés"
                                             Click="SessionsManageLink_Click"
                                             HorizontalAlignment="Left"
                                             Padding="0" />
                            </StackPanel>

                            <StackPanel x:Name="PrivacyGroupExceptions" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Exceptions" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Domaines ignorés par le bloqueur de publicités et de traceurs (onglet « Publicités et traceurs »)." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="PrivacyWhitelistBox"
                                         PlaceholderText="exemple.com"
                                         Width="220" />
                                <Button Content="Ajouter"
                                        Style="{StaticResource NovaButtonStyle}"
                                        Click="PrivacyWhitelistAddButton_Click"
                                        VerticalAlignment="Bottom" />
                            </StackPanel>
                            <StackPanel x:Name="PrivacyWhitelistPanel" Spacing="6" />
                            </StackPanel>

                        </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" Grid.Column="1"
                        Margin="0,0,18,18"
                        Style="{StaticResource NovaPanelShellCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SettingsPendingText"
                                   Text="Aucun changement en attente."
