                                    Opening="ConsentIndicatorFlyout_Opening"
                                    Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="10">
                                    <TextBlock Text="Cookies"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock x:Name="ConsentIndicatorText"
                                               Opacity="0.75"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- Popups retenues en attente d'un choix explicite (0.84.0.6) :
                         masqué tant qu'aucune popup n'est en attente sur l'onglet
                         courant, comme l'icône de popup bloqué de Chrome/Firefox/Edge. -->
                    <Button x:Name="PopupRecoveryButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Popups en attente"
                            ToolTipService.ToolTip="Popups en attente"
                            Visibility="Collapsed">
                        <Grid>
                            <SymbolIcon Style="{StaticResource NovaModuleSymbolIconStyle}" Symbol="Stop" />
                            <Border x:Name="PopupRecoveryBadge"
                                    Background="{StaticResource NovaAccentBrush}"
                                    CornerRadius="7" MinWidth="14" Height="14"
                                    Padding="3,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-6,-7,0">
                                <TextBlock x:Name="PopupRecoveryBadgeText"
                                           Text="1" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource NovaTextOnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="PopupRecoveryFlyout"
                                    Opening="PopupRecoveryFlyout_Opening"
                                    Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="320" Spacing="10">
                                    <TextBlock Text="Popups en attente"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock Text="Un vrai clic vers ce(s) site(s) a demandé une nouvelle fenêtre. Lumora ne peut pas deviner si c'est voulu (connexion, partage...) ou un détournement : à toi de choisir."
                                               Opacity="0.65"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                    <StackPanel x:Name="PopupRecoveryPanel" Spacing="6" />
                                    <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                    <Button x:Name="PopupRecoveryAlwaysAllowButton"
                                            Content="Toujours autoriser les popups de ce site"
                                            HorizontalAlignment="Stretch"
                                            Click="PopupRecoveryAlwaysAllowButton_Click" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- Diviser l'ecran (0.93.4.0) : point d'entree direct au split view,
                         qui n'existait auparavant que par clic droit sur un onglet
                         (menu contextuel/selection multiple, toujours conserves).
                         Glyphe change (0.93.18) : E8A9 (ViewAll) etait partage a
                         l'identique avec ModulesQuickAccessButton (bouton puzzle) ET
                         la tuile "Tous les modules" du Menu Demarrer (StartMenuTileRegistry.cs)
                         - ces deux-la gardent ViewAll (coherent avec le concept "modules"),
                         c'est ce bouton, sans rapport avec les modules, qui recoit une
                         icone propre. E89A (TwoPage) verifie sur la liste officielle
                         Microsoft Segoe MDL2 Assets avant utilisation. -->
                    <Button x:Name="SplitViewButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Diviser l'écran entre deux onglets"
                            ToolTipService.ToolTip="Diviser l'écran entre deux onglets"
                            Click="SplitViewButton_Click">
                        <FontIcon x:Name="SplitViewButtonIcon" Style="{StaticResource NovaModuleFontIconStyle}" Foreground="{StaticResource NovaTileFamilyToolsBrush}" Glyph="&#xE89A;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <!-- Acces direct, toujours visible (pas besoin de passer par le menu
                         Lumora) : un clic installe la page active comme application, sans
                         detour par le panneau Applications. Demande explicite le
                         2026-07-26 - "trop de manipulations pour faire une application". -->
                    <!-- Glyphe change (2026-08-12, retour utilisateur : "n'a aucun sens") :
                         E7B8 (Package, une boite abstraite) remplace par un pictogramme
                         dessine a la main (ecran + fleche vers le bas) - aucun glyphe Segoe
                         MDL2 verifie ne correspond a "installer une app" sans dupliquer un
                         glyphe deja pris (E896 Download = Telechargements, E8B5 Import =
                         Importer des favoris), voir MEMORY.md. Meme teinte "outils" que les
                         2 boutons voisins. -->
                    <Button x:Name="InstallWebAppQuickButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            ToolTipService.ToolTip="Installer cette page comme application"
                            AutomationProperties.Name="Installer cette page comme application"
                            Click="InstallAppMenu_Click">
                        <Grid Width="15" Height="15">
                            <Rectangle Width="14" Height="9" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{StaticResource NovaTileFamilyToolsBrush}" StrokeThickness="1.3"
                                       Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Top" />
                            <Path Stroke="{StaticResource NovaTileFamilyToolsBrush}" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5,14.3 L10,14.3" />
                            <Path Stroke="{StaticResource NovaTileFamilyToolsBrush}" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M7.5,2.3 L7.5,7 M5.7,4.8 L7.5,7 L9.3,4.8" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="14,0,14,8"
                CornerRadius="18"
                Background="{StaticResource NovaFloatingGlassBrush}"
                BorderBrush="{StaticResource NovaChromeStrokeSoftBrush}"
                BorderThickness="1"
                Translation="0,0,24">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
        <Grid x:Name="BookmarksBarRow"
              Padding="10,6,10,6"
              ColumnSpacing="8"
              SizeChanged="BookmarksBarRow_SizeChanged"
              RightTapped="WorkspaceLayoutSurface_RightTapped"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0"
                     Grid.ColumnSpan="2"
                     Width="180"
                     Height="54"
                     Margin="-18,-10,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Fill="{StaticResource NovaChromeHaloWarmGlowBrush}"
                     IsHitTestVisible="False" />
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="5"
                        Margin="2,0,10,0"
                        VerticalAlignment="Center"
                        Opacity="0.6">
                <TextBlock Text="✦" FontSize="10" Foreground="{StaticResource NovaAccentBrush}" />
                <TextBlock Text="Constellation" FontSize="10.5" Foreground="{StaticResource NovaTextMutedBrush}" />
            </StackPanel>
            <StackPanel x:Name="BookmarksBarPanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center" />
            <Border Grid.Column="2"
                    Width="1"
                    Height="18"
                    Margin="5,0"
                    Background="{StaticResource NovaChromeStrokeBrush}" />
            <StackPanel x:Name="OtherBookmarksBarHost"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center" />
        </Grid>
        </Border>

        <Grid x:Name="ContentHost" Grid.Row="4" Background="{StaticResource NovaAppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="WorkspaceBottomBookmarksRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorkspaceLeftBookmarksColumn" Width="0" />
                <ColumnDefinition x:Name="WorkspaceLeftTabsColumn" Width="0" />
                <ColumnDefinition x:Name="WorkspaceLeftTabsResizeColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="WorkspaceRightTabsResizeColumn" Width="0" />
                <ColumnDefinition x:Name="WorkspaceRightTabsColumn" Width="0" />
                <ColumnDefinition x:Name="WorkspaceRightBookmarksColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="BookmarksSideRail"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Width="220"
                    Margin="8,8,8,8"
                    Padding="12,12,10,12"
                    CornerRadius="24"
                    BorderThickness="1"
                    BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                    Background="{StaticResource NovaChromeGradientBrush}"
                    RightTapped="WorkspaceLayoutSurface_RightTapped"
                    Visibility="Collapsed">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse Fill="{StaticResource NovaIdentityMarkBrush}" />
                            <Ellipse Width="4"
                                     Height="4"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource NovaChromeSurfaceBrush}"
                                     Opacity="0.38" />
                        </Grid>
                        <TextBlock Text="Favoris"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NovaPrimaryTextBrush}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  SizeChanged="BookmarksLayoutHost_SizeChanged">
                        <StackPanel x:Name="BookmarksSideBarPanel" Spacing="4" />
                    </ScrollViewer>
                    <StackPanel x:Name="OtherBookmarksSideHost"
                                Grid.Row="2"
                                Spacing="6" />
                </Grid>
            </Border>

            <Border
                x:Name="VerticalTabsRail"
                Grid.RowSpan="2"
                Grid.Column="1"
                Width="210"
                Margin="8,8,8,8"
                Padding="10"
                CornerRadius="24"
                BorderThickness="1"
                BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                Background="{StaticResource NovaChromeGradientBrush}"
                Visibility="Collapsed"
                Canvas.ZIndex="45"
                VerticalAlignment="Stretch"
                RightTapped="WorkspaceLayoutSurface_RightTapped"
                PointerEntered="VerticalTabsRail_PointerEntered"
                PointerExited="VerticalTabsRail_PointerExited">
                <StackPanel Spacing="8">
                    <!-- Rangee d'actions, presentation elargie (une ligne : nouvel
                         onglet qui s'etire, muet, reduire). VerticalTabsNewTabButton,
                         VerticalTabsMuteAllButton et VerticalTabsCompactButton sont
                         deplaces d'ici vers VerticalTabsCompactActionsColumn en mode
                         reduit par ApplyVerticalTabsActionsLayout - voir
                         MainWindow.Settings.cs. -->
                    <StackPanel x:Name="VerticalTabsActionsPanel" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="VerticalTabsNewTabButton"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Nouvel onglet"
                                AutomationProperties.Name="Nouvel onglet"
                                Click="NewTabMenu_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Add" />
                                <TextBlock x:Name="VerticalTabsNewTabLabel" Text="Nouvel onglet" />
                            </StackPanel>
                        </Button>
                        <!-- Coupe-son global (2026-08-12, comparaison utilisateur avec le
                             rail d'onglets verticaux d'Edge) : bascule IsMuted sur TOUS les
                             onglets d'un coup, aucun coupe-son par onglet n'existait avant.
                             En reduit (round 3), plus de bouton dedie : accessible via le
                             clic droit du rail (WorkspaceLayoutSurface_RightTapped). -->
                        <Button
                            x:Name="VerticalTabsMuteAllButton"
                            Width="34"
                            AutomationProperties.Name="Couper le son de tous les onglets"
                            ToolTipService.ToolTip="Couper/rétablir le son de tous les onglets"
                            Click="VerticalTabsMuteAllButton_Click">
                            <FontIcon x:Name="VerticalTabsMuteAllIcon" Glyph="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        </Button>
                        <Button
                            x:Name="VerticalTabsCompactButton"
                            Width="34"
                            AutomationProperties.Name="Reduire ou agrandir les onglets verticaux"
                            ToolTipService.ToolTip="Reduire/agrandir les onglets verticaux"
                            Click="VerticalTabsCompactButton_Click">
                            <SymbolIcon Symbol="Pin" />
                        </Button>
                    </StackPanel>
                    <!-- Rangee d'actions, presentation reduite (round 3, 2026-08-12) :
                         seules les 2 actions les plus frequentes (agrandir, nouvel
                         onglet) restent visibles, empilees en colonne simple - la
                         grille 2x2 des 4 actions (round 2) restait encore trop large
                         pour un usage a ~15 onglets/session (retour utilisateur,
                         capture d'ecran d'un rail Edge reduit a l'appui). Muet global
                         et recherche rejoignent le clic droit du rail
                         (WorkspaceLayoutSurface_RightTapped, voir
                         MainWindow.LayoutStudio.cs) plutot que de couter de la largeur
                         en permanence pour un geste occasionnel. -->
                    <StackPanel x:Name="VerticalTabsCompactActionsColumn"
                                Visibility="Collapsed"
                                Spacing="5" />
                    <!-- Recherche d'onglet (2026-08-12, meme comparaison) : filtre en
                         direct VerticalTabsPanelItems, meme principe que
                         StartMenuSearchBox_TextChanged (filtre sur place, pas de
                         panneau separe). Masque en presentation reduite : illisible a
                         40px de large ; accessible via "Rechercher un onglet..." dans
                         le clic droit du rail en reduit (round 3). -->
                    <TextBox x:Name="VerticalTabsSearchBox"
                             PlaceholderText="Rechercher un onglet..."
                             TextChanged="VerticalTabsSearchBox_TextChanged"
                             AutomationProperties.Name="Rechercher un onglet ouvert" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="VerticalTabsPanelItems" Spacing="4" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Thumb
                x:Name="VerticalTabsResizeThumb"
                Grid.RowSpan="2"
                Grid.Column="2"
                Width="12"
                DragDelta="VerticalTabsResizeThumb_DragDelta"
                DragCompleted="VerticalTabsResizeThumb_DragCompleted"
                Visibility="Collapsed">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbRoot"
                                Background="Transparent"
                                ToolTipService.ToolTip="Faire glisser pour redimensionner">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ThumbLine.Opacity" Value="1" />
                                            <Setter Target="ThumbRoot.Background" Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ThumbLine.Opacity" Value="1" />
                                            <Setter Target="ThumbRoot.Background" Value="{ThemeResource SystemControlHighlightBaseLowBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="ThumbLine"
                                    Width="3" Height="48" CornerRadius="2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Opacity="0.45" />
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Grid x:Name="BrowserPanel" Grid.Row="0" Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- InfoBar affichée une seule fois, la première fois qu'une purge de
                     sessions a réellement lieu, pour expliquer le comportement. -->
                <InfoBar x:Name="SessionPurgeInfoBar" Grid.Row="0" Severity="Informational"
                         Margin="10,8,10,0"
                         IsOpen="False" Title="Sessions de la visite précédente nettoyées"
                         Message="Les sites que vous n'avez pas marqués comme sites de confiance repartent à zéro à chaque démarrage de Lumora."
                         Closed="SessionPurgeInfoBar_Closed">
                    <InfoBar.ActionButton>
                        <Button Content="Gérer les sites connectés" Click="SessionsManageLink_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Barre de proposition d'enregistrement d'identifiants -->
                <Border x:Name="CredentialSaveBar" Grid.Row="1" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0" Symbol="Permissions" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CredentialSaveText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="CredentialSaveAccept" Grid.Column="2" Content="Enregistrer" Click="CredentialSaveAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="CredentialSaveDismiss" Grid.Column="3" Content="Ignorer" Click="CredentialSaveDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Barre de proposition de remplissage automatique -->
                <Border x:Name="AutoFillBar" Grid.Row="2" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0" Symbol="Contact" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AutoFillText" Grid.Column="1" VerticalAlignment="Center"/>
                        <Button x:Name="AutoFillAccept" Grid.Column="2" Content="Remplir" Click="AutoFillAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <!-- Visible uniquement quand plusieurs comptes existent pour ce site (ex. 2 comptes Google) -->
                        <Button x:Name="AutoFillChooseButton" Grid.Column="2" Content="Choisir un compte" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12">
                            <Button.Flyout>
                                <MenuFlyout x:Name="AutoFillAccountsFlyout" Placement="Bottom"/>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="AutoFillDismiss" Grid.Column="3" Content="Ignorer" Click="AutoFillDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Barre de proposition de remplissage d'une carte du portefeuille.
                     Remplissage UNIQUEMENT sur clic : jamais de pré-remplissage silencieux
                     (un script de page ne doit pas pouvoir aspirer la carte). -->
                <Border x:Name="WalletFillBar" Grid.Row="3" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WalletFillText" Grid.Column="1" VerticalAlignment="Center" Text="Page de paiement détectée — remplir avec une carte du portefeuille ?"/>
                        <Button x:Name="WalletFillAccept" Grid.Column="2" Content="Remplir" Click="WalletFillAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="WalletFillDismiss" Grid.Column="3" Content="Ignorer" Click="WalletFillDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Barre proposée après un login détecté, quand les sessions éphémères
                     sont actives et que le site n'est pas déjà connu (confiance ou refus). -->
                <Border x:Name="SessionKeepBar" Grid.Row="4" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0" Symbol="Keyboard" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SessionKeepText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="SessionKeepAccept" Grid.Column="2" Content="Conserver la session" Click="SessionKeepAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SessionKeepDismiss" Grid.Column="3" Content="Non merci" Click="SessionKeepDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Barre de suggestion de mot de passe fort, sur detection d'un champ
                     "nouveau mot de passe" (inscription, changement de mot de passe). -->
                <Border x:Name="SuggestPasswordBar" Grid.Row="5" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0" Symbol="Permissions" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Utiliser un mot de passe fort généré ?" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SuggestPasswordValueText" FontFamily="Consolas" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="SuggestPasswordAccept" Grid.Column="2" Content="Utiliser" Click="SuggestPasswordAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SuggestPasswordRegenerate" Grid.Column="3" Content="Régénérer" Click="SuggestPasswordRegenerate_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                        <Button x:Name="SuggestPasswordDismiss" Grid.Column="4" Content="Ignorer" Click="SuggestPasswordDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Bandeau de proposition de traduction locale de la page (modele
                     telecharge une fois puis mis en cache, traduction 100% hors ligne
                     ensuite). Jamais automatique : uniquement sur clic explicite. -->
                <Border x:Name="TranslateBar" Grid.Row="6" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xF2B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TranslateText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Cette page semble être en anglais. La traduire en français ?"/>
                        <Button x:Name="TranslateAccept" Grid.Column="2" Content="Traduire" Click="TranslateAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="TranslateDismiss" Grid.Column="3" Content="Non merci" Click="TranslateDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Garde-fou : quand on ferme ou dissout un groupe non enregistre,
                     propose de le ranger dans la bibliotheque avant qu'il disparaisse. -->
                <Border x:Name="SaveGroupBar" Grid.Row="7" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SaveGroupText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="SaveGroupAccept" Grid.Column="2" Content="Garder ce groupe" Click="SaveGroupAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SaveGroupDismiss" Grid.Column="3" Content="Non" Click="SaveGroupDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Reprise « site introuvable » : le domaine ne se resout plus (site
                     ferme, nom de domaine change, faute de frappe). Suggestion calculee
                     100% localement ; la recherche web ne part QUE sur clic explicite,
                     vers le moteur de recherche configure. -->
                <Border x:Name="SiteNotFoundBar" Grid.Row="8" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SiteNotFoundText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="SiteNotFoundTrySuggestion" Grid.Column="2" Visibility="Collapsed" Click="SiteNotFoundTrySuggestion_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                        <Button x:Name="SiteNotFoundSearch" Grid.Column="3" Content="Rechercher ce site sur le web" Click="SiteNotFoundSearch_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SiteNotFoundDismiss" Grid.Column="4" Content="Fermer" Click="SiteNotFoundDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Site demenage : une redirection permanente (301/308) vers un autre
                     domaine a ete observee et des favoris/raccourcis pointent encore
                     vers l'ancien. Proposition unique par demenagement ; apprentissage
                     100% local (SiteRelocationStore), rien n'est envoye nulle part. -->
                <Border x:Name="SiteMovedBar" Grid.Row="9" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SiteMovedText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="SiteMovedUpdate" Grid.Column="2" Content="Mettre a jour" Click="SiteMovedUpdate_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SiteMovedDismiss" Grid.Column="3" Content="Non merci" Click="SiteMovedDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- 0.78.3.1 : les navigations publicitaires/parasites sont
                     bloquees silencieusement (statut + bouclier), plus de barre
                     « Continuer quand meme ». Une adresse tapee dans la barre
                     n'est jamais bloquee ; la whitelist par site reste la
                     soupape durable. -->
                <Grid x:Name="BrowserHost" Grid.Row="11" />
            </Grid>

            <Grid x:Name="BookmarksPanel" Grid.Column="3" Padding="16" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Favoris Lumora" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Dossiers" Opacity="0.68" />
                    </StackPanel>
                    <ListView
                        x:Name="BookmarkFoldersList"
                        Grid.Row="1"
                        RightTapped="BookmarkFoldersList_RightTapped"
                        SelectionChanged="BookmarkFoldersList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="16" Height="16" Source="{Binding IconImageUri}" Visibility="{Binding IconImageVisibility}" />
                                    <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Visibility="{Binding IconGlyphVisibility}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Opacity="0.62" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid Grid.Column="2" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock x:Name="CurrentBookmarkFolderTitle" Text="Barre des favoris" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="BookmarkBreadcrumbText" Opacity="0.68" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- Barre d'actions reorganisee par frequence d'usage (2026-08-10,
                             "choses a revoir" - retour utilisateur : garder les 7 actions
                             d'origine, juste mieux rangees qu'une seule rangee plate de
                             boutons texte). Icones ajoutees pour un reperage plus rapide,
                             "Vider" isole avec une marge de groupe et une teinte danger
                             (NovaDangerBrush, meme convention semantique que la pastille
                             de robustesse du Coffre juste a cote dans cette meme session)
                             car c'est la seule action irreversible sur TOUS les favoris. -->
                        <Button Grid.Column="1" Click="NewBookmarkFolderButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="NewFolder" />
                                <TextBlock Text="Nouveau dossier" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Click="RenameBookmarkButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Rename" />
                                <TextBlock Text="Renommer" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Margin="12,0,0,0" Click="SelectAllBookmarksButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="SelectAll" />
                                <TextBlock Text="Tout sélectionner" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Click="DeleteBookmarkButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="Supprimer sélection" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="5" Margin="12,0,0,0"
                                Foreground="{StaticResource NovaDangerBrush}"
                                ToolTipService.ToolTip="Supprime TOUS les favoris, pas seulement ce dossier"
                                Click="ClearBookmarksButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Delete" />
                                <TextBlock Text="Vider" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="6" Margin="12,0,0,0" Click="ImportMenu_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Import" />
                                <TextBlock Text="Importer" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="7" Click="ExportHtmlButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <SymbolIcon Symbol="Save" />
                                <TextBlock Text="Exporter" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBox
                        x:Name="BookmarksSearchBox"
                        Grid.Row="1"
                        TextChanged="BookmarksSearchBox_TextChanged"
                        PlaceholderText="Rechercher dans les favoris..." />

                    <!-- Grille de vignettes plutot que liste de lignes de texte
                         (2026-08-10, "choses a revoir" - retour utilisateur : les
                         favoris sont consultes en vitesse et reconnus par leur icone,
                         pas lus comme du texte ; comparaison faite par l'utilisateur
                         avec le gestionnaire Chrome, juge "tres moche"). ItemsWrapGrid
                         en ItemsPanel plutot qu'un changement de type de controle
                         (ListView -> GridView) : conserve a l'identique tout le
                         code-behind existant (SelectAll/SelectedItems/
                         ShowBookmarkListContextMenu(ListView...)) qui dependait
                         specifiquement du type ListView. -->
                    <ListView
                        x:Name="BookmarksList"
                        Grid.Row="2"
                        SelectionMode="Extended"
                        DoubleTapped="BookmarksList_DoubleTapped"
                        RightTapped="BookmarksList_RightTapped"
                        SelectionChanged="BookmarksList_SelectionChanged"
                        KeyDown="BookmarksList_KeyDown">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="148" ItemHeight="116" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Width="136" Height="104" Padding="12" CornerRadius="10"
                                        Background="{StaticResource NovaChromeButtonBackgroundBrush}"
                                        BorderBrush="{StaticResource NovaChromeButtonBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="30" Height="30" HorizontalAlignment="Center">
                                            <Image Width="26" Height="26" Source="{Binding IconImageUri}" Visibility="{Binding IconImageVisibility}" />
                                            <FontIcon Glyph="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="22" Visibility="{Binding IconGlyphVisibility}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                   HorizontalAlignment="Stretch" MaxLines="1" />
                                        <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                   HorizontalAlignment="Stretch" MaxLines="1" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <Grid x:Name="ImportPanel" Grid.Column="3" Padding="28" Visibility="Collapsed">
                <StackPanel Spacing="14" MaxWidth="820">
                    <TextBlock Text="Importer et exporter" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.78"
                               Text="Lumora lit les profils Chromium détectés sur cette machine et peut aussi importer/exporter un fichier HTML de favoris. Les données restent dans le profil local Lumora." />
                    <TextBlock Text="Depuis un navigateur installé" FontWeight="SemiBold" />
                    <TextBlock x:Name="ImportSourcesStatusText" TextWrapping="Wrap" Opacity="0.72" />
                    <ListView x:Name="ImportSourcesList" MaxHeight="260" SelectionChanged="ImportSourcesList_SelectionChanged" />
                    <TextBlock x:Name="ImportComparisonText" TextWrapping="Wrap" Opacity="0.72" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Fusionner le navigateur sélectionné" Click="ImportBrowserButton_Click" />
                        <Button Content="Remplacer par le navigateur sélectionné" Click="ReplaceBrowserButton_Click" />
                    </StackPanel>
                    <TextBlock Text="Fichier HTML" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Importer un fichier HTML" Click="ImportHtmlButton_Click" />
                        <Button Content="Exporter en HTML" Click="ExportHtmlButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- SettingsPanel : centre de pilotage Lumora -->
            <Grid x:Name="SettingsPanel" Grid.Column="3" Visibility="Collapsed"
                  Background="{StaticResource NovaPanelBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Navigation du centre Lumora -->
                <Border Grid.RowSpan="2"
                        Grid.Column="0"
                        Margin="18,18,12,18"
                        Style="{StaticResource NovaPanelShellCardStyle}">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource NovaFlyoutHeroCardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Centre Lumora" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Le coeur du navigateur : ambiance, organisation, confort et données locales."
                                           Style="{StaticResource NovaPanelDescriptionStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NovaPanelCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Navigation rapide" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                <!-- Icones ajoutees le 2026-08-10 (chantier identite visuelle,
                                     demande explicite utilisateur : nav du panneau Reglages en
                                     texte seul jusqu'ici). Couleur par famille de sens, meme
                                     principe qu'au Menu Demarrer, mappee par groupe de section
                                     plutot que par entree individuelle : Navigation rapide =
                                     neutre (vue d'ensemble = systeme), Espace personnel = ambre
                                     (ce qui est a vous), Travail quotidien = cyan (outils),
                                     Donnees locales = rose (protection). -->
                                <RadioButton x:Name="SettingsNavOverview"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav" IsChecked="True"
                                             AutomationProperties.Name="Vue d'ensemble"
                                             Click="SettingsNav_Click" Tag="overview">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                  Foreground="{StaticResource NovaChromeButtonForegroundBrush}" />
                                        <TextBlock Text="Vue d'ensemble" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NovaPanelCardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Espace personnel" Opacity="0.6" FontSize="11" />
                                <RadioButton x:Name="SettingsNavAppearance"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             AutomationProperties.Name="Mon Lumora"
                                             Click="SettingsNav_Click" Tag="appearance">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                  Foreground="{StaticResource NovaTileFamilyContentBrush}" />
                                        <TextBlock Text="Mon Lumora" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SettingsNavProfile"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             AutomationProperties.Name="Profils locaux"
                                             Click="SettingsNav_Click" Tag="profile">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                  Foreground="{StaticResource NovaTileFamilyContentBrush}" />
                                        <TextBlock Text="Profils locaux" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SettingsNavAccessibility"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             AutomationProperties.Name="Accessibilité"
                                             Click="SettingsNav_Click" Tag="accessibility">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                  Foreground="{StaticResource NovaTileFamilyContentBrush}" />
                                        <TextBlock Text="Accessibilité" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NovaPanelCardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Travail quotidien" Opacity="0.6" FontSize="11" />
                                <RadioButton x:Name="SettingsNavNavigation"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             AutomationProperties.Name="Espace de travail"
                                             Click="SettingsNav_Click" Tag="navigation">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                  Foreground="{StaticResource NovaTileFamilyToolsBrush}" />
                                        <TextBlock Text="Espace de travail" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SettingsNavStartup"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             AutomationProperties.Name="Ouverture"
                                             Click="SettingsNav_Click" Tag="startup">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                  Foreground="{StaticResource NovaTileFamilyToolsBrush}" />
                                        <TextBlock Text="Ouverture" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NovaPanelCardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Données locales" Opacity="0.6" FontSize="11" />
                                <RadioButton x:Name="SettingsNavPrivacy"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             AutomationProperties.Name="Confidentialité"
                                             Click="SettingsNav_Click" Tag="privacy">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                  Foreground="{StaticResource NovaTileFamilyProtectionBrush}" />
                                        <TextBlock Text="Confidentialité" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SettingsNavVault"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             AutomationProperties.Name="Coffre et données"
                                             Click="SettingsNav_Click" Tag="vault">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                  Foreground="{StaticResource NovaTileFamilyProtectionBrush}" />
                                        <TextBlock Text="Coffre et données" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SettingsNavStorage"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             AutomationProperties.Name="Stockage local"
                                             Click="SettingsNav_Click" Tag="storage">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                  Foreground="{StaticResource NovaTileFamilyProtectionBrush}" />
                                        <TextBlock Text="Stockage local" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Zone de contenu des paramètres -->
                <ScrollViewer x:Name="SettingsContentScrollViewer"
                              Grid.Row="0" Grid.Column="1"
                              VerticalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="28,22,28,18" Margin="0,0,18,0">
                    <StackPanel Spacing="18" MaxWidth="760">
                        <Border Style="{StaticResource NovaFlyoutHeroCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Façonnez un navigateur qui vous ressemble"
                                           Style="{StaticResource NovaPanelPageTitleStyle}" />
                                <TextBlock Text="Lumora garde une base claire : lumière, relief et lisibilité. Ensuite, vous choisissez votre rythme, vos panneaux et votre confort sans vous perdre dans des sous-menus."
                                           Style="{StaticResource NovaPanelDescriptionStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Mon Lumora"
                                            Tag="appearance"
                                            Click="SettingsNavigateButton_Click"
                                            Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    <Button Content="Espace de travail"
                                            Tag="navigation"
                                            Click="SettingsNavigateButton_Click"
                                            Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    <Button Content="Vie privee"
                                            Tag="privacy"
                                            Click="SettingsNavigateButton_Click"
                                            Style="{StaticResource NovaPanelActionButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section : Vue d'ensemble -->
                        <StackPanel x:Name="SettingsSectionOverview" Spacing="14">
                            <TextBlock Text="Centre Lumora" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="Un point d'entrée pour façonner votre navigateur : ambiance, organisation, confidentialité locale et données du profil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource NovaPanelShellCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Mon Lumora" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Avatar, thème, accueil, rythme visuel et confort de l'interface." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <Button Content="Personnaliser" Tag="appearance" Click="SettingsNavigateButton_Click" Style="{StaticResource NovaPanelActionButtonStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource NovaPanelShellCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Espace de travail" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Recherche, onglets, barre verticale, commandes rapides et outils de productivité." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <Button Content="Organiser" Tag="navigation" Click="SettingsNavigateButton_Click" Style="{StaticResource NovaPanelActionButtonStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource NovaPanelShellCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Confidentialité" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Protections actives, sessions, cookies, listes de filtrage et exceptions." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <Button Content="Protéger" Tag="privacy" Click="SettingsNavigateButton_Click" Style="{StaticResource NovaPanelActionButtonStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource NovaPanelShellCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Coffre et données" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Mots de passe, portefeuille, sauvegardes et stockage local du profil." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <Button Content="Gerer" Tag="vault" Click="SettingsNavigateButton_Click" Style="{StaticResource NovaPanelActionButtonStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource NovaPanelShellCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Profils locaux" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Identité, verrouillage, PIN, récupération et profils sur cet ordinateur." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <Button Content="Ouvrir" Tag="profile" Click="SettingsNavigateButton_Click" Style="{StaticResource NovaPanelActionButtonStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource NovaPanelShellCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Accessibilité" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Lisibilité, focus clavier, réduction des animations, voix et lecture à haute voix." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <Button Content="Adapter" Tag="accessibility" Click="SettingsNavigateButton_Click" Style="{StaticResource NovaPanelActionButtonStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="Lumora garde ces choix dans votre profil local. Aucun tableau de bord distant, aucune synchronisation forcée."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                        </StackPanel>

                        <!-- Section : Espace de travail -->
                        <StackPanel x:Name="SettingsSectionNavigation" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Espace de travail" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="Organisez les repères qui vous servent tous les jours : recherche, onglets, commandes rapides et modules utiles."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <TextBlock Text="Recherche" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <ComboBox x:Name="SearchEngineCombo" Header="Moteur de recherche" Width="280"
                                      SelectionChanged="SearchEngineCombo_SelectionChanged">
                                <ComboBoxItem Content="Google" Tag="google" />
                                <ComboBoxItem Content="DuckDuckGo" Tag="duckduckgo" />
                                <ComboBoxItem Content="Brave Search" Tag="brave" />
                                <ComboBoxItem Content="Bing" Tag="bing" />
                            </ComboBox>
                            <ToggleSwitch x:Name="AddressSuggestionsSwitch" Header="Suggestions dans la barre d'adresse" Toggled="AddressSuggestionsSwitch_Toggled" />
                            <TextBlock Text="Pendant la frappe, propose vos onglets ouverts, favoris et pages déjà visitées. Calcul 100% local sur cet appareil : ce que vous tapez n'est jamais envoyé à un service de suggestions."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="TranslationEnabledSwitch" Header="Proposer de traduire les pages" Toggled="TranslationEnabledSwitch_Toggled" />
                            <TextBlock Text="Traduction neuronale locale (actuellement anglais vers français). Le modèle est téléchargé une seule fois puis la traduction se fait entièrement hors ligne, jamais de texte envoyé à un serveur."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="SearchAssistEnabledSwitch" Header="Assistant IA pour preciser mes recherches" Toggled="SearchAssistEnabledSwitch_Toggled" />
                            <TextBlock Text="Désactivé par défaut : nécessite un téléchargement unique d'environ 2,7 Go (modèle de langage local Phi-3-mini). Une fois téléchargée, la reformulation se fait hors ligne ; seule la requête finale que vous validez est envoyée à votre moteur de recherche, exactement comme aujourd'hui."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="HistorySemanticSearchEnabledSwitch" Header="Recherche intelligente dans l'historique" Toggled="HistorySemanticSearchEnabledSwitch_Toggled" />
                            <TextBlock Text="Retrouvez une page par son sens plutôt que par mot-clé exact (« cet article sur la fiscalité des indépendants »), même sans vous souvenir du titre ou du site. Désactivé par défaut : nécessite un téléchargement unique d'environ 120 Mo (modèle d'embedding local multilingual-e5-small). Une fois activé, le contenu texte des pages visitées est analysé et indexé localement (chiffré comme le reste de l'historique) ; rien n'est jamais envoyé à un serveur."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Onglets" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <ToggleSwitch x:Name="VerticalTabsSwitch" Header="Barre d'onglets verticale" Toggled="VerticalTabsSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Palette de commande" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Raccourci Ctrl+K" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="Ctrl+K ouvre une recherche rapide dans les onglets, favoris, historique et commandes de Lumora. Par defaut, le raccourci respecte les champs de saisie et les formulaires web."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Ouvrir Ctrl+K"
                                                Style="{StaticResource NovaCompactButtonStyle}"
                                                Click="SettingsOpenCommandPaletteButton_Click" />
                                        <Button Content="Ouverture"
                                                Style="{StaticResource NovaCompactButtonStyle}"
                                                Click="SettingsStartupShortcutButton_Click" />
                                        <Button Content="Accessibilité"
                                                Style="{StaticResource NovaCompactButtonStyle}"
                                                Click="SettingsAccessibilityShortcutButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ToggleSwitch x:Name="CommandPaletteEnabledSwitch"
                                          Header="Palette de commande Ctrl+K"
                                          Toggled="CommandPaletteEnabledSwitch_Toggled" />
                            <ToggleSwitch x:Name="CommandPaletteWebPagesSwitch"
                                          Header="Autoriser Ctrl+K depuis les pages web"
                                          Toggled="CommandPaletteContextSwitch_Toggled" />
                            <ToggleSwitch x:Name="CommandPaletteTextFieldsSwitch"
                                          Header="Autoriser Ctrl+K pendant la saisie dans un champ"
                                          Toggled="CommandPaletteContextSwitch_Toggled" />
                            <TextBlock Text="Activez ces deux autorisations uniquement si vous voulez que Lumora intercepte Ctrl+K même quand une page ou un champ de texte a le focus."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                        </StackPanel>

                        <!-- Section : Personnalisation -->
                        <StackPanel x:Name="SettingsSectionAppearance" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Mon Lumora" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="Choisissez l'ambiance, le rythme et les repères visuels qui rendent Lumora confortable pour vous."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <TextBlock x:Name="AppearancePendingText"
                                       Text="Les positions des onglets/favoris s'appliquent tout de suite. Les autres changements visuels de cette section restent regroupés sous le bouton global en bas."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <ScrollViewer HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <RadioButton x:Name="AppearanceSubNavIdentity" Content="Identité" Tag="identity"
                                             GroupName="AppearanceSubNav" IsChecked="True"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="AppearanceSubNav_Click" />
                                <RadioButton x:Name="AppearanceSubNavTheme" Content="Thème et couleurs" Tag="theme"
                                             GroupName="AppearanceSubNav"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="AppearanceSubNav_Click" />
                                <RadioButton x:Name="AppearanceSubNavLayout" Content="Disposition" Tag="layout"
                                             GroupName="AppearanceSubNav"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="AppearanceSubNav_Click" />
                                <RadioButton x:Name="AppearanceSubNavNewTab" Content="Nouvel onglet" Tag="newtab"
                                             GroupName="AppearanceSubNav"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="AppearanceSubNav_Click" />
                                <RadioButton x:Name="AppearanceSubNavDiscovery" Content="Découverte" Tag="discovery"
                                             GroupName="AppearanceSubNav"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="AppearanceSubNav_Click" />
                            </StackPanel>
                            </ScrollViewer>
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,0,0,4" />

                            <StackPanel x:Name="AppearanceGroupIdentity" Spacing="12">
                            <TextBlock Text="Identité" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="64" Height="64" VerticalAlignment="Top">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="ProfileAvatarBrush" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Avatar Lumora" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Image locale visible dans le bandeau bas du navigateur. Elle reste dans ce profil et n'est jamais synchronisée."
                                                   Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Choisir une image"
                                                    Click="ChangeAvatarButton_Click"
                                                    Style="{StaticResource NovaCompactButtonStyle}" />
                                            <Button x:Name="RemoveAvatarButton"
                                                    Content="Supprimer"
                                                    Click="RemoveAvatarButton_Click"
                                                    Style="{StaticResource NovaCompactButtonStyle}"
                                                    Visibility="Collapsed" />
                                        </StackPanel>
                                        <TextBlock x:Name="AvatarPendingText"
                                                   Style="{StaticResource NovaPanelDescriptionStyle}"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="64" Height="64" CornerRadius="8" VerticalAlignment="Top">
                                        <Border.Background>
                                            <ImageBrush x:Name="WallpaperPreviewBrush" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Fond d'écran (page Nouvel onglet)" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Image locale affichée derrière la page Nouvel onglet uniquement - jamais sur la barre d'outils ni les onglets, pour ne jamais gêner la lecture des boutons. Reste dans ce profil, jamais synchronisée."
                                                   Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Choisir une image"
                                                    Click="ChangeWallpaperButton_Click"
                                                    Style="{StaticResource NovaCompactButtonStyle}" />
                                            <Button x:Name="RemoveWallpaperButton"
                                                    Content="Supprimer"
                                                    Click="RemoveWallpaperButton_Click"
                                                    Style="{StaticResource NovaCompactButtonStyle}"
                                                    Visibility="Collapsed" />
                                        </StackPanel>
                                        <TextBlock x:Name="WallpaperPendingText"
                                                   Style="{StaticResource NovaPanelDescriptionStyle}"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </StackPanel>

                            <StackPanel x:Name="AppearanceGroupTheme" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Thème et couleurs" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />
                            <ComboBox x:Name="ThemeModeCombo" Header="Thème" Width="220"
                                      SelectionChanged="ThemeModeCombo_SelectionChanged">
                                <ComboBoxItem Content="Sombre" Tag="dark" />
                                <ComboBoxItem Content="Clair" Tag="light" />
                                <ComboBoxItem Content="Système" Tag="system" />
                            </ComboBox>
                            <ComboBox x:Name="AccentPaletteCombo" Header="Palette Lumora" Width="260"
                                      SelectionChanged="AppearanceOption_Changed">
                                <ComboBoxItem Content="Lumora cyan" Tag="lumora" />
                                <ComboBoxItem Content="Ocean" Tag="ocean" />
                                <ComboBoxItem Content="Forêt" Tag="forest" />
                                <ComboBoxItem Content="Ambre" Tag="ember" />
                            </ComboBox>
                            <TextBlock Text="Personnalité Lumora" Style="{StaticResource NovaPanelSectionTitleStyle}" Margin="0,10,0,0" />
                            <ComboBox x:Name="UsageModeCombo" Header="Mode d'usage" Width="280"
                                      SelectionChanged="AppearanceOption_Changed">
                                <ComboBoxItem Content="Neutre" Tag="neutral" />
                                <ComboBoxItem Content="Équilibre" Tag="balanced" />
                                <ComboBoxItem Content="Focus" Tag="focus" />
                                <ComboBoxItem Content="Lecture" Tag="reading" />
                                <ComboBoxItem Content="Création" Tag="creative" />
                                <ComboBoxItem Content="Recherche" Tag="research" />
                                <ComboBoxItem Content="Nuit" Tag="night" />
                            </ComboBox>
                            <TextBlock Text="Le mode d'usage adapte l'accueil Lumora et prépare la logique des futurs espaces de travail."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <TextBlock Text="Couleur du mode d'usage" Style="{StaticResource NovaPanelSectionTitleStyle}" Margin="0,10,0,0" />
                            <TextBlock Text="Chaque mode garde sa propre teinte Lumora par défaut ; choisissez une couleur pour la remplacer sur ce mode uniquement (le second ton du dégradé est dérivé automatiquement). Réinitialiser revient à la teinte Lumora d'origine. Sans effet si le contraste élevé (Accessibilité) est actif."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Button x:Name="ModeColorSwatchNeutralButton"
                                            Tag="neutral"
                                            Style="{StaticResource NovaModeColorSwatchButtonStyle}"
                                            ToolTipService.ToolTip="Couleur du mode Neutre"
                                            AutomationProperties.Name="Couleur du mode Neutre">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="10">
                                                    <ColorPicker x:Name="ModeColorPickerNeutral" Tag="neutral"
                                                                 IsAlphaEnabled="False" ColorSpectrumShape="Ring"
                                                                 ColorChanged="ModeColorPicker_ColorChanged" />
                                                    <Button Content="Réinitialiser" Tag="neutral" Click="ModeColorResetButton_Click"
                                                            Style="{StaticResource NovaCompactButtonStyle}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock Text="Neutre" FontSize="11" Opacity="0.72" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Button x:Name="ModeColorSwatchFocusButton"
                                            Tag="focus"
                                            Style="{StaticResource NovaModeColorSwatchButtonStyle}"
                                            ToolTipService.ToolTip="Couleur du mode Focus"
                                            AutomationProperties.Name="Couleur du mode Focus">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="10">
                                                    <ColorPicker x:Name="ModeColorPickerFocus" Tag="focus"
                                                                 IsAlphaEnabled="False" ColorSpectrumShape="Ring"
                                                                 ColorChanged="ModeColorPicker_ColorChanged" />
                                                    <Button Content="Réinitialiser" Tag="focus" Click="ModeColorResetButton_Click"
                                                            Style="{StaticResource NovaCompactButtonStyle}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock Text="Focus" FontSize="11" Opacity="0.72" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Button x:Name="ModeColorSwatchReadingButton"
                                            Tag="reading"
                                            Style="{StaticResource NovaModeColorSwatchButtonStyle}"
                                            ToolTipService.ToolTip="Couleur du mode Lecture"
                                            AutomationProperties.Name="Couleur du mode Lecture">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="10">
                                                    <ColorPicker x:Name="ModeColorPickerReading" Tag="reading"
                                                                 IsAlphaEnabled="False" ColorSpectrumShape="Ring"
                                                                 ColorChanged="ModeColorPicker_ColorChanged" />
                                                    <Button Content="Réinitialiser" Tag="reading" Click="ModeColorResetButton_Click"
                                                            Style="{StaticResource NovaCompactButtonStyle}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock Text="Lecture" FontSize="11" Opacity="0.72" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Button x:Name="ModeColorSwatchCreativeButton"
                                            Tag="creative"
                                            Style="{StaticResource NovaModeColorSwatchButtonStyle}"
                                            ToolTipService.ToolTip="Couleur du mode Création"
                                            AutomationProperties.Name="Couleur du mode Création">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="10">
                                                    <ColorPicker x:Name="ModeColorPickerCreative" Tag="creative"
                                                                 IsAlphaEnabled="False" ColorSpectrumShape="Ring"
                                                                 ColorChanged="ModeColorPicker_ColorChanged" />
                                                    <Button Content="Réinitialiser" Tag="creative" Click="ModeColorResetButton_Click"
                                                            Style="{StaticResource NovaCompactButtonStyle}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock Text="Création" FontSize="11" Opacity="0.72" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Button x:Name="ModeColorSwatchResearchButton"
                                            Tag="research"
                                            Style="{StaticResource NovaModeColorSwatchButtonStyle}"
                                            ToolTipService.ToolTip="Couleur du mode Recherche"
                                            AutomationProperties.Name="Couleur du mode Recherche">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="10">
                                                    <ColorPicker x:Name="ModeColorPickerResearch" Tag="research"
                                                                 IsAlphaEnabled="False" ColorSpectrumShape="Ring"
                                                                 ColorChanged="ModeColorPicker_ColorChanged" />
                                                    <Button Content="Réinitialiser" Tag="research" Click="ModeColorResetButton_Click"
                                                            Style="{StaticResource NovaCompactButtonStyle}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock Text="Recherche" FontSize="11" Opacity="0.72" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Button x:Name="ModeColorSwatchNightButton"
                                            Tag="night"
                                            Style="{StaticResource NovaModeColorSwatchButtonStyle}"
                                            ToolTipService.ToolTip="Couleur du mode Nuit"
                                            AutomationProperties.Name="Couleur du mode Nuit">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="10">
                                                    <ColorPicker x:Name="ModeColorPickerNight" Tag="night"
                                                                 IsAlphaEnabled="False" ColorSpectrumShape="Ring"
                                                                 ColorChanged="ModeColorPicker_ColorChanged" />
                                                    <Button Content="Réinitialiser" Tag="night" Click="ModeColorResetButton_Click"
                                                            Style="{StaticResource NovaCompactButtonStyle}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock Text="Nuit" FontSize="11" Opacity="0.72" HorizontalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="AppearanceGroupLayout" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Disposition" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Disposition Lumora"
                                               Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="Le thème Lumora reste la signature de base ; ici, vous composez votre propre ergonomie en plaçant les zones du navigateur autour du contenu."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <ComboBox x:Name="TabStripPositionCombo"
                                              Header="Position des onglets"
                                              Width="260"
                                              SelectionChanged="TabStripPositionCombo_SelectionChanged">
                                        <ComboBoxItem Content="Haut" Tag="top" />
                                        <ComboBoxItem Content="Bas" Tag="bottom" />
                                        <ComboBoxItem Content="Gauche" Tag="left" />
                                        <ComboBoxItem Content="Droite" Tag="right" />
                                    </ComboBox>
                                    <ComboBox x:Name="BookmarksBarPositionCombo"
                                              Header="Position des favoris"
                                              Width="260"
                                              SelectionChanged="BookmarksBarPositionCombo_SelectionChanged">
                                        <ComboBoxItem Content="Haut" Tag="top" />
                                        <ComboBoxItem Content="Bas" Tag="bottom" />
                                        <ComboBoxItem Content="Gauche" Tag="left" />
                                        <ComboBoxItem Content="Droite" Tag="right" />
                                    </ComboBox>
                                    <TextBlock Text="Presets d'espace Lumora"
                                               Style="{StaticResource NovaPanelSectionTitleStyle}"
                                               Opacity="0.72" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Halo"
                                                Tag="top|top"
                                                Click="WorkspacePresetButton_Click"
                                                Style="{StaticResource NovaCompactButtonStyle}" />
                                        <Button Content="Atelier"
                                                Tag="left|right"
                                                Click="WorkspacePresetButton_Click"
                                                Style="{StaticResource NovaCompactButtonStyle}" />
                                        <Button Content="Flux"
                                                Tag="bottom|left"
                                                Click="WorkspacePresetButton_Click"
                                                Style="{StaticResource NovaCompactButtonStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="Halo garde une lecture classique lumineuse, Atelier ouvre un espace de travail latéral, Flux pousse les zones d'outil hors du haut de fenêtre pour libérer la vue. Les positions ci-dessus et ces présets s'appliquent maintenant tout de suite."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                </StackPanel>
                            </Border>
                            <ToggleSwitch x:Name="BookmarksBarSwitch" Header="Barre de favoris visible" Toggled="BookmarksBarSwitch_Toggled" />
                            <ToggleSwitch x:Name="CompactModeSwitch" Header="Interface compacte" Toggled="CompactModeSwitch_Toggled" />
                            <ToggleSwitch x:Name="CompactModeHideBookmarksSwitch"
                                          Header="Masquer les favoris en interface compacte"
                                          Toggled="CompactModeHideBookmarksSwitch_Toggled" />
                            <ComboBox x:Name="UiDensityCombo" Header="Taille de l'interface" Width="260"
                                      SelectionChanged="UiDensityCombo_SelectionChanged">
                                <ComboBoxItem Content="Confortable" Tag="comfortable" />
                                <ComboBoxItem Content="Standard" Tag="standard" />
                                <!-- "Dense" -> "Petit" (2026-08-08, retour utilisateur) : "dense" decrit un
                                     agencement resserre, pas des elements plus petits en taille - c'est
                                     bien la taille qui change ici, pas la densite. Tag interne "dense"
                                     inchange (valeur stockee dans UiSettings, pas affichee). -->
                                <ComboBoxItem Content="Petit" Tag="dense" />
                            </ComboBox>
                            <TextBlock Text="Ajuste la taille des boutons de la barre d'outils, de la barre d'adresse, de la barre de favoris et de la barre du bas. Standard est la taille par défaut, proche des navigateurs courants ; Confortable garde les tailles historiques de Lumora ; Petit réduit au maximum l'espace pris par ces zones."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="FullScreenAutoHideChromeSwitch"
                                          Header="Masquer les barres en plein écran et les révéler au survol"
                                          Toggled="FullScreenAutoHideChromeSwitch_Toggled" />
                            <TextBlock Text="En plein écran, approchez la souris du haut pour les actions principales, ou du bord gauche pour retrouver le rail latéral."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ComboBox x:Name="PersonalizationMotionCombo" Header="Animations et réactions" Width="280"
                                      SelectionChanged="AppearanceOption_Changed">
                                <ComboBoxItem Content="Discret" Tag="subtle" />
                                <ComboBoxItem Content="Lumineux" Tag="luminous" />
                                <ComboBoxItem Content="Dynamique" Tag="dynamic" />
                            </ComboBox>
                            <TextBlock Text="Ce réglage module l'accueil, les effets lumineux et les réactions visuelles. L'option d'accessibilité Réduire les animations reste prioritaire."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            </StackPanel>

                            <StackPanel x:Name="AppearanceGroupNewTab" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Nouvel onglet" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />
                            <TextBox x:Name="NewTabTitleBox"
                                     Header="Titre affiché"
                                     MaxLength="32"
                                     TextChanged="NewTabTitleBox_TextChanged" />
                            <ComboBox x:Name="NewTabStyleCombo" Header="Style du nouvel onglet" Width="260"
                                      SelectionChanged="AppearanceOption_Changed">
                                <ComboBoxItem Content="Signature" Tag="signature" />
                                <ComboBoxItem Content="Calme" Tag="calm" />
                                <ComboBoxItem Content="Minimal" Tag="minimal" />
                            </ComboBox>
                            <ToggleSwitch x:Name="NewTabFocusSearchSwitch"
                                          Header="Placer le curseur dans la recherche du nouvel onglet"
                                          Toggled="NewTabFocusSearchSwitch_Toggled" />
                            <TextBlock Text="Désactivé par défaut pour éviter qu'une saisie de connexion ou de PIN se retrouve dans la page d'accueil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="NewTabShortcutsSwitch"
                                          Header="Afficher les raccourcis"
                                          Toggled="NewTabShortcutsSwitch_Toggled" />
                            <TextBlock Text="Désactiver masque uniquement la liste des raccourcis déjà ajoutés. Le bouton d'ajout rapide (+) reste toujours disponible sur la page nouvel onglet."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <TextBox x:Name="NewTabShortcutsBox"
                                     Header="Raccourcis"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Height="120"
                                     PlaceholderText="Nom | https://exemple.com"
                                     TextChanged="NewTabShortcutsBox_TextChanged" />
                            <TextBlock Text="Un raccourci par ligne : Nom | URL."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            </StackPanel>

                            <StackPanel x:Name="AppearanceGroupDiscovery" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Découverte" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Écran de bienvenue" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="Revoir la présentation de Lumora montrée au tout premier lancement (fonctions majeures), sans toucher à votre profil ni à vos réglages actuels."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <Button Content="Revoir l'écran de bienvenue"
                                            Click="ReplayWelcomeSlidesButton_Click"
                                            Style="{StaticResource NovaCompactButtonStyle}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Section : Accessibilite -->
                        <StackPanel x:Name="SettingsSectionAccessibility" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Accessibilité" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="Deux familles de réglages indépendantes : le confort de lecture (affichage, contenu des pages et aides à la lecture), et la navigation clavier et lecteur d'écran. Tout reste local à ce profil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <ScrollViewer HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <RadioButton x:Name="AccessibilitySubNavProfiles" Content="Profils" Tag="profiles"
                                             GroupName="AccessibilitySubNav" IsChecked="True"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="AccessibilitySubNav_Click" />
                                <RadioButton x:Name="AccessibilitySubNavDisplay" Content="Affichage" Tag="display"
                                             GroupName="AccessibilitySubNav"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="AccessibilitySubNav_Click" />
                                <RadioButton x:Name="AccessibilitySubNavWebContent" Content="Contenu des pages web" Tag="webcontent"
                                             GroupName="AccessibilitySubNav"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="AccessibilitySubNav_Click" />
                                <RadioButton x:Name="AccessibilitySubNavReading" Content="Aides à la lecture" Tag="reading"
                                             GroupName="AccessibilitySubNav"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="AccessibilitySubNav_Click" />
                                <RadioButton x:Name="AccessibilitySubNavKeyboard" Content="Navigation clavier" Tag="keyboard"
                                             GroupName="AccessibilitySubNav"
                                             Style="{StaticResource NovaSubTabRadioButtonStyle}" Click="AccessibilitySubNav_Click" />
                            </StackPanel>
                            </ScrollViewer>
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,0,0,4" />

                            <StackPanel x:Name="AccessibilityGroupProfiles" Spacing="12">
                            <TextBlock Text="Profils prêts à l'emploi" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Base rapide" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="Lumora peut partir d'un profil de confort cohérent, puis vous laisser retoucher chaque aide juste en dessous."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <RadioButtons x:Name="AccessibilityComfortProfileRadio"
                                                  SelectionChanged="AccessibilityComfortProfileRadio_SelectionChanged">
                                        <RadioButton Tag="balanced">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Aucune aide" FontWeight="SemiBold" />
                                                <TextBlock Text="Point de départ : rien n'est activé, à vous de choisir un profil ou de régler chaque aide à la main."
                                                           Style="{StaticResource NovaPanelDescriptionStyle}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Tag="vision">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Vision fatiguée" FontWeight="SemiBold" />
                                                <TextBlock Text="Teinte plus chaude, texte agrandi et transitions limitées - pas de contraste forcé, pensé pour la fatigue visuelle plutôt que la basse vision."
                                                           Style="{StaticResource NovaPanelDescriptionStyle}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Tag="custom">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Personnalisé" FontWeight="SemiBold" />
                                                <TextBlock Text="Pour vos réglages mélangés à la main, sans revenir à un préset."
                                                           Style="{StaticResource NovaPanelDescriptionStyle}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </RadioButtons>
                                    <TextBlock x:Name="AccessibilityComfortProfileSummaryText"
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Mode secours" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="Ce n'est pas un profil à choisir dans la liste ci-dessus : c'est un geste d'urgence pour reprendre la main tout de suite si la lisibilité s'effondre (texte, contraste, repères). Un seul retour arrière est mémorisé, et il se perd à la fermeture de Lumora."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock x:Name="AccessibilityRescueStatusText"
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="AccessibilityRescueActivateButton"
                                                Content="Activer le mode secours"
                                                Click="AccessibilityRescueActivateButton_Click"
                                                AutomationProperties.Name="Activer le mode secours"
                                                AutomationProperties.HelpText="Raccourci clavier : Ctrl+Alt+S."
                                                Style="{StaticResource NovaCompactButtonStyle}" />
                                        <Button x:Name="AccessibilityRescueRestoreButton"
                                                Content="Revenir à l'état d'avant"
                                                Click="AccessibilityRescueRestoreButton_Click"
                                                AutomationProperties.Name="Revenir à l'état de confort d'avant"
                                                AutomationProperties.HelpText="Raccourci clavier : Ctrl+Alt+X."
                                                Style="{StaticResource NovaCompactButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <StackPanel x:Name="AccessibilityGroupDisplay" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Affichage de Lumora" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />
                            <TextBlock Text="Ces réglages ajustent la chrome Lumora (fenêtre, panneaux, boutons) - pas le contenu des pages web visitées."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityHighContrastSwitch"
                                          Header="Contraste renforcé"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Augmente les contrastes de la chrome Lumora, des panneaux et de la page d'accueil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityLargeTextSwitch"
                                          Header="Texte plus lisible"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Agrandit les textes de navigation, de commande et les messages importants."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityReduceMotionSwitch"
                                          Header="Limiter les transitions visuelles"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Agit surtout sur les transitions de survol de l'accueil et des contrôles internes."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityVisibleFocusSwitch"
                                          Header="Focus clavier plus visible"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Renforce les contours visibles quand vous naviguez avec Tab, Entrée ou les flèches."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityLargeTargetsSwitch"
                                          Header="Boutons plus grands"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Agrandit les boutons de la barre de navigation (retour, avancer, recharger...) pour des cibles plus faciles à viser. Désactivé par défaut : la taille compacte reste la norme, cette aide est à votre choix."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            </StackPanel>

                            <StackPanel x:Name="AccessibilityGroupWebContent" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Contenu des pages web" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />
                            <TextBlock Text="Contrairement au reste de cette page (qui ajuste la chrome Lumora), ces réglages agissent directement sur le contenu des pages web visitées."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityReduceBlueLightSwitch"
                                          Header="Réduire la lumière bleue"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Teinte plus chaude sur les pages visitées, pensée pour la fatigue visuelle (usage prolongé, soirée) - à l'opposé du contraste renforcé, qui vise la basse vision et durcit volontairement l'affichage."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ComboBox x:Name="AccessibilityTextSpacingCombo"
                                      Header="Espacement du texte des pages"
                                      SelectionChanged="AccessibilityTextSpacingCombo_SelectionChanged">
                                <ComboBoxItem Content="Normal" Tag="normal" />
                                <ComboBoxItem Content="Confortable" Tag="comfortable" />
                                <ComboBoxItem Content="Large" Tag="wide" />
                            </ComboBox>
                            <TextBlock Text="Augmente l'espacement entre lettres, mots et lignes sur les pages visitées (recommandation d'accessibilité WCAG 1.4.12). Aide la dyslexie et la basse vision : un texte trop serré devient difficile à suivre ligne par ligne."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityColorBoostSwitch"
                                          Header="Renforcer les couleurs difficiles à distinguer"
                                          Toggled="AccessibilityColorBoostSwitch_Toggled" />
                            <TextBlock Text="Augmente la saturation et le contraste des pages visitées, utile à certains daltoniens quand des couleurs proches se confondent. Ce n'est pas une correction médicale ni une simulation exacte : pour un filtre de vision des couleurs complet, Windows propose ses propres Filtres de couleurs (Paramètres Windows > Accessibilité), qui s'appliquent à tout l'écran."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            </StackPanel>

                            <StackPanel x:Name="AccessibilityGroupReading" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Aides à la lecture" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />
                            <ToggleSwitch x:Name="ReadAloudEnabledSwitch" Header="Lire les pages à voix haute" Toggled="ReadAloudEnabledSwitch_Toggled" />
                            <TextBlock Text="Ajoute un bouton dans la barre d'outils pour faire lire le texte de la page à voix haute (utile en cas de difficulté de lecture). Synthèse vocale 100% locale (Windows), aucun texte de page envoyé à un serveur externe."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="ReadingLensEnabledSwitch" Header="Loupe de lecture" Toggled="ReadingLensEnabledSwitch_Toggled" />
                            <TextBlock Text="Ajoute un bouton dans la barre d'outils qui capture la page dans un panneau zoomable, utile pour un captcha visuel déformé ou un texte minuscule. Aucune résolution automatique : une image locale agrandie, vous lisez et répondez vous-même."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="ReadingGuideEnabledSwitch" Header="Guide de lecture immersif" Toggled="ReadingGuideEnabledSwitch_Toggled" />
                            <TextBlock Text="Assombrit légèrement le reste de la page et garde une bande nette qui suit la lecture dans le viewport. Pratique pour ne pas perdre sa ligne sur les longs articles, tableaux ou formulaires denses."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ComboBox x:Name="ReadingGuideBandHeightCombo"
                                      Header="Hauteur de la bande de lecture"
                                      SelectionChanged="ReadingGuideBandHeightCombo_SelectionChanged">
                                <ComboBoxItem Content="Standard" Tag="160" />
                                <ComboBoxItem Content="Large" Tag="220" />
                            </ComboBox>
                            <TextBlock Text="La bande suit le pointeur, les changements de focus et les grands déplacements clavier pour rester au bon niveau sans demander une nouvelle action."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            </StackPanel>

                            <StackPanel x:Name="AccessibilityGroupKeyboard" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Navigation clavier" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" />
                            <TextBlock Text="Indépendant du confort de lecture des autres onglets : repérage et déplacement au clavier dans toute la fenêtre Lumora, utile avec ou sans lecteur d'écran."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Navigation clavier" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="Ctrl+K ouvre la palette, Échap ferme les panneaux temporaires ou quitte le plein écran, Tab parcourt les commandes visibles."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Raccourcis Lumora" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="F6 ou Maj+F6 : passer d'une grande zone du navigateur à l'autre."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Ctrl+Alt+1 à 5 : aller directement vers les onglets, la barre d'adresse, le contenu actif, les outils ou le compagnon."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Ctrl+Alt+F : faire relire le repère courant (zone, surface et contrôle actif)."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Ctrl+Alt+R : recentrer le focus sur le repère utile quand on se sent perdu."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Ctrl+Alt+S : activer le mode secours. Ctrl+Alt+X : revenir à l'état de confort d'avant."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Ctrl+K : ouvrir la palette de commande sans quitter le clavier."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Win+H : lancer la dictée Windows quand un champ de texte est actif."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Ctrl+T : nouvel onglet. Ctrl+W : fermer l'onglet actif. Ctrl+L : mettre le focus sur la barre d'adresse."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="F5 : recharger la page. Alt+Gauche ou Alt+Droite : page précédente ou suivante."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Ctrl+Tab ou Ctrl+Maj+Tab : passer à l'onglet suivant ou précédent. F11 : basculer le plein écran."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <Button x:Name="AccessibilityShortcutHelpButton"
                                            Content="Faire annoncer les raccourcis"
                                            Click="AccessibilityShortcutHelpButton_Click"
                                            AutomationProperties.Name="Faire annoncer les raccourcis Lumora"
                                            AutomationProperties.HelpText="Relit les raccourcis clavier importants via les annonces d'accessibilité."
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource NovaCompactButtonStyle}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Les boutons, onglets, favoris et menus principaux exposent des noms lisibles aux lecteurs d'écran."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Section : Ouverture -->
                        <StackPanel x:Name="SettingsSectionStartup" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Ouverture" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <RadioButtons x:Name="StartupModeRadio" Header="Quand Lumora s'ouvre" SelectionChanged="StartupModeRadio_SelectionChanged">
                                <RadioButton x:Name="StartupRestoreRadio" Content="Restaurer la session précédente" Tag="restore" />
                                <RadioButton x:Name="StartupHomeRadio" Content="Accueil Lumora" Tag="home" />
                                <RadioButton x:Name="StartupCustomRadio" Content="URL personnalisee" Tag="custom" />
                            </RadioButtons>
                            <TextBox x:Name="StartupUrlBox" Header="URL de démarrage"
                                     Visibility="Collapsed" PlaceholderText="https://..."
                                     TextChanged="StartupUrlBox_TextChanged" MaxWidth="400" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Section : Coffre et données -->
                        <StackPanel x:Name="SettingsSectionVault" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Coffre et données" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="vault.lumora reste local, chiffré et lié à votre profil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <Border Background="{StaticResource NovaWarningSurfaceBrush}"
                                    CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Text="La récupération n'est possible qu'avec la clé de récupération locale que vous avez notée. Sans mot de passe et sans cette clé, Lumora ne peut pas déchiffrer le coffre." />
                            </Border>
                            <TextBlock Text="Le mot de passe du coffre se change depuis Profil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="VaultMenu_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Permissions" />
                                        <TextBlock Text="Ouvrir les mots de passe" />
                                    </StackPanel>
                                </Button>
                                <Button Click="ImportPasswordsMenu_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Import" />
                                        <TextBlock Text="Importer un CSV" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                    Margin="0,8,0,0" />
                            <TextBlock Text="Portefeuille" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Cartes stockées dans le même coffre. Remplissage uniquement sur clic explicite ; CVV jamais enregistré." />
                            <Button Click="WalletMenu_Click" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                    <TextBlock Text="Ouvrir le portefeuille" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Section : Profils locaux. Restructurée en 3 blocs distincts
                             (session "Écran de connexion", 2026-08-10) : Mon profil (identité +
                             actions sensibles sur SOI), Autres profils (uniquement les AUTRES
                             profils de la machine, plus de doublon avec le profil actif dont
                             les boutons étaient désactivés) et Zone dangereuse (réinitialisation,
                             isolée visuellement - même esprit que "Vider" sur les Favoris). Aucune
                             des actions d'origine n'est retirée, seulement regroupée. -->
                        <StackPanel x:Name="SettingsSectionProfile" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Profils locaux" Style="{StaticResource NovaPanelPageTitleStyle}" />

                            <!-- Mon profil -->
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="44" Height="44" VerticalAlignment="Center">
                                            <Ellipse>
                                                <Ellipse.Fill>
                                                    <ImageBrush x:Name="ProfileSectionAvatarBrush" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <FontIcon x:Name="ProfileSectionAvatarPlaceholder"
                                                      Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                      Foreground="{StaticResource NovaBrandChipMutedBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock x:Name="ProfileNameDisplay" Grid.Column="1"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.78" />
                                        <Border Grid.Column="2" VerticalAlignment="Center"
                                                Background="{StaticResource NovaAccentSoftBrush}"
                                                CornerRadius="999" Padding="10,4">
                                            <TextBlock Text="Ce profil" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <HyperlinkButton Content="Modifier l'avatar dans Personnalisation"
                                                      Click="OpenPersonalizationFromProfileButton_Click"
                                                      Padding="0" FontSize="12" />
                                    <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Click="ChangeProfileNameButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <SymbolIcon Symbol="Rename" />
                                            <TextBlock Text="Changer le nom" />
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Click="ChangeProfilePasswordButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <SymbolIcon Symbol="Permissions" />
                                            <TextBlock Text="Changer le mot de passe" />
                                        </StackPanel>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Click="CreateRecoveryKeyButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                            <TextBlock Text="Nouvelle clé de récupération" />
                                        </StackPanel>
                                    </Button>
                                    <ToggleSwitch x:Name="ProfilePinSwitch" Header="Code PIN rapide (6 chiffres)"
                                                 Toggled="ProfilePinSwitch_Toggled" />
                                    <ComboBox x:Name="SessionTimeoutCombo"
                                              Header="Verrouillage automatique de la session"
                                              HorizontalAlignment="Stretch"
                                              SelectionChanged="SessionTimeoutCombo_SelectionChanged">
                                        <ComboBoxItem Content="Jamais" Tag="0" />
                                        <ComboBoxItem Content="10 minutes" Tag="10" />
                                        <ComboBoxItem Content="1 heure" Tag="60" />
                                        <ComboBoxItem Content="5 heures" Tag="300" />
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!--
                                Trouve en usage reel (mode invite) le 2026-07-22 : ce bloc expose le
                                chemin reel de chaque profil en texte brut, propose d'ouvrir son
                                dossier (coffre inclus) et de le mettre en quarantaine SANS mot de
                                passe (juste retaper le nom, visible juste au-dessus) - et le bouton
                                Reinitialiser plus bas supprime tout le dossier du profil actif SANS
                                aucune verification, alors qu'en mode invite _profile pointe encore
                                sur le vrai profil par defaut. Aucune de ces deux actions n'a de sens
                                pour une session invite (aucun profil a soi a gerer) : le bloc entier
                                est cache et remplace par ProfileGuestRestrictedNotice tant que
                                _isGuestMode est vrai (voir RefreshProfileSettings).
                            -->
                            <StackPanel x:Name="ProfileManagementRestrictedPanel" Spacing="12">
                                <!-- Autres profils -->
                                <Border Style="{StaticResource NovaPanelCardStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Autres profils sur cet appareil" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                                <TextBlock Text="Profils détectés sur cet ordinateur, hors le tien." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Actualiser" Click="RefreshProfilesButton_Click" />
                                            <Button Grid.Column="2" Content="Créer un profil"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="CreateAnotherProfileFromSettingsButton_Click" />
                                        </Grid>
                                        <StackPanel x:Name="ProfileManagementPanel" Spacing="8" />
                                    </StackPanel>
                                </Border>

                                <!-- Zone dangereuse : même traitement que "Vider" sur les Favoris
                                     (0.93.23) - fond teinté, isolé du reste. Confirmation renforcée
                                     par mot de passe dans ResetProfileButton_Click (MainWindow.Profile.cs). -->
                                <Border Background="{StaticResource NovaDangerSurfaceBrush}" CornerRadius="10" Padding="14,12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Zone dangereuse" FontWeight="SemiBold"
                                                   Foreground="{StaticResource NovaDangerBrush}" />
                                        <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                                   Text="Supprime définitivement toutes vos données : favoris, historique, onglets, paramètres, coffre et identifiants de connexion. Opération irréversible." />
                                        <Button Content="Réinitialiser ce profil..."
                                                Foreground="{StaticResource NovaDangerBrush}"
                                                HorizontalAlignment="Left"
                                                Margin="0,4,0,0"
                                                Click="ResetProfileButton_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <InfoBar x:Name="ProfileGuestRestrictedNotice"
                                     Title="Indisponible en mode invité"
                                     Message="La gestion des utilisateurs locaux et la réinitialisation de profil touchent aux données d'un vrai profil : connectez-vous ou créez un profil pour y accéder."
                                     Severity="Informational"
                                     IsOpen="False" />
                        </StackPanel>

                        <!-- Section : Stockage local -->
                        <StackPanel x:Name="SettingsSectionStorage" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Stockage local" Style="{StaticResource NovaPanelPageTitleStyle}" />

                            <TextBlock Text="Dossier actuel" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBox x:Name="StorageCurrentFolderText"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     Opacity="0.78" FontFamily="Consolas" FontSize="12" />
                            <Button Content="Changer de dossier..." Click="ChangeFolderButton_Click" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Les fichiers existants seront copiés vers le nouvel emplacement. Redémarrage nécessaire." />

                            <InfoBar x:Name="StorageRestartBar"
                                     Title="Redémarrage requis"
                                     Message="Le dossier de données a été modifié. Redémarrez Lumora pour appliquer le changement."
                                     Severity="Warning"
                                     IsOpen="False">
                                <InfoBar.ActionButton>
                                    <Button Content="Fermer Lumora" Click="StorageRestartCloseButton_Click" />
                                </InfoBar.ActionButton>
                            </InfoBar>

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />

                            <TextBlock Text="Données de navigation" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Supprime cookies, sessions, cache et données des sites." />
