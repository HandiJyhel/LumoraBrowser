<Window
    x:Class="Lumora.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Lumora">

    <Grid x:Name="RootShell" Background="#FF0D1822">
        <Grid.Resources>
            <SolidColorBrush x:Key="NovaAppBackgroundBrush" Color="#FF0D1822" />
            <SolidColorBrush x:Key="NovaChromeSurfaceBrush" Color="#FF14202A" />
            <SolidColorBrush x:Key="NovaChromeSurfaceAltBrush" Color="#FF1A2731" />
            <SolidColorBrush x:Key="NovaChromeSurfaceRaisedBrush" Color="#FF22313A" />
            <SolidColorBrush x:Key="NovaChromeStrokeBrush" Color="#FF40545B" />
            <SolidColorBrush x:Key="NovaChromeStrokeSoftBrush" Color="#FF24343C" />
            <SolidColorBrush x:Key="NovaAddressBackgroundBrush" Color="#FF172834" />
            <SolidColorBrush x:Key="NovaAddressBorderBrush" Color="#FF46616A" />
            <SolidColorBrush x:Key="NovaAddressForegroundBrush" Color="#FFFFF8EA" />
            <SolidColorBrush x:Key="NovaTextMutedBrush" Color="#FFC3B9A5" />
            <SolidColorBrush x:Key="NovaAccentBrush" Color="#FFFFB935" />
            <SolidColorBrush x:Key="NovaAccentSoftBrush" Color="#33FFB935" />
            <SolidColorBrush x:Key="NovaCoolAccentBrush" Color="#FF43DBD1" />
            <SolidColorBrush x:Key="NovaCoolAccentSoftBrush" Color="#2443DBD1" />
            <SolidColorBrush x:Key="NovaFocusBrush" Color="#FFFFE668" />
            <SolidColorBrush x:Key="NovaFocusInnerBrush" Color="#FF0D1822" />
            <SolidColorBrush x:Key="NovaInfoSurfaceBrush" Color="#FF1D2E38" />
            <SolidColorBrush x:Key="NovaPanelBackgroundBrush" Color="#FF101D26" />
            <LinearGradientBrush x:Key="NovaChromeGradientBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF121D27" Offset="0" />
                <GradientStop Color="#FF182936" Offset="0.55" />
                <GradientStop Color="#FF123731" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="NovaIdentityMarkBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF43DBD1" Offset="0" />
                <GradientStop Color="#FFFFB935" Offset="0.56" />
                <GradientStop Color="#FFFF7F35" Offset="1" />
            </LinearGradientBrush>
            <Style x:Key="NovaChromeIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaChromeStrokeSoftBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource NovaTextMutedBrush}" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource NovaFocusBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource NovaFocusInnerBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="NovaChromeAccentIconButtonStyle" TargetType="Button" BasedOn="{StaticResource NovaChromeIconButtonStyle}">
                <Setter Property="Background" Value="{StaticResource NovaAccentSoftBrush}" />
                <Setter Property="Foreground" Value="#FFFFF4E2" />
                <Setter Property="BorderBrush" Value="#55E17818" />
            </Style>
            <Style x:Key="NovaModuleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource NovaChromeIconButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#FFEDE6DB" />
            </Style>
            <Style x:Key="NovaModulePuzzleButtonStyle" TargetType="Button" BasedOn="{StaticResource NovaModuleIconButtonStyle}">
                <Setter Property="Background" Value="{StaticResource NovaChromeSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaChromeStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource NovaTextMutedBrush}" />
            </Style>
            <Style x:Key="NovaModuleFlyoutActionStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource NovaAddressForegroundBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style x:Key="NovaModulePinButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource NovaTextMutedBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style x:Key="NovaCompactButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource NovaFocusBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource NovaFocusInnerBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="NovaPanelCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{StaticResource NovaChromeSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaChromeStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="NovaPanelSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="NovaPanelDescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.68" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="17" />
            </Style>
            <Style x:Key="NovaPanelPageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition x:Name="TopTabsRow" Height="38" />
            <RowDefinition x:Name="NavigationRow" Height="42" />
            <RowDefinition x:Name="BookmarksRow" Height="28" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="FullScreenTopBar"
              Grid.RowSpan="6"
              Canvas.ZIndex="50"
              Height="44"
              VerticalAlignment="Top"
              Padding="10,0"
              ColumnSpacing="6"
              Visibility="Collapsed"
              Background="{StaticResource NovaChromeSurfaceBrush}"
              PointerEntered="FullScreenTopBar_PointerEntered"
              PointerExited="FullScreenTopBar_PointerExited">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7">
                    <Image Source="ms-appx:///Assets/LumoraApp.png"
                           Width="24" Height="24"
                           Stretch="Uniform" />
                </Border>
                <TextBlock Text="Lumora" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="FullScreenAddressText"
                       Grid.Column="1"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Opacity="0.74"
                       TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="2"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Nouvel onglet"
                    AutomationProperties.Name="Nouvel onglet"
                    Click="NewTabMenu_Click">
                <SymbolIcon Symbol="Add" />
            </Button>
            <Button Grid.Column="3"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Accueil"
                    AutomationProperties.Name="Accueil"
                    Click="HomeMenu_Click">
                <SymbolIcon Symbol="Home" />
            </Button>
            <Button x:Name="FullScreenExitButton"
                    Grid.Column="4"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Quitter le plein ecran"
                    AutomationProperties.Name="Quitter le plein ecran"
                    Click="CompactModeButton_Click">
                <SymbolIcon Symbol="BackToWindow" />
            </Button>
            <Button x:Name="MainMenuButton"
                    Grid.Column="5"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    AutomationProperties.Name="Menu Lumora"
                    ToolTipService.ToolTip="Menu Lumora">
                <SymbolIcon Symbol="More" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutSubItem Text="Navigation">
                            <MenuFlyoutItem Text="Nouvel onglet" Click="NewTabMenu_Click" />
                            <MenuFlyoutItem Text="Nouvelle fenêtre privée" Click="PrivateWindowMenu_Click" />
                            <MenuFlyoutItem Text="Rouvrir l'onglet ferme" Click="ReopenTabMenu_Click" />
                            <MenuFlyoutItem Text="Groupes enregistres" Click="SavedTabGroupsMenu_Click" />
                            <MenuFlyoutItem Text="Accueil Lumora" Click="HomeMenu_Click" />
                            <MenuFlyoutItem Text="Arrêter le chargement" Click="StopButton_Click" />
                            <MenuFlyoutItem Text="Plein écran" Click="CompactModeButton_Click" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Bibliothèque">
                            <MenuFlyoutItem Text="Favoris" Click="BookmarksMenu_Click" />
                            <MenuFlyoutItem Text="Importer / exporter les favoris" Click="ImportMenu_Click" />
                            <MenuFlyoutItem Text="Historique" Click="HistoryMenu_Click" />
                            <MenuFlyoutItem Text="Téléchargements" Click="DownloadsMenu_Click" />
                            <MenuFlyoutItem Text="Notes et annotations" Click="NotesMenu_Click" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Sécurité et données">
                            <MenuFlyoutItem Text="Site actuel" Click="SiteControlMenu_Click" />
                            <MenuFlyoutItem Text="Sessions conservées" Click="SessionsManageLink_Click" />
                            <MenuFlyoutItem Text="Mots de passe" Click="VaultMenu_Click" />
                            <MenuFlyoutItem Text="Importer des mots de passe" Click="ImportPasswordsMenu_Click" />
                            <MenuFlyoutItem Text="Clés d'accès" Click="PasskeysMenu_Click" />
                            <MenuFlyoutItem Text="Portefeuille" Click="WalletMenu_Click" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Paramètres" Click="SettingsMenu_Click" />
                        <MenuFlyoutItem Text="À propos" Click="AboutMenu_Click" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Fond permanent de la bande de titre, sous BrowserTabs : quand les onglets
             sont verticaux (BrowserTabs masqué), cette bande reste visible et doit
             avoir EXACTEMENT la même couleur que les boutons système (ApplyWindowTitleBarColors),
             sans quoi un liseré de couleur différente apparaît autour d'eux — c'est
             ce qui rend l'intégration "sale" comparé à Chrome. -->
        <Border Grid.Row="1" Background="{StaticResource NovaChromeSurfaceBrush}" />

        <TabView
            x:Name="BrowserTabs"
            Grid.Row="1"
            Background="{StaticResource NovaChromeSurfaceBrush}"
            BorderBrush="{StaticResource NovaChromeStrokeSoftBrush}"
            CanReorderTabs="True"
            AddTabButtonClick="BrowserTabs_AddTabButtonClick"
            SelectionChanged="BrowserTabs_SelectionChanged"
            TabCloseRequested="BrowserTabs_TabCloseRequested"
            Tapped="BrowserTabs_Tapped" />

        <Border Grid.Row="1"
                Height="2"
                VerticalAlignment="Top"
                Background="{StaticResource NovaIdentityMarkBrush}"
                Opacity="0.95" />

        <Grid x:Name="NavigationToolbar"
              Grid.Row="2"
              Padding="10,4,10,5"
              ColumnSpacing="4"
              Background="{StaticResource NovaChromeGradientBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource NovaChromeIconButtonStyle}" ToolTipService.ToolTip="Retour" AutomationProperties.Name="Retour" Click="BackButton_Click">
                <SymbolIcon Symbol="Back" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource NovaChromeIconButtonStyle}" ToolTipService.ToolTip="Avancer" AutomationProperties.Name="Avancer" Click="ForwardButton_Click">
                <SymbolIcon Symbol="Forward" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource NovaChromeIconButtonStyle}" ToolTipService.ToolTip="Recharger" AutomationProperties.Name="Recharger" Click="ReloadButton_Click">
                <SymbolIcon Symbol="Refresh" />
            </Button>
            <Button Grid.Column="3"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Stop"
                    AutomationProperties.Name="Stop"
                    Visibility="Collapsed"
                    Click="StopButton_Click">
                <SymbolIcon Symbol="Cancel" />
            </Button>
            <TextBox
                x:Name="AddressBox"
                Grid.Column="4"
                Margin="6,0"
                MinHeight="34"
                Padding="14,4"
                CornerRadius="17"
                Background="{StaticResource NovaAddressBackgroundBrush}"
                BorderBrush="{StaticResource NovaAddressBorderBrush}"
                BorderThickness="1"
                Foreground="{StaticResource NovaAddressForegroundBrush}"
                PlaceholderForeground="{StaticResource NovaTextMutedBrush}"
                FocusVisualPrimaryBrush="{StaticResource NovaFocusBrush}"
                FocusVisualSecondaryBrush="{StaticResource NovaFocusInnerBrush}"
                AutomationProperties.Name="Adresse ou recherche"
                VerticalAlignment="Center"
                KeyDown="AddressBox_KeyDown"
                TextChanged="AddressBox_TextChanged"
                LostFocus="AddressBox_LostFocus"
                PlaceholderText="Rechercher ou entrer une adresse" />

            <!-- Suggestions locales pendant la frappe : onglets ouverts, favoris,
                 historique. Popup ancré sous la barre d'adresse via PlacementTarget
                 (rendu dans la couche popup, au-dessus du WebView2). Jamais de requête
                 réseau : tout vient des stores locaux du profil. -->
            <Popup x:Name="AddressSuggestionsPopup"
                   PlacementTarget="{x:Bind AddressBox}"
                   DesiredPlacement="Bottom"
                   IsLightDismissEnabled="False">
                <Border x:Name="AddressSuggestionsSurface"
                        Background="{StaticResource NovaChromeSurfaceRaisedBrush}"
                        BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="6"
                        MaxHeight="420"
                        PointerEntered="AddressSuggestions_PointerEntered"
                        PointerExited="AddressSuggestions_PointerExited">
                    <ListView x:Name="AddressSuggestionsList"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="AddressSuggestionsList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,7" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="{Binding Glyph}"
                                              FontFamily="Segoe MDL2 Assets" FontSize="13"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding UrlDisplay}"
                                                   Opacity="0.6" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding KindLabel}"
                                               Opacity="0.5" FontSize="11"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Popup>
            <Button Grid.Column="5"
                    Style="{StaticResource NovaChromeAccentIconButtonStyle}"
                    ToolTipService.ToolTip="Ouvrir l'adresse"
                    AutomationProperties.Name="Ouvrir l'adresse"
                    Click="GoButton_Click">
                <SymbolIcon Symbol="Forward" />
            </Button>

            <!-- Bouton bouclier confidentialité -->
            <Button x:Name="ShieldButton"
                    Grid.Column="6"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    AutomationProperties.Name="Confidentialité du site"
                    ToolTipService.ToolTip="Confidentialité">
                <Grid Width="22" Height="22">
                    <FontIcon Glyph="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border x:Name="TelemetryActivityBadge"
                            MinWidth="16"
                            Height="16"
                            Padding="3,0"
                            CornerRadius="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-5,-7,0"
                            Background="{StaticResource NovaCoolAccentBrush}"
                            BorderBrush="{StaticResource NovaChromeSurfaceBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ShieldBlockedBadgeText"
                                   Text="0"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <Button.Flyout>
                    <Flyout x:Name="ShieldFlyout"
                            Opening="ShieldFlyout_Opening"
                            Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="330" Spacing="12">
                            <TextBlock x:Name="ShieldDomainText"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ShieldBlockedCountText"
                                       Opacity="0.65"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ShieldSiteSummaryText"
                                       Opacity="0.65"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ShieldRecommendationText"
                                       Opacity="0.82"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <StackPanel x:Name="ShieldRecentBlocksPanel"
                                        Spacing="4" />
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                            <ToggleSwitch x:Name="ShieldSiteExcludeToggle"
                                          Header="Exclure ce site du bloqueur"
                                          Toggled="ShieldSiteExcludeToggle_Toggled" />
                            <Button x:Name="ShieldSiteCenterButton"
                                    Content="Centre du site"
                                    HorizontalAlignment="Stretch"
                                    Click="ShieldSiteCenterButton_Click" />
                            <HyperlinkButton Content="Paramètres de confidentialité"
                                             Click="ShieldSettingsLink_Click"
                                             HorizontalAlignment="Left"
                                             Padding="0" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Étoile d'état : pleine et accentuée quand la page courante est
                 déjà en favori, contour simple sinon. Rafraîchie à chaque
                 navigation, changement d'onglet et modification des favoris. -->
            <Button Grid.Column="7" x:Name="AddBookmarkButton" Style="{StaticResource NovaChromeIconButtonStyle}" ToolTipService.ToolTip="Ajouter aux favoris" AutomationProperties.Name="Ajouter aux favoris" Click="AddBookmarkButton_Click">
                <FontIcon x:Name="BookmarkStarIcon" Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>
            <!-- Acces rapide aux identifiants du site courant, sans ouvrir tout le
                 panneau coffre (meme esprit que les extensions de gestionnaire de
                 mots de passe type Proton Pass). -->
            <Button x:Name="VaultQuickAccessButton"
                    Grid.Column="8"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Identifiants de ce site"
                    AutomationProperties.Name="Identifiants de ce site">
                <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                <Button.Flyout>
                    <Flyout x:Name="VaultQuickAccessFlyout"
                            Opening="VaultQuickAccessFlyout_Opening"
                            Placement="BottomEdgeAlignedRight">
                        <StackPanel x:Name="VaultQuickAccessPanel" Width="320" Spacing="10" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="9"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Accueil"
                    AutomationProperties.Name="Accueil"
                    Visibility="Collapsed"
                    Click="HomeMenu_Click">
                <SymbolIcon Symbol="Home" />
            </Button>
            <Button x:Name="CompactModeButton"
                    Grid.Column="10"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Interface compacte"
                    AutomationProperties.Name="Interface compacte"
                    Visibility="Collapsed"
                    Click="CompactModeButton_Click">
                <SymbolIcon Symbol="FullScreen" />
            </Button>
            <Border x:Name="ModulesQuickBar"
                    Grid.Column="11"
                    Grid.ColumnSpan="6"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button x:Name="ReaderModeButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Mode lecture - surligner et commenter cette page"
                            ToolTipService.ToolTip="Mode lecture - surligner et commenter cette page"
                            Click="ReaderModeButton_Click">
                        <Grid>
                            <FontIcon Glyph="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                            <Border x:Name="ReaderAnnotationBadge"
                                    Background="{StaticResource NovaAccentBrush}"
                                    CornerRadius="7" MinWidth="14" Height="14"
                                    Padding="3,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-6,-7,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="ReaderAnnotationBadgeText"
                                           Text="0" FontSize="9" FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="NotesModuleButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Notes et annotations"
                            ToolTipService.ToolTip="Notes et annotations"
                            Click="NotesMenu_Click">
                        <FontIcon Glyph="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <Button x:Name="ReadAloudButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Lire la page à voix haute"
                            ToolTipService.ToolTip="Lire la page à voix haute (traitement local, aucune donnée envoyée)"
                            Click="ReadAloudButton_Click">
                        <FontIcon x:Name="ReadAloudIcon" Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                        <Button.Flyout>
                            <Flyout x:Name="ReadAloudFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="220" Spacing="10">
                                    <TextBlock Text="Lecture à voix haute" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock x:Name="ReadAloudStatusText" TextWrapping="Wrap" FontSize="12" Opacity="0.78" Text="Prêt." />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="ReadAloudPlayPauseButton" Content="Lire la page" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12" Click="ReadAloudPlayPauseButton_Click" />
                                        <Button Content="Arrêter" Style="{StaticResource NovaCompactButtonStyle}" Click="ReadAloudStopButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="DetachVideoPinnedButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
