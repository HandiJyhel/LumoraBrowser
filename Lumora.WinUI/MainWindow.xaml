                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Les fichiers existants seront copiés vers le nouvel emplacement. Redémarrage nécessaire." />

                            <InfoBar x:Name="StorageRestartBar"
                                     Title="Redémarrage requis"
                                     Message="Le dossier de données a été modifié. Redémarrez Lumora pour appliquer le changement."
