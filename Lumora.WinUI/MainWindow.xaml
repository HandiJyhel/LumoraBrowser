            <Grid x:Name="HistoryPanel" Grid.Column="3" Padding="20" Visibility="Collapsed"
                  Background="{StaticResource NovaPanelBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource NovaPanelShellCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Historique" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="Trajectoires visitees localement sur cet appareil." Opacity="0.68" />
                        </StackPanel>
                        <Button x:Name="ClearHistoryButton" Grid.Column="1"
                                Content="Vider l'historique"
                                Click="ClearHistoryButton_Click"
                                Style="{StaticResource NovaCompactButtonDangerStyle}"
                                VerticalAlignment="Bottom" />
                    </Grid>
                </Border>
                <TextBox x:Name="HistorySearchBox" Grid.Row="1" Margin="0,12,0,0"
                         Style="{StaticResource NovaCommandPaletteSearchBoxStyle}"
                         TextChanged="HistorySearchBox_TextChanged"
                         PlaceholderText="Rechercher dans l'historique..." />
                <Border Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource NovaPanelShellCardStyle}">
                    <ListView x:Name="HistoryList"
                              Background="Transparent"
                              Padding="4,2"
                              DoubleTapped="HistoryList_DoubleTapped"
                              RightTapped="HistoryList_RightTapped"
                              KeyDown="HistoryList_KeyDown">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- En-tete de groupe (Aujourd'hui / Hier / ...) -->
                                    <TextBlock Text="{Binding GroupHeaderText}"
                                               Visibility="{Binding HeaderVisibility}"
                                               FontSize="12" FontWeight="SemiBold" Opacity="0.6"
                                               Margin="6,18,6,7" />
                                    <!-- Ligne d'entree : pas de carte individuelle, juste le
                                         survol par defaut du ListViewItem, comme une vraie liste. -->
                                    <Grid Visibility="{Binding RowVisibility}"
                                          ColumnSpacing="12"
                                          Padding="10,12"
                                          CornerRadius="10"
                                          AutomationProperties.Name="{Binding AccessibleName}"
                                          ToolTipService.ToolTip="{Binding Title}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0" Width="18" Height="18"
                                               Source="{Binding IconImageUri}" Visibility="{Binding IconImageVisibility}"
                                               VerticalAlignment="Center" />
                                        <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}"
                                                  FontFamily="Segoe MDL2 Assets" FontSize="14" Opacity="0.6"
                                                  Visibility="{Binding IconGlyphVisibility}"
                                                  VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Domain}"
                                                       Opacity="0.58" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeDisplay}"
                                                   Opacity="0.55" FontSize="11.5"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <Grid x:Name="DownloadsPanel" Grid.Column="3" Padding="20" Visibility="Collapsed"
                  Background="{StaticResource NovaPanelBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
