                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="UsageModeReadingButton" Grid.Row="1" Grid.Column="1" Tag="reading" Style="{StaticResource NovaModuleFlyoutActionStyle}" Click="UsageModeQuickButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2" Width="140">
                                                <TextBlock Text="Lecture" FontWeight="SemiBold" />
                                                <TextBlock Text="Lecture, annotations, voix locale." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="UsageModeCreativeButton" Grid.Row="2" Grid.Column="0" Tag="creative" Style="{StaticResource NovaModuleFlyoutActionStyle}" Click="UsageModeQuickButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2" Width="140">
                                                <TextBlock Text="Création" FontWeight="SemiBold" />
                                                <TextBlock Text="Idées, notes rapides, repères." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="UsageModeResearchButton" Grid.Row="2" Grid.Column="1" Tag="research" Style="{StaticResource NovaModuleFlyoutActionStyle}" Click="UsageModeQuickButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2" Width="140">
                                                <TextBlock Text="Recherche" FontWeight="SemiBold" />
                                                <TextBlock Text="Sources, historique, comparaison." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="UsageModeNightButton" Grid.Row="3" Grid.Column="0" Tag="night" Style="{StaticResource NovaModuleFlyoutActionStyle}" Click="UsageModeQuickButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2" Width="140">
                                                <TextBlock Text="Nuit" FontWeight="SemiBold" />
