                    <ScrollViewer>
                        <StackPanel x:Name="DownloadsPanelItems" Spacing="8" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid x:Name="SavedTabGroupsPanel" Grid.Column="3" Padding="20" Visibility="Collapsed"
                  Background="{StaticResource NovaPanelBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Margin="0,0,0,16" Style="{StaticResource NovaPanelShellCardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Groupes enregistres" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Vos groupes d'onglets ranges. Ouvrez-en un pour retrouver tous ses onglets d'un coup. Tout est stocke localement sur cet appareil."
                                   Opacity="0.68" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
