                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="{StaticResource NovaCompanionGlassBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaCompanionStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="{StaticResource NovaChromeSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaChromeStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource NovaAddressForegroundBrush}" />
            </Style>
            <!-- Le menu Demarrer (ModulesFlyout) depasse la largeur par defaut
                 d'un FlyoutPresenter WinUI (~456px, FlyoutThemeMaxWidth) : au-dela,
                 le contenu deborde et se fait rogner a gauche plutot que d'agrandir
                 le presenter. Style dedie avec une largeur maximale plus genereuse. -->
            <Style x:Key="StartMenuFlyoutPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="Background" Value="{StaticResource NovaChromeSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaChromeStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource NovaAddressForegroundBrush}" />
                <Setter Property="MaxWidth" Value="660" />
            </Style>
            <Style TargetType="MenuFlyoutPresenter">
                <Setter Property="Background" Value="{StaticResource NovaBrandChipBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaBrandChipBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource NovaAddressForegroundBrush}" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="8" />
            </Style>
            <Style TargetType="MenuFlyoutItem">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="10,6" />
            </Style>
            <Style TargetType="MenuFlyoutSubItem">
                <Setter Property="Padding" Value="10,6" />
            </Style>
            <Style TargetType="TabViewItem">
                <Setter Property="CornerRadius" Value="16" />
            </Style>
            <!-- ControlTemplate du TabView recopie de generic.xaml WinUI
                 (Microsoft.WindowsAppSDK.WinUI 1.8) avec deux changements
                 cibles seulement - le reste est identique a la version SDK,
                 pas une reinvention :
                 1) le conteneur du bouton "+" etait VerticalAlignment="Bottom"
                    dans une rangee Auto calee sur le plus grand contenu -
                    concu pour TabViewItemMinHeight=32, mais nos onglets
                    (pastille a deux lignes, TopTabsRow=52) font grandir la
                    rangee sans que le bouton suive : il restait colle en bas,
                    visuellement plus bas que le centre de la pastille (signale
                    par capture d'ecran utilisateur). Passe a "Center".
                 2) le glyph "+" plat (Segoe Fluent, gris systeme, non
                    theme-conscient) remplace par un petit plus trace a la
                    main avec NovaIdentityMarkBrush (dégradé cyan->ambre deja
                    utilise pour la pastille de marque juste a cote), pour
                    rester coherent avec l'identite visuelle plutot qu'un
                    glyph systeme generique (demande explicite utilisateur).
                    Le bouton n'utilise plus "{ThemeResource TabViewButtonStyle}"
                    (le Style nomme du SDK, introuvable en lookup depuis une
                    ControlTemplate copiee hors de generic.xaml - plante au
                    lancement) : couleurs/dimensions posees directement sur
                    l'element avec les memes brushes Nova que les autres
                    boutons du chrome. -->
            <Style TargetType="TabView">
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Padding" Value="0,8,0,0" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="KeyboardAcceleratorPlacementMode" Value="Hidden" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabView">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="NormalBottomBorderLine" />
                                        <VisualState x:Name="SingleBottomBorderLine">
                                            <VisualState.Setters>
                                                <Setter Target="LeftBottomBorderLine.(Grid.ColumnSpan)" Value="4" />
                                                <Setter Target="RightBottomBorderLine.Visibility" Value="Collapsed" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid x:Name="TabContainerGrid" Background="{TemplateBinding Background}" XYFocusKeyboardNavigation="Enabled">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="2" x:Name="LeftContentColumn" />
                                        <ColumnDefinition Width="Auto" x:Name="TabColumn" />
                                        <ColumnDefinition Width="Auto" x:Name="AddButtonColumn" />
                                        <ColumnDefinition Width="*" x:Name="RightContentColumn" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="LeftBottomBorderLine" Background="{ThemeResource TabViewBorderBrush}" Height="1" VerticalAlignment="Bottom" />
                                    <Border x:Name="RightBottomBorderLine" Background="{ThemeResource TabViewBorderBrush}" Height="1" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Bottom" />
                                    <ContentPresenter Grid.Column="0" x:Name="LeftContentPresenter" Content="{TemplateBinding TabStripHeader}" ContentTemplate="{TemplateBinding TabStripHeaderTemplate}" />
                                    <primitives:TabViewListView Grid.Column="1" HorizontalAlignment="Stretch" x:Name="TabListView" Padding="{TemplateBinding Padding}" CanReorderItems="{TemplateBinding CanReorderTabs}" CanDragItems="{TemplateBinding CanDragTabs}" AllowDrop="{TemplateBinding AllowDropTabs}" ItemsSource="{TemplateBinding TabItemsSource}" ItemTemplate="{TemplateBinding TabItemTemplate}" ItemTemplateSelector="{TemplateBinding TabItemTemplateSelector}" />
                                    <Border Visibility="{Binding IsAddTabButtonVisible, RelativeSource={RelativeSource TemplatedParent}}" Grid.Column="2" Padding="3,0,0,0" VerticalAlignment="Center">
                                        <Button x:Name="AddButton" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Width="32" Height="24" Padding="0" CornerRadius="6"
                                                Background="{StaticResource NovaChromeButtonBackgroundBrush}"
                                                BorderThickness="0"
                                                IsTextScaleFactorEnabled="False"
                                                Command="{TemplateBinding AddTabButtonCommand}"
                                                CommandParameter="{TemplateBinding AddTabButtonCommandParameter}"
                                                HighContrastAdjustment="None">
                                            <Grid Width="12" Height="12">
                                                <Rectangle Width="12" Height="2.4" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource NovaIdentityMarkBrush}" VerticalAlignment="Center" />
                                                <Rectangle Width="2.4" Height="12" RadiusX="1.2" RadiusY="1.2" Fill="{StaticResource NovaIdentityMarkBrush}" HorizontalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </Border>
                                    <ContentPresenter Grid.Column="3" x:Name="RightContentPresenter" HorizontalAlignment="Stretch" Content="{TemplateBinding TabStripFooter}" ContentTemplate="{TemplateBinding TabStripFooterTemplate}" />
                                </Grid>
                                <ContentPresenter x:Name="TabContentPresenter" Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Menu Demarrer : tuiles pilotees par StartMenuTileRegistry +
                 _uiSettings (StartMenuTile_Click/StartMenuTilePin_Click dans
                 MainWindow.StartMenu.cs). StartMenuActionTileTemplate (2
                 colonnes, pleine largeur du flyout) sert a la recherche ;
                 StartMenuDetailTileTemplate (1 colonne, largeur du volet
                 detail plus etroit) sert au rail categories/Epingles/Recent
                 depuis la refonte maitre/detail 0.93.5.0-dev. Icones dans un
                 badge rond au degrade Lumora (NovaIdentityMarkBrush, meme
                 degrade que la marque) plutot qu'un glyphe nu sur fond
                 transparent - retour utilisateur : les tuiles etaient "trop
                 simplistes, ne correspondent pas a Lumora" (glyphes systeme
                 Segoe MDL2 monochromes, aucune identite visuelle propre). -->
            <DataTemplate x:Key="StartMenuActionTileTemplate">
                <Button Style="{StaticResource NovaPanelActionButtonStyle}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Margin="0,0,8,8" Width="278"
                        Tag="{Binding Id}" Click="StartMenuTile_Click"
                        AutomationProperties.Name="{Binding Title}">
                    <Button.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{Binding PinActionLabel}" Tag="{Binding Id}" Click="StartMenuTilePin_Click" />
                        </MenuFlyout>
                    </Button.ContextFlyout>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Grid Width="30" Height="30">
                            <Border CornerRadius="15" Background="{StaticResource NovaIdentityMarkBrush}" />
                            <FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Opacity="0.62" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </DataTemplate>

            <DataTemplate x:Key="StartMenuDetailTileTemplate">
                <Button Style="{StaticResource NovaPanelActionButtonStyle}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Margin="0,0,0,8"
                        Tag="{Binding Id}" Click="StartMenuTile_Click"
                        AutomationProperties.Name="{Binding Title}">
                    <Button.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{Binding PinActionLabel}" Tag="{Binding Id}" Click="StartMenuTilePin_Click" />
                        </MenuFlyout>
                    </Button.ContextFlyout>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Grid Width="30" Height="30">
                            <Border CornerRadius="15" Background="{StaticResource NovaIdentityMarkBrush}" />
                            <FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                      Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Opacity="0.62" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </DataTemplate>

            <!-- Rail de categories (colonne de gauche) : Epingles + une entree
                 par section du registre. Bouton pleine largeur a l'interieur
                 d'un ListViewItem plutot qu'un ListViewItem stylise
                 directement, pour garder le meme motif clic/tooltip que le
                 reste du menu. Meme badge degrade que les tuiles pour rester
                 coherent (0.93.5.0-dev). -->
            <DataTemplate x:Key="StartMenuCategoryTemplate">
                <Grid ColumnSpacing="10" Padding="10,9" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{Binding Title}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="26" Height="26">
                        <Border CornerRadius="13" Background="{StaticResource NovaIdentityMarkBrush}" />
                        <FontIcon Glyph="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                  Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition x:Name="TopTabsRow" Height="52" />
            <RowDefinition x:Name="NavigationRow" Height="72" />
            <RowDefinition x:Name="BookmarksRow" Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="BottomTabsRow" Height="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="FullScreenTopBar"
              Grid.RowSpan="7"
              Canvas.ZIndex="50"
              Height="44"
              VerticalAlignment="Top"
              Padding="10,0"
              ColumnSpacing="6"
              Visibility="Collapsed"
              Background="{StaticResource NovaChromeSurfaceBrush}"
              PointerEntered="FullScreenTopBar_PointerEntered"
              PointerExited="FullScreenTopBar_PointerExited">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7">
                    <Image Source="ms-appx:///Assets/LumoraApp.png"
                           Width="24" Height="24"
                           Stretch="Uniform" />
                </Border>
                <TextBlock Text="Lumora" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="FullScreenAddressText"
                       Grid.Column="1"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Opacity="0.74"
                       TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="2"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Nouvel onglet"
                    AutomationProperties.Name="Nouvel onglet"
                    Click="NewTabMenu_Click">
                <SymbolIcon Symbol="Add" />
            </Button>
            <Button Grid.Column="3"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Accueil"
                    AutomationProperties.Name="Accueil"
                    Click="HomeMenu_Click">
                <SymbolIcon Symbol="Home" />
            </Button>
            <Button x:Name="FullScreenExitButton"
                    Grid.Column="4"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Quitter le plein ecran"
                    AutomationProperties.Name="Quitter le plein ecran"
                    Click="CompactModeButton_Click">
                <SymbolIcon Symbol="BackToWindow" />
            </Button>
            <Button x:Name="MainMenuButton"
                    Grid.Column="5"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    AutomationProperties.Name="Menu Lumora"
                    ToolTipService.ToolTip="Menu Lumora">
                <SymbolIcon Symbol="More" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem Text="LUMORA • lumière locale" IsEnabled="False">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE790;" FontFamily="Segoe MDL2 Assets" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem Text="Navigation">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE8AB;" FontFamily="Segoe MDL2 Assets" />
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem Text="Nouvel onglet" Click="NewTabMenu_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Add" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Incognito" Click="IncognitoWindowMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Rouvrir l'onglet ferme" Click="ReopenTabMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Groupes enregistres" Click="SavedTabGroupsMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Accueil Lumora" Click="HomeMenu_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Home" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Arrêter le chargement" Click="StopButton_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="Stop" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Plein écran" Click="CompactModeButton_Click">
                                <MenuFlyoutItem.Icon><SymbolIcon Symbol="FullScreen" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Bibliothèque">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets" />
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem Text="Favoris" Click="BookmarksMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE735;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Importer / exporter les favoris" Click="ImportMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D5;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Historique" Click="HistoryMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Téléchargements" Click="DownloadsMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Notes et annotations" Click="NotesMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70B;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Flux RSS" Click="RssMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C1;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Sécurité et données">
                            <MenuFlyoutSubItem.Icon>
                                <FontIcon Glyph="&#xEA18;" FontFamily="Segoe MDL2 Assets" />
                            </MenuFlyoutSubItem.Icon>
                            <MenuFlyoutItem Text="Site actuel" Click="SiteControlMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Sessions conservées" Click="SessionsManageLink_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Mots de passe" Click="VaultMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Importer des mots de passe" Click="ImportPasswordsMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D5;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Clés d'accès" Click="PasskeysMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D7;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Portefeuille" Click="WalletMenu_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C7;" FontFamily="Segoe MDL2 Assets" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Paramètres" Click="SettingsMenu_Click">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Setting" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="À propos" Click="AboutMenu_Click">
                            <MenuFlyoutItem.Icon><SymbolIcon Symbol="Help" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Fond permanent de la bande de titre, sous BrowserTabs : quand les onglets
             sont verticaux (BrowserTabs masqué), cette bande reste visible et doit
             avoir EXACTEMENT la même couleur que les boutons système (ApplyWindowTitleBarColors),
             sans quoi un liseré de couleur différente apparaît autour d'eux — c'est
             ce qui rend l'intégration "sale" comparé à Chrome. -->
        <Grid Grid.Row="1" IsHitTestVisible="False">
            <Border Background="{StaticResource NovaChromeSurfaceBrush}" />
            <Ellipse Width="210"
                     Height="94"
                     Margin="18,-30,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Fill="{StaticResource NovaChromeHaloWarmGlowBrush}" />
            <Ellipse Width="260"
                     Height="116"
                     Margin="0,-42,96,0"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Fill="{StaticResource NovaChromeHaloCoolGlowBrush}" />
            <Border Height="1"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource NovaChromeMistBrush}"
                    Opacity="0.85" />
        </Grid>

        <TabView
            x:Name="BrowserTabs"
            Grid.Row="1"
            Background="{StaticResource NovaChromeSurfaceBrush}"
            BorderBrush="{StaticResource NovaChromeStrokeSoftBrush}"
            CanReorderTabs="True"
            TabWidthMode="SizeToContent"
            AddTabButtonClick="BrowserTabs_AddTabButtonClick"
            SelectionChanged="BrowserTabs_SelectionChanged"
            TabCloseRequested="BrowserTabs_TabCloseRequested"
            Tapped="BrowserTabs_Tapped">
            <TabView.TabStripHeader>
                <!-- Repere d'identite minimal : juste la marque, pour laisser
                     toute la largeur disponible aux onglets eux-memes. Le nom
                     complet "LUMORA - lumière locale" reste present ailleurs
                     (menu Lumora, a propos) - inutile de le repeter ici. -->
                <Border x:Name="TabStripBrandBadge"
                        Width="24"
                        Height="24"
                        Margin="10,14,8,14"
                        CornerRadius="12"
                        Background="{StaticResource NovaBrandChipBackgroundBrush}"
                        BorderBrush="{StaticResource NovaBrandChipBorderBrush}"
                        BorderThickness="1"
                        ToolTipService.ToolTip="Lumora"
                        AutomationProperties.Name="Lumora">
                    <Grid Width="12" Height="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Polygon Points="6,0 12,6 6,12 0,6" Fill="{StaticResource NovaIdentityMarkBrush}" />
                        <Ellipse Width="4"
                                 Height="4"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource NovaChromeSurfaceBrush}"
                                 Opacity="0.38" />
                    </Grid>
                </Border>
            </TabView.TabStripHeader>
        </TabView>

        <Border x:Name="ModeChromeAccentStrip"
                Grid.Row="1"
                Height="2"
                VerticalAlignment="Top"
                Background="{StaticResource NovaIdentityMarkBrush}"
                Opacity="0.95" />

        <!-- Bouton menu Demarrer : point d'ancrage a gauche, hors de la
             capsule de la barre d'outils, comme le bouton Windows/Ubuntu
             ne se mele jamais aux autres icones de la barre des taches. -->
        <Button x:Name="ModulesButton"
                Grid.Row="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Width="40" Height="40"
                Margin="18,0,0,0"
                Style="{StaticResource NovaChromeIconButtonStyle}"
                AutomationProperties.Name="Menu Lumora"
                ToolTipService.ToolTip="Menu Lumora — modules, favoris, paramètres">
            <Path x:Name="ModulesButtonMark" Width="21" Height="21" Stretch="Uniform"
                  Fill="{StaticResource NovaIdentityMarkBrush}"
                  Data="M20,4 L44,4 A16,16 0 0 1 60,20 L60,44 A16,16 0 0 1 44,60 L20,60 A16,16 0 0 1 4,44 L4,20 A16,16 0 0 1 20,4 Z M50,6 L60,6 L60,16 L38,38 L28,28 Z" />
            <Button.Flyout>
                <Flyout x:Name="ModulesFlyout" Placement="BottomEdgeAlignedLeft" FlyoutPresenterStyle="{StaticResource StartMenuFlyoutPresenterStyle}" Opening="ModulesFlyout_Opening">
                    <StackPanel x:Name="ModulesFlyoutRoot" Width="600" Spacing="0">

                        <!-- En-tete profil (0.93.5.0-dev, deplace depuis la barre de statut basse) :
                             photo + nom en tete du menu, comme un vrai menu demarrer Windows - clic
                             ouvre le meme ProfileStatusFlyout qu'avant (deplace avec lui, aucune
                             nouvelle logique de profil). -->
                        <Button x:Name="ProfileStatusButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="10,10"
                                Margin="0,0,0,12"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="12"
                                ToolTipService.ToolTip="Ouvrir le menu profil"
                                AutomationProperties.Name="Profil Lumora"
                                Click="ProfileStatusButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Ellipse x:Name="ProfileStatusAvatar" Width="38" Height="38" Visibility="Collapsed">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="ProfileStatusAvatarBrush" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock x:Name="ProfileStatusText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Opacity="0.92" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="ProfileStatusFlyout" Placement="TopEdgeAlignedRight">
                                    <StackPanel Width="340" Spacing="12">
                                        <Border Style="{StaticResource NovaFlyoutHeroCardStyle}">
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="ProfileFlyoutTitleText"
                                                           Text="Profil Lumora"
                                                           FontWeight="SemiBold"
                                                           FontSize="18"
                                                           Foreground="{StaticResource NovaBrandChipForegroundBrush}" />
                                                <TextBlock x:Name="ProfileFlyoutSubtitleText"
                                                           Text="Gerez l'utilisateur local, les profils et les reglages de cette session."
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Opacity="0.82"
                                                           Foreground="{StaticResource NovaBrandChipMutedBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource NovaFlyoutSectionCardStyle}">
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="ProfileFlyoutCurrentUserText"
                                                           Text="Aucun profil actif"
                                                           FontWeight="SemiBold" />
                                                <TextBlock x:Name="ProfileFlyoutCurrentStateText"
                                                           Text="Creer ou choisir un profil local pour garder vos donnees."
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Opacity="0.68" />
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="ProfileFlyoutSettingsButton"
                                                Style="{StaticResource NovaModuleFlyoutActionStyle}"
                                                Click="ProfileFlyoutSettingsButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Parametres utilisateur" FontWeight="SemiBold" />
                                                    <TextBlock Text="Ouvrir les reglages du profil local, du PIN et des autres comptes." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ProfileFlyoutSwitchButton"
                                                Style="{StaticResource NovaModuleFlyoutActionStyle}"
                                                Click="ProfileFlyoutSwitchButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Changer d'utilisateur" FontWeight="SemiBold" />
                                                    <TextBlock Text="Afficher le choix des profils locaux sur cet ordinateur." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ProfileFlyoutCreateButton"
                                                Style="{StaticResource NovaModuleFlyoutActionStyle}"
                                                Click="ProfileFlyoutCreateButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Creer un utilisateur" FontWeight="SemiBold" />
                                                    <TextBlock Text="Ajouter un nouveau profil Lumora sur cet appareil." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- En-tete : mark + recherche en direct (filtre la grille sur place,
                             StartMenuSearchBox_TextChanged - ne delegue plus a la palette
                             de commande separee) + fermeture -->
                        <Grid ColumnSpacing="10" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="24" Height="24" Stretch="Uniform"
                                  Fill="{StaticResource NovaIdentityMarkBrush}"
                                  Data="M20,4 L44,4 A16,16 0 0 1 60,20 L60,44 A16,16 0 0 1 44,60 L20,60 A16,16 0 0 1 4,44 L4,20 A16,16 0 0 1 20,4 Z M50,6 L60,6 L60,16 L38,38 L28,28 Z" />
                            <TextBox Grid.Column="1" x:Name="StartMenuSearchBox"
                                     Style="{StaticResource NovaCommandPaletteSearchBoxStyle}"
                                     PlaceholderText="Rechercher un module, un favori, un site..."
                                     TextChanged="StartMenuSearchBox_TextChanged"
                                     AutomationProperties.Name="Rechercher un module, un favori, un site" />
                            <Button Grid.Column="2" Style="{StaticResource NovaChromeIconButtonStyle}"
                                    ToolTipService.ToolTip="Fermer" AutomationProperties.Name="Fermer le menu" Click="ModulesFlyoutCloseButton_Click">
                                <SymbolIcon Symbol="Cancel" />
                            </Button>
                        </Grid>

                        <!-- Rail de categories (gauche) + volet detail (droite) : refonte
                             maitre/detail 0.93.5.0-dev (a la Windows 7, Panneau de configuration
                             en vue categories), demande explicite de l'utilisateur pour remplacer
                             l'ancien bascule Epingles-par-defaut/Toutes-les-applications qui
                             obligeait a naviguer entre deux ecrans. "Epingles" est desormais une
                             categorie comme les autres, toujours en tete du rail, selectionnee par
                             defaut a l'ouverture (ModulesFlyout_Opening) - comme un vrai menu
                             demarrer (Windows/GNOME), on y revient a chaque ouverture. -->
                        <Grid x:Name="StartMenuRailAndDetail" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="192" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ListView x:Name="StartMenuCategoryList"
                                      Grid.Column="0"
                                      SelectionMode="Single"
                                      ItemTemplate="{StaticResource StartMenuCategoryTemplate}"
                                      SelectionChanged="StartMenuCategoryList_SelectionChanged"
                                      AutomationProperties.Name="Catégories du menu Démarrer" />

                            <Border Grid.Column="1" Width="1" HorizontalAlignment="Left"
                                    Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- x:Name pose ici expres (correctif molette defensif, meme motif que
                                 SettingsPanel_RootWheelDiagnostics/MainWindow.xaml.cs:489-566) : ce
                                 flyout bascule maintenant entre 2 contenus (rail+detail / recherche),
                                 le meme genre de changement dynamique qui avait fait "s'arreter" la
                                 molette sur Parametres apres un moment. -->
                            <ScrollViewer x:Name="StartMenuDetailScrollViewer" Grid.Column="1" Margin="14,0,0,0"
                                          MaxHeight="480" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="StartMenuDetailTitleIcon" FontFamily="Segoe MDL2 Assets" FontSize="12" Opacity="0.7" />
                                        <TextBlock x:Name="StartMenuDetailTitleText" Style="{StaticResource NovaPanelSectionTitleStyle}" FontSize="13" />
                                    </StackPanel>

                                    <!-- Recent et frequent : uniquement dans la categorie Epingles, appris
                                         de l'usage reel (StartMenuTileUsage, upsert a chaque ouverture
                                         d'une tuile). Masquee tant qu'aucune tuile n'a ete ouverte au
                                         moins une fois (pas de deviner un defaut et l'appeler "appris"). -->
                                    <Border x:Name="StartMenuRecentCard"
                                            Style="{StaticResource NovaFlyoutHeroCardStyle}"
                                            Background="{StaticResource NovaBookmarkButtonActiveBackgroundBrush}"
                                            BorderBrush="{StaticResource NovaBookmarkButtonActiveBorderBrush}"
                                            BorderThickness="1.5"
                                            Visibility="Collapsed">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource NovaBookmarkButtonActiveForegroundBrush}" />
                                                <TextBlock Text="Récent et fréquent" Foreground="{StaticResource NovaBookmarkButtonActiveForegroundBrush}" Style="{StaticResource NovaPanelSectionTitleStyle}" FontSize="13" FontWeight="Bold" />
                                            </StackPanel>
                                            <ItemsRepeater x:Name="StartMenuRecentList" ItemTemplate="{StaticResource StartMenuDetailTileTemplate}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Tuiles epinglees (clic droit / appui long sur n'importe quelle
                                         tuile -> Epingler/Desepingler, dans n'importe quelle categorie) :
                                         visible uniquement quand la categorie Epingles est selectionnee. -->
                                    <StackPanel x:Name="StartMenuPinnedSection" Spacing="8">
                                        <ItemsRepeater x:Name="StartMenuPinnedRow" ItemTemplate="{StaticResource StartMenuDetailTileTemplate}" />
                                        <TextBlock x:Name="StartMenuPinnedEmptyText"
                                                   Text="Aucune tuile épinglée. Clic droit sur une tuile, dans n'importe quelle catégorie, pour l'ajouter ici."
                                                   Style="{StaticResource NovaPanelDescriptionStyle}"
                                                   TextWrapping="Wrap"
                                                   Visibility="Collapsed" />
                                    </StackPanel>

                                    <!-- Tuiles de la categorie selectionnee (source unique
                                         StartMenuTileRegistry.All) : visible pour toute categorie autre
                                         qu'Epingles. -->
                                    <ItemsRepeater x:Name="StartMenuDetailList" ItemTemplate="{StaticResource StartMenuDetailTileTemplate}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Recherche en direct : liste plate triee par score (meme forme
                             que ScoreCommandPaletteItem), visible uniquement pendant une
                             recherche active - remplace le rail+detail ci-dessus le temps
                             de la recherche (StartMenuRailAndDetail.Visibility=Collapsed). -->
                        <ScrollViewer x:Name="StartMenuFilteredScrollViewer" MaxHeight="480" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="12" Width="600">
                                <ItemsRepeater x:Name="StartMenuFilteredList"
                                              Visibility="Collapsed"
                                              ItemTemplate="{StaticResource StartMenuActionTileTemplate}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout Orientation="Horizontal" MaximumRowsOrColumns="2" MinItemWidth="278" MinItemHeight="46" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                                <TextBlock x:Name="StartMenuNoResultsText"
                                           Text="Aucun résultat"
                                           Style="{StaticResource NovaPanelDescriptionStyle}"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

        <Border x:Name="NavigationToolbarCapsule"
                Grid.Row="2"
                Margin="66,6,14,6"
                CornerRadius="22"
                Background="{StaticResource NovaFloatingGlassBrush}"
                BorderBrush="{StaticResource NovaChromeStrokeSoftBrush}"
                BorderThickness="1"
                Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
        <Grid x:Name="NavigationToolbar"
              SizeChanged="NavigationToolbar_SizeChanged"
              Padding="12,6,12,7"
              ColumnSpacing="6"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="NavigationMenuDividerColumn" Width="Auto" />
                <ColumnDefinition x:Name="NavigationMenuButtonColumn" Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse Grid.Column="4"
                     Grid.ColumnSpan="5"
                     Width="220"
                     Height="64"
                     Margin="-28,-6,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Fill="{StaticResource NovaChromeHaloWarmGlowBrush}"
                     IsHitTestVisible="False" />
            <Border Grid.Column="4"
                    Grid.ColumnSpan="13"
                    Margin="0,2,0,2"
                    CornerRadius="19"
                    Background="{StaticResource NovaChromeMistBrush}"
                    Opacity="0.16"
                    IsHitTestVisible="False" />
            <Border Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Margin="0,2,8,2"
                    CornerRadius="18"
                    Background="{StaticResource NovaCompanionGlassBrush}"
                    BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False" />
            <Border Grid.Column="4"
                    Grid.ColumnSpan="2"
                    Margin="8,0,10,0"
                    CornerRadius="22"
                    Background="{StaticResource NovaBrandChipBackgroundBrush}"
                    BorderBrush="{StaticResource NovaBrandChipBorderBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False" />
            <Border x:Name="NavigationToolbarToolsShell"
                    Grid.Column="6"
                    Grid.ColumnSpan="11"
                    Margin="6,2,8,2"
                    CornerRadius="18"
                    Background="{StaticResource NovaCompanionGlassBrush}"
                    BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False" />

            <Button Grid.Column="0" Style="{StaticResource NovaChromeIconButtonStyle}" ToolTipService.ToolTip="Retour" AutomationProperties.Name="Retour" Click="BackButton_Click">
                <SymbolIcon Style="{StaticResource NovaChromeSymbolIconStyle}" Symbol="Back" />
            </Button>
            <Button Grid.Column="1" Style="{StaticResource NovaChromeIconButtonStyle}" ToolTipService.ToolTip="Avancer" AutomationProperties.Name="Avancer" Click="ForwardButton_Click">
                <SymbolIcon Style="{StaticResource NovaChromeSymbolIconStyle}" Symbol="Forward" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource NovaChromeIconButtonStyle}" ToolTipService.ToolTip="Recharger" AutomationProperties.Name="Recharger" Click="ReloadButton_Click">
                <SymbolIcon Style="{StaticResource NovaChromeSymbolIconStyle}" Symbol="Refresh" />
            </Button>
            <Button Grid.Column="3"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Stop"
                    AutomationProperties.Name="Stop"
                    Visibility="Collapsed"
                    Click="StopButton_Click">
                <SymbolIcon Style="{StaticResource NovaChromeSymbolIconStyle}" Symbol="Cancel" />
            </Button>
            <Grid Grid.Column="4" Margin="6,0">
                <Border Margin="0,1,0,1"
                        VerticalAlignment="Center"
                        CornerRadius="22"
                        BorderThickness="1"
                        BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                        Background="{StaticResource NovaAddressBackgroundBrush}"
                        IsHitTestVisible="False" />
                <Border Margin="1"
                        VerticalAlignment="Center"
                        CornerRadius="21"
                        Background="{StaticResource NovaChromeHaloCoolBrush}"
                        Opacity="0.12"
                        IsHitTestVisible="False" />
                <TextBox
                    x:Name="AddressBox"
                    MinHeight="42"
                    Padding="54,8,18,8"
                    CornerRadius="22"
                    Background="Transparent"
                    BorderBrush="{StaticResource NovaAddressBorderBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource NovaAddressForegroundBrush}"
                    PlaceholderForeground="{StaticResource NovaTextMutedBrush}"
                    FocusVisualPrimaryBrush="{StaticResource NovaFocusBrush}"
                    FocusVisualSecondaryBrush="{StaticResource NovaFocusInnerBrush}"
                    AutomationProperties.Name="Adresse ou recherche"
                    VerticalAlignment="Center"
                    KeyDown="AddressBox_KeyDown"
                    TextChanged="AddressBox_TextChanged"
                    LostFocus="AddressBox_LostFocus"
                    PlaceholderText="Aller vers un site ou lancer une recherche" />
                <Border Height="1"
                        Margin="18,8,20,0"
                        VerticalAlignment="Top"
                        Background="{StaticResource NovaChromeMistBrush}"
                        Opacity="0.9"
                        IsHitTestVisible="False" />
                <Border Height="1"
                        Margin="26,0,26,8"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource NovaChromeHaloWarmBrush}"
                        Opacity="0.42"
                        IsHitTestVisible="False" />
                <Border x:Name="AddressIdentityBadge"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="30"
                        Height="30"
                        Margin="10,0,0,0"
                        Padding="0"
                        CornerRadius="15"
                        Background="{StaticResource NovaBrandChipBackgroundBrush}"
                        BorderBrush="{StaticResource NovaBrandChipBorderBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False">
                    <Grid Width="12" Height="12"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Polygon Points="6,0 12,6 6,12 0,6" Fill="{StaticResource NovaIdentityMarkBrush}" />
                        <Ellipse Width="4"
                                 Height="4"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource NovaChromeSurfaceBrush}"
                                 Opacity="0.38" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Suggestions locales pendant la frappe : onglets ouverts, favoris,
                 historique. Popup ancré sous la barre d'adresse via PlacementTarget
                 (rendu dans la couche popup, au-dessus du WebView2). Jamais de requête
                 réseau : tout vient des stores locaux du profil. -->
            <Popup x:Name="AddressSuggestionsPopup"
                   PlacementTarget="{x:Bind AddressBox}"
                   DesiredPlacement="Bottom"
                   IsLightDismissEnabled="False">
                <Border x:Name="AddressSuggestionsSurface"
                        Background="{StaticResource NovaBrandChipBackgroundBrush}"
                        BorderBrush="{StaticResource NovaBrandChipBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="8"
                        MaxHeight="420"
                        PointerEntered="AddressSuggestions_PointerEntered"
                        PointerExited="AddressSuggestions_PointerExited">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock Text="Trajectoires Lumora"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource NovaAddressForegroundBrush}" />
                                <TextBlock Text="Tout reste local : onglets, favoris et historique."
                                           FontSize="11"
                                           Opacity="0.68"
                                           Foreground="{StaticResource NovaTextMutedBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Padding="8,3"
                                    CornerRadius="11"
                                    Background="{StaticResource NovaCompanionGlassBrush}"
                                    BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="local"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource NovaAddressForegroundBrush}" />
                            </Border>
                        </Grid>
                        <ListView x:Name="AddressSuggestionsList"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  ItemClick="AddressSuggestionsList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,9" ColumnSpacing="10"
                                          AutomationProperties.Name="{Binding AccessibleName}"
                                          ToolTipService.ToolTip="{Binding AccessibleName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                Background="{StaticResource NovaCompanionGlassBrush}"
                                                BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding Glyph}"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="13"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Foreground="{StaticResource NovaAddressForegroundBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding UrlDisplay}"
                                                       Opacity="0.62"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Padding="8,3"
                                                CornerRadius="11"
                                                Background="{StaticResource NovaChromeHaloWarmBrush}">
                                            <TextBlock Text="{Binding KindLabel}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource NovaAddressForegroundBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Popup>
            <Button Grid.Column="5"
                    Style="{StaticResource NovaChromeAccentIconButtonStyle}"
                    ToolTipService.ToolTip="Ouvrir l'adresse"
                    AutomationProperties.Name="Ouvrir l'adresse"
                    Click="GoButton_Click">
                <SymbolIcon Style="{StaticResource NovaChromeAccentSymbolIconStyle}" Symbol="Forward" />
            </Button>

            <!-- Bouton bouclier confidentialité -->
            <Button x:Name="ShieldButton"
                    Grid.Column="6"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    AutomationProperties.Name="Confidentialité du site"
                    ToolTipService.ToolTip="Confidentialité">
                <Grid Width="22" Height="22">
                    <FontIcon Style="{StaticResource NovaChromeFontIconStyle}" Glyph="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border x:Name="TelemetryActivityBadge"
                            MinWidth="16"
                            Height="16"
                            Padding="3,0"
                            CornerRadius="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-5,-7,0"
                            Background="{StaticResource NovaCoolAccentBrush}"
                            BorderBrush="{StaticResource NovaChromeSurfaceBrush}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ShieldBlockedBadgeText"
                                   Text="0"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NovaTextOnAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <Button.Flyout>
                    <Flyout x:Name="ShieldFlyout"
                            Opening="ShieldFlyout_Opening"
                            Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="330" Spacing="12">
                            <TextBlock x:Name="ShieldDomainText"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ShieldBlockedCountText"
                                       Opacity="0.65"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ShieldSiteSummaryText"
                                       Opacity="0.65"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ShieldRecommendationText"
                                       Opacity="0.82"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <StackPanel x:Name="ShieldRecentBlocksPanel"
                                        Spacing="4" />
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                            <ToggleSwitch x:Name="ShieldSiteExcludeToggle"
                                          Header="Exclure ce site du bloqueur"
                                          Toggled="ShieldSiteExcludeToggle_Toggled" />
                            <Button x:Name="ShieldSiteCenterButton"
                                    Content="Centre du site"
                                    HorizontalAlignment="Stretch"
                                    Click="ShieldSiteCenterButton_Click" />
                            <HyperlinkButton Content="Paramètres de confidentialité"
                                             Click="ShieldSettingsLink_Click"
                                             HorizontalAlignment="Left"
                                             Padding="0" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!-- Étoile d'état : pleine et accentuée quand la page courante est
                 déjà en favori, contour simple sinon. Rafraîchie à chaque
                 navigation, changement d'onglet et modification des favoris. -->
            <Button Grid.Column="7" x:Name="AddBookmarkButton" Style="{StaticResource NovaBookmarkIconButtonStyle}" ToolTipService.ToolTip="Ajouter aux favoris" AutomationProperties.Name="Ajouter aux favoris" Click="AddBookmarkButton_Click">
                <FontIcon x:Name="BookmarkStarIcon" Style="{StaticResource NovaBookmarkFontIconStyle}" Glyph="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="17" />
            </Button>
            <!-- Acces rapide aux identifiants du site courant, sans ouvrir tout le
                 panneau coffre (meme esprit que les extensions de gestionnaire de
                 mots de passe type Proton Pass). -->
            <Button x:Name="VaultQuickAccessButton"
                    Grid.Column="8"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Identifiants de ce site"
                    AutomationProperties.Name="Identifiants de ce site">
                <FontIcon Style="{StaticResource NovaChromeFontIconStyle}" Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                <Button.Flyout>
                    <Flyout x:Name="VaultQuickAccessFlyout"
                            Opening="VaultQuickAccessFlyout_Opening"
                            Placement="BottomEdgeAlignedRight">
                        <StackPanel x:Name="VaultQuickAccessPanel" Width="320" Spacing="10" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="9"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Accueil"
                    AutomationProperties.Name="Accueil"
                    Visibility="Collapsed"
                    Click="HomeMenu_Click">
                <SymbolIcon Style="{StaticResource NovaChromeSymbolIconStyle}" Symbol="Home" />
            </Button>
            <Button x:Name="CompactModeButton"
                    Grid.Column="10"
                    Style="{StaticResource NovaChromeIconButtonStyle}"
                    ToolTipService.ToolTip="Interface compacte"
                    AutomationProperties.Name="Interface compacte"
                    Visibility="Collapsed"
                    Click="CompactModeButton_Click">
                <SymbolIcon Style="{StaticResource NovaChromeSymbolIconStyle}" Symbol="FullScreen" />
            </Button>
            <Border x:Name="ModulesQuickBar"
                    Grid.Column="11"
                    Grid.ColumnSpan="6"
                    Padding="0"
                    BorderThickness="0"
                    Background="Transparent"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <!-- Refus automatique des cookies (0.84.0.10) : masqué tant qu'aucun
                         signal n'est arrivé pour la page active, visible dès que
                         ConsentManagerModule a agi (bouton direct ou panneau détaillé). -->
                    <Button x:Name="ConsentIndicatorButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Cookies refusés automatiquement"
                            ToolTipService.ToolTip="Cookies refusés automatiquement"
                            Visibility="Collapsed">
                        <FontIcon Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xED1A;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                        <Button.Flyout>
                            <Flyout x:Name="ConsentIndicatorFlyout"
                                    Opening="ConsentIndicatorFlyout_Opening"
                                    Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="10">
                                    <TextBlock Text="Cookies"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock x:Name="ConsentIndicatorText"
                                               Opacity="0.75"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- Popups retenues en attente d'un choix explicite (0.84.0.6) :
                         masqué tant qu'aucune popup n'est en attente sur l'onglet
                         courant, comme l'icône de popup bloqué de Chrome/Firefox/Edge. -->
                    <Button x:Name="PopupRecoveryButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Popups en attente"
                            ToolTipService.ToolTip="Popups en attente"
                            Visibility="Collapsed">
                        <Grid>
                            <SymbolIcon Style="{StaticResource NovaModuleSymbolIconStyle}" Symbol="Stop" />
                            <Border x:Name="PopupRecoveryBadge"
                                    Background="{StaticResource NovaAccentBrush}"
                                    CornerRadius="7" MinWidth="14" Height="14"
                                    Padding="3,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-6,-7,0">
                                <TextBlock x:Name="PopupRecoveryBadgeText"
                                           Text="1" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource NovaTextOnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="PopupRecoveryFlyout"
                                    Opening="PopupRecoveryFlyout_Opening"
                                    Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="320" Spacing="10">
                                    <TextBlock Text="Popups en attente"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock Text="Un vrai clic vers ce(s) site(s) a demandé une nouvelle fenêtre. Lumora ne peut pas deviner si c'est voulu (connexion, partage...) ou un détournement : à toi de choisir."
                                               Opacity="0.65"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                    <StackPanel x:Name="PopupRecoveryPanel" Spacing="6" />
                                    <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                    <Button x:Name="PopupRecoveryAlwaysAllowButton"
                                            Content="Toujours autoriser les popups de ce site"
                                            HorizontalAlignment="Stretch"
                                            Click="PopupRecoveryAlwaysAllowButton_Click" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <!-- Indicateur de telechargements (0.84.0.8) : masque tant qu'aucun
                         telechargement n'a eu lieu durant la session. Depuis 0.84.0.7,
                         Lumora supprime la boite de dialogue native de WebView2/Edge
                         (args.Handled = true) - cette icone redonne un signal visible
                         pendant/apres, comme Chrome/Edge/Firefox le font nativement. -->
                    <Button x:Name="DownloadsIndicatorButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Telechargements"
                            ToolTipService.ToolTip="Telechargements"
                            Visibility="Collapsed">
                        <Grid>
                            <FontIcon Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                            <Border x:Name="DownloadsIndicatorBadge"
                                    Background="{StaticResource NovaAccentBrush}"
                                    CornerRadius="7" MinWidth="14" Height="14"
                                    Padding="3,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-6,-7,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="DownloadsIndicatorBadgeText"
                                           Text="1" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource NovaTextOnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Button.Flyout>
                            <Flyout x:Name="DownloadsIndicatorFlyout"
                                    Opening="DownloadsIndicatorFlyout_Opening"
                                    Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="340" Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Telechargements" FontWeight="SemiBold" FontSize="14" />
                                        <HyperlinkButton Grid.Column="1" Content="Tout voir" Padding="0"
                                                         Click="DownloadsIndicatorSeeAllButton_Click" />
                                    </Grid>
                                    <StackPanel x:Name="DownloadsIndicatorPanel" Spacing="6" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="ReaderModeButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Mode lecture - surligner et commenter cette page"
                            ToolTipService.ToolTip="Mode lecture - surligner et commenter cette page"
                            Click="ReaderModeButton_Click">
                        <Grid>
                            <FontIcon Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                            <Border x:Name="ReaderAnnotationBadge"
                                    Background="{StaticResource NovaAccentBrush}"
                                    CornerRadius="7" MinWidth="14" Height="14"
                                    Padding="3,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-6,-7,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="ReaderAnnotationBadgeText"
                                           Text="0" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource NovaTextOnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="NotesModuleButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Notes et annotations"
                            ToolTipService.ToolTip="Notes et annotations"
                            Click="NotesMenu_Click">
                        <FontIcon Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <Button x:Name="RssModuleButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Flux RSS"
                            ToolTipService.ToolTip="Flux RSS"
                            Click="RssMenu_Click">
                        <Grid>
                            <FontIcon Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                            <Border x:Name="RssModuleBadge"
                                    Background="{StaticResource NovaAccentBrush}"
                                    CornerRadius="7" MinWidth="14" Height="14"
                                    Padding="3,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-6,-7,0"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="RssModuleBadgeText"
                                           Text="1" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource NovaTextOnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                    <!-- Diviser l'ecran (0.93.4.0) : point d'entree direct au split view,
                         qui n'existait auparavant que par clic droit sur un onglet
                         (menu contextuel/selection multiple, toujours conserves). -->
                    <Button x:Name="SplitViewButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Diviser l'écran entre deux onglets"
                            ToolTipService.ToolTip="Diviser l'écran entre deux onglets"
                            Click="SplitViewButton_Click">
                        <FontIcon x:Name="SplitViewButtonIcon" Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <Button x:Name="ReadAloudButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Lire la page à voix haute"
                            ToolTipService.ToolTip="Lire la page à voix haute (traitement local, aucune donnée envoyée)"
                            Click="ReadAloudButton_Click">
                        <FontIcon x:Name="ReadAloudIcon" Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                        <Button.Flyout>
                            <Flyout x:Name="ReadAloudFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="220" Spacing="10">
                                    <TextBlock Text="Lecture à voix haute" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock x:Name="ReadAloudStatusText" TextWrapping="Wrap" FontSize="12" Opacity="0.78" Text="Prêt." />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="ReadAloudPlayPauseButton" Content="Lire la page" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12" Click="ReadAloudPlayPauseButton_Click" />
                                        <Button Content="Arrêter" Style="{StaticResource NovaCompactButtonStyle}" Click="ReadAloudStopButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="ReadingLensButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Loupe de lecture"
                            ToolTipService.ToolTip="Loupe de lecture - agrandir la page pour mieux lire (captcha deforme, texte minuscule)"
                            Click="ReadingLensButton_Click">
                        <FontIcon Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <Button x:Name="DetachVideoPinnedButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            ToolTipService.ToolTip="Détacher la vidéo"
                            AutomationProperties.Name="Détacher la vidéo"
                            Visibility="Collapsed"
                            Click="DetachVideoMenu_Click">
                        <FontIcon Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <Button x:Name="VideoDownloadButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            ToolTipService.ToolTip="Télécharger la vidéo"
                            AutomationProperties.Name="Télécharger la vidéo">
                        <FontIcon Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                        <Button.Flyout>
                            <Flyout x:Name="VideoDownloadFlyout"
                                    Opening="VideoDownloadFlyout_Opening"
                                    Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="320" Spacing="10">
                                    <TextBlock Text="Télécharger la vidéo"
                                               FontWeight="SemiBold"
                                               FontSize="15" />
                                    <TextBlock x:Name="VideoDownloadTitleText"
                                               TextWrapping="Wrap"
                                               Opacity="0.78" />
                                    <TextBlock x:Name="VideoDownloadEngineText"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Opacity="0.68" />
                                    <Border Height="1"
                                            Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                    <ComboBox x:Name="VideoDownloadQualityCombo"
                                              Header="Qualite"
                                              HorizontalAlignment="Stretch"
                                              IsEnabled="False"
                                              SelectionChanged="VideoDownloadQualityCombo_SelectionChanged">
                                        <ComboBoxItem Content="Meilleure qualite disponible" Tag="Best" IsSelected="True" />
                                        <ComboBoxItem Content="1080p" Tag="Q1080" />
                                        <ComboBoxItem Content="720p" Tag="Q720" />
                                        <ComboBoxItem Content="480p" Tag="Q480" />
                                    </ComboBox>
                                    <TextBlock x:Name="VideoDownloadStatusText"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Opacity="0.72" />
                                    <ProgressBar x:Name="VideoDownloadProgressBar"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Visibility="Collapsed" />
                                    <Button x:Name="VideoDownloadInstallEngineButton"
                                            Content="Installer le moteur yt-dlp (open source)"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Visibility="Collapsed"
                                            Click="VideoDownloadInstallEngine_Click" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="VideoDownloadStartButton"
                                                Content="Télécharger"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="VideoDownloadStartButton_Click" />
                                        <Button Content="Téléchargements"
                                                Click="DownloadsMenu_Click"
                                                Style="{StaticResource NovaCompactButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="TranslatePinnedButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            ToolTipService.ToolTip="Traduction locale"
                            AutomationProperties.Name="Traduction locale"
                            Visibility="Collapsed"
                            Click="ModulesTranslate_Click">
                        <FontIcon Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xF2B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <!-- Acces direct, toujours visible (pas besoin de passer par le menu
                         Lumora) : un clic installe la page active comme application, sans
                         detour par le panneau Applications. Demande explicite le
                         2026-07-26 - "trop de manipulations pour faire une application". -->
                    <Button x:Name="InstallWebAppQuickButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            ToolTipService.ToolTip="Installer cette page comme application"
                            AutomationProperties.Name="Installer cette page comme application"
                            Click="InstallAppMenu_Click">
                        <FontIcon Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <Button x:Name="WebAppsPinnedButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            ToolTipService.ToolTip="Applications web"
                            AutomationProperties.Name="Applications web"
                            Visibility="Collapsed"
                            Click="WebAppsMenu_Click">
                        <FontIcon Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <Button x:Name="SearchAssistButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Préciser ma recherche"
                            ToolTipService.ToolTip="Préciser ma recherche (IA locale, aucune donnée envoyée)"
                            Click="SearchAssistButton_Click">
                        <FontIcon Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                        <Button.Flyout>
                            <Flyout x:Name="SearchAssistFlyout" Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="300" Spacing="10">
                                    <TextBlock Text="Requête précisée" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock x:Name="SearchAssistSuggestionText" TextWrapping="Wrap" FontSize="13" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SearchAssistUseButton" Content="Utiliser" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12" Click="SearchAssistUseButton_Click" />
                                        <Button Content="Ignorer" Style="{StaticResource NovaCompactButtonStyle}" Click="SearchAssistIgnoreButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="DictationPinnedButton"
                            Style="{StaticResource NovaModuleIconButtonStyle}"
                            AutomationProperties.Name="Dictee vocale"
                            ToolTipService.ToolTip="Dictee vocale"
                            Visibility="Collapsed"
                            Click="MicDictationButton_Click">
                        <FontIcon Style="{StaticResource NovaModuleFontIconStyle}" Glyph="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="14,0,14,8"
                CornerRadius="18"
                Background="{StaticResource NovaFloatingGlassBrush}"
                BorderBrush="{StaticResource NovaChromeStrokeSoftBrush}"
                BorderThickness="1"
                Translation="0,0,24">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
        <Grid x:Name="BookmarksBarRow"
              Padding="10,6,10,6"
              ColumnSpacing="8"
              SizeChanged="BookmarksBarRow_SizeChanged"
              RightTapped="WorkspaceLayoutSurface_RightTapped"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0"
                     Grid.ColumnSpan="2"
                     Width="180"
                     Height="54"
                     Margin="-18,-10,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Fill="{StaticResource NovaChromeHaloWarmGlowBrush}"
                     IsHitTestVisible="False" />
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="5"
                        Margin="2,0,10,0"
                        VerticalAlignment="Center"
                        Opacity="0.6">
                <TextBlock Text="✦" FontSize="10" Foreground="{StaticResource NovaAccentBrush}" />
                <TextBlock Text="Constellation" FontSize="10.5" Foreground="{StaticResource NovaTextMutedBrush}" />
            </StackPanel>
            <StackPanel x:Name="BookmarksBarPanel"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center" />
            <Border Grid.Column="2"
                    Width="1"
                    Height="18"
                    Margin="5,0"
                    Background="{StaticResource NovaChromeStrokeBrush}" />
            <StackPanel x:Name="OtherBookmarksBarHost"
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center" />
        </Grid>
        </Border>

        <Grid x:Name="ContentHost" Grid.Row="4" Background="{StaticResource NovaAppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition x:Name="WorkspaceBottomBookmarksRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorkspaceLeftBookmarksColumn" Width="0" />
                <ColumnDefinition x:Name="WorkspaceLeftTabsColumn" Width="0" />
                <ColumnDefinition x:Name="WorkspaceLeftTabsResizeColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="WorkspaceRightTabsResizeColumn" Width="0" />
                <ColumnDefinition x:Name="WorkspaceRightTabsColumn" Width="0" />
                <ColumnDefinition x:Name="WorkspaceRightBookmarksColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="BookmarksSideRail"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Width="220"
                    Margin="8,8,8,8"
                    Padding="12,12,10,12"
                    CornerRadius="24"
                    BorderThickness="1"
                    BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                    Background="{StaticResource NovaChromeGradientBrush}"
                    RightTapped="WorkspaceLayoutSurface_RightTapped"
                    Visibility="Collapsed">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse Fill="{StaticResource NovaIdentityMarkBrush}" />
                            <Ellipse Width="4"
                                     Height="4"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource NovaChromeSurfaceBrush}"
                                     Opacity="0.38" />
                        </Grid>
                        <TextBlock Text="Favoris"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource NovaAddressForegroundBrush}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  SizeChanged="BookmarksLayoutHost_SizeChanged">
                        <StackPanel x:Name="BookmarksSideBarPanel" Spacing="4" />
                    </ScrollViewer>
                    <StackPanel x:Name="OtherBookmarksSideHost"
                                Grid.Row="2"
                                Spacing="6" />
                </Grid>
            </Border>

            <Border
                x:Name="VerticalTabsRail"
                Grid.RowSpan="2"
                Grid.Column="1"
                Width="210"
                Margin="8,8,8,8"
                Padding="10"
                CornerRadius="24"
                BorderThickness="1"
                BorderBrush="{StaticResource NovaCompanionStrokeBrush}"
                Background="{StaticResource NovaChromeGradientBrush}"
                Visibility="Collapsed"
                Canvas.ZIndex="45"
                VerticalAlignment="Stretch"
                RightTapped="WorkspaceLayoutSurface_RightTapped"
                PointerEntered="VerticalTabsRail_PointerEntered"
                PointerExited="VerticalTabsRail_PointerExited">
                <StackPanel Spacing="8">
                    <StackPanel x:Name="VerticalTabsActionsPanel" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="VerticalTabsNewTabButton"
                                HorizontalAlignment="Stretch"
                                ToolTipService.ToolTip="Nouvel onglet"
                                AutomationProperties.Name="Nouvel onglet"
                                Click="NewTabMenu_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Add" />
                                <TextBlock x:Name="VerticalTabsNewTabLabel" Text="Nouvel onglet" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="VerticalTabsCompactButton"
                            Width="34"
                            AutomationProperties.Name="Reduire ou agrandir les onglets verticaux"
                            ToolTipService.ToolTip="Reduire/agrandir les onglets verticaux"
                            Click="VerticalTabsCompactButton_Click">
                            <SymbolIcon Symbol="Pin" />
                        </Button>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="VerticalTabsPanelItems" Spacing="4" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Thumb
                x:Name="VerticalTabsResizeThumb"
                Grid.RowSpan="2"
                Grid.Column="2"
                Width="12"
                DragDelta="VerticalTabsResizeThumb_DragDelta"
                DragCompleted="VerticalTabsResizeThumb_DragCompleted"
                Visibility="Collapsed">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbRoot"
                                Background="Transparent"
                                ToolTipService.ToolTip="Faire glisser pour redimensionner">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ThumbLine.Opacity" Value="1" />
                                            <Setter Target="ThumbRoot.Background" Value="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ThumbLine.Opacity" Value="1" />
                                            <Setter Target="ThumbRoot.Background" Value="{ThemeResource SystemControlHighlightBaseLowBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="ThumbLine"
                                    Width="3" Height="48" CornerRadius="2"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Opacity="0.45" />
                        </Border>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Grid x:Name="BrowserPanel" Grid.Row="0" Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- InfoBar affichée une seule fois, la première fois qu'une purge de
                     sessions a réellement lieu, pour expliquer le comportement. -->
                <InfoBar x:Name="SessionPurgeInfoBar" Grid.Row="0" Severity="Informational"
                         Margin="10,8,10,0"
                         IsOpen="False" Title="Sessions de la visite precedente nettoyees"
                         Message="Les sites que vous n'avez pas marques comme sites de confiance repartent a zero a chaque demarrage de Lumora."
                         Closed="SessionPurgeInfoBar_Closed">
                    <InfoBar.ActionButton>
                        <Button Content="Gerer les sites connectes" Click="SessionsManageLink_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Barre de proposition d'enregistrement d'identifiants -->
                <Border x:Name="CredentialSaveBar" Grid.Row="1" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0" Symbol="Permissions" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CredentialSaveText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="CredentialSaveAccept" Grid.Column="2" Content="Enregistrer" Click="CredentialSaveAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="CredentialSaveDismiss" Grid.Column="3" Content="Ignorer" Click="CredentialSaveDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Barre de proposition de remplissage automatique -->
                <Border x:Name="AutoFillBar" Grid.Row="2" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0" Symbol="Contact" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AutoFillText" Grid.Column="1" VerticalAlignment="Center"/>
                        <Button x:Name="AutoFillAccept" Grid.Column="2" Content="Remplir" Click="AutoFillAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <!-- Visible uniquement quand plusieurs comptes existent pour ce site (ex. 2 comptes Google) -->
                        <Button x:Name="AutoFillChooseButton" Grid.Column="2" Content="Choisir un compte" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12">
                            <Button.Flyout>
                                <MenuFlyout x:Name="AutoFillAccountsFlyout" Placement="Bottom"/>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="AutoFillDismiss" Grid.Column="3" Content="Ignorer" Click="AutoFillDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Barre de proposition de remplissage d'une carte du portefeuille.
                     Remplissage UNIQUEMENT sur clic : jamais de pré-remplissage silencieux
                     (un script de page ne doit pas pouvoir aspirer la carte). -->
                <Border x:Name="WalletFillBar" Grid.Row="3" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="WalletFillText" Grid.Column="1" VerticalAlignment="Center" Text="Page de paiement détectée — remplir avec une carte du portefeuille ?"/>
                        <Button x:Name="WalletFillAccept" Grid.Column="2" Content="Remplir" Click="WalletFillAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="WalletFillDismiss" Grid.Column="3" Content="Ignorer" Click="WalletFillDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Barre proposée après un login détecté, quand les sessions éphémères
                     sont actives et que le site n'est pas déjà connu (confiance ou refus). -->
                <Border x:Name="SessionKeepBar" Grid.Row="4" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0" Symbol="Keyboard" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SessionKeepText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="SessionKeepAccept" Grid.Column="2" Content="Conserver la session" Click="SessionKeepAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SessionKeepDismiss" Grid.Column="3" Content="Non merci" Click="SessionKeepDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Barre de suggestion de mot de passe fort, sur detection d'un champ
                     "nouveau mot de passe" (inscription, changement de mot de passe). -->
                <Border x:Name="SuggestPasswordBar" Grid.Row="5" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0" Symbol="Permissions" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Utiliser un mot de passe fort genere ?" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SuggestPasswordValueText" FontFamily="Consolas" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="SuggestPasswordAccept" Grid.Column="2" Content="Utiliser" Click="SuggestPasswordAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SuggestPasswordRegenerate" Grid.Column="3" Content="Regenerer" Click="SuggestPasswordRegenerate_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                        <Button x:Name="SuggestPasswordDismiss" Grid.Column="4" Content="Ignorer" Click="SuggestPasswordDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Bandeau de proposition de traduction locale de la page (modele
                     telecharge une fois puis mis en cache, traduction 100% hors ligne
                     ensuite). Jamais automatique : uniquement sur clic explicite. -->
                <Border x:Name="TranslateBar" Grid.Row="6" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xF2B7;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TranslateText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Cette page semble etre en anglais. La traduire en francais ?"/>
                        <Button x:Name="TranslateAccept" Grid.Column="2" Content="Traduire" Click="TranslateAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="TranslateDismiss" Grid.Column="3" Content="Non merci" Click="TranslateDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Garde-fou : quand on ferme ou dissout un groupe non enregistre,
                     propose de le ranger dans la bibliotheque avant qu'il disparaisse. -->
                <Border x:Name="SaveGroupBar" Grid.Row="7" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SaveGroupText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="SaveGroupAccept" Grid.Column="2" Content="Garder ce groupe" Click="SaveGroupAccept_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SaveGroupDismiss" Grid.Column="3" Content="Non" Click="SaveGroupDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Reprise « site introuvable » : le domaine ne se resout plus (site
                     ferme, nom de domaine change, faute de frappe). Suggestion calculee
                     100% localement ; la recherche web ne part QUE sur clic explicite,
                     vers le moteur de recherche configure. -->
                <Border x:Name="SiteNotFoundBar" Grid.Row="8" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SiteNotFoundText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="SiteNotFoundTrySuggestion" Grid.Column="2" Visibility="Collapsed" Click="SiteNotFoundTrySuggestion_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                        <Button x:Name="SiteNotFoundSearch" Grid.Column="3" Content="Rechercher ce site sur le web" Click="SiteNotFoundSearch_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SiteNotFoundDismiss" Grid.Column="4" Content="Fermer" Click="SiteNotFoundDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- Site demenage : une redirection permanente (301/308) vers un autre
                     domaine a ete observee et des favoris/raccourcis pointent encore
                     vers l'ancien. Proposition unique par demenagement ; apprentissage
                     100% local (SiteRelocationStore), rien n'est envoye nulle part. -->
                <Border x:Name="SiteMovedBar" Grid.Row="9" Visibility="Collapsed"
                        Background="{StaticResource NovaInfoSurfaceBrush}"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        Padding="10,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SiteMovedText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="SiteMovedUpdate" Grid.Column="2" Content="Mettre a jour" Click="SiteMovedUpdate_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,2" FontSize="12"/>
                        <Button x:Name="SiteMovedDismiss" Grid.Column="3" Content="Non merci" Click="SiteMovedDismiss_Click" Style="{StaticResource NovaCompactButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- 0.78.3.1 : les navigations publicitaires/parasites sont
                     bloquees silencieusement (statut + bouclier), plus de barre
                     « Continuer quand meme ». Une adresse tapee dans la barre
                     n'est jamais bloquee ; la whitelist par site reste la
                     soupape durable. -->
                <Grid x:Name="BrowserHost" Grid.Row="11" />

                <!-- Ecran natif "Compagnon du mode" (colonne identitaire) :
                     recouvre BrowserHost UNIQUEMENT quand ChromeLayoutStyle ==
                     "identitySpine" ET l'onglet actif est lumora://accueil -
                     la page HTML continue de se charger dessous, inchangee
                     (MainWindow.IdentitySpine.cs,
                     UpdateIdentitySpineHomeHeroVisibility()). Reutilise les
                     memes styles que ModeCompanionFlyout (NovaFlyoutHeroCardStyle,
                     NovaFlyoutSectionCardStyle, NovaModuleFlyoutActionStyle) :
                     meme Lumie, juste presente en grand. -->
                <Grid x:Name="IdentitySpineHomeHero"
                      Grid.Row="11"
                      Visibility="Collapsed"
                      Background="{StaticResource NovaAppBackgroundBrush}">
                    <StackPanel MaxWidth="560" Spacing="16"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock x:Name="IdentitySpineHeroEyebrowText"
                                       HorizontalAlignment="Center"
                                       FontSize="12" FontWeight="SemiBold" CharacterSpacing="60"
                                       Foreground="{StaticResource NovaCoolAccentBrush}" />
                            <TextBlock x:Name="IdentitySpineHeroTitleText"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       FontSize="38" FontWeight="SemiBold"
                                       Foreground="{StaticResource NovaBrandChipForegroundBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="IdentitySpineHeroBodyText"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" FontSize="14"
                                   Foreground="{StaticResource NovaBrandChipMutedBrush}" />

                        <Border Style="{StaticResource NovaFlyoutSectionCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="IdentitySpineHeroMemoryTitleText"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBox x:Name="IdentitySpineHeroObjectiveBox"
                                         MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap"
                                         AutomationProperties.Name="Objectif du compagnon" />
                                <Button x:Name="IdentitySpineHeroSaveButton"
                                        Content="Garder dans Lumie"
                                        Style="{StaticResource NovaCompactButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Click="IdentitySpineHeroSaveButton_Click" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="IdentitySpineHeroPrimaryButton"
                                Style="{StaticResource NovaModuleFlyoutActionStyle}"
                                Click="IdentitySpineHeroPrimaryButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon x:Name="IdentitySpineHeroPrimaryIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="IdentitySpineHeroPrimaryTitleText" FontWeight="SemiBold" />
                                    <TextBlock x:Name="IdentitySpineHeroPrimaryHintText" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button x:Name="IdentitySpineHeroSecondaryButton"
                                Style="{StaticResource NovaModuleFlyoutActionStyle}"
                                Click="IdentitySpineHeroSecondaryButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon x:Name="IdentitySpineHeroSecondaryIcon" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="IdentitySpineHeroSecondaryTitleText" FontWeight="SemiBold" />
                                    <TextBlock x:Name="IdentitySpineHeroSecondaryHintText" FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="BookmarksPanel" Grid.Column="3" Padding="16" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Favoris Lumora" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Dossiers" Opacity="0.68" />
                    </StackPanel>
                    <ListView
                        x:Name="BookmarkFoldersList"
                        Grid.Row="1"
                        RightTapped="BookmarkFoldersList_RightTapped"
                        SelectionChanged="BookmarkFoldersList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="16" Height="16" Source="{Binding IconImageUri}" Visibility="{Binding IconImageVisibility}" />
                                    <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Visibility="{Binding IconGlyphVisibility}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Opacity="0.62" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid Grid.Column="2" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock x:Name="CurrentBookmarkFolderTitle" Text="Barre des favoris" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="BookmarkBreadcrumbText" Opacity="0.68" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Nouveau dossier" Click="NewBookmarkFolderButton_Click" />
                        <Button Grid.Column="2" Content="Renommer" Click="RenameBookmarkButton_Click" />
                        <Button Grid.Column="3" Content="Tout sélectionner" Click="SelectAllBookmarksButton_Click" />
                        <Button Grid.Column="4" Content="Supprimer sélection" Click="DeleteBookmarkButton_Click" />
                        <Button Grid.Column="5" Content="Vider" Click="ClearBookmarksButton_Click" />
                        <Button Grid.Column="6" Content="Importer" Click="ImportMenu_Click" />
                        <Button Grid.Column="7" Content="Exporter" Click="ExportHtmlButton_Click" />
                    </Grid>

                    <TextBox
                        x:Name="BookmarksSearchBox"
                        Grid.Row="1"
                        TextChanged="BookmarksSearchBox_TextChanged"
                        PlaceholderText="Rechercher dans les favoris..." />

                    <ListView
                        x:Name="BookmarksList"
                        Grid.Row="2"
                        SelectionMode="Extended"
                        DoubleTapped="BookmarksList_DoubleTapped"
                        RightTapped="BookmarksList_RightTapped"
                        SelectionChanged="BookmarksList_SelectionChanged"
                        KeyDown="BookmarksList_KeyDown">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="16" Height="16" Source="{Binding IconImageUri}" Visibility="{Binding IconImageVisibility}" />
                                    <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="15" Visibility="{Binding IconGlyphVisibility}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <Grid x:Name="ImportPanel" Grid.Column="3" Padding="28" Visibility="Collapsed">
                <StackPanel Spacing="14" MaxWidth="820">
                    <TextBlock Text="Importer et exporter" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.78"
                               Text="Lumora lit les profils Chromium detectes sur cette machine et peut aussi importer/exporter un fichier HTML de favoris. Les donnees restent dans le profil local Lumora." />
                    <TextBlock Text="Depuis un navigateur installe" FontWeight="SemiBold" />
                    <TextBlock x:Name="ImportSourcesStatusText" TextWrapping="Wrap" Opacity="0.72" />
                    <ListView x:Name="ImportSourcesList" MaxHeight="260" SelectionChanged="ImportSourcesList_SelectionChanged" />
                    <TextBlock x:Name="ImportComparisonText" TextWrapping="Wrap" Opacity="0.72" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Fusionner le navigateur selectionne" Click="ImportBrowserButton_Click" />
                        <Button Content="Remplacer par le navigateur selectionne" Click="ReplaceBrowserButton_Click" />
                    </StackPanel>
                    <TextBlock Text="Fichier HTML" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Importer un fichier HTML" Click="ImportHtmlButton_Click" />
                        <Button Content="Exporter en HTML" Click="ExportHtmlButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- SettingsPanel : centre de pilotage Lumora -->
            <Grid x:Name="SettingsPanel" Grid.Column="3" Visibility="Collapsed"
                  Background="{StaticResource NovaPanelBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Navigation du centre Lumora -->
                <Border Grid.RowSpan="2"
                        Grid.Column="0"
                        Margin="18,18,12,18"
                        Style="{StaticResource NovaPanelShellCardStyle}">
                    <StackPanel Spacing="12">
                        <Border Style="{StaticResource NovaFlyoutHeroCardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Centre Lumora" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Le coeur du navigateur : ambiance, organisation, confort et donnees locales."
                                           Style="{StaticResource NovaPanelDescriptionStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NovaPanelCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Navigation rapide" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                <RadioButton x:Name="SettingsNavOverview" Content="Vue d'ensemble"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav" IsChecked="True"
                                             Click="SettingsNav_Click" Tag="overview" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NovaPanelCardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Espace personnel" Opacity="0.6" FontSize="11" />
                                <RadioButton x:Name="SettingsNavAppearance" Content="Mon Lumora"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             Click="SettingsNav_Click" Tag="appearance" />
                                <RadioButton x:Name="SettingsNavProfile" Content="Profils locaux"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             Click="SettingsNav_Click" Tag="profile" />
                                <RadioButton x:Name="SettingsNavAccessibility" Content="Confort"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             Click="SettingsNav_Click" Tag="accessibility" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NovaPanelCardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Travail quotidien" Opacity="0.6" FontSize="11" />
                                <RadioButton x:Name="SettingsNavNavigation" Content="Espace de travail"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             Click="SettingsNav_Click" Tag="navigation" />
                                <RadioButton x:Name="SettingsNavStartup" Content="Ouverture"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             Click="SettingsNav_Click" Tag="startup" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NovaPanelCardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Donnees locales" Opacity="0.6" FontSize="11" />
                                <RadioButton x:Name="SettingsNavPrivacy" Content="Vie privee locale"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             Click="SettingsNav_Click" Tag="privacy" />
                                <RadioButton x:Name="SettingsNavVault" Content="Coffre et donnees"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             Click="SettingsNav_Click" Tag="vault" />
                                <RadioButton x:Name="SettingsNavStorage" Content="Stockage local"
                                             Style="{StaticResource NovaSideRailNavRadioButtonStyle}"
                                             GroupName="SettingsNav"
                                             Click="SettingsNav_Click" Tag="storage" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Zone de contenu des paramètres -->
                <ScrollViewer x:Name="SettingsContentScrollViewer"
                              Grid.Row="0" Grid.Column="1"
                              VerticalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="28,22,28,18" Margin="0,0,18,0">
                    <StackPanel Spacing="18" MaxWidth="760">
                        <Border Style="{StaticResource NovaFlyoutHeroCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Façonnez un navigateur qui vous ressemble"
                                           Style="{StaticResource NovaPanelPageTitleStyle}" />
                                <TextBlock Text="Lumora garde une base claire : lumiere, relief et lisibilite. Ensuite, vous choisissez votre rythme, vos panneaux et votre confort sans vous perdre dans des sous-menus."
                                           Style="{StaticResource NovaPanelDescriptionStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Mon Lumora"
                                            Tag="appearance"
                                            Click="SettingsNavigateButton_Click"
                                            Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    <Button Content="Espace de travail"
                                            Tag="navigation"
                                            Click="SettingsNavigateButton_Click"
                                            Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    <Button Content="Vie privee"
                                            Tag="privacy"
                                            Click="SettingsNavigateButton_Click"
                                            Style="{StaticResource NovaPanelActionButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Section : Vue d'ensemble -->
                        <StackPanel x:Name="SettingsSectionOverview" Spacing="14">
                            <TextBlock Text="Centre Lumora" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="Un point d'entrée pour façonner votre navigateur : ambiance, organisation, confidentialité locale et données du profil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource NovaPanelShellCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Mon Lumora" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Avatar, thème, accueil, rythme visuel et confort de l'interface." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <Button Content="Personnaliser" Tag="appearance" Click="SettingsNavigateButton_Click" Style="{StaticResource NovaPanelActionButtonStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource NovaPanelShellCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Espace de travail" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Recherche, onglets, barre verticale, commandes rapides et outils de productivité." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <Button Content="Organiser" Tag="navigation" Click="SettingsNavigateButton_Click" Style="{StaticResource NovaPanelActionButtonStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource NovaPanelShellCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Vie privée locale" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Protections actives, sessions, cookies, listes de filtrage et exceptions." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <Button Content="Proteger" Tag="privacy" Click="SettingsNavigateButton_Click" Style="{StaticResource NovaPanelActionButtonStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource NovaPanelShellCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Coffre et données" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Mots de passe, portefeuille, sauvegardes et stockage local du profil." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <Button Content="Gerer" Tag="vault" Click="SettingsNavigateButton_Click" Style="{StaticResource NovaPanelActionButtonStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource NovaPanelShellCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Profils locaux" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Identité, verrouillage, PIN, récupération et profils sur cet ordinateur." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <Button Content="Ouvrir" Tag="profile" Click="SettingsNavigateButton_Click" Style="{StaticResource NovaPanelActionButtonStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource NovaPanelShellCardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Confort" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Lisibilité, focus clavier, réduction des animations, voix et lecture à haute voix." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <Button Content="Adapter" Tag="accessibility" Click="SettingsNavigateButton_Click" Style="{StaticResource NovaPanelActionButtonStyle}" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="Lumora garde ces choix dans votre profil local. Aucun tableau de bord distant, aucune synchronisation forcée."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                        </StackPanel>

                        <!-- Section : Espace de travail -->
                        <StackPanel x:Name="SettingsSectionNavigation" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Espace de travail" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="Organisez les repères qui vous servent tous les jours : recherche, onglets, commandes rapides et modules utiles."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <TextBlock Text="Recherche" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <ComboBox x:Name="SearchEngineCombo" Header="Moteur de recherche" Width="280"
                                      SelectionChanged="SearchEngineCombo_SelectionChanged">
                                <ComboBoxItem Content="Google" Tag="google" />
                                <ComboBoxItem Content="DuckDuckGo" Tag="duckduckgo" />
                                <ComboBoxItem Content="Brave Search" Tag="brave" />
                                <ComboBoxItem Content="Bing" Tag="bing" />
                            </ComboBox>
                            <ToggleSwitch x:Name="AddressSuggestionsSwitch" Header="Suggestions dans la barre d'adresse" Toggled="AddressSuggestionsSwitch_Toggled" />
                            <TextBlock Text="Pendant la frappe, propose vos onglets ouverts, favoris et pages deja visitees. Calcul 100% local sur cet appareil : ce que vous tapez n'est jamais envoye a un service de suggestions."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="TranslationEnabledSwitch" Header="Proposer de traduire les pages" Toggled="TranslationEnabledSwitch_Toggled" />
                            <TextBlock Text="Traduction neuronale locale (actuellement anglais vers francais). Le modele est telecharge une seule fois puis la traduction se fait entierement hors ligne, jamais de texte envoye a un serveur."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="SearchAssistEnabledSwitch" Header="Assistant IA pour preciser mes recherches" Toggled="SearchAssistEnabledSwitch_Toggled" />
                            <TextBlock Text="Desactive par defaut : necessite un telechargement unique d'environ 2,7 Go (modele de langage local Phi-3-mini). Une fois telechargee, la reformulation se fait hors ligne ; seule la requete finale que vous validez est envoyee a votre moteur de recherche, exactement comme aujourd'hui."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="HistorySemanticSearchEnabledSwitch" Header="Recherche intelligente dans l'historique" Toggled="HistorySemanticSearchEnabledSwitch_Toggled" />
                            <TextBlock Text="Retrouvez une page par son sens plutot que par mot-clé exact (« cet article sur la fiscalité des indépendants »), meme sans vous souvenir du titre ou du site. Desactive par defaut : necessite un telechargement unique d'environ 120 Mo (modele d'embedding local multilingual-e5-small). Une fois active, le contenu texte des pages visitees est analyse et indexe localement (chiffre comme le reste de l'historique) ; rien n'est jamais envoye a un serveur."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Onglets" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <ToggleSwitch x:Name="VerticalTabsSwitch" Header="Barre d'onglets verticale" Toggled="VerticalTabsSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Palette de commande" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Raccourci Ctrl+K" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="Ctrl+K ouvre une recherche rapide dans les onglets, favoris, historique et commandes de Lumora. Par defaut, le raccourci respecte les champs de saisie et les formulaires web."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Ouvrir Ctrl+K"
                                                Style="{StaticResource NovaCompactButtonStyle}"
                                                Click="SettingsOpenCommandPaletteButton_Click" />
                                        <Button Content="Ouverture"
                                                Style="{StaticResource NovaCompactButtonStyle}"
                                                Click="SettingsStartupShortcutButton_Click" />
                                        <Button Content="Confort"
                                                Style="{StaticResource NovaCompactButtonStyle}"
                                                Click="SettingsAccessibilityShortcutButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <ToggleSwitch x:Name="CommandPaletteEnabledSwitch"
                                          Header="Palette de commande Ctrl+K"
                                          Toggled="CommandPaletteEnabledSwitch_Toggled" />
                            <ToggleSwitch x:Name="CommandPaletteWebPagesSwitch"
                                          Header="Autoriser Ctrl+K depuis les pages web"
                                          Toggled="CommandPaletteContextSwitch_Toggled" />
                            <ToggleSwitch x:Name="CommandPaletteTextFieldsSwitch"
                                          Header="Autoriser Ctrl+K pendant la saisie dans un champ"
                                          Toggled="CommandPaletteContextSwitch_Toggled" />
                            <TextBlock Text="Activez ces deux autorisations uniquement si vous voulez que Lumora intercepte Ctrl+K meme quand une page ou un champ de texte a le focus."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                        </StackPanel>

                        <!-- Section : Personnalisation -->
                        <StackPanel x:Name="SettingsSectionAppearance" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Mon Lumora" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="Choisissez l'ambiance, le rythme et les repères visuels qui rendent Lumora confortable pour vous."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="64" Height="64" VerticalAlignment="Top">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="ProfileAvatarBrush" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Avatar Lumora" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Image locale visible dans le bandeau bas du navigateur. Elle reste dans ce profil et n'est jamais synchronisee."
                                                   Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Choisir une image"
                                                    Click="ChangeAvatarButton_Click"
                                                    Style="{StaticResource NovaCompactButtonStyle}" />
                                            <Button x:Name="RemoveAvatarButton"
                                                    Content="Supprimer"
                                                    Click="RemoveAvatarButton_Click"
                                                    Style="{StaticResource NovaCompactButtonStyle}"
                                                    Visibility="Collapsed" />
                                        </StackPanel>
                                        <TextBlock x:Name="AvatarPendingText"
                                                   Style="{StaticResource NovaPanelDescriptionStyle}"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="64" Height="64" CornerRadius="8" VerticalAlignment="Top">
                                        <Border.Background>
                                            <ImageBrush x:Name="WallpaperPreviewBrush" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Fond d'ecran (page Nouvel onglet)" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Image locale affichee derriere la page Nouvel onglet uniquement - jamais sur la barre d'outils ni les onglets, pour ne jamais gener la lecture des boutons. Reste dans ce profil, jamais synchronisee."
                                                   Style="{StaticResource NovaPanelDescriptionStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Choisir une image"
                                                    Click="ChangeWallpaperButton_Click"
                                                    Style="{StaticResource NovaCompactButtonStyle}" />
                                            <Button x:Name="RemoveWallpaperButton"
                                                    Content="Supprimer"
                                                    Click="RemoveWallpaperButton_Click"
                                                    Style="{StaticResource NovaCompactButtonStyle}"
                                                    Visibility="Collapsed" />
                                        </StackPanel>
                                        <TextBlock x:Name="WallpaperPendingText"
                                                   Style="{StaticResource NovaPanelDescriptionStyle}"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="Apparence" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <ComboBox x:Name="ThemeModeCombo" Header="Theme" Width="220"
                                      SelectionChanged="ThemeModeCombo_SelectionChanged">
                                <ComboBoxItem Content="Sombre" Tag="dark" />
                                <ComboBoxItem Content="Clair" Tag="light" />
                                <ComboBoxItem Content="Systeme" Tag="system" />
                            </ComboBox>
                            <ComboBox x:Name="AccentPaletteCombo" Header="Palette Lumora" Width="260"
                                      SelectionChanged="AppearanceOption_Changed">
                                <ComboBoxItem Content="Lumora cyan" Tag="lumora" />
                                <ComboBoxItem Content="Ocean" Tag="ocean" />
                                <ComboBoxItem Content="Foret" Tag="forest" />
                                <ComboBoxItem Content="Ambre" Tag="ember" />
                            </ComboBox>
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Disposition Lumora"
                                               Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="Le theme Lumora reste la signature de base ; ici, vous composez votre propre ergonomie en plaçant les zones du navigateur autour du contenu."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <ComboBox x:Name="TabStripPositionCombo"
                                              Header="Position des onglets"
                                              Width="260"
                                              SelectionChanged="TabStripPositionCombo_SelectionChanged">
                                        <ComboBoxItem Content="Haut" Tag="top" />
                                        <ComboBoxItem Content="Bas" Tag="bottom" />
                                        <ComboBoxItem Content="Gauche" Tag="left" />
                                        <ComboBoxItem Content="Droite" Tag="right" />
                                    </ComboBox>
                                    <ComboBox x:Name="BookmarksBarPositionCombo"
                                              Header="Position des favoris"
                                              Width="260"
                                              SelectionChanged="BookmarksBarPositionCombo_SelectionChanged">
                                        <ComboBoxItem Content="Haut" Tag="top" />
                                        <ComboBoxItem Content="Bas" Tag="bottom" />
                                        <ComboBoxItem Content="Gauche" Tag="left" />
                                        <ComboBoxItem Content="Droite" Tag="right" />
                                    </ComboBox>
                                    <ComboBox x:Name="ChromeLayoutStyleCombo"
                                              Header="Style de disposition"
                                              Width="260"
                                              SelectionChanged="ChromeLayoutStyleCombo_SelectionChanged">
                                        <ComboBoxItem Content="Classique" Tag="classic" />
                                        <ComboBoxItem Content="Colonne identitaire" Tag="identitySpine" />
                                    </ComboBox>
                                    <TextBlock Text="La colonne identitaire remplace la barre d'outils et les onglets classiques par une colonne verticale teintee du Mode d'usage, avec une barre d'adresse invocable. Coexiste avec la position des onglets ci-dessus : revenir en Classique retablit exactement l'affichage precedent."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <ToggleSwitch x:Name="IdentitySpineAutoHideSwitch"
                                                  Header="Masquer automatiquement la colonne et la capsule"
                                                  Toggled="IdentitySpineAutoHideSwitch_Toggled" />
                                    <TextBlock Text="Comme la barre des taches Windows : la colonne et la capsule se replient quand la souris s'eloigne, et reapparaissent au survol du bord gauche ou du bord haut. Les favoris integres restent toujours visibles pendant le repli."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Presets d'espace Lumora"
                                               Style="{StaticResource NovaPanelSectionTitleStyle}"
                                               Opacity="0.72" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Halo"
                                                Tag="top|top"
                                                Click="WorkspacePresetButton_Click"
                                                Style="{StaticResource NovaCompactButtonStyle}" />
                                        <Button Content="Atelier"
                                                Tag="left|right"
                                                Click="WorkspacePresetButton_Click"
                                                Style="{StaticResource NovaCompactButtonStyle}" />
                                        <Button Content="Flux"
                                                Tag="bottom|left"
                                                Click="WorkspacePresetButton_Click"
                                                Style="{StaticResource NovaCompactButtonStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="Halo garde une lecture classique lumineuse, Atelier ouvre un espace de travail lateral, Flux pousse les zones d'outil hors du haut de fenetre pour liberer la vue. Les positions ci-dessus et ces presets s'appliquent maintenant tout de suite."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                </StackPanel>
                            </Border>
                            <ToggleSwitch x:Name="BookmarksBarSwitch" Header="Barre de favoris visible" Toggled="BookmarksBarSwitch_Toggled" />
                            <ToggleSwitch x:Name="CompactModeSwitch" Header="Interface compacte" Toggled="CompactModeSwitch_Toggled" />
                            <ToggleSwitch x:Name="CompactModeHideBookmarksSwitch"
                                          Header="Masquer les favoris en interface compacte"
                                          Toggled="CompactModeHideBookmarksSwitch_Toggled" />
                            <ToggleSwitch x:Name="FullScreenAutoHideChromeSwitch"
                                          Header="Masquer les barres en plein ecran et les reveler au survol"
                                          Toggled="FullScreenAutoHideChromeSwitch_Toggled" />
                            <TextBlock Text="En plein ecran, approchez la souris du haut pour les actions principales, ou du bord gauche pour retrouver le rail lateral."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,8,0,0" />
                            <TextBlock Text="Nouvel onglet" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBox x:Name="NewTabTitleBox"
                                     Header="Titre affiche"
                                     MaxLength="32"
                                     TextChanged="NewTabTitleBox_TextChanged" />
                            <ComboBox x:Name="NewTabStyleCombo" Header="Style du nouvel onglet" Width="260"
                                      SelectionChanged="AppearanceOption_Changed">
                                <ComboBoxItem Content="Signature" Tag="signature" />
                                <ComboBoxItem Content="Calme" Tag="calm" />
                                <ComboBoxItem Content="Minimal" Tag="minimal" />
                            </ComboBox>
                            <TextBlock Text="Personnalité Lumora" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <ComboBox x:Name="UsageModeCombo" Header="Mode d'usage" Width="280"
                                      SelectionChanged="AppearanceOption_Changed">
                                <ComboBoxItem Content="Neutre" Tag="neutral" />
                                <ComboBoxItem Content="Équilibre" Tag="balanced" />
                                <ComboBoxItem Content="Focus" Tag="focus" />
                                <ComboBoxItem Content="Lecture" Tag="reading" />
                                <ComboBoxItem Content="Création" Tag="creative" />
                                <ComboBoxItem Content="Recherche" Tag="research" />
                                <ComboBoxItem Content="Nuit" Tag="night" />
                            </ComboBox>
                            <TextBlock Text="Le mode d'usage adapte l'accueil Lumora et prépare la logique des futurs espaces de travail."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <TextBlock Text="Couleur du mode d'usage" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <TextBlock Text="Chaque mode garde sa propre teinte Lumora par defaut ; choisissez une couleur pour la remplacer sur ce mode uniquement (le second ton du degrade est derive automatiquement). Reinitialiser revient a la teinte Lumora d'origine. Sans effet si le contraste eleve (Confort) est actif."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Button x:Name="ModeColorSwatchNeutralButton"
                                            Tag="neutral"
                                            Style="{StaticResource NovaModeColorSwatchButtonStyle}"
                                            ToolTipService.ToolTip="Couleur du mode Neutre"
                                            AutomationProperties.Name="Couleur du mode Neutre">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="10">
                                                    <ColorPicker x:Name="ModeColorPickerNeutral" Tag="neutral"
                                                                 IsAlphaEnabled="False" ColorSpectrumShape="Ring"
                                                                 ColorChanged="ModeColorPicker_ColorChanged" />
                                                    <Button Content="Reinitialiser" Tag="neutral" Click="ModeColorResetButton_Click"
                                                            Style="{StaticResource NovaCompactButtonStyle}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock Text="Neutre" FontSize="11" Opacity="0.72" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Button x:Name="ModeColorSwatchFocusButton"
                                            Tag="focus"
                                            Style="{StaticResource NovaModeColorSwatchButtonStyle}"
                                            ToolTipService.ToolTip="Couleur du mode Focus"
                                            AutomationProperties.Name="Couleur du mode Focus">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="10">
                                                    <ColorPicker x:Name="ModeColorPickerFocus" Tag="focus"
                                                                 IsAlphaEnabled="False" ColorSpectrumShape="Ring"
                                                                 ColorChanged="ModeColorPicker_ColorChanged" />
                                                    <Button Content="Reinitialiser" Tag="focus" Click="ModeColorResetButton_Click"
                                                            Style="{StaticResource NovaCompactButtonStyle}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock Text="Focus" FontSize="11" Opacity="0.72" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Button x:Name="ModeColorSwatchReadingButton"
                                            Tag="reading"
                                            Style="{StaticResource NovaModeColorSwatchButtonStyle}"
                                            ToolTipService.ToolTip="Couleur du mode Lecture"
                                            AutomationProperties.Name="Couleur du mode Lecture">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="10">
                                                    <ColorPicker x:Name="ModeColorPickerReading" Tag="reading"
                                                                 IsAlphaEnabled="False" ColorSpectrumShape="Ring"
                                                                 ColorChanged="ModeColorPicker_ColorChanged" />
                                                    <Button Content="Reinitialiser" Tag="reading" Click="ModeColorResetButton_Click"
                                                            Style="{StaticResource NovaCompactButtonStyle}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock Text="Lecture" FontSize="11" Opacity="0.72" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Button x:Name="ModeColorSwatchCreativeButton"
                                            Tag="creative"
                                            Style="{StaticResource NovaModeColorSwatchButtonStyle}"
                                            ToolTipService.ToolTip="Couleur du mode Creation"
                                            AutomationProperties.Name="Couleur du mode Creation">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="10">
                                                    <ColorPicker x:Name="ModeColorPickerCreative" Tag="creative"
                                                                 IsAlphaEnabled="False" ColorSpectrumShape="Ring"
                                                                 ColorChanged="ModeColorPicker_ColorChanged" />
                                                    <Button Content="Reinitialiser" Tag="creative" Click="ModeColorResetButton_Click"
                                                            Style="{StaticResource NovaCompactButtonStyle}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock Text="Création" FontSize="11" Opacity="0.72" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Button x:Name="ModeColorSwatchResearchButton"
                                            Tag="research"
                                            Style="{StaticResource NovaModeColorSwatchButtonStyle}"
                                            ToolTipService.ToolTip="Couleur du mode Recherche"
                                            AutomationProperties.Name="Couleur du mode Recherche">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="10">
                                                    <ColorPicker x:Name="ModeColorPickerResearch" Tag="research"
                                                                 IsAlphaEnabled="False" ColorSpectrumShape="Ring"
                                                                 ColorChanged="ModeColorPicker_ColorChanged" />
                                                    <Button Content="Reinitialiser" Tag="research" Click="ModeColorResetButton_Click"
                                                            Style="{StaticResource NovaCompactButtonStyle}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock Text="Recherche" FontSize="11" Opacity="0.72" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Button x:Name="ModeColorSwatchNightButton"
                                            Tag="night"
                                            Style="{StaticResource NovaModeColorSwatchButtonStyle}"
                                            ToolTipService.ToolTip="Couleur du mode Nuit"
                                            AutomationProperties.Name="Couleur du mode Nuit">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel Spacing="10">
                                                    <ColorPicker x:Name="ModeColorPickerNight" Tag="night"
                                                                 IsAlphaEnabled="False" ColorSpectrumShape="Ring"
                                                                 ColorChanged="ModeColorPicker_ColorChanged" />
                                                    <Button Content="Reinitialiser" Tag="night" Click="ModeColorResetButton_Click"
                                                            Style="{StaticResource NovaCompactButtonStyle}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <TextBlock Text="Nuit" FontSize="11" Opacity="0.72" HorizontalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <ComboBox x:Name="PersonalizationMotionCombo" Header="Animations et réactions" Width="280"
                                      SelectionChanged="AppearanceOption_Changed">
                                <ComboBoxItem Content="Discret" Tag="subtle" />
                                <ComboBoxItem Content="Lumineux" Tag="luminous" />
                                <ComboBoxItem Content="Dynamique" Tag="dynamic" />
                            </ComboBox>
                            <TextBlock Text="Ce réglage module l'accueil, les effets lumineux et les réactions visuelles. L'option d'accessibilité Réduire les animations reste prioritaire."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="NewTabFocusSearchSwitch"
                                          Header="Placer le curseur dans la recherche du nouvel onglet"
                                          Toggled="NewTabFocusSearchSwitch_Toggled" />
                            <TextBlock Text="Desactive par defaut pour eviter qu'une saisie de connexion ou de PIN se retrouve dans la page d'accueil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="NewTabShortcutsSwitch"
                                          Header="Afficher les raccourcis"
                                          Toggled="NewTabShortcutsSwitch_Toggled" />
                            <TextBlock Text="Desactiver masque uniquement la liste des raccourcis deja ajoutes. Le bouton d'ajout rapide (+) reste toujours disponible sur la page nouvel onglet."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <TextBox x:Name="NewTabShortcutsBox"
                                     Header="Raccourcis"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Height="120"
                                     PlaceholderText="Nom | https://exemple.com"
                                     TextChanged="NewTabShortcutsBox_TextChanged" />
                            <TextBlock Text="Un raccourci par ligne : Nom | URL."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <TextBlock x:Name="AppearancePendingText"
                                       Text="Les positions des onglets/favoris s'appliquent tout de suite. Les autres changements visuels de cette section restent regroupes sous le bouton global en bas."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                        </StackPanel>

                        <!-- Section : Accessibilite -->
                        <StackPanel x:Name="SettingsSectionAccessibility" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Confort" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="Deux familles de reglages independantes : le confort de lecture juste en dessous (affichage et aides vocales), puis la navigation clavier et lecteur d'ecran plus bas. Tout reste local a ce profil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <TextBlock Text="Confort de lecture" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" Margin="0,4,0,0" />

                            <TextBlock Text="Profils prets a l'emploi" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Base rapide" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="Lumora peut partir d'un profil de confort coherent, puis vous laisser retoucher chaque aide juste en dessous."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <RadioButtons x:Name="AccessibilityComfortProfileRadio"
                                                  SelectionChanged="AccessibilityComfortProfileRadio_SelectionChanged">
                                        <RadioButton Tag="balanced">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Aucune aide" FontWeight="SemiBold" />
                                                <TextBlock Text="Point de depart : rien n'est active, a vous de choisir un profil ou de regler chaque aide a la main."
                                                           Style="{StaticResource NovaPanelDescriptionStyle}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Tag="vision">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Vision fatiguee" FontWeight="SemiBold" />
                                                <TextBlock Text="Teinte plus chaude, texte agrandi et transitions limitees - pas de contraste force, pense pour la fatigue visuelle plutot que la basse vision."
                                                           Style="{StaticResource NovaPanelDescriptionStyle}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton Tag="custom">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Personnalise" FontWeight="SemiBold" />
                                                <TextBlock Text="Pour vos reglages melanges a la main, sans revenir a un preset."
                                                           Style="{StaticResource NovaPanelDescriptionStyle}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </RadioButtons>
                                    <TextBlock x:Name="AccessibilityComfortProfileSummaryText"
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Mode secours" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="Ce n'est pas un profil a choisir dans la liste ci-dessus : c'est un geste d'urgence pour reprendre la main tout de suite si la lisibilite s'effondre (texte, contraste, reperes). Un seul retour arriere est memorise, et il se perd a la fermeture de Lumora."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock x:Name="AccessibilityRescueStatusText"
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="AccessibilityRescueActivateButton"
                                                Content="Activer le mode secours"
                                                Click="AccessibilityRescueActivateButton_Click"
                                                AutomationProperties.Name="Activer le mode secours"
                                                AutomationProperties.HelpText="Raccourci clavier : Ctrl+Alt+S."
                                                Style="{StaticResource NovaCompactButtonStyle}" />
                                        <Button x:Name="AccessibilityRescueRestoreButton"
                                                Content="Revenir a l'etat d'avant"
                                                Click="AccessibilityRescueRestoreButton_Click"
                                                AutomationProperties.Name="Revenir a l'etat de confort d'avant"
                                                AutomationProperties.HelpText="Raccourci clavier : Ctrl+Alt+X."
                                                Style="{StaticResource NovaCompactButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Affichage" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <ToggleSwitch x:Name="AccessibilityHighContrastSwitch"
                                          Header="Contraste renforce"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Augmente les contrastes de la chrome Lumora, des panneaux et de la page d'accueil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityLargeTextSwitch"
                                          Header="Texte plus lisible"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Agrandit les textes de navigation, de commande et les messages importants."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityReduceMotionSwitch"
                                          Header="Limiter les transitions visuelles"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Agit surtout sur les transitions de survol de l'accueil et des controles internes."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityVisibleFocusSwitch"
                                          Header="Focus clavier plus visible"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Renforce les contours visibles quand vous naviguez avec Tab, Entree ou les fleches."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityReduceBlueLightSwitch"
                                          Header="Reduire la lumiere bleue"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Teinte plus chaude sur les pages visitees, pensee pour la fatigue visuelle (usage prolonge, soiree) - a l'oppose du contraste renforce, qui vise la basse vision et durcit volontairement l'affichage. N'agit pour l'instant que sur le contenu des pages, pas encore sur Lumora lui-meme."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Confort moteur" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <ToggleSwitch x:Name="AccessibilityLargeTargetsSwitch"
                                          Header="Boutons plus grands"
                                          Toggled="AccessibilitySwitch_Toggled" />
                            <TextBlock Text="Agrandit les boutons de la barre de navigation (retour, avancer, recharger...) pour des cibles plus faciles a viser. Desactive par defaut : la taille compacte reste la norme, cette aide est a votre choix."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Assistants vocaux" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <ToggleSwitch x:Name="ReadAloudEnabledSwitch" Header="Lire les pages a voix haute" Toggled="ReadAloudEnabledSwitch_Toggled" />
                            <TextBlock Text="Ajoute un bouton dans la barre d'outils pour faire lire le texte de la page a voix haute (utile en cas de difficulte de lecture). Synthese vocale 100% locale (Windows), aucun texte de page envoye a un serveur externe."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="ReadingLensEnabledSwitch" Header="Loupe de lecture" Toggled="ReadingLensEnabledSwitch_Toggled" />
                            <TextBlock Text="Ajoute un bouton dans la barre d'outils qui capture la page dans un panneau zoomable, utile pour un captcha visuel deforme ou un texte minuscule. Aucune resolution automatique : une image locale agrandie, vous lisez et repondez vous-meme."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="ReadingGuideEnabledSwitch" Header="Guide de lecture immersif" Toggled="ReadingGuideEnabledSwitch_Toggled" />
                            <TextBlock Text="Assombrit legerement le reste de la page et garde une bande nette qui suit la lecture dans le viewport. Pratique pour ne pas perdre sa ligne sur les longs articles, tableaux ou formulaires denses."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ComboBox x:Name="ReadingGuideBandHeightCombo"
                                      Header="Hauteur de la bande de lecture"
                                      SelectionChanged="ReadingGuideBandHeightCombo_SelectionChanged">
                                <ComboBoxItem Content="Standard" Tag="160" />
                                <ComboBoxItem Content="Large" Tag="220" />
                            </ComboBox>
                            <TextBlock Text="La bande suit le pointeur, les changements de focus et les grands deplacements clavier pour rester au bon niveau sans demander une nouvelle action."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Aides ciblees" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <TextBlock Text="Contrairement au reste de cette page (qui ajuste la chrome Lumora), ces deux reglages agissent directement sur le contenu des pages web visitees."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ComboBox x:Name="AccessibilityTextSpacingCombo"
                                      Header="Espacement du texte des pages"
                                      SelectionChanged="AccessibilityTextSpacingCombo_SelectionChanged">
                                <ComboBoxItem Content="Normal" Tag="normal" />
                                <ComboBoxItem Content="Confortable" Tag="comfortable" />
                                <ComboBoxItem Content="Large" Tag="wide" />
                            </ComboBox>
                            <TextBlock Text="Augmente l'espacement entre lettres, mots et lignes sur les pages visitees (recommandation d'accessibilite WCAG 1.4.12). Aide la dyslexie et la basse vision : un texte trop serre devient difficile a suivre ligne par ligne."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <ToggleSwitch x:Name="AccessibilityColorBoostSwitch"
                                          Header="Renforcer les couleurs difficiles a distinguer"
                                          Toggled="AccessibilityColorBoostSwitch_Toggled" />
                            <TextBlock Text="Augmente la saturation et le contraste des pages visitees, utile a certains daltoniens quand des couleurs proches se confondent. Ce n'est pas une correction medicale ni une simulation exacte : pour un filtre de vision des couleurs complet, Windows propose ses propres Filtres de couleurs (Parametres Windows > Accessibilite), qui s'appliquent a tout l'ecran."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Navigation clavier" Style="{StaticResource NovaPanelPageTitleStyle}" FontSize="17" Margin="0,4,0,0" />
                            <TextBlock Text="Independant du confort de lecture ci-dessus : reperage et deplacement au clavier dans toute la fenetre Lumora, utile avec ou sans lecteur d'ecran."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <TextBlock Text="Clavier et lecteurs d'ecran" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Navigation clavier" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="Ctrl+K ouvre la palette, Echap ferme les panneaux temporaires ou quitte le plein ecran, Tab parcourt les commandes visibles."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Raccourcis Lumora" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="F6 ou Maj+F6 : passer d'une grande zone du navigateur a l'autre."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Ctrl+Alt+1 a 5 : aller directement vers les onglets, la barre d'adresse, le contenu actif, les outils ou le compagnon."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Ctrl+Alt+F : faire relire le repere courant (zone, surface et controle actif)."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Ctrl+Alt+R : recentrer le focus sur le repere utile quand on se sent perdu."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Ctrl+Alt+S : activer le mode secours. Ctrl+Alt+X : revenir a l'etat de confort d'avant."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Ctrl+K : ouvrir la palette de commande sans quitter le clavier."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Win+H : lancer la dictee Windows quand un champ de texte est actif."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Ctrl+T : nouvel onglet. Ctrl+W : fermer l'onglet actif. Ctrl+L : mettre le focus sur la barre d'adresse."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="F5 : recharger la page. Alt+Gauche ou Alt+Droite : page precedente ou suivante."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <TextBlock Text="Ctrl+Tab ou Ctrl+Maj+Tab : passer a l'onglet suivant ou precedent. F11 : basculer le plein ecran."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <Button x:Name="AccessibilityShortcutHelpButton"
                                            Content="Faire annoncer les raccourcis"
                                            Click="AccessibilityShortcutHelpButton_Click"
                                            AutomationProperties.Name="Faire annoncer les raccourcis Lumora"
                                            AutomationProperties.HelpText="Relit les raccourcis clavier importants via les annonces d'accessibilite."
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource NovaCompactButtonStyle}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Les boutons, onglets, favoris et menus principaux exposent des noms lisibles aux lecteurs d'ecran."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                        </StackPanel>

                        <!-- Section : Ouverture -->
                        <StackPanel x:Name="SettingsSectionStartup" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Ouverture" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <RadioButtons x:Name="StartupModeRadio" Header="Quand Lumora s'ouvre" SelectionChanged="StartupModeRadio_SelectionChanged">
                                <RadioButton x:Name="StartupRestoreRadio" Content="Restaurer la session precedente" Tag="restore" />
                                <RadioButton x:Name="StartupHomeRadio" Content="Accueil Lumora" Tag="home" />
                                <RadioButton x:Name="StartupCustomRadio" Content="URL personnalisee" Tag="custom" />
                            </RadioButtons>
                            <TextBox x:Name="StartupUrlBox" Header="URL de demarrage"
                                     Visibility="Collapsed" PlaceholderText="https://..."
                                     TextChanged="StartupUrlBox_TextChanged" MaxWidth="400" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- Section : Coffre et données -->
                        <StackPanel x:Name="SettingsSectionVault" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Coffre et données" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="vault.lumora reste local, chiffre et lie a votre profil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <Border Background="{StaticResource NovaWarningSurfaceBrush}"
                                    CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                                <TextBlock TextWrapping="Wrap" FontSize="13"
                                           Text="La recuperation n'est possible qu'avec la cle de recuperation locale que vous avez notee. Sans mot de passe et sans cette cle, Lumora ne peut pas dechiffrer le coffre." />
                            </Border>
                            <TextBlock Text="Le mot de passe du coffre se change depuis Profil."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="VaultMenu_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Permissions" />
                                        <TextBlock Text="Ouvrir les mots de passe" />
                                    </StackPanel>
                                </Button>
                                <Button Click="ImportPasswordsMenu_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Import" />
                                        <TextBlock Text="Importer un CSV" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                    Margin="0,8,0,0" />
                            <TextBlock Text="Portefeuille" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Cartes stockees dans le meme coffre. Remplissage uniquement sur clic explicite ; CVV jamais enregistre." />
                            <Button Click="WalletMenu_Click" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                    <TextBlock Text="Ouvrir le portefeuille" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Section : Profils locaux -->
                        <StackPanel x:Name="SettingsSectionProfile" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Profils locaux" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock x:Name="ProfileNameDisplay" Opacity="0.78" />
                            <Border Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Identite visible" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    <TextBlock Text="L'avatar et les options visuelles sont regroupes dans Personnalisation. Ici, Lumora garde les actions sensibles du profil."
                                               Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <Button Content="Ouvrir la personnalisation"
                                            Click="OpenPersonalizationFromProfileButton_Click"
                                            Style="{StaticResource NovaCompactButtonStyle}"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Changer le nom" Click="ChangeProfileNameButton_Click" />
                                <Button Grid.Column="1" Content="Changer le mot de passe" Click="ChangeProfilePasswordButton_Click" />
                                <Button Grid.Column="2" Content="Nouvelle cle de recuperation"
                                        Click="CreateRecoveryKeyButton_Click" />
                            </Grid>
                            <ToggleSwitch x:Name="ProfilePinSwitch" Header="Code PIN rapide (6 chiffres)"
                                         Toggled="ProfilePinSwitch_Toggled" />
                            <ComboBox x:Name="SessionTimeoutCombo"
                                      Header="Verrouillage automatique de la session"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="SessionTimeoutCombo_SelectionChanged">
                                <ComboBoxItem Content="Jamais" Tag="0" />
                                <ComboBoxItem Content="10 minutes" Tag="10" />
                                <ComboBoxItem Content="1 heure" Tag="60" />
                                <ComboBoxItem Content="5 heures" Tag="300" />
                            </ComboBox>
                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                    Margin="0,8,0,0" />
                            <!--
                                Trouve en usage reel (mode invite) le 2026-07-22 : ce bloc expose le
                                chemin reel de chaque profil en texte brut, propose d'ouvrir son
                                dossier (coffre inclus) et de le mettre en quarantaine SANS mot de
                                passe (juste retaper le nom, visible juste au-dessus) - et le bouton
                                Reinitialiser plus bas supprime tout le dossier du profil actif SANS
                                aucune verification, alors qu'en mode invite _profile pointe encore
                                sur le vrai profil par defaut. Aucune de ces deux actions n'a de sens
                                pour une session invite (aucun profil a soi a gerer) : le bloc entier
                                est cache et remplace par ProfileGuestRestrictedNotice tant que
                                _isGuestMode est vrai (voir RefreshProfileSettings).
                            -->
                            <StackPanel x:Name="ProfileManagementRestrictedPanel" Spacing="12">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Utilisateurs locaux" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                        <TextBlock Text="Profils detectes sur cet ordinateur." Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Actualiser" Click="RefreshProfilesButton_Click" />
                                    <Button Grid.Column="2" Content="Creer un profil" Click="CreateAnotherProfileFromSettingsButton_Click" />
                                </Grid>
                                <StackPanel x:Name="ProfileManagementPanel" Spacing="8" />
                                <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                        Margin="0,8,0,0" />
                                <TextBlock Text="Reinitialisation" Style="{StaticResource NovaPanelSectionTitleStyle}" Opacity="0.72" />
                                <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                           Text="Supprime definitivement toutes vos donnees : favoris, historique, onglets, parametres, coffre et identifiants de connexion. Operation irreversible." />
                                <Button Content="Reinitialiser le profil..."
                                        Foreground="{StaticResource NovaDangerBrush}"
                                        Click="ResetProfileButton_Click" />
                            </StackPanel>
                            <InfoBar x:Name="ProfileGuestRestrictedNotice"
                                     Title="Indisponible en mode invite"
                                     Message="La gestion des utilisateurs locaux et la reinitialisation de profil touchent aux donnees d'un vrai profil : connectez-vous ou creez un profil pour y acceder."
                                     Severity="Informational"
                                     IsOpen="False" />
                        </StackPanel>

                        <!-- Section : Stockage local -->
                        <StackPanel x:Name="SettingsSectionStorage" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Stockage local" Style="{StaticResource NovaPanelPageTitleStyle}" />

                            <TextBlock Text="Dossier actuel" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBox x:Name="StorageCurrentFolderText"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     Opacity="0.78" FontFamily="Consolas" FontSize="12" />
                            <Button Content="Changer de dossier..." Click="ChangeFolderButton_Click" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Les fichiers existants seront copies vers le nouvel emplacement. Redemarrage necessaire." />

                            <InfoBar x:Name="StorageRestartBar"
                                     Title="Redemarrage requis"
                                     Message="Le dossier de donnees a ete modifie. Redemarrez Lumora pour appliquer le changement."
                                     Severity="Warning"
                                     IsOpen="False">
                                <InfoBar.ActionButton>
                                    <Button Content="Fermer Lumora" Click="StorageRestartCloseButton_Click" />
                                </InfoBar.ActionButton>
                            </InfoBar>

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />

                            <TextBlock Text="Donnees de navigation" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Supprime cookies, sessions, cache et donnees des sites." />
                            <Button Content="Vider les donnees de navigation"
                                    Click="ClearBrowsingDataButton_Click" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,0" />

                            <TextBlock Text="Sauvegarde" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Favoris, historique, onglets et parametres dans un fichier chiffre. Le coffre reste lie au compte Windows." />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Exporter une sauvegarde..." Click="ExportBackupButton_Click" />
                                <Button Content="Importer une sauvegarde..." Click="ImportBackupButton_Click" />
                            </StackPanel>

                            <InfoBar x:Name="StorageImportBar"
                                     Title="Restauration réussie"
                                     Message="Les données ont été importées. Redémarrez Lumora pour appliquer tous les changements."
                                     Severity="Success"
                                     IsOpen="False">
                                <InfoBar.ActionButton>
                                    <Button Content="Fermer Lumora" Click="StorageRestartCloseButton_Click" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </StackPanel>

                        <!-- Section : Vie privée locale -->
                        <StackPanel x:Name="SettingsSectionPrivacy" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Vie privée locale" Style="{StaticResource NovaPanelPageTitleStyle}" />

                            <!-- Compteur de blocages -->
                            <Border Style="{StaticResource NovaPanelCardStyle}"
                                    Background="{StaticResource NovaSuccessSurfaceBrush}">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="PrivacyBlockedCountText"
                                               Text="0 requête bloquée"
                                               FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PrivacyRuleCountText"
                                               Text="Chargement des règles..."
                                               Opacity="0.7" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Bloqueur pub / trackers -->
                            <TextBlock Text="Pubs et trackers" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Bloque les serveurs publicitaires et de tracking avec des listes locales." />
                            <ToggleSwitch x:Name="NetworkBlockerSwitch"
                                         Header="Activer le bloqueur"
                                         Toggled="NetworkBlockerSwitch_Toggled" />
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
                                <Button x:Name="UpdatePrivacyListsButton"
                                        Content="Mettre à jour les listes maintenant"
                                        Click="UpdatePrivacyListsButton_Click" />
                                <TextBlock x:Name="PrivacyLastUpdateText"
                                           VerticalAlignment="Center"
                                           Opacity="0.65" FontSize="12" />
                            </StackPanel>
                            <TextBlock x:Name="PrivacyStatusText"
                                       Style="{StaticResource NovaPanelDescriptionStyle}"
                                       FontStyle="Italic" />
                            <InfoBar x:Name="PrivacyListsUpdateBar"
                                     Title="Listes mises à jour"
                                     Message="Les nouvelles règles de filtrage sont actives."
                                     Severity="Success"
                                     IsOpen="False" IsClosable="True" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Anti-télémétrie -->
                            <TextBlock Text="Anti-télémétrie" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Bloque la mesure d'audience, le replay de session, les rapports de crash et les métriques produit des sites." />
                            <ToggleSwitch x:Name="TelemetryBlockerSwitch"
                                         Header="Bloquer la télémétrie"
                                         Toggled="TelemetryBlockerSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Nettoyage URL -->
                            <TextBlock Text="Nettoyage des URL" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Retire les paramètres de tracking avant navigation." />
                            <ToggleSwitch x:Name="ParameterCleanerSwitch"
                                         Header="Nettoyer les URL"
                                         Toggled="ParameterCleanerSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- HTTPS enforcer -->
                            <TextBlock Text="HTTPS" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Tente HTTPS avant HTTP quand le site le permet." />
                            <ToggleSwitch x:Name="HttpsEnforcerSwitch"
                                         Header="Forcer HTTPS"
                                         Toggled="HttpsEnforcerSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- CNAME uncloaker -->
                            <TextBlock Text="CNAME cloaking" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Détecte les trackers cachés derrière un alias DNS." />
                            <ToggleSwitch x:Name="CnameUncloakerSwitch"
                                         Header="Détecter le CNAME cloaking"
                                         Toggled="CnameUncloakerSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Anti-fuite WebRTC -->
                            <TextBlock Text="WebRTC" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Empêche les sites de révéler votre IP locale/publique réelle via WebRTC (utile même sans VPN actif). Nécessite un redémarrage de Lumora pour s'appliquer." />
                            <ToggleSwitch x:Name="WebRtcLeakProtectionSwitch"
                                         Header="Bloquer les fuites d'IP WebRTC"
                                         Toggled="WebRtcLeakProtectionSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Position fictive (geolocalisation) -->
                            <TextBlock Text="Geolocalisation" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Renvoie une position fixe aux sites qui demandent votre localisation (cartes, meteo, recherche « pres de moi ») au lieu de la position reelle de l'appareil. Sans effet sur le catalogue des services de streaming, qui se base sur l'adresse IP, pas sur cette API. Un site autorise explicitement (onglet Site actuel) recoit toujours la vraie position." />
                            <ToggleSwitch x:Name="GeolocationSpoofingSwitch"
                                         Header="Position fictive"
                                         Toggled="GeolocationSpoofingSwitch_Toggled" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GeolocationLatitudeBox" Grid.Column="0" Header="Latitude" PlaceholderText="48.8566" />
                                <TextBox x:Name="GeolocationLongitudeBox" Grid.Column="1" Header="Longitude" PlaceholderText="2.3522" />
                                <Button Grid.Column="2" Content="Appliquer" VerticalAlignment="Bottom" Click="GeolocationSpoofApplyButton_Click" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Anti-fingerprinting -->
                            <TextBlock Text="Empreinte du navigateur" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Ajoute un leger bruit a la lecture du Canvas, du WebGL et de l'AudioContext (les techniques de fingerprinting les plus courantes) pour rendre le pistage inter-sites plus difficile, sans casser l'affichage ni ralentir la navigation." />
                            <ToggleSwitch x:Name="FingerprintProtectionSwitch"
                                         Header="Brouiller l'empreinte du navigateur"
                                         Toggled="FingerprintProtectionSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Filtre cosmétique -->
                            <TextBlock Text="Masquage visuel" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Masque les emplacements publicitaires vides après filtrage réseau." />
                            <ToggleSwitch x:Name="CosmeticFilterSwitch"
                                         Header="Masquer les emplacements pub"
                                         Toggled="CosmeticFilterSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Gestionnaire de consentement cookies -->
                            <TextBlock Text="Cookies" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Refuse les bandeaux compatibles quand cela ne casse pas le site." />
                            <ToggleSwitch x:Name="ConsentManagerSwitch"
                                         Header="Refuser automatiquement les cookies"
                                         Toggled="ConsentManagerSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Sessions éphémères -->
                            <TextBlock Text="Sessions éphémères" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Purge les sessions au démarrage, sauf pour les sites que vous gardez connectés." />
                            <ToggleSwitch x:Name="SessionPurgeSwitch"
                                         Header="Purger les sessions au démarrage"
                                         Toggled="SessionPurgeSwitch_Toggled" />
                            <HyperlinkButton Content="Gérer les sites connectés"
                                             Click="SessionsManageLink_Click"
                                             HorizontalAlignment="Left"
                                             Padding="0" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- SmartScreen -->
                            <TextBlock Text="SmartScreen" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Protection Microsoft anti-phishing optionnelle. Désactivée par défaut." />
                            <ToggleSwitch x:Name="SmartScreenSwitch"
                                         Header="Activer SmartScreen (envoie les URL à Microsoft)"
                                         Toggled="SmartScreenSwitch_Toggled" />

                            <!-- Renforcement anti-publicité (0.77) : popups et détournements -->
                            <TextBlock Text="Popups et redirections" Style="{StaticResource NovaPanelSectionTitleStyle}" Margin="0,14,0,0" />
                            <TextBlock Text="Les popups automatiques et les détournements de clic vers des domaines publicitaires sont bloqués. Les fenêtres de connexion (Google, OAuth...) restent toujours autorisées."
                                       Opacity="0.7" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,6" />
                            <ToggleSwitch x:Name="PopupBlockerSwitch"
                                         Header="Bloquer les popups publicitaires et automatiques"
                                         Toggled="PopupBlockerSwitch_Toggled" />
                            <ToggleSwitch x:Name="StrictAdBlockSwitch"
                                         Header="Bloquer les redirections vers des domaines publicitaires"
                                         Toggled="StrictAdBlockSwitch_Toggled" />

                            <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <!-- Whitelist utilisateur -->
                            <TextBlock Text="Exceptions" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                       Text="Domaines ignorés par le bloqueur de contenu." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="PrivacyWhitelistBox"
                                         PlaceholderText="exemple.com"
                                         Width="220" />
                                <Button Content="Ajouter"
                                        Click="PrivacyWhitelistAddButton_Click"
                                        VerticalAlignment="Bottom" />
                            </StackPanel>
                            <StackPanel x:Name="PrivacyWhitelistPanel" Spacing="6" />

                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" Grid.Column="1"
                        Margin="0,0,18,18"
                        Style="{StaticResource NovaPanelShellCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SettingsPendingText"
                                   Text="Aucun changement en attente."
                                   Style="{StaticResource NovaPanelDescriptionStyle}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Annuler"
                                Click="ResetSettingsChangesButton_Click"
                                Style="{StaticResource NovaPanelActionButtonStyle}" />
                        <Button x:Name="ApplySettingsChangesButton"
                                Grid.Column="2"
                                Click="ApplySettingsChangesButton_Click"
                                AutomationProperties.Name="Appliquer les changements"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Accept" />
                                <TextBlock Text="Appliquer les changements" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="AboutPanel" Grid.Column="3" Padding="28,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" MaxWidth="1040" HorizontalAlignment="Center" Spacing="12">
                    <Border Width="86" Height="86" CornerRadius="20"
                            HorizontalAlignment="Center">
                        <Image Source="ms-appx:///Assets/LumoraApp.png"
                               Width="86" Height="86"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="Lumora" FontSize="34" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Lumière locale, navigation web claire"
                               Opacity="0.74"
                               HorizontalAlignment="Center" />
                    <Border Padding="14,8"
                            CornerRadius="8"
                            Background="{StaticResource NovaCoolAccentSoftBrush}"
                            BorderBrush="{StaticResource NovaCoolAccentBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Accept" Foreground="{StaticResource NovaCoolAccentBrush}" />
                            <TextBlock x:Name="AboutVersionLabelText" Text="Version de développement" FontWeight="SemiBold" />
                            <TextBlock x:Name="AboutVersionSeparatorText" Text="•" Opacity="0.45" />
                            <TextBlock x:Name="AboutVersionText" Opacity="0.82" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1"
                      MaxWidth="1080"
                      HorizontalAlignment="Center"
                      Margin="0,24,0,0"
                      ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource NovaPanelCardStyle}"
                            VerticalAlignment="Top">
                        <StackPanel Spacing="4">
                            <TextBlock Text="À propos"
                                       Style="{StaticResource NovaPanelSectionTitleStyle}"
                                       Margin="0,0,0,8" />
                            <RadioButton x:Name="AboutNavSummary" Content="Vue d'ensemble" Style="{StaticResource NovaSideRailNavRadioButtonStyle}" Tag="summary" IsChecked="True" Click="AboutNav_Click" />
                            <RadioButton x:Name="AboutNavModules" Content="Modules" Style="{StaticResource NovaSideRailNavRadioButtonStyle}" Tag="modules" Click="AboutNav_Click" />
                            <RadioButton x:Name="AboutNavPrivacy" Content="Confidentialité" Style="{StaticResource NovaSideRailNavRadioButtonStyle}" Tag="privacy" Click="AboutNav_Click" />
                            <RadioButton x:Name="AboutNavAuthenticity" Content="Authenticité" Style="{StaticResource NovaSideRailNavRadioButtonStyle}" Tag="authenticity" Click="AboutNav_Click" />
                            <RadioButton x:Name="AboutNavCredits" Content="Dépendances" Style="{StaticResource NovaSideRailNavRadioButtonStyle}" Tag="credits" Click="AboutNav_Click" />
                            <RadioButton x:Name="AboutNavTechnical" Content="Technique" Style="{StaticResource NovaSideRailNavRadioButtonStyle}" Tag="technical" Click="AboutNav_Click" />
                            <RadioButton x:Name="AboutNavProfile" Content="Profil local" Style="{StaticResource NovaSideRailNavRadioButtonStyle}" Tag="profile" Click="AboutNav_Click" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1">
                        <Grid MaxWidth="820">
                            <StackPanel x:Name="AboutSectionSummary" Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Vue d'ensemble" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.76" LineHeight="20"
                                               Text="Lumora associe maintenant son idée de lumière à un symbole de navigation web : un cœur lumineux, des arcs de globe et une trajectoire locale, au service d'un navigateur clair et maîtrisable." />
                                </StackPanel>
                                <Grid ColumnSpacing="12" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource NovaPanelCardStyle}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Local-first" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                                       Text="Les favoris, l'historique, les sessions et les données sensibles restent sur cet ordinateur." />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource NovaPanelCardStyle}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Moteur web" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                                       Text="Chromium via WebView2, dans une interface WinUI 3 propre à Lumora." />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource NovaPanelCardStyle}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Modules intégrés" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                                       Text="Lecture, annotations, traduction, recherche assistée, vidéo et outils pratiques restent accessibles sans transformer le menu en fourre-tout." />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource NovaPanelCardStyle}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Transparence" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                            <TextBlock Style="{StaticResource NovaPanelDescriptionStyle}"
                                                       Text="Les dépendances open source, le build et le profil local sont détaillés dans les sections dédiées." />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Modules Lumora" Click="ModulesMenu_Click" />
                                    <Button Content="Paramètres" Style="{StaticResource NovaCompactButtonStyle}" Click="SettingsMenu_Click" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="AboutSectionModules" Spacing="14" Visibility="Collapsed">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Modules Lumora" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.76" LineHeight="20"
                                               Text="Les modules sont des outils intégrés au navigateur : ils restent locaux, activables à la demande, et rangés comme de vraies fonctions de Lumora." />
                                </StackPanel>
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Style="{StaticResource NovaPanelCardStyle}">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Lecture et annotations" FontWeight="SemiBold" />
