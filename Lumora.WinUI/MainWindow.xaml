                                    <TextBlock Grid.Row="7" Grid.Column="2" Text="Sites épinglés en fenêtre dédiée." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="7" Grid.Column="3" Content="Gerer" Click="WebAppsMenu_Click" Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    <ToggleButton x:Name="PanelWebAppsPinToggleButton" Grid.Row="7" Grid.Column="4" Tag="webApps" Style="{StaticResource NovaModulePinButtonStyle}" Click="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler">
                                        <FontIcon Glyph="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                    </ToggleButton>

                                    <FontIcon Grid.Row="8" Grid.Column="0" Glyph="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Dictée vocale" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="8" Grid.Column="2" Text="Raccourci vers la dictée Windows sans voler le focus." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="8" Grid.Column="3" Content="Aide dictée" Click="MicDictationButton_Click" Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    <ToggleButton x:Name="PanelDictationPinToggleButton" Grid.Row="8" Grid.Column="4" Tag="dictation" Style="{StaticResource NovaModulePinButtonStyle}" Click="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler">
                                        <FontIcon Glyph="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                    </ToggleButton>

                                    <!-- Flux RSS et Loupe de lecture (2026-08-09) : integres au systeme
                                         de modules epinglables, demande explicite - voir MEMORY.md. -->
                                    <FontIcon Grid.Row="9" Grid.Column="0" Glyph="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="Flux RSS" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="9" Grid.Column="2" Text="Lecteur de flux RSS/Atom local, sans compte." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="9" Grid.Column="3" Content="Ouvrir" Click="RssMenu_Click" Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    <ToggleButton x:Name="PanelRssPinToggleButton" Grid.Row="9" Grid.Column="4" Tag="rss" Style="{StaticResource NovaModulePinButtonStyle}" Click="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler">
                                        <FontIcon Glyph="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                    </ToggleButton>

                                    <FontIcon Grid.Row="10" Grid.Column="0" Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="10" Grid.Column="1" Text="Loupe de lecture" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="10" Grid.Column="2" Text="Agrandir la page pour mieux lire (captcha déformé, texte minuscule)." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="10" Grid.Column="3" Content="Ouvrir" Click="ReadingLensButton_Click" Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    <ToggleButton x:Name="PanelReadingLensPinToggleButton" Grid.Row="10" Grid.Column="4" Tag="readingLens" Style="{StaticResource NovaModulePinButtonStyle}" Click="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler">
                                        <FontIcon Glyph="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                    </ToggleButton>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
