                        <TextBlock Text="Historique" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Pages visitees localement sur cet appareil." Opacity="0.68" />
                    </StackPanel>
                    <Button x:Name="ClearHistoryButton" Grid.Column="1"
                            Content="Vider l'historique"
                            Click="ClearHistoryButton_Click"
                            VerticalAlignment="Bottom" />
                </Grid>
                <TextBox x:Name="HistorySearchBox" Grid.Row="1" Margin="0,12,0,0"
                         TextChanged="HistorySearchBox_TextChanged"
                         PlaceholderText="Rechercher dans l'historique..." />
                <ListView x:Name="HistoryList" Grid.Row="2" Margin="0,8,0,0"
                          DoubleTapped="HistoryList_DoubleTapped"
                          RightTapped="HistoryList_RightTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,5" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Width="16" Height="16"
                                       Source="{Binding IconImageUri}" Visibility="{Binding IconImageVisibility}"
                                       VerticalAlignment="Center" />
                                <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}"
                                          FontFamily="Segoe MDL2 Assets" FontSize="13"
                                          Visibility="{Binding IconGlyphVisibility}"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Domain}"
                                           Opacity="0.65" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding TimeDisplay}"
                                           Opacity="0.55" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid x:Name="DownloadsPanel" Grid.Column="2" Padding="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Telechargements" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Historique local des fichiers telecharges." Opacity="0.68" />
                    </StackPanel>
                    <Button x:Name="ClearDownloadsButton" Grid.Column="1"
                            Content="Effacer"
                            VerticalAlignment="Bottom"
                            Click="ClearDownloadsButton_Click"
                            ToolTipService.ToolTip="Effacer l'historique local des telechargements" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="DownloadsPanelItems" Spacing="6" />
                </ScrollViewer>
            </Grid>

            <Grid x:Name="SavedTabGroupsPanel" Grid.Column="2" Padding="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4" Margin="0,0,0,16">
                    <TextBlock Text="Groupes enregistres" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Vos groupes d'onglets ranges. Ouvrez-en un pour retrouver tous ses onglets d'un coup. Tout est stocke localement sur cet appareil."
                               Opacity="0.68" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="SavedTabGroupsPanelItems" Spacing="10" />
                </ScrollViewer>
            </Grid>

            <!-- Panneau Notes : pages annotées en mode lecture (reprise
                 d'activité) + bloc-notes libre. Liste à gauche, détail à
                 droite (lecteur d'annotations ou éditeur de note selon la
                 sélection). Tout est stocké chiffré dans le profil. -->
            <Grid x:Name="NotesPanel" Grid.Column="2" Padding="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Notes" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Vos pages annotees en mode lecture et vos notes libres. Rouvrez une page annotee pour reprendre votre lecture la ou vous l'aviez laissee. Tout est chiffre dans votre profil et ne quitte jamais cet appareil."
                                   Opacity="0.68" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="NotesAddButton" VerticalAlignment="Bottom"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="Nouvelle note"
                            Click="NotesAddButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock Text="Nouvelle note" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <TextBox x:Name="NotesSearchBox"
                             PlaceholderText="Rechercher dans les notes et annotations"
                             AutomationProperties.Name="Rechercher dans les notes et annotations"
                             TextChanged="NotesSearchBox_TextChanged" />
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="NotesList" SelectionMode="Single"
                              AutomationProperties.Name="Liste des notes et pages annotees"
                              SelectionChanged="NotesList_SelectionChanged" />

                    <!-- Détail d'une page annotée : reprise en mode lecture,
                         liste des surlignages et commentaires. -->
                    <Grid Grid.Column="1" x:Name="AnnotationViewerHost" RowSpacing="10" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="AnnotationPageTitleText" FontSize="18" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="AnnotationPageUrlText" Opacity="0.6" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Row="1" x:Name="AnnotationOpenPageButton"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.Name="Reprendre la page en mode lecture"
                                Click="AnnotationOpenPageButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                <TextBlock Text="Reprendre en mode lecture" />
                            </StackPanel>
                        </Button>
                        <ListView Grid.Row="2" x:Name="AnnotationsList" SelectionMode="None"
                                  AutomationProperties.Name="Annotations de la page" />
                        <Grid Grid.Row="3">
                            <TextBlock x:Name="AnnotationMetaText" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                            <Button x:Name="AnnotationForgetPageButton" HorizontalAlignment="Right"
                                    AutomationProperties.Name="Oublier toutes les annotations de cette page"
                                    Click="AnnotationForgetPageButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Delete" />
                                    <TextBlock Text="Oublier cette page" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="1" x:Name="NoteEditorHost" RowSpacing="10" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="NoteTitleBox" PlaceholderText="Titre de la note"
                                 AutomationProperties.Name="Titre de la note" MaxLength="160"
                                 TextChanged="NoteEditor_TextChanged" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <HyperlinkButton x:Name="NoteLinkButton" Padding="2,0"
                                             AutomationProperties.Name="Ouvrir la page liee"
                                             Click="NoteLinkButton_Click" Visibility="Collapsed" />
                            <Button x:Name="NoteAttachPageButton"
                                    ToolTipService.ToolTip="Rattacher cette note a la page web courante"
                                    AutomationProperties.Name="Rattacher a la page courante"
                                    Click="NoteAttachPageButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                    <TextBlock Text="Rattacher a la page" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBox Grid.Row="2" x:Name="NoteContentBox"
                                 PlaceholderText="Ecrivez votre note ici..."
                                 AutomationProperties.Name="Contenu de la note"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                                 TextChanged="NoteEditor_TextChanged" />
                        <Grid Grid.Row="3">
                            <TextBlock x:Name="NoteMetaText" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                            <Button x:Name="NoteDeleteButton" HorizontalAlignment="Right"
                                    AutomationProperties.Name="Supprimer la note"
                                    Click="NoteDeleteButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Delete" />
                                    <TextBlock Text="Supprimer" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                    <TextBlock Grid.Column="1" x:Name="NotesEmptyText"
                               Text="Rien pour l'instant. Surlignez un passage d'une page web via le Mode lecture (bouton dans la barre d'outils) : la page annotee apparaitra ici. Vous pouvez aussi creer une note libre."
                               Opacity="0.6" TextWrapping="Wrap" MaxWidth="420"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Grid x:Name="VaultPanel" Grid.Column="2" Padding="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Gestionnaire de mots de passe" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Comptes locaux stockes dans vault.lumora, chiffre AES-256 avec une cle derivee du mot de passe du profil." Opacity="0.68" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="VaultHealthButton" Margin="0,0,8,0" VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Bilan de sante : mots de passe reutilises, faibles ou anciens (analyse 100% locale)"
                            AutomationProperties.Name="Bilan de sante des mots de passe"
                            Click="VaultHealthButton_Click">
                        <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </Button>
                    <Button Grid.Column="2" x:Name="VaultMergeButton" Margin="0,0,8,0" VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Fusionner les doublons : meme site, meme identifiant et meme mot de passe enregistres plusieurs fois (www., sous-domaines...)"
                            AutomationProperties.Name="Fusionner les doublons du coffre"
                            Click="VaultMergeButton_Click">
                        <FontIcon Glyph="&#xEA99;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                    </Button>
                    <Button Grid.Column="3" x:Name="VaultImportButton" Margin="0,0,8,0" VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Importer des mots de passe : fichier CSV ou navigateur installe (Chrome, Edge, Brave...)"
                            AutomationProperties.Name="Importer des mots de passe"
                            Click="VaultImportButton_Click">
                        <SymbolIcon Symbol="Import" />
                    </Button>
                    <Button Grid.Column="4" x:Name="VaultExportButton" Margin="0,0,8,0" VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Exporter en clair vers un fichier CSV"
                            AutomationProperties.Name="Exporter les mots de passe"
                            Click="VaultExportButton_Click">
                        <SymbolIcon Symbol="Save" />
                    </Button>
                    <Button Grid.Column="5" x:Name="VaultRefreshButton" Margin="0,0,8,0" VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Actualiser"
                            AutomationProperties.Name="Actualiser le coffre"
                            Click="VaultRefreshButton_Click">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                    <Button Grid.Column="6" x:Name="VaultAddButton" VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Ajouter un identifiant"
                            AutomationProperties.Name="Ajouter un identifiant"
                            Click="VaultAddButton_Click">
                        <SymbolIcon Symbol="Add" />
                    </Button>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,12" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="PasswordManagerSearchBox"
                             PlaceholderText="Rechercher un site, un identifiant ou un domaine"
                             TextChanged="PasswordManagerSearchBox_TextChanged" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <RadioButton x:Name="VaultSortRecentRadio" Content="Recent" GroupName="VaultSort"
                                     IsChecked="True" Click="VaultSort_Click" />
                        <RadioButton x:Name="VaultSortAlphabeticalRadio" Content="Alphabetique" GroupName="VaultSort"
                                     Click="VaultSort_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0">
                        <StackPanel x:Name="VaultPanelItems" Spacing="10" />
                    </ScrollViewer>
                    <Border Grid.Column="1"
                            BorderThickness="1"
                            BorderBrush="{StaticResource NovaChromeStrokeSoftBrush}"
                            CornerRadius="8"
                            Padding="20">
                        <Grid>
                            <TextBlock x:Name="VaultDetailEmptyText"
                                       Text="Selectionnez un identifiant dans la liste pour voir ses details."
                                       Opacity="0.55" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel x:Name="VaultDetailPanel" Spacing="12" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Panneau Clés d'accès (Passkeys) -->
            <Grid x:Name="PasskeysPanel" Grid.Column="2" Padding="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Clés d'accès (Passkeys)" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.68" Margin="0,4,0,0"
                               Text="Connexion sans mot de passe via Windows Hello. Les clés sont chiffrées localement et ne quittent jamais votre appareil." />
                </StackPanel>

                <Border Grid.Row="1" Padding="16" CornerRadius="8" Margin="0,0,0,16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Gestion complète via Windows" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.72" FontSize="13"
                                   Text="Windows Hello stocke et sécurise vos clés d'accès. Lumora enregistre les sites où vous en créez ou utilisez une." />
                        <Button Click="PasskeysWindowsSettingsButton_Click" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                <TextBlock Text="Paramètres Windows — Clés d'accès" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2">
                    <StackPanel x:Name="PasskeysPanelItems" Spacing="8" />
                </ScrollViewer>
            </Grid>

            <!-- Panneau Portefeuille (moyens de paiement locaux) -->
            <Grid x:Name="WalletPanel" Grid.Column="2" Padding="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Portefeuille" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.68" Margin="0,4,0,0"
                               Text="Vos moyens de paiement sont stockés uniquement dans vault.lumora, chiffrés comme vos mots de passe. Rien n'est confié au moteur web, rien ne quitte votre machine. Le cryptogramme (CVV) n'est jamais enregistré : vous le saisissez au moment du paiement." />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                    <Button Click="WalletAddButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            <TextBlock Text="Ajouter une carte" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="2">
                    <StackPanel x:Name="WalletPanelItems" Spacing="8" />
                </ScrollViewer>
            </Grid>

            <!-- Panneau Modules Lumora : hub des outils integres, pense comme des
                 extensions locales. Les actions restent explicites et ne lancent
                 rien en arriere-plan sans clic de l'utilisateur. -->
            <Grid x:Name="ModulesPanel" Grid.Column="2" Padding="24,20,24,24" Visibility="Collapsed"
                  Background="{StaticResource NovaPanelBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18" ColumnSpacing="14" MaxWidth="980" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="8"
                            Background="{StaticResource NovaIdentityMarkBrush}">
                        <FontIcon Glyph="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                  Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Modules Lumora" Style="{StaticResource NovaPanelPageTitleStyle}" />
                        <TextBlock Text="Les outils integres de Lumora, regroupes comme des extensions locales : lecture, media, productivite et actions rapides."
                                   Style="{StaticResource NovaPanelDescriptionStyle}" MaxWidth="760" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,18">
                    <Button Style="{StaticResource AccentButtonStyle}" Click="ModulesOpenCommandPalette_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            <TextBlock Text="Actions rapides" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NovaCompactButtonStyle}" Click="SettingsMenu_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Setting" />
                            <TextBlock Text="Régler les modules" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NovaCompactButtonStyle}" Click="AboutMenu_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            <TextBlock Text="À propos" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="2">
                    <StackPanel MaxWidth="980" Spacing="14" HorizontalAlignment="Left">
                        <Border Style="{StaticResource NovaPanelCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Modules épinglables" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                <TextBlock Text="Choisissez ce qui reste visible dans la barre. Les modules non épinglés restent disponibles dans le bouton puzzle."
                                           Style="{StaticResource NovaPanelDescriptionStyle}" />

                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Mode lecture" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Article épuré, surlignage et commentaires ancrés." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="0" Grid.Column="3" Content="Lire" Click="ReaderModeMenu_Click" />
                                    <ToggleButton x:Name="PanelReaderPinToggleButton" Grid.Row="0" Grid.Column="4" Tag="reader" Style="{StaticResource NovaModulePinButtonStyle}" Click="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler">
                                        <FontIcon Glyph="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                    </ToggleButton>

                                    <FontIcon Grid.Row="1" Grid.Column="0" Glyph="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Notes et annotations" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Pages annotées et notes libres du profil." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="1" Grid.Column="3" Content="Ouvrir" Click="NotesMenu_Click" />
                                    <ToggleButton x:Name="PanelNotesPinToggleButton" Grid.Row="1" Grid.Column="4" Tag="notes" Style="{StaticResource NovaModulePinButtonStyle}" Click="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler">
                                        <FontIcon Glyph="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                    </ToggleButton>

                                    <FontIcon Grid.Row="2" Grid.Column="0" Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Lecture à voix haute" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Synthèse vocale Windows, locale." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="2" Grid.Column="3" Content="Ouvrir" Click="ModulesReadAloud_Click" />
                                    <ToggleButton x:Name="PanelReadAloudPinToggleButton" Grid.Row="2" Grid.Column="4" Tag="readAloud" Style="{StaticResource NovaModulePinButtonStyle}" Click="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler">
                                        <FontIcon Glyph="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                    </ToggleButton>

                                    <FontIcon Grid.Row="3" Grid.Column="0" Glyph="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Détacher la vidéo" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Picture-in-Picture pour la vidéo active." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="3" Grid.Column="3" Content="Détacher" Click="DetachVideoMenu_Click" />
                                    <ToggleButton x:Name="PanelDetachVideoPinToggleButton" Grid.Row="3" Grid.Column="4" Tag="detachVideo" Style="{StaticResource NovaModulePinButtonStyle}" Click="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler">
                                        <FontIcon Glyph="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                    </ToggleButton>

                                    <FontIcon Grid.Row="4" Grid.Column="0" Glyph="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Télécharger la vidéo" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Module média local, avec historique des téléchargements." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="4" Grid.Column="3" Content="Télécharger" Click="ModulesVideoDownload_Click" />
                                    <ToggleButton x:Name="PanelVideoDownloadPinToggleButton" Grid.Row="4" Grid.Column="4" Tag="videoDownload" Style="{StaticResource NovaModulePinButtonStyle}" Click="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler">
                                        <FontIcon Glyph="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                    </ToggleButton>

                                    <FontIcon Grid.Row="5" Grid.Column="0" Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Recherche assistée" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Reformulation locale d'une requête avant validation." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="5" Grid.Column="3" Content="Préciser" Click="ModulesSearchAssist_Click" />
                                    <ToggleButton x:Name="PanelSearchAssistPinToggleButton" Grid.Row="5" Grid.Column="4" Tag="searchAssist" Style="{StaticResource NovaModulePinButtonStyle}" Click="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler">
                                        <FontIcon Glyph="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                    </ToggleButton>

                                    <FontIcon Grid.Row="6" Grid.Column="0" Glyph="&#xF2B7;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Traduction locale" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="6" Grid.Column="2" Text="Vérification et traduction de la page compatible." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="6" Grid.Column="3" Content="Vérifier" Click="ModulesTranslate_Click" />
                                    <ToggleButton x:Name="PanelTranslatePinToggleButton" Grid.Row="6" Grid.Column="4" Tag="translate" Style="{StaticResource NovaModulePinButtonStyle}" Click="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler">
                                        <FontIcon Glyph="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                    </ToggleButton>

                                    <FontIcon Grid.Row="7" Grid.Column="0" Glyph="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Applications web" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="7" Grid.Column="2" Text="Sites épinglés en fenêtre dédiée." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="7" Grid.Column="3" Content="Gérer" Click="WebAppsMenu_Click" />
                                    <ToggleButton x:Name="PanelWebAppsPinToggleButton" Grid.Row="7" Grid.Column="4" Tag="webApps" Style="{StaticResource NovaModulePinButtonStyle}" Click="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler">
                                        <FontIcon Glyph="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                    </ToggleButton>

                                    <FontIcon Grid.Row="8" Grid.Column="0" Glyph="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Dictée vocale" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="8" Grid.Column="2" Text="Raccourci vers la dictée Windows sans voler le focus." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="8" Grid.Column="3" Content="Aide dictée" Click="MicDictationButton_Click" />
                                    <ToggleButton x:Name="PanelDictationPinToggleButton" Grid.Row="8" Grid.Column="4" Tag="dictation" Style="{StaticResource NovaModulePinButtonStyle}" Click="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler">
                                        <FontIcon Glyph="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                                    </ToggleButton>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
            </Grid>

            <!-- Panneau Applications web Lumora -->
            <Grid x:Name="WebAppsPanel" Grid.Column="2" Padding="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Applications" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.68" Margin="0,4,0,0"
                               Text="Des sites épinglés, ouverts dans une fenêtre dédiée sans onglets ni barre d'adresse, comme une vraie application. Même profil : les sessions sont partagées avec Lumora. Les protections (bloqueur de pubs/trackers, anti-télémétrie, HTTPS) restent actives." />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                    <Button Click="InstallAppMenu_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            <TextBlock Text="Installer la page active" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="2">
                    <StackPanel x:Name="WebAppsPanelItems" Spacing="8" />
                </ScrollViewer>
            </Grid>

            <!-- Panneau Centre du site actuel -->
            <Grid x:Name="SiteControlPanel" Grid.Column="2" Padding="24,20,24,24" Visibility="Collapsed"
                  Background="{StaticResource NovaPanelBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18" ColumnSpacing="10" MaxWidth="920" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="SiteControlTitleText" Text="Site actuel" Style="{StaticResource NovaPanelPageTitleStyle}" />
                        <TextBlock x:Name="SiteControlAddressText" TextWrapping="Wrap" Opacity="0.68" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="SiteControlRefreshButton" VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Actualiser"
                            AutomationProperties.Name="Actualiser le centre du site"
                            Click="SiteControlRefreshButton_Click">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                    <Button Grid.Column="2" x:Name="SiteControlReturnButton" VerticalAlignment="Bottom"
                            Content="Retour au site"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="SiteControlReturnButton_Click" />
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="12" MaxWidth="920" HorizontalAlignment="Left">
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                        <TextBlock Text="Protection" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="SiteControlPrivacyText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <Border Background="{StaticResource NovaInfoSurfaceBrush}" CornerRadius="7" Padding="10,7">
                                        <TextBlock x:Name="SiteControlProtectionAdviceText"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Opacity="0.9" />
                                    </Border>
                                    <StackPanel x:Name="SiteControlRecentBlocksPanel" Spacing="6" />
                                    <TextBlock x:Name="SiteControlCompatibilityText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <Button x:Name="SiteControlEnableCompatibilityButton"
                                            Content="Autoriser le flux de connexion"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="SiteControlEnableCompatibilityButton_Click" />
                                    <ToggleSwitch x:Name="SiteControlCompatibilityToggle"
                                                  Header="Mode compatibilite connexion"
                                                  Toggled="SiteControlCompatibilityToggle_Toggled" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="SiteControlDiagnosticText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                            <ToggleSwitch x:Name="SiteControlDiagnosticToggle"
                                                          Header="Diagnostic connexion"
                                                          Toggled="SiteControlDiagnosticToggle_Toggled" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                x:Name="SiteControlExportDiagnosticButton"
                                                Content="Exporter"
                                                VerticalAlignment="Bottom"
                                                Click="SiteControlExportDiagnosticButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                        <TextBlock Text="Session" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="SiteControlSessionText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <ToggleSwitch x:Name="SiteControlTrustToggle"
                                                  Header="Conserver la session au demarrage"
                                                  Toggled="SiteControlTrustToggle_Toggled" />
                                    <Button x:Name="SiteControlForgetButton"
                                            Content="Oublier ce site maintenant"
                                            HorizontalAlignment="Left"
                                            Click="SiteControlForgetButton_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                        <TextBlock Text="Mots de passe" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="SiteControlPasswordText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <Button x:Name="SiteControlOpenPasswordsButton"
                                            Content="Voir les identifiants"
                                            HorizontalAlignment="Left"
                                            Click="SiteControlOpenPasswordsButton_Click" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource NovaPanelCardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Clock" />
                                        <TextBlock Text="Historique" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="SiteControlHistoryText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <Button x:Name="SiteControlOpenHistoryButton"
                                            Content="Voir l'historique du site"
                                            HorizontalAlignment="Left"
                                            Click="SiteControlOpenHistoryButton_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource NovaPanelCardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="Permissions" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="SiteControlPermissionsText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                <StackPanel x:Name="SiteControlPermissionsPanel" Spacing="8" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="SiteControlRecentHistoryPanel" Spacing="6" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Panneau Sites connectés (sessions éphémères) -->
            <Grid x:Name="SessionsPanel" Grid.Column="2" Padding="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,16" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Sites connectés" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.68"
                                   Text="Sites ayant une session active (cookies). Au démarrage, Lumora purge toutes les sessions sauf celles des sites de confiance. Le coffre de mots de passe n'est jamais concerné." />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="SessionsForgetAllButton" VerticalAlignment="Bottom"
                            Content="Tout oublier maintenant"
                            ToolTipService.ToolTip="Supprime les cookies de tous les sites, sauf les sites de confiance"
                            Click="SessionsForgetAllButton_Click" />
                    <Button Grid.Column="2" x:Name="SessionsRefreshButton" VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Actualiser"
                            AutomationProperties.Name="Actualiser les sessions"
                            Click="SessionsRefreshButton_Click">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="SessionsPanelItems" Spacing="8" MaxWidth="760" HorizontalAlignment="Left" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid x:Name="StatusBarRow" Grid.Row="5" Visibility="Collapsed" Background="{StaticResource NovaChromeSurfaceAltBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Padding="10,4"
                       Text="Lumora WinUI 3 initialise." Opacity="0.72"
                       FontSize="12"
                       AutomationProperties.LiveSetting="Polite"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button x:Name="BackToPageButton" Grid.Column="1" Visibility="Collapsed"
                    Padding="9,1,9,1" Margin="0,2,0,2" FontSize="12"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Revenir a la page web en cours"
                    Click="BackToPageButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    <TextBlock Text="Retour au site" FontSize="12" />
                </StackPanel>
            </Button>
            <Button x:Name="ProfileStatusButton"
                    Grid.Column="2"
                    Padding="10,2"
                    Margin="6,3,8,3"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="6"
                    ToolTipService.ToolTip="Ouvrir la personnalisation du profil"
                    AutomationProperties.Name="Profil Lumora"
                    Click="ProfileStatusButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:Name="ProfileStatusAvatar" Width="18" Height="18" Visibility="Collapsed">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="ProfileStatusAvatarBrush" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="ProfileStatusText" FontSize="12" VerticalAlignment="Center"
                               Opacity="0.85" />
                </StackPanel>
            </Button>
        </Grid>

        <Border x:Name="FullScreenTopRevealZone"
                Grid.RowSpan="6"
                Canvas.ZIndex="35"
                Height="10"
                VerticalAlignment="Top"
                Background="Transparent"
                Visibility="Collapsed"
                PointerEntered="FullScreenTopRevealZone_PointerEntered" />

        <Border x:Name="FullScreenLeftRevealZone"
                Grid.RowSpan="6"
                Canvas.ZIndex="35"
                Width="10"
                HorizontalAlignment="Left"
                Background="Transparent"
                Visibility="Collapsed"
                PointerEntered="FullScreenLeftRevealZone_PointerEntered" />

        <!-- Palette de commande Ctrl+K -->
        <Grid x:Name="CommandPaletteOverlay"
              Grid.RowSpan="6"
              Visibility="Collapsed"
              Background="#66000000">
            <Border x:Name="CommandPaletteCard"
                    Width="700"
                    MaxHeight="560"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,54,0,0"
                    Padding="14"
                    CornerRadius="8"
                    Background="{StaticResource NovaChromeSurfaceRaisedBrush}"
                    BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                    BorderThickness="1">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0"
                                  Glyph="&#xE721;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="18"
                                  VerticalAlignment="Center" />
                        <TextBox x:Name="CommandPaletteSearchBox"
                                 Grid.Column="1"
                                 MinHeight="36"
                                 FocusVisualPrimaryBrush="{StaticResource NovaFocusBrush}"
                                 FocusVisualSecondaryBrush="{StaticResource NovaFocusInnerBrush}"
                                 AutomationProperties.Name="Recherche de commande"
                                 PlaceholderText="Chercher une commande, un onglet, un favori, une page..."
                                 TextChanged="CommandPaletteSearchBox_TextChanged"
                                 KeyDown="CommandPaletteSearchBox_KeyDown" />
                        <Button Grid.Column="2"
                                Style="{StaticResource NovaChromeIconButtonStyle}"
                                ToolTipService.ToolTip="Fermer"
                                AutomationProperties.Name="Fermer la palette de commande"
                                Click="CommandPaletteCloseButton_Click">
                            <SymbolIcon Symbol="Cancel" />
                        </Button>
                    </Grid>

                    <TextBlock x:Name="CommandPaletteHintText"
                               Grid.Row="1"
                               Text="Entrée pour ouvrir, Échap pour fermer."
                               Opacity="0.58"
                               FontSize="12" />

                    <ListView x:Name="CommandPaletteList"
                              Grid.Row="2"
                              MaxHeight="440"
                              SelectionMode="Single"
                              DoubleTapped="CommandPaletteList_DoubleTapped"
                              KeyDown="CommandPaletteList_KeyDown">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,7" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="24"
                                            Height="24"
                                            CornerRadius="6"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <FontIcon Glyph="{Binding Glyph}"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="13"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Opacity="0.62"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Kind}"
                                               Opacity="0.54"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay de connexion (dernier enfant = au-dessus de tout) -->
        <Grid x:Name="LoginOverlay" Grid.RowSpan="6" Visibility="Collapsed"
              Background="{StaticResource NovaAppBackgroundBrush}">
            <ScrollViewer HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{StaticResource NovaChromeSurfaceRaisedBrush}"
                        BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="40,36,40,36" Margin="0,32,0,32">
                    <StackPanel Width="300" Spacing="0">

                        <!-- Logo -->
                        <StackPanel Orientation="Horizontal" Spacing="12"
                                    HorizontalAlignment="Center" Margin="0,0,0,28">
                            <Border Width="40" Height="40" CornerRadius="10">
                                <Image Source="ms-appx:///Assets/LumoraApp.png"
                                       Width="40" Height="40"
                                       Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Lumora" FontSize="22" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Message de statut -->
                        <TextBlock x:Name="LoginStatusText"
                                   HorizontalAlignment="Center" Opacity="0.65"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   FontSize="13" Margin="0,0,0,14" />

                        <!-- Choix du profil -->
                        <StackPanel x:Name="ProfilePickerPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Choisir un profil" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Chaque profil garde ses favoris, son historique, ses sessions, son coffre et ses parametres separes."
                                       TextWrapping="Wrap" Opacity="0.65" TextAlignment="Center"
                                       FontSize="13" Margin="0,0,0,6" />
                            <ListBox x:Name="ProfilePickerList"
                                     MaxHeight="190"
                                     SelectionChanged="ProfilePickerList_SelectionChanged" />
                            <Button x:Name="ProfilePickerContinueButton"
                                    Content="Continuer avec ce profil"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="ProfilePickerContinueButton_Click" />
                            <Button Content="Creer un autre profil"
                                    HorizontalAlignment="Stretch"
                                    Click="CreateAnotherProfileButton_Click" />
                            <Border Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Margin="0,6,0,2" />
                            <HyperlinkButton Content="Continuer sans profil (mode invite)"
                                             HorizontalAlignment="Center" Opacity="0.6"
                                             Click="SkipProfileButton_Click" />
                        </StackPanel>

                        <!-- Connexion par mot de passe -->
                        <StackPanel x:Name="LoginPasswordPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock x:Name="LoginWelcomeText" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Margin="0,0,0,2" />
                            <PasswordBox x:Name="LoginPasswordBox" PlaceholderText="Mot de passe"
                                         KeyDown="LoginPasswordBox_KeyDown" />
                            <Button x:Name="LoginButton" Content="Se connecter"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Click="LoginButton_Click" />
                            <HyperlinkButton Content="Mot de passe oublie ?"
                                             HorizontalAlignment="Center"
                                             Click="ForgotPasswordButton_Click" />
                            <HyperlinkButton x:Name="ShowPinButton" Content="Utiliser le code PIN"
                                             HorizontalAlignment="Center" Visibility="Collapsed"
                                             Click="ShowPinButton_Click" />
                            <HyperlinkButton Content="Changer de profil"
                                             HorizontalAlignment="Center"
                                             Click="ShowProfilePickerButton_Click" />
                            <Border Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Margin="0,10,0,2" />
                            <HyperlinkButton Content="Continuer sans profil (mode invite)"
                                             HorizontalAlignment="Center" Opacity="0.6"
                                             Click="SkipProfileButton_Click" />
                        </StackPanel>

                        <!-- Connexion par code PIN -->
                        <StackPanel x:Name="LoginPinPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock x:Name="PinWelcomeText" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock x:Name="PinDotsDisplay" Text="○ ○ ○ ○ ○ ○" FontSize="26"
                                       HorizontalAlignment="Center" Margin="0,4,0,4" />
                            <Grid ColumnSpacing="8" RowSpacing="8" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46" />
                                    <RowDefinition Height="46" />
                                    <RowDefinition Height="46" />
                                    <RowDefinition Height="46" />
                                </Grid.RowDefinitions>
                                <Button Content="1" Tag="1" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" FontSize="18" />
                                <Button Content="2" Tag="2" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" FontSize="18" />
                                <Button Content="3" Tag="3" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" FontSize="18" />
                                <Button Content="4" Tag="4" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" FontSize="18" />
                                <Button Content="5" Tag="5" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" FontSize="18" />
                                <Button Content="6" Tag="6" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" FontSize="18" />
                                <Button Content="7" Tag="7" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" FontSize="18" />
                                <Button Content="8" Tag="8" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" FontSize="18" />
                                <Button Content="9" Tag="9" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" FontSize="18" />
                                <Button Content="⌫" Tag="back" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" FontSize="16" />
                                <Button Content="0" Tag="0" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" FontSize="18" />
                                <Button Content="✕" Tag="clear" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PinDigit_Click" FontSize="14" />
                            </Grid>
                            <HyperlinkButton Content="Utiliser le mot de passe"
                                             HorizontalAlignment="Center"
                                             Click="ShowPasswordButton_Click" />
                            <HyperlinkButton Content="Changer de profil"
                                             HorizontalAlignment="Center"
                                             Click="ShowProfilePickerButton_Click" />
                            <Border Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Margin="0,6,0,2" />
                            <HyperlinkButton Content="Continuer sans profil (mode invite)"
                                             HorizontalAlignment="Center" Opacity="0.6"
                                             Click="SkipProfileButton_Click" />
                        </StackPanel>

                        <!-- Création de profil (premier lancement) -->
                        <StackPanel x:Name="CreateProfilePanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="Bienvenue" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Creez votre profil pour proteger vos donnees."
                                       TextWrapping="Wrap" Opacity="0.65" TextAlignment="Center"
                                       FontSize="13" Margin="0,0,0,6" />
                            <TextBox x:Name="ProfileNameBox" Header="Prenom ou pseudo"
                                     PlaceholderText="Jean" MaxLength="32" />
                            <PasswordBox x:Name="CreatePasswordBox" Header="Mot de passe (min. 8 caracteres)"
                                         PlaceholderText="••••••••" />
                            <PasswordBox x:Name="ConfirmPasswordBox" Header="Confirmer le mot de passe"
                                         PlaceholderText="••••••••" />
                            <ToggleSwitch x:Name="EnablePinSwitch" Header="Connexion rapide par PIN"
                                          Toggled="EnablePinSwitch_Toggled" Margin="0,4,0,0" />
                            <PasswordBox x:Name="PinSetupBox" Header="Code PIN (6 chiffres)"
                                         PlaceholderText="● ● ● ● ● ●" MaxLength="6"
                                         Visibility="Collapsed" />
                            <PasswordBox x:Name="ConfirmPinBox" Header="Confirmer le code PIN"
                                         PlaceholderText="● ● ● ● ● ●" MaxLength="6"
                                         Visibility="Collapsed" />

                            <Button x:Name="CreateProfileButton" Content="Creer mon profil"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Click="CreateProfileButton_Click"
                                    Margin="0,6,0,0" />
                            <InfoBar x:Name="GuestModeInfoBar" IsOpen="False" IsClosable="False"
                                     Severity="Informational" Visibility="Collapsed"
                                     Message="En mode sans profil, rien ne sera enregistre a la fermeture." />
                        </StackPanel>

                        <!-- Emplacement du profil (étape 2 de la création) -->
                        <StackPanel x:Name="ProfileLocationPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Ou stocker votre profil ?"
                                       FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Votre profil contient tout ce qui vous appartient :"
                                       TextWrapping="Wrap" Opacity="0.65" TextAlignment="Center"
                                       FontSize="13" Margin="0,0,0,2" />

                            <Border CornerRadius="8" Padding="14,10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="• Favoris et historique de navigation" FontSize="13" />
                                    <TextBlock Text="• Mots de passe (coffre chiffre AES-256)" FontSize="13" />
                                    <TextBlock Text="• Onglets ouverts et sessions" FontSize="13" />
                                    <TextBlock Text="• Parametres et preferences" FontSize="13" />
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="Emplacement de stockage"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12">
En choisissant un dossier personnalise (disque externe, dossier Documents...), votre profil restera accessible apres une reinstallation de Windows. Par defaut, le profil est dans %LOCALAPPDATA%\Lumora\profile.
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <TextBlock x:Name="ProfileLocationPathText"
                                               Text="Emplacement par defaut"
                                               FontSize="12" Opacity="0.72"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="200" />
                                    <Button Content="Changer"
                                            Click="ChooseProfileLocationButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="ProfileLocationContinueButton" Content="Continuer"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="ProfileLocationContinueButton_Click"
                                    Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Migration depuis un autre navigateur (après création du profil) -->
                        <StackPanel x:Name="MigrationPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Importer vos favoris ?" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Selectionnez un navigateur pour recuperer vos favoris."
                                       TextWrapping="Wrap" Opacity="0.65" TextAlignment="Center" FontSize="13" />
                            <ListBox x:Name="MigrationSourcesList" MaxHeight="180" />
                            <TextBlock Text="Firefox : exportez d'abord vos favoris en HTML depuis Firefox (Signets › Afficher tous les signets › Importer et sauvegarder › Exporter en HTML), puis utilisez le bouton ci-dessous."
                                       TextWrapping="Wrap" Opacity="0.45" FontSize="11" />
                            <Button x:Name="MigrationImportButton" Content="Importer les favoris"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Click="MigrationImportButton_Click" />
                            <Button Content="Depuis un fichier HTML..."
                                    HorizontalAlignment="Stretch"
                                    Click="MigrationImportHtmlButton_Click" />
                            <Border Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Margin="0,4,0,0" />
                            <HyperlinkButton Content="Passer cette etape"
                                             HorizontalAlignment="Center" Opacity="0.6"
                                             Click="MigrationSkipButton_Click" />
                        </StackPanel>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Wizard premier lancement (visible une seule fois apres creation de compte) -->
        <Grid x:Name="SetupWizardOverlay" Grid.RowSpan="6" Visibility="Collapsed"
              Background="{StaticResource NovaAppBackgroundBrush}">
            <ScrollViewer HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{StaticResource NovaChromeSurfaceRaisedBrush}"
                        BorderBrush="{StaticResource NovaChromeStrokeBrush}"
                        BorderThickness="1" CornerRadius="10"
                        Padding="40,36,40,36" Margin="0,32,0,32">
                    <StackPanel Width="340" Spacing="0">

                        <!-- Logo -->
                        <StackPanel Orientation="Horizontal" Spacing="12"
                                    HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Border Width="36" Height="36" CornerRadius="9">
                                <Image Source="ms-appx:///Assets/LumoraApp.png"
                                       Width="36" Height="36"
                                       Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="Lumora" FontSize="20" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Indicateur d'etape -->
                        <TextBlock x:Name="WizardStepIndicator" Text="Etape 1 / 3"
                                   HorizontalAlignment="Center" Opacity="0.5"
                                   FontSize="12" Margin="0,0,0,20" />

                        <!-- Etape 0 : Bienvenue -->
                        <StackPanel x:Name="WizardStep0" Spacing="14">
                            <TextBlock Text="Bienvenue !" FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Lumora protege votre vie privee par defaut. Quelques reglages rapides pour personnaliser votre experience."
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="14" Opacity="0.72" Margin="0,0,0,6" />
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="16,14">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Bloqueur de publicites et traceurs integre"
                                               FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="Refus automatique des bandeaux cookies"
                                               FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="Donnees stockees uniquement sur votre machine"
                                               FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Etape 1 : Moteur de recherche -->
                        <StackPanel x:Name="WizardStep1" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Moteur de recherche" FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Quel moteur souhaitez-vous utiliser par defaut ?"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="14" Opacity="0.72" Margin="0,0,0,6" />
                            <RadioButton x:Name="WizardSearchGoogle" Content="Google"
                                         GroupName="WizardSearchGroup" IsChecked="True"
                                         Tag="google" Checked="WizardSearch_Checked" />
                            <RadioButton x:Name="WizardSearchDuckDuckGo" Content="DuckDuckGo"
                                         GroupName="WizardSearchGroup"
                                         Tag="duckduckgo" Checked="WizardSearch_Checked" />
                            <RadioButton x:Name="WizardSearchBrave" Content="Brave Search"
                                         GroupName="WizardSearchGroup"
                                         Tag="brave" Checked="WizardSearch_Checked" />
                            <RadioButton x:Name="WizardSearchBing" Content="Bing"
                                         GroupName="WizardSearchGroup"
                                         Tag="bing" Checked="WizardSearch_Checked" />
                        </StackPanel>

                        <!-- Etape 2 : Resume et confirmation -->
                        <StackPanel x:Name="WizardStep2" Spacing="14" Visibility="Collapsed">
                            <TextBlock Text="Vous etes pret !" FontSize="22" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Lumora est configure. Vous pouvez modifier ces reglages a tout moment dans Parametres."
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="14" Opacity="0.72" Margin="0,0,0,6" />
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="16,14">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Name="WizardSummarySearch"
                                               FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="Protection de la vie privee activee"
                                               FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Separateur -->
                        <Border Height="1"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Margin="0,24,0,20" />

                        <!-- Boutons de navigation -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="WizardPrevButton" Content="Precedent"
                                    Grid.Column="0" IsEnabled="False"
                                    Click="WizardPrevButton_Click" />
                            <Button x:Name="WizardNextButton" Content="Suivant"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Grid.Column="2"
                                    Click="WizardNextButton_Click" />
                        </Grid>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

    </Grid>
</Window>
