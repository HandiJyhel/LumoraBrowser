            <!-- Panneau Loupe de lecture (accessibilite) -->
            <Grid x:Name="ReadingLensPanel" Grid.Column="3" Padding="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,16" Spacing="4">
                    <TextBlock Text="Loupe de lecture" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.68" MaxWidth="720" HorizontalAlignment="Left"
                               Text="Capture agrandie de la page pour mieux lire un texte minuscule ou déformé (par exemple un captcha visuel). Molette + Ctrl (ou pincer) pour zoomer, barres de défilement pour naviguer dans l'image. Rien n'est transmis : c'est une image locale, vous lisez et répondez vous-même." />
                    <Button x:Name="ReadingLensRefreshButton" Content="Actualiser la capture"
                            HorizontalAlignment="Left" Margin="0,4,0,0" Click="ReadingLensRefreshButton_Click" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              ZoomMode="Enabled"
                              MinZoomFactor="0.25"
                              MaxZoomFactor="6"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Enabled"
                              Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
                    <Image x:Name="ReadingLensImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </ScrollViewer>
                <TextBlock x:Name="ReadingLensEmptyText" Grid.Row="1"
                           Text="Ouvrez une page web puis cliquez sur la loupe dans la barre d'outils."
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
            </Grid>

            <!-- Panneau Applications web Lumora -->
            <Grid x:Name="WebAppsPanel" Grid.Column="3" Padding="20" Visibility="Collapsed"
                  Background="{StaticResource NovaPanelBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Margin="0,0,0,16" Style="{StaticResource NovaPanelShellCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Applications" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.68" Margin="0,4,0,0"
                                   Text="Des sites épinglés, ouverts dans une fenêtre dédiée sans onglets ni barre d'adresse, comme une vraie application. Même profil : les sessions sont partagées avec Lumora. Les protections (bloqueur de pubs/trackers, anti-télémétrie, HTTPS) restent actives." />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                    <Button Click="InstallAppMenu_Click"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            <TextBlock Text="Installer la page active" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource NovaPanelShellCardStyle}">
                    <ScrollViewer>
                        <StackPanel x:Name="WebAppsPanelItems" Spacing="8" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Panneau Centre du site actuel -->
            <Grid x:Name="SiteControlPanel" Grid.Column="3" Padding="24,20,24,24" Visibility="Collapsed"
                  Background="{StaticResource NovaPanelBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Margin="0,0,0,18" MaxWidth="920" HorizontalAlignment="Left"
                        Style="{StaticResource NovaFlyoutHeroCardStyle}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="SiteControlTitleText" Text="Site actuel" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock x:Name="SiteControlAddressText" TextWrapping="Wrap" Opacity="0.68" FontSize="12" />
                            <TextBlock Text="Tout ce qui suit ne concerne que ce site : session, confort, permissions et compatibilite."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="SiteControlRefreshButton" VerticalAlignment="Bottom"
                                ToolTipService.ToolTip="Actualiser"
                                AutomationProperties.Name="Actualiser le centre du site"
                                Click="SiteControlRefreshButton_Click"
                                Style="{StaticResource NovaPanelActionButtonStyle}">
                            <SymbolIcon Symbol="Refresh" />
                        </Button>
                        <Button Grid.Column="2" x:Name="SiteControlReturnButton" VerticalAlignment="Bottom"
                                Content="Retour au site"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="SiteControlReturnButton_Click" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="12" MaxWidth="920" HorizontalAlignment="Left">
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource NovaPanelShellCardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                        <TextBlock Text="Protection" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="SiteControlPrivacyText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <Border Background="{StaticResource NovaInfoSurfaceBrush}" CornerRadius="7" Padding="10,7">
                                        <TextBlock x:Name="SiteControlProtectionAdviceText"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Opacity="0.9" />
                                    </Border>
                                    <StackPanel x:Name="SiteControlRecentBlocksPanel" Spacing="6" />
                                    <TextBlock x:Name="SiteControlCompatibilityText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <Button x:Name="SiteControlEnableCompatibilityButton"
                                            Content="Autoriser le flux de connexion"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="SiteControlEnableCompatibilityButton_Click" />
                                    <ToggleSwitch x:Name="SiteControlCompatibilityToggle"
                                                  Header="Mode compatibilite connexion"
                                                  Toggled="SiteControlCompatibilityToggle_Toggled" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="SiteControlDiagnosticText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                            <ToggleSwitch x:Name="SiteControlDiagnosticToggle"
                                                          Header="Diagnostic connexion"
                                                          Toggled="SiteControlDiagnosticToggle_Toggled" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                x:Name="SiteControlExportDiagnosticButton"
                                                Content="Exporter"
                                                VerticalAlignment="Bottom"
                                                Click="SiteControlExportDiagnosticButton_Click"
                                                Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource NovaPanelShellCardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                        <TextBlock Text="Session" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="SiteControlSessionText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <ToggleSwitch x:Name="SiteControlTrustToggle"
                                                  Header="Conserver la session au démarrage"
                                                  Toggled="SiteControlTrustToggle_Toggled" />
                                    <Button x:Name="SiteControlForgetButton"
                                            Content="Oublier ce site maintenant"
                                            HorizontalAlignment="Left"
                                            Click="SiteControlForgetButton_Click"
                                            Style="{StaticResource NovaPanelActionButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource NovaPanelShellCardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="Confort de ce site" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="SiteControlComfortText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                <ComboBox x:Name="SiteControlComfortZoomCombo"
                                          Header="Zoom prefere pour ce site"
                                          Width="220"
                                          SelectionChanged="SiteControlComfortZoomCombo_SelectionChanged">
                                    <ComboBoxItem Content="90 %" Tag="90" />
                                    <ComboBoxItem Content="100 %" Tag="100" />
                                    <ComboBoxItem Content="110 %" Tag="110" />
                                    <ComboBoxItem Content="125 %" Tag="125" />
                                    <ComboBoxItem Content="140 %" Tag="140" />
                                    <ComboBoxItem Content="160 %" Tag="160" />
                                </ComboBox>
                                <ToggleSwitch x:Name="SiteControlComfortLargeTextToggle"
                                              Header="Texte plus lisible sur ce site"
                                              Toggled="SiteControlComfortLargeTextToggle_Toggled" />
                                <ToggleSwitch x:Name="SiteControlComfortReduceMotionToggle"
                                              Header="Limiter les animations sur ce site"
                                              Toggled="SiteControlComfortReduceMotionToggle_Toggled" />
                                <Button x:Name="SiteControlComfortResetButton"
                                        Content="Réinitialiser le confort de ce site"
                                        HorizontalAlignment="Left"
                                        Click="SiteControlComfortResetButton_Click"
                                        Style="{StaticResource NovaPanelActionButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource NovaPanelShellCardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                        <TextBlock Text="Mots de passe" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="SiteControlPasswordText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <Button x:Name="SiteControlOpenPasswordsButton"
                                            Content="Voir les identifiants"
                                            HorizontalAlignment="Left"
                                            Click="SiteControlOpenPasswordsButton_Click"
                                            Style="{StaticResource NovaPanelActionButtonStyle}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource NovaPanelShellCardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Clock" />
                                        <TextBlock Text="Historique" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="SiteControlHistoryText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                    <Button x:Name="SiteControlOpenHistoryButton"
                                            Content="Voir l'historique du site"
                                            HorizontalAlignment="Left"
                                            Click="SiteControlOpenHistoryButton_Click"
                                            Style="{StaticResource NovaPanelActionButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource NovaPanelShellCardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE785;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                                    <TextBlock Text="Permissions" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="SiteControlPermissionsText" Style="{StaticResource NovaPanelDescriptionStyle}" />
                                <StackPanel x:Name="SiteControlPermissionsPanel" Spacing="8" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="SiteControlRecentHistoryPanel" Spacing="6" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Panneau Sites connectés (sessions éphémères) -->
            <Grid x:Name="SessionsPanel" Grid.Column="3" Padding="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,16" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Sites connectés" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.68"
                                   Text="Sites ayant une session active (cookies). Au démarrage, Lumora purge toutes les sessions sauf celles des sites de confiance. Le coffre de mots de passe n'est jamais concerné." />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="SessionsForgetAllButton" VerticalAlignment="Bottom"
                            Content="Tout oublier maintenant"
                            ToolTipService.ToolTip="Supprime les cookies de tous les sites, sauf les sites de confiance"
                            Click="SessionsForgetAllButton_Click" />
                    <Button Grid.Column="2" x:Name="SessionsRefreshButton" VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Actualiser"
                            AutomationProperties.Name="Actualiser les sessions"
                            Click="SessionsRefreshButton_Click">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <StackPanel x:Name="SessionsPanelItems" Spacing="8" MaxWidth="760" HorizontalAlignment="Left" />
                </ScrollViewer>
            </Grid>

        <Grid x:Name="BookmarksBottomRow"
                  Grid.Row="1"
                  Grid.ColumnSpan="7"
                  Padding="10,6,10,6"
                  ColumnSpacing="8"
                  SizeChanged="BookmarksLayoutHost_SizeChanged"
                  RightTapped="WorkspaceLayoutSurface_RightTapped"
                  BorderThickness="0,1,0,0"
                  BorderBrush="{StaticResource NovaChromeStrokeSoftBrush}"
                  Background="{StaticResource NovaChromeGradientBrush}"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="5"
                            Margin="2,0,10,0"
                            VerticalAlignment="Center"
                            Opacity="0.6">
                    <TextBlock Text="✦" FontSize="10" Foreground="{StaticResource NovaAccentBrush}" />
                    <TextBlock Text="Constellation" FontSize="10.5" Foreground="{StaticResource NovaTextMutedBrush}" />
                </StackPanel>
                <StackPanel x:Name="BookmarksBottomBarPanel"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center" />
                <Border Grid.Column="2"
                        Width="1"
                        Height="18"
                        Margin="5,0"
                        Background="{StaticResource NovaChromeStrokeBrush}" />
                <StackPanel x:Name="OtherBookmarksBottomHost"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <Grid x:Name="StatusBarRow" Grid.Row="6" Visibility="Collapsed" Background="{StaticResource NovaChromeSurfaceAltBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Padding="10,4"
                       Text="Lumora WinUI 3 initialise." Opacity="0.72"
                       FontSize="12"
                       AutomationProperties.Name="État Lumora"
                       AutomationProperties.HelpText="Annonce les changements importants de navigation, de sécurité et d'accessibilité."
                       AutomationProperties.LiveSetting="Polite"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button x:Name="BackToPageButton" Grid.Column="1" Visibility="Collapsed"
                    Padding="9,1,9,1" Margin="0,2,0,2" FontSize="12"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Revenir a la page web en cours"
                    Click="BackToPageButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    <TextBlock Text="Retour au site" FontSize="12" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        Margin="6,3,8,3"
                        VerticalAlignment="Center">
                <!-- 2026-08-10 : refonte en 3 menus distincts de la barre du bas
                     (demande explicite utilisateur - "l'utilisateur n'est pas
                     perdu"). Remplace la fusion en un seul UsageModeButton faite
                     plus tot cette session : plus une seule surcouche par-dessus
                     l'ancien, 3 vrais Button/Flyout independants, chacun avec sa
                     propre couleur d'accent (Mode=NovaAccentBrush/ambre,
                     Compagnon=NovaCompanionAccentBrush/rose, Accessibilite=
                     NovaCoolAccentBrush/cyan) et sa propre methode de mise a jour
                     C# (voir MainWindow.UsageMode.cs). -->

                <!-- Menu 1/3 : Mode -->
                <Button x:Name="ModeUsageButton"
                        MinHeight="30"
                        Padding="10,0"
                        Style="{StaticResource NovaFooterPillButtonStyle}"
                        AutomationProperties.Name="Mode"
                        ToolTipService.ToolTip="Mode d'usage">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border x:Name="UsageModeAccentBar"
                                Width="2"
                                Height="14"
                                CornerRadius="1"
                                Background="{StaticResource NovaAccentBrush}"
                                Opacity="0.78" />
                        <FontIcon x:Name="UsageModeIcon"
                                  Glyph="&#xE7F4;"
                                  FontFamily="Segoe MDL2 Assets"
                                  FontSize="11.5"
                                  Opacity="0.76"
                                  VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="UsageModeLabelText" Text="Mode" FontSize="10.5" Opacity="0.56" VerticalAlignment="Center" />
                            <TextBlock x:Name="UsageModeCurrentText" Text="Équilibre" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                        <FontIcon x:Name="UsageModeChevronIcon" Glyph="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" Opacity="0.44" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="ModeUsageFlyout" Placement="TopEdgeAlignedRight">
                            <StackPanel Width="340" Spacing="12">
                                <Border Style="{StaticResource NovaFlyoutHeroCardStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Mode d'usage"
                                                   FontWeight="SemiBold"
                                                   FontSize="18"
                                                   Foreground="{StaticResource NovaBrandChipForegroundBrush}" />
                                        <TextBlock Text="Ajuste le rythme de Lumora selon ce que vous faites."
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Opacity="0.82"
                                                   Foreground="{StaticResource NovaBrandChipMutedBrush}" />
                                    </StackPanel>
                                </Border>
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button x:Name="UsageModeNeutralButton" Grid.Row="0" Grid.Column="0" Tag="neutral" Style="{StaticResource NovaModuleFlyoutActionStyle}" Click="UsageModeQuickButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2" Width="140">
                                                <TextBlock Text="Neutre" FontWeight="SemiBold" />
                                                <TextBlock Text="Heure, recherche et outils essentiels." FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="UsageModeBalancedButton" Grid.Row="0" Grid.Column="1" Tag="balanced" Style="{StaticResource NovaModuleFlyoutActionStyle}" Click="UsageModeQuickButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                                            <StackPanel Spacing="2" Width="140">
                                                <TextBlock Text="Équilibre" FontWeight="SemiBold" />
