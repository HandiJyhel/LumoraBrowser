                </Border>
                <Border Grid.Row="1" Style="{StaticResource NovaPanelShellCardStyle}">
                    <ScrollViewer>
                        <StackPanel x:Name="SavedTabGroupsPanelItems" Spacing="10" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Panneau Notes : pages annotées en mode lecture (reprise
                 d'activité) + bloc-notes libre. Liste à gauche, détail à
                 droite (lecteur d'annotations ou éditeur de note selon la
                 sélection). Tout est stocké chiffré dans le profil. -->
            <Grid x:Name="NotesPanel" Grid.Column="3" Padding="20" Visibility="Collapsed"
                  Background="{StaticResource NovaPanelBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Margin="0,0,0,16" Style="{StaticResource NovaPanelShellCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Notes" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Vos pages annotées en mode lecture et vos notes libres. Rouvrez une page annotée pour reprendre votre lecture là où vous l'aviez laissée. Tout est chiffré dans votre profil et ne quitte jamais cet appareil."
                                   Opacity="0.68" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="NotesAddButton" VerticalAlignment="Bottom"
                            Style="{StaticResource NovaButtonPrimaryStyle}"
                            AutomationProperties.Name="Nouvelle note"
                            Click="NotesAddButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock Text="Nouvelle note" />
                        </StackPanel>
                    </Button>
                </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <TextBox x:Name="NotesSearchBox"
                             Style="{StaticResource NovaCommandPaletteSearchBoxStyle}"
                             PlaceholderText="Rechercher dans les notes et annotations"
                             AutomationProperties.Name="Rechercher dans les notes et annotations"
                             TextChanged="NotesSearchBox_TextChanged" />
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="NotesList" SelectionMode="Single"
                              AutomationProperties.Name="Liste des notes et pages annotees"
                              SelectionChanged="NotesList_SelectionChanged" />

                    <!-- Détail d'une page annotée : reprise en mode lecture,
                         liste des surlignages et commentaires. -->
                    <Grid Grid.Column="1" x:Name="AnnotationViewerHost" RowSpacing="10" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="AnnotationPageTitleText" FontSize="18" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="AnnotationPageUrlText" Opacity="0.6" FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Row="1" x:Name="AnnotationOpenPageButton"
                                Style="{StaticResource NovaButtonPrimaryStyle}"
                                AutomationProperties.Name="Reprendre la page en mode lecture"
                                Click="AnnotationOpenPageButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                <TextBlock Text="Reprendre en mode lecture" />
                            </StackPanel>
                        </Button>
                        <ListView Grid.Row="2" x:Name="AnnotationsList" SelectionMode="None"
                                  AutomationProperties.Name="Annotations de la page" />
                        <Grid Grid.Row="3">
                            <TextBlock x:Name="AnnotationMetaText" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                            <Button x:Name="AnnotationForgetPageButton" HorizontalAlignment="Right"
                                    Style="{StaticResource NovaButtonStyle}"
                                    AutomationProperties.Name="Oublier toutes les annotations de cette page"
                                    Click="AnnotationForgetPageButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Delete" />
                                    <TextBlock Text="Oublier cette page" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="1" x:Name="NoteEditorHost" RowSpacing="10" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="NoteTitleBox" PlaceholderText="Titre de la note"
                                 AutomationProperties.Name="Titre de la note" MaxLength="160"
                                 TextChanged="NoteEditor_TextChanged" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <HyperlinkButton x:Name="NoteLinkButton" Padding="2,0"
                                             AutomationProperties.Name="Ouvrir la page liee"
                                             Click="NoteLinkButton_Click" Visibility="Collapsed" />
                            <Button x:Name="NoteAttachPageButton"
                                    Style="{StaticResource NovaButtonStyle}"
                                    ToolTipService.ToolTip="Rattacher cette note a la page web courante"
                                    AutomationProperties.Name="Rattacher a la page courante"
                                    Click="NoteAttachPageButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                    <TextBlock Text="Rattacher a la page" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBox Grid.Row="2" x:Name="NoteContentBox"
                                 PlaceholderText="Ecrivez votre note ici..."
                                 AutomationProperties.Name="Contenu de la note"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                                 TextChanged="NoteEditor_TextChanged" />
                        <Grid Grid.Row="3">
                            <TextBlock x:Name="NoteMetaText" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                            <Button x:Name="NoteDeleteButton" HorizontalAlignment="Right"
                                    Style="{StaticResource NovaButtonDangerStyle}"
                                    AutomationProperties.Name="Supprimer la note"
                                    Click="NoteDeleteButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SymbolIcon Symbol="Delete" />
                                    <TextBlock Text="Supprimer" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                    <TextBlock Grid.Column="1" x:Name="NotesEmptyText"
                               Text="Rien pour l'instant. Surlignez un passage d'une page web via le Mode lecture (bouton dans la barre d'outils) : la page annotée apparaîtra ici. Vous pouvez aussi créer une note libre."
                               Opacity="0.6" TextWrapping="Wrap" MaxWidth="420"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <!-- Panneau Flux RSS : liste des flux a gauche, articles du flux
                 selectionne a droite. Les articles ne sont jamais stockes
                 localement, juste recuperes en direct - seul l'identifiant des
                 articles lus est retenu (etat lu/non lu). -->
            <Grid x:Name="RssPanel" Grid.Column="3" Padding="20" Visibility="Collapsed"
                  Background="{StaticResource NovaPanelBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Margin="0,0,0,16" Style="{StaticResource NovaPanelShellCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Flux RSS" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Suivez vos sites preferes sans algorithme ni compte : ajoutez l'adresse d'un flux RSS ou Atom, les articles sont recuperes en direct a chaque consultation."
                                   Opacity="0.68" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="RssAddButton" VerticalAlignment="Bottom"
                            Style="{StaticResource NovaButtonPrimaryStyle}"
                            AutomationProperties.Name="Ajouter un flux RSS"
                            Click="RssAddButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock Text="Ajouter un flux" />
                        </StackPanel>
                    </Button>
                </Grid>
                </Border>
                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="RssFeedsList" SelectionMode="Single"
                              AutomationProperties.Name="Liste des flux RSS suivis"
                              SelectionChanged="RssFeedsList_SelectionChanged" />
                    <TextBlock x:Name="RssFeedsEmptyText"
                               Text="Aucun flux pour l'instant. Ajoutez l'adresse d'un flux RSS ou Atom pour commencer."
                               Opacity="0.6" TextWrapping="Wrap" MaxWidth="280"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

                    <Grid Grid.Column="1" x:Name="RssArticlesHost" RowSpacing="10" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RssFeedTitleText" FontSize="18" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="RssRefreshButton"
                                    Style="{StaticResource NovaChromeIconButtonStyle}"
                                    AutomationProperties.Name="Actualiser ce flux"
                                    ToolTipService.ToolTip="Actualiser"
                                    Click="RssRefreshButton_Click">
                                <SymbolIcon Symbol="Refresh" />
                            </Button>
                            <Button Grid.Column="2" x:Name="RssRemoveFeedButton" Margin="8,0,0,0"
                                    Style="{StaticResource NovaButtonDangerStyle}"
                                    AutomationProperties.Name="Supprimer ce flux"
                                    ToolTipService.ToolTip="Ne plus suivre ce flux"
                                    Click="RssRemoveFeedButton_Click">
                                <SymbolIcon Symbol="Delete" />
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" x:Name="RssArticlesStatusText" Opacity="0.6" FontSize="12" />
                        <ListView Grid.Row="2" x:Name="RssArticlesList" SelectionMode="None" IsItemClickEnabled="True"
                                  AutomationProperties.Name="Articles du flux"
                                  ItemClick="RssArticlesList_ItemClick" />
                    </Grid>
                    <TextBlock Grid.Column="1" x:Name="RssArticlesEmptyText"
                               Text="Sélectionnez un flux à gauche pour voir ses articles."
                               Opacity="0.6" TextWrapping="Wrap" MaxWidth="420"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>

            <Grid x:Name="VaultPanel" Grid.Column="3" Padding="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Gestionnaire de mots de passe" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="Comptes locaux stockés dans vault.lumora, chiffré AES-256 avec une clé dérivée du mot de passe du profil." Opacity="0.68" />
                    </StackPanel>
                    <!-- Barre d'actions avec libelles (2026-08-10, "choses a revoir" -
                         retour utilisateur sur 6 icones sans texte : "j'ai du deviner
                         leur sens"). Les info-bulles/noms d'accessibilite detailles
                         restent inchanges, un mot court s'ajoute juste a cote de
                         chaque icone. Seule "Ajouter un identifiant" (l'action la
                         plus frequente) passe en bouton d'accent, meme convention
                         que NotesAddButton/WalletAddCardButton ailleurs dans l'app. -->
                    <Button Grid.Column="1" x:Name="VaultHealthButton" Margin="0,0,8,0" VerticalAlignment="Bottom"
                            Style="{StaticResource NovaButtonStyle}"
                            ToolTipService.ToolTip="Bilan de santé : mots de passe réutilisés, faibles ou anciens (analyse 100% locale)"
                            AutomationProperties.Name="Bilan de sante des mots de passe"
                            Click="VaultHealthButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Text="Bilan" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="VaultMergeButton" Margin="0,0,8,0" VerticalAlignment="Bottom"
                            Style="{StaticResource NovaButtonStyle}"
                            ToolTipService.ToolTip="Fusionner les doublons : même site, même identifiant et même mot de passe enregistrés plusieurs fois (www., sous-domaines...)"
                            AutomationProperties.Name="Fusionner les doublons du coffre"
                            Click="VaultMergeButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEA99;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                            <TextBlock Text="Fusionner" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" x:Name="VaultImportButton" Margin="0,0,8,0" VerticalAlignment="Bottom"
                            Style="{StaticResource NovaButtonStyle}"
                            ToolTipService.ToolTip="Importer des mots de passe : fichier CSV ou navigateur installé (Chrome, Edge, Brave...)"
                            AutomationProperties.Name="Importer des mots de passe"
                            Click="VaultImportButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Import" />
                            <TextBlock Text="Importer" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" x:Name="VaultExportButton" Margin="0,0,8,0" VerticalAlignment="Bottom"
                            Style="{StaticResource NovaButtonStyle}"
                            ToolTipService.ToolTip="Exporter en clair vers un fichier CSV"
                            AutomationProperties.Name="Exporter les mots de passe"
                            Click="VaultExportButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Save" />
                            <TextBlock Text="Exporter" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="5" x:Name="VaultRefreshButton" Margin="0,0,8,0" VerticalAlignment="Bottom"
                            Style="{StaticResource NovaChromeIconButtonStyle}"
                            ToolTipService.ToolTip="Actualiser"
                            AutomationProperties.Name="Actualiser le coffre"
                            Click="VaultRefreshButton_Click">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                    <Button Grid.Column="6" x:Name="VaultAddButton" VerticalAlignment="Bottom"
                            Style="{StaticResource NovaButtonPrimaryStyle}"
                            ToolTipService.ToolTip="Ajouter un identifiant"
                            AutomationProperties.Name="Ajouter un identifiant"
                            Click="VaultAddButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock Text="Ajouter un identifiant" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,12" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="PasswordManagerSearchBox"
                             PlaceholderText="Rechercher un site, un identifiant ou un domaine"
                             TextChanged="PasswordManagerSearchBox_TextChanged" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <RadioButton x:Name="VaultSortRecentRadio" Content="Récent" GroupName="VaultSort"
                                     IsChecked="True" Click="VaultSort_Click" />
                        <RadioButton x:Name="VaultSortAlphabeticalRadio" Content="Alphabétique" GroupName="VaultSort"
                                     Click="VaultSort_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0">
                        <StackPanel x:Name="VaultPanelItems" Spacing="10" />
                    </ScrollViewer>
                    <Border Grid.Column="1"
                            BorderThickness="1"
                            BorderBrush="{StaticResource NovaChromeStrokeSoftBrush}"
                            CornerRadius="8"
                            Padding="20">
                        <Grid>
                            <!-- Etat vide illustre (2026-08-10, "choses a revoir" -
                                 remplace une simple ligne de texte grise qui laissait
                                 la moitie de l'ecran vide sans aucune explication). -->
                            <StackPanel x:Name="VaultDetailEmptyText"
                                        Spacing="10" MaxWidth="280"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                          Opacity="0.35" HorizontalAlignment="Center" />
                                <TextBlock Text="Sélectionnez un identifiant dans la liste pour voir ses détails."
                                           Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel x:Name="VaultDetailPanel" Spacing="12" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Panneau Portefeuille (moyens de paiement locaux) -->
            <Grid x:Name="WalletPanel" Grid.Column="3" Padding="16" Visibility="Collapsed"
                  AutomationProperties.Name="Portefeuille"
                  AutomationProperties.HelpText="Ajoutez une carte locale, modifiez-la ou utilisez-la sur la page active.">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Portefeuille" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.68" Margin="0,4,0,0"
                               Text="Vos moyens de paiement sont stockés uniquement dans vault.lumora, chiffrés comme vos mots de passe. Rien n'est confié au moteur web, rien ne quitte votre machine. Le cryptogramme (CVV) n'est jamais enregistré : vous le saisissez au moment du paiement." />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                    <Button x:Name="WalletAddCardButton"
                            Style="{StaticResource NovaButtonPrimaryStyle}"
                            Click="WalletAddButton_Click"
                            AutomationProperties.Name="Ajouter une carte au portefeuille">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            <TextBlock Text="Ajouter une carte" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="2">
                    <StackPanel x:Name="WalletPanelItems" Spacing="8" />
                </ScrollViewer>
            </Grid>

            <!-- Panneau Modules Lumora : hub des outils integres, pense comme des
                 extensions locales. Les actions restent explicites et ne lancent
                 rien en arriere-plan sans clic de l'utilisateur. -->
            <Grid x:Name="ModulesPanel" Grid.Column="3" Padding="24,20,24,24" Visibility="Collapsed"
                  Background="{StaticResource NovaPanelBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Margin="0,0,0,18" MaxWidth="980" HorizontalAlignment="Left"
                        Style="{StaticResource NovaFlyoutHeroCardStyle}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="12"
                                Background="{StaticResource NovaIdentityMarkBrush}">
                            <FontIcon Glyph="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                      Foreground="{StaticResource NovaTextOnAccentBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Modules Lumora" Style="{StaticResource NovaPanelPageTitleStyle}" />
                            <TextBlock Text="Des outils locaux visibles, utiles et faciles à épingler. Lumora les présente comme des briques de votre propre ergonomie, pas comme un magasin d'extensions."
                                       Style="{StaticResource NovaPanelDescriptionStyle}" MaxWidth="760" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,0,0,18" MaxWidth="980" HorizontalAlignment="Left"
                        Style="{StaticResource NovaPanelShellCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Actions essentielles" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource NovaButtonPrimaryStyle}" Click="ModulesOpenCommandPalette_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                    <TextBlock Text="Actions rapides" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NovaPanelActionButtonStyle}" Click="SettingsMenu_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Setting" />
                                    <TextBlock Text="Regler les modules" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NovaPanelActionButtonStyle}" Click="AboutMenu_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                    <TextBlock Text="A propos" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2">
                    <StackPanel MaxWidth="980" Spacing="14" HorizontalAlignment="Left">
                        <Border Style="{StaticResource NovaFlyoutHeroCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Mode d'usage" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                <TextBlock Text="Changez rapidement le rythme de Lumora sans quitter le hub des modules."
                                           Style="{StaticResource NovaPanelDescriptionStyle}" />
                                <ComboBox x:Name="ModulesUsageModeCombo"
                                          Header="Mode actuel"
                                          Width="280"
                                          SelectionChanged="ModulesUsageModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Neutre" Tag="neutral" />
                                    <ComboBoxItem Content="Équilibre" Tag="balanced" />
                                    <ComboBoxItem Content="Focus" Tag="focus" />
                                    <ComboBoxItem Content="Lecture" Tag="reading" />
                                    <ComboBoxItem Content="Création" Tag="creative" />
                                    <ComboBoxItem Content="Recherche" Tag="research" />
                                    <ComboBoxItem Content="Nuit" Tag="night" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NovaPanelShellCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Protections" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                <TextBlock Text="Sécurité active en arrière-plan, sans intermédiaire réseau ni coût de vitesse. Détail et réglages fins dans Confidentialité."
                                           Style="{StaticResource NovaPanelDescriptionStyle}" />

                                <ToggleSwitch x:Name="ModulesWebRtcSwitch"
                                             Header="Bloquer les fuites d'IP WebRTC"
                                             Toggled="ModulesWebRtcSwitch_Toggled" />
                                <ToggleSwitch x:Name="ModulesGeolocationSwitch"
                                             Header="Position fictive (geolocalisation)"
                                             Toggled="ModulesGeolocationSwitch_Toggled" />
                                <ToggleSwitch x:Name="ModulesFingerprintSwitch"
                                             Header="Brouiller l'empreinte du navigateur"
                                             Toggled="ModulesFingerprintSwitch_Toggled" />

                                <Button Content="Réglages avancés" Tag="privacy" Click="ModulesProtectionsSettingsButton_Click"
                                        Style="{StaticResource NovaPanelActionButtonStyle}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NovaPanelShellCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Modules épinglables" Style="{StaticResource NovaPanelSectionTitleStyle}" />
                                <TextBlock Text="Choisissez ce qui reste visible dans la barre. Les modules non épinglés restent disponibles dans le bouton puzzle."
                                           Style="{StaticResource NovaPanelDescriptionStyle}" />

                                <Grid ColumnSpacing="12" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <FontIcon Grid.Row="0" Grid.Column="0" Glyph="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Mode lecture" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Article épuré, surlignage et commentaires ancrés." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="0" Grid.Column="3" Content="Lire" Click="ReaderModeMenu_Click" Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    <ToggleSwitch x:Name="PanelReaderPinToggleButton" Grid.Row="0" Grid.Column="4" Tag="reader" Style="{StaticResource NovaModulePinSwitchStyle}" Toggled="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler" />

                                    <FontIcon Grid.Row="1" Grid.Column="0" Glyph="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Notes et annotations" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Pages annotées et notes libres du profil." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="1" Grid.Column="3" Content="Ouvrir" Click="NotesMenu_Click" Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    <ToggleSwitch x:Name="PanelNotesPinToggleButton" Grid.Row="1" Grid.Column="4" Tag="notes" Style="{StaticResource NovaModulePinSwitchStyle}" Toggled="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler" />

                                    <FontIcon Grid.Row="2" Grid.Column="0" Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Lecture à voix haute" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Synthèse vocale Windows, locale." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="2" Grid.Column="3" Content="Ouvrir" Click="ModulesReadAloud_Click" Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    <ToggleSwitch x:Name="PanelReadAloudPinToggleButton" Grid.Row="2" Grid.Column="4" Tag="readAloud" Style="{StaticResource NovaModulePinSwitchStyle}" Toggled="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler" />

                                    <FontIcon Grid.Row="3" Grid.Column="0" Glyph="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Détacher la vidéo" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Picture-in-Picture pour la vidéo active." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="3" Grid.Column="3" Content="Detacher" Click="DetachVideoMenu_Click" Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    <ToggleSwitch x:Name="PanelDetachVideoPinToggleButton" Grid.Row="3" Grid.Column="4" Tag="detachVideo" Style="{StaticResource NovaModulePinSwitchStyle}" Toggled="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler" />

                                    <FontIcon Grid.Row="4" Grid.Column="0" Glyph="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Télécharger la vidéo" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Module média local, avec historique des téléchargements." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="4" Grid.Column="3" Content="Télécharger" Click="ModulesVideoDownload_Click" Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    <ToggleSwitch x:Name="PanelVideoDownloadPinToggleButton" Grid.Row="4" Grid.Column="4" Tag="videoDownload" Style="{StaticResource NovaModulePinSwitchStyle}" Toggled="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler" />

                                    <FontIcon Grid.Row="5" Grid.Column="0" Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Recherche assistée" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Reformulation locale d'une requête avant validation." Opacity="0.68" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Row="5" Grid.Column="3" Content="Preciser" Click="ModulesSearchAssist_Click" Style="{StaticResource NovaPanelActionButtonStyle}" />
                                    <ToggleSwitch x:Name="PanelSearchAssistPinToggleButton" Grid.Row="5" Grid.Column="4" Tag="searchAssist" Style="{StaticResource NovaModulePinSwitchStyle}" Toggled="ModulePinToggle_Click" ToolTipService.ToolTip="Épingler" />

                                    <FontIcon Grid.Row="6" Grid.Column="0" Glyph="&#xF2B7;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Traduction locale" FontWeight="SemiBold" VerticalAlignment="Center" />
