<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Lumora.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\LumoraApp.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;bin\**\*;obj\**;obj\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.14.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0-preview.1.25125.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Credentials\*.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Translation\*.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ReadAloud\*.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Reader\*.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SemanticSearch\*.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Credentials\TestPages\*.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\LumoraApp.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\LumoraApp.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\LumoraLogoMark.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\LumoraIncognito.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Public Suffix List (Mozilla, licence MPL 2.0) — https://publicsuffix.org -->
    <EmbeddedResource Include="Credentials\public_suffix_list.dat" />
  </ItemGroup>

</Project>
