<Application
    x:Class="Lumora.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Lumora.WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#FFFFB935</Color>
            <!-- Familles de sens du Menu Demarrer (chantier identite visuelle,
                 2026-08-10) : badge de tuile colore par famille plutot que le
                 meme degrade Lumora partout. Content = ambre (issu du meme
                 degrade que NovaIdentityMarkBrush, ce qui vous appartient),
                 Protection = rose (ce qui vous protege), Outils = cyan (meme
                 teinte que NovaCoolAccentBrush - deja l'accent
                 technique/verification ailleurs dans la chrome ; copie plutot
                 que reference directe car NovaCoolAccentBrush vit dans les
                 ressources de la fenetre, hors de portee ici). Ces 3 brushes
                 vivent en Application.Resources (pas RootShell.Resources) car
                 le convertisseur qui les consomme n'a pas de reference a la
                 fenetre - a la difference de NovaIdentityMarkBrush (reste
                 dans MainWindow.xaml, mute en direct par SetIdentityGradient),
                 rien d'autre n'ecrit dans ces 3-la, aucun risque a les avoir
                 ici. -->
            <SolidColorBrush x:Key="NovaTileFamilyContentBrush" Color="#FFE6AA48" />
            <SolidColorBrush x:Key="NovaTileFamilyProtectionBrush" Color="#FFE2897F" />
            <SolidColorBrush x:Key="NovaTileFamilyToolsBrush" Color="#FF56C2E4" />
            <!-- Famille "identity" (2026-08-12, retour utilisateur : "Lumora et
                 profil" reste dégradé neutre terne à côté des 3 familles vives
                 ci-dessus) - violet dédié, distinct des 3 teintes existantes. -->
            <SolidColorBrush x:Key="NovaTileFamilyIdentityBrush" Color="#FF9E8CD6" />
            <conv:StartMenuFamilyKeyToBrushConverter x:Key="StartMenuFamilyKeyToBrushConverter" />
            <!-- Ecran de connexion / gestion des utilisateurs (session
                 "Ecran de connexion", 2026-08-10) : avatars par profil dans le
                 selecteur de profil. -->
            <conv:AvatarPathToBrushConverter x:Key="AvatarPathToBrushConverter" />
            <conv:AvatarPathToPlaceholderVisibilityConverter x:Key="AvatarPathToPlaceholderVisibilityConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <Color x:Key="SystemAccentColorLight1">#FFFFCA66</Color>
            <Color x:Key="SystemAccentColorLight2">#FFFFDEA0</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFFF1CC</Color>
            <Color x:Key="SystemAccentColorDark1">#FFE49B17</Color>
            <Color x:Key="SystemAccentColorDark2">#FFB8750B</Color>
            <Color x:Key="SystemAccentColorDark3">#FF7E4E08</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFFB935" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#DDFFB935" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B8FFB935" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#55FFB935" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF0D1822" />
            <SolidColorBrush x:Key="NovaFocusVisualPrimaryBrush" Color="#FFFFE668" />
            <SolidColorBrush x:Key="NovaFocusVisualSecondaryBrush" Color="#FF0D1822" />
            <SolidColorBrush x:Key="NovaControlForegroundBrush" Color="#FFFFF8EA" />
            <SolidColorBrush x:Key="NovaControlMutedForegroundBrush" Color="#FFC3B9A5" />
            <SolidColorBrush x:Key="NovaControlSurfaceBrush" Color="#FF1A2231" />
            <SolidColorBrush x:Key="NovaControlSurfaceRaisedBrush" Color="#FF222A3A" />
            <SolidColorBrush x:Key="NovaControlStrokeBrush" Color="#FF40495B" />
            <SolidColorBrush x:Key="NovaSuccessBrush" Color="#FF3DD688" />
            <SolidColorBrush x:Key="NovaSuccessSurfaceBrush" Color="#FF1F3C39" />
            <SolidColorBrush x:Key="NovaWarningBrush" Color="#FFFFB935" />
            <SolidColorBrush x:Key="NovaWarningSurfaceBrush" Color="#FF3B3121" />
            <SolidColorBrush x:Key="NovaDangerBrush" Color="#FFE5484D" />
            <SolidColorBrush x:Key="NovaDangerSurfaceBrush" Color="#FF412428" />
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource NovaControlSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaControlStrokeBrush}" />
                <Setter Property="Foreground" Value="{StaticResource NovaControlForegroundBrush}" />
                <Setter Property="PlaceholderForeground" Value="{StaticResource NovaControlMutedForegroundBrush}" />
                <Setter Property="SelectionHighlightColor" Value="{StaticResource AccentFillColorSecondaryBrush}" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource NovaFocusVisualPrimaryBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource NovaFocusVisualSecondaryBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{StaticResource NovaControlSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaControlStrokeBrush}" />
                <Setter Property="Foreground" Value="{StaticResource NovaControlForegroundBrush}" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource NovaFocusVisualPrimaryBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource NovaFocusVisualSecondaryBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource NovaControlSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaControlStrokeBrush}" />
                <Setter Property="Foreground" Value="{StaticResource NovaControlForegroundBrush}" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource NovaFocusVisualPrimaryBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource NovaFocusVisualSecondaryBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style TargetType="ToggleSwitch">
                <Setter Property="Foreground" Value="{StaticResource NovaControlForegroundBrush}" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource NovaFocusVisualPrimaryBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource NovaFocusVisualSecondaryBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <!-- RadioButton/CheckBox n'avaient aucun style applicatif par
                 defaut : ils gardaient le focus visuel systeme, incoherent
                 avec le jaune vif NovaFocusVisualPrimaryBrush utilise partout
                 ailleurs dans la chrome (audit accessibilite basse vision,
                 palier 0.93.x). Pas de changement de couleur/taille propre au
                 controle, seulement le focus. -->
            <Style TargetType="RadioButton">
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource NovaFocusVisualPrimaryBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource NovaFocusVisualSecondaryBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource NovaFocusVisualPrimaryBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource NovaFocusVisualSecondaryBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style TargetType="InfoBar">
                <Setter Property="Background" Value="{StaticResource NovaControlSurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaControlStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource NovaControlForegroundBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
