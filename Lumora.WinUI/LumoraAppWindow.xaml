<Window
    x:Class="Lumora.WinUI.LumoraAppWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="using:Microsoft.Web.WebView2.Core"
    mc:Ignorable="d"
    Title="Lumora">

    <!--
        Fenêtre d'application web Lumora : volontairement minimale (pas d'onglets, pas
        de barre d'adresse), comme le mode « application » de Chrome/Edge. Le site
        occupe tout l'espace ; seule une barre discrète apparaît quand la navigation
        sort du domaine de l'application (confinement doux, jamais de blocage dur pour
        ne pas casser les redirections de connexion type Google/Microsoft).
    -->
    <Grid x:Name="RootGrid" Background="#FF1F211F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ExternalDomainBar" Grid.Row="0" Visibility="Collapsed"
                Background="#FF2C2D28" BorderThickness="0,2,0,1" BorderBrush="#FF575648"
                AutomationProperties.Name="Navigation hors domaine de l'application"
                Padding="12,6">
            <Border.Resources>
                <LinearGradientBrush x:Key="LumoraAppWindowIdentityBrush" StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FFE17818" Offset="0" />
                    <GradientStop Color="#FF66D1BE" Offset="1" />
                </LinearGradientBrush>
            </Border.Resources>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="6" Height="22" CornerRadius="3"
                        Background="{StaticResource LumoraAppWindowIdentityBrush}"
                        VerticalAlignment="Center" />
                <FontIcon Grid.Column="1" Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                          Foreground="#FFF5F1EA" VerticalAlignment="Center" />
                <TextBlock x:Name="ExternalDomainText" Grid.Column="2" Foreground="#FFF5F1EA"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="ExternalDomainReturnButton" Grid.Column="3"
                        Content="Retour à l'application" Click="ExternalDomainReturnButton_Click"
                        FocusVisualPrimaryBrush="{StaticResource NovaFocusVisualPrimaryBrush}"
                        FocusVisualSecondaryBrush="{StaticResource NovaFocusVisualSecondaryBrush}"
                        AutomationProperties.Name="Retour à l'application"
                        Padding="10,2" FontSize="12" />
            </Grid>
        </Border>

        <Grid x:Name="AppWebViewHost" Grid.Row="1" />
    </Grid>
</Window>
