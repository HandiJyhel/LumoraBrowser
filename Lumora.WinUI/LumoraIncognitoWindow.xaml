<Window
    x:Class="Lumora.WinUI.LumoraIncognitoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Incognito - Lumora">

    <!--
        Fenetre Incognito : fusionne l'ancienne navigation privee et l'ancienne
        navigation anonyme (Tor) en un seul mode, pour eviter la confusion entre
        deux entrees qui se marchaient dessus. Deux promesses toujours tenues
        separement, jamais fusionnees en un seul message :
        - session ephemere (IsInPrivateModeEnabled, profil en memoire) :
          TOUJOURS active, que Tor soit active ou non ;
        - IP masquee via Tor : desactivee par defaut (latence du reseau Tor non
          imposee a tout le monde), activable via la bascule ci-dessous, avec un
          etat toujours visible pour qu'il n'y ait jamais de doute sur ce qui est
          reellement actif.
        Volontairement minimale : pas de hub Modules, pas de compagnon, pas de
        raccourcis de confort. Onglets simples (pas de groupes, pas d'epingles,
        pas d'historique d'onglets fermes) : une page cible (target=_blank)
        ouvre un nouvel onglet dans la MEME fenetre/process, pas une nouvelle
        fenetre Incognito - tous les onglets d'une fenetre partagent deja le
        meme etat Tor/session, donc pas de risque de fuite entre onglets. Les
        protections reseau de fond (bloqueur pubs/trackers, anti-telemetrie,
        HTTPS, CNAME) restent actives sans bouton dedie, comme dans les
        anciennes fenetres.
    -->
    <Grid x:Name="RootGrid" Background="#FF1A1626">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="10,8" ColumnSpacing="8" Background="#FF241C33">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0" Glyph="&#xE727;" FontFamily="Segoe MDL2 Assets"
                      FontSize="16" Foreground="#FFB9A7E8" VerticalAlignment="Center"
                      Margin="2,0,4,0" />

            <Button x:Name="IncognitoBackButton" Grid.Column="1" Padding="8,5"
                    Click="IncognitoBackButton_Click" IsEnabled="False"
                    AutomationProperties.Name="Page precedente"
                    ToolTipService.ToolTip="Page precedente">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
            </Button>
            <Button x:Name="IncognitoForwardButton" Grid.Column="2" Padding="8,5"
                    Click="IncognitoForwardButton_Click" IsEnabled="False"
                    AutomationProperties.Name="Page suivante"
                    ToolTipService.ToolTip="Page suivante">
                <FontIcon Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
            </Button>
            <Button x:Name="IncognitoReloadButton" Grid.Column="3" Padding="8,5"
                    Click="IncognitoReloadButton_Click"
                    AutomationProperties.Name="Recharger la page"
                    ToolTipService.ToolTip="Recharger la page">
                <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
            </Button>

            <TextBox x:Name="IncognitoAddressBox" Grid.Column="4"
                     PlaceholderText="Rechercher ou saisir une URL (Incognito)"
                     KeyDown="IncognitoAddressBox_KeyDown"
                     AutomationProperties.Name="Barre d'adresse Incognito"
                     VerticalAlignment="Center" />

            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock x:Name="IncognitoTorStatusText" Text="IP masquee : non" Foreground="#FFB9A7E8"
                           FontSize="12" VerticalAlignment="Center" />
                <ToggleSwitch x:Name="IncognitoTorSwitch" OnContent="Tor" OffContent="Tor"
                              Toggled="IncognitoTorSwitch_Toggled"
                              AutomationProperties.Name="Masquer l'adresse IP via Tor" />
                <Button x:Name="IncognitoNewCircuitButton" Padding="8,5" Visibility="Collapsed"
                        Content="Nouveau circuit" Click="IncognitoNewCircuitButton_Click"
                        AutomationProperties.Name="Demander un nouveau circuit Tor"
                        ToolTipService.ToolTip="Change de noeud de sortie Tor pour cette fenetre (utile si un captcha boucle sans jamais accepter la reponse)" />
                <Button x:Name="IncognitoTorInstallButton" Padding="8,5" Visibility="Collapsed"
                        Content="Installer le moteur Tor" Click="IncognitoTorInstallButton_Click"
                        AutomationProperties.Name="Installer le moteur Tor" />
            </StackPanel>

            <TextBlock Grid.Column="6" Text="Incognito" Foreground="#FFB9A7E8"
                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       Margin="4,0,2,0" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                IncognitoTabs ne porte que la bande d'onglets (TabViewItem.Content
                n'est jamais utilise) : WebView2 place directement en contenu d'un
                TabViewItem ne s'affiche pas de facon fiable (verifie en conditions
                reelles - fond vide malgre une navigation reussie). Meme mecanisme
                que MainWindow (BrowserTabs pour la bande, BrowserHost pour la
                surface reelle) : un host partage, TOUJOURS dans l'arbre visuel,
                contient tous les WebView2 des onglets, seule leur Visibility
                bascule selon l'onglet actif.
            -->
            <TabView x:Name="IncognitoTabs" Grid.Row="0"
                     Background="#FF1A1626"
                     TabWidthMode="Equal"
                     CanReorderTabs="True"
                     AddTabButtonClick="IncognitoTabs_AddTabButtonClick"
                     SelectionChanged="IncognitoTabs_SelectionChanged"
                     TabCloseRequested="IncognitoTabs_TabCloseRequested"
                     AutomationProperties.Name="Onglets Incognito" />

            <Grid x:Name="IncognitoWebViewHost" Grid.Row="1" />
            <Grid x:Name="IncognitoErrorHost" Grid.Row="1" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
