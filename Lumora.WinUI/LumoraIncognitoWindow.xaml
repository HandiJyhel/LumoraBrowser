<Window
    x:Class="Lumora.WinUI.LumoraIncognitoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Incognito - Lumora">

    <!--
        Fenetre Incognito : fusionne l'ancienne navigation privee et l'ancienne
        navigation anonyme (Tor) en un seul mode, pour eviter la confusion entre
        deux entrees qui se marchaient dessus. Deux promesses toujours tenues
        separement, jamais fusionnees en un seul message :
        - session ephemere (IsInPrivateModeEnabled, profil en memoire) :
          TOUJOURS active, que Tor soit active ou non ;
        - IP masquee via Tor : desactivee par defaut (latence du reseau Tor non
          imposee a tout le monde), activable via la bascule ci-dessous, avec un
          etat toujours visible pour qu'il n'y ait jamais de doute sur ce qui est
          reellement actif.
        Volontairement minimale : pas de hub Modules, pas de compagnon, pas de
        raccourcis de confort. Onglets simples (pas de groupes, pas d'epingles,
        pas d'historique d'onglets fermes) : une page cible (target=_blank)
        ouvre un nouvel onglet dans la MEME fenetre/process, pas une nouvelle
        fenetre Incognito - tous les onglets d'une fenetre partagent deja le
        meme etat Tor/session, donc pas de risque de fuite entre onglets. Les
        protections reseau de fond (bloqueur pubs/trackers, anti-telemetrie,
        HTTPS, CNAME) restent actives sans bouton dedie, comme dans les
        anciennes fenetres.
    -->
    <Grid x:Name="RootGrid" Background="#FF1A1626">
        <Grid.Resources>
            <SolidColorBrush x:Key="LumoraWindowBackgroundBrush" Color="#FF1A1626" />
            <SolidColorBrush x:Key="LumoraWindowChromeBrush" Color="#FF241C33" />
            <SolidColorBrush x:Key="LumoraWindowAccentBrush" Color="#FFB9A7E8" />
            <SolidColorBrush x:Key="LumoraWindowCalloutBrush" Color="#FF241C33" />
            <SolidColorBrush x:Key="LumoraWindowCalloutStrokeBrush" Color="#FF4D4660" />
            <SolidColorBrush x:Key="LumoraWindowSuccessBrush" Color="#FF3DD688" />
            <SolidColorBrush x:Key="LumoraWindowDangerBrush" Color="#FFE5484D" />
            <SolidColorBrush x:Key="LumoraWindowTabStripBrush" Color="#FF1A1626" />
            <SolidColorBrush x:Key="LumoraWindowTextBrush" Color="#FFF6EFFF" />
            <SolidColorBrush x:Key="LumoraWindowMutedTextBrush" Color="#FFC1B6D9" />
            <SolidColorBrush x:Key="LumoraWindowButtonShadowBrush" Color="#5A000000" />
            <SolidColorBrush x:Key="LumoraWindowButtonHighlightBrush" Color="#1AFFFFFF" />
            <LinearGradientBrush x:Key="LumoraWindowIdentityBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFB9A7E8" Offset="0" />
                <GradientStop Color="#FF7BE4DB" Offset="1" />
            </LinearGradientBrush>

            <!--
                Ajoutes le 2026-08-03 ("garder le cote minimaliste/agence secrete,
                mais plus soigne") : profondeur discrete de la barre d'outils
                (dégradé au lieu d'un aplat) et teinte de selection d'onglet -
                aucune animation, ce chrome reste visible en continu pendant des
                heures d'usage reel, contrairement a la page d'accueil.
            -->
            <LinearGradientBrush x:Key="LumoraToolbarGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF2A2140" Offset="0" />
                <GradientStop Color="#FF241C33" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="LumoraTabSelectedBrush" Color="#33B9A7E8" />
            <SolidColorBrush x:Key="LumoraTabPointerOverBrush" Color="#1AB9A7E8" />

            <!--
                Copie locale de NovaRaisedIconButtonTemplate (MainWindow.xaml) :
                MainWindow definit son template "relief" dans ses propres
                Grid.Resources, non partages via App.xaml, donc inaccessible
                depuis cette fenetre. Duplique ici plutot que de refactorer le
                partage de ressources entre fenetres (deja le principe adopte
                pour tout le jeu LumoraWindow*Brush ci-dessus) - meme structure
                ShadowLayer/SurfaceBorder/TopGloss et memes VisualStates, pour
                que les boutons Incognito partagent le meme langage visuel que
                le reste de Lumora tout en gardant l'identite violette.
            -->
            <ControlTemplate x:Key="IncognitoRaisedButtonTemplate" TargetType="Button">
                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Target="ShadowLayer.Opacity" Value="0.92" />
                                    <Setter Target="TopGloss.Opacity" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Target="ShadowLayer.Opacity" Value="0.16" />
                                    <Setter Target="SurfaceBorder.Margin" Value="0,1,0,-1" />
                                    <Setter Target="TopGloss.Opacity" Value="0.28" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="SurfaceBorder.Opacity" Value="0.44" />
                                    <Setter Target="ShadowLayer.Opacity" Value="0.10" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border x:Name="ShadowLayer"
                            Margin="0,3,0,0"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{StaticResource LumoraWindowButtonShadowBrush}"
                            Opacity="0.85" />
                    <Border x:Name="SurfaceBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Border x:Name="TopGloss"
                                    Height="10"
                                    Margin="1,1,1,0"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource LumoraWindowButtonHighlightBrush}"
                                    Opacity="0.92" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>
                </Grid>
            </ControlTemplate>

            <Style x:Key="IncognitoToolbarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource NovaControlSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource NovaControlStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource NovaControlForegroundBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource NovaFocusVisualPrimaryBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource NovaFocusVisualSecondaryBrush}" />
                <Setter Property="Template" Value="{StaticResource IncognitoRaisedButtonTemplate}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="10,8" ColumnSpacing="8" Background="{StaticResource LumoraToolbarGradientBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Marque maison (silhouette de masque a deux yeux) plutot que
                 l'icone Segoe MDL2 generique - meme dessin que le logo SVG de
                 IncognitoWelcomeHtml, pour relier visuellement le chrome et la
                 page d'accueil (2026-08-03). -->
            <Viewbox Grid.Column="0" Width="26" Height="15" VerticalAlignment="Center" Margin="2,0,4,0">
                <Grid Width="48" Height="28">
                    <Path Data="M24 1c-10 0-18.3 5.7-22 13 3.7 7.3 12 13 22 13s18.3-5.7 22-13c-3.7-7.3-12-13-22-13Z"
                          Stroke="{StaticResource LumoraWindowIdentityBrush}" StrokeThickness="2.6" />
                    <Ellipse Canvas.Left="12" Width="6.4" Height="6.4" Fill="{StaticResource LumoraWindowIdentityBrush}"
                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12.3,0,0,0" />
                    <Ellipse Width="6.4" Height="6.4" Fill="{StaticResource LumoraWindowIdentityBrush}"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12.3,0" />
                </Grid>
            </Viewbox>

            <Button x:Name="IncognitoBackButton" Grid.Column="1" Padding="8,5"
                    Style="{StaticResource IncognitoToolbarButtonStyle}"
                    Click="IncognitoBackButton_Click" IsEnabled="False"
                    AutomationProperties.Name="Page précédente"
                    ToolTipService.ToolTip="Page précédente">
                <FontIcon Glyph="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
            </Button>
            <Button x:Name="IncognitoForwardButton" Grid.Column="2" Padding="8,5"
                    Style="{StaticResource IncognitoToolbarButtonStyle}"
                    Click="IncognitoForwardButton_Click" IsEnabled="False"
                    AutomationProperties.Name="Page suivante"
                    ToolTipService.ToolTip="Page suivante">
                <FontIcon Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
            </Button>
            <Button x:Name="IncognitoReloadButton" Grid.Column="3" Padding="8,5"
                    Style="{StaticResource IncognitoToolbarButtonStyle}"
                    Click="IncognitoReloadButton_Click"
                    AutomationProperties.Name="Recharger la page"
                    ToolTipService.ToolTip="Recharger la page">
                <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
            </Button>

            <TextBox x:Name="IncognitoAddressBox" Grid.Column="4"
                     PlaceholderText="Rechercher ou saisir une URL (Incognito)"
                     KeyDown="IncognitoAddressBox_KeyDown"
                     AutomationProperties.Name="Barre d'adresse Incognito"
                     VerticalAlignment="Center"
                     CornerRadius="10"
                     Background="{StaticResource LumoraWindowCalloutBrush}"
                     BorderBrush="{StaticResource LumoraWindowCalloutStrokeBrush}"
                     Foreground="{StaticResource LumoraWindowTextBrush}"
                     PlaceholderForeground="{StaticResource LumoraWindowMutedTextBrush}"
                     FocusVisualPrimaryBrush="{StaticResource LumoraWindowAccentBrush}"
                     FocusVisualSecondaryBrush="{StaticResource LumoraWindowAccentBrush}"
                     SelectionHighlightColor="{StaticResource LumoraWindowAccentBrush}" />

            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Puce arrondie (2026-08-03) : reprend le composant status-pill
                     de IncognitoWelcomeHtml pour que la barre d'outils et la page
                     d'accueil parlent le meme langage visuel. -->
                <Border Background="{StaticResource LumoraWindowCalloutBrush}"
                        BorderBrush="{StaticResource LumoraWindowCalloutStrokeBrush}" BorderThickness="1"
                        CornerRadius="999" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <!-- Pastille rouge/vert : indicateur purement visuel, decoratif pour le lecteur
                             d'ecran (AccessibilityView=Raw) car IncognitoTorStatusText juste a cote
                             annonce deja le meme etat en texte - jamais la couleur seule comme signal. -->
                        <Ellipse x:Name="IncognitoTorIndicatorDot" Width="8" Height="8" Fill="{StaticResource LumoraWindowDangerBrush}"
                                 VerticalAlignment="Center"
                                 AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="IncognitoTorStatusText" Text="IP masquée : non" Foreground="{StaticResource LumoraWindowTextBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ToggleSwitch x:Name="IncognitoTorSwitch" OnContent="Tor" OffContent="Tor"
                              Toggled="IncognitoTorSwitch_Toggled"
                              AutomationProperties.Name="Masquer l'adresse IP via Tor"
                              ToolTipService.ToolTip="Change l'état de Tor : ferme cette fenêtre Incognito et en rouvre une nouvelle dans le nouvel état (les onglets ouverts sont perdus, vous restez en Incognito)" />
                <Button x:Name="IncognitoNewCircuitButton" Padding="8,5" Visibility="Collapsed"
                        Style="{StaticResource IncognitoToolbarButtonStyle}"
                        Content="Nouveau circuit" Click="IncognitoNewCircuitButton_Click"
                        AutomationProperties.Name="Demander un nouveau circuit Tor"
                        ToolTipService.ToolTip="Change de nœud de sortie Tor pour cette fenêtre (utile si un captcha boucle sans jamais accepter la réponse)" />
                <Button x:Name="IncognitoTorInstallButton" Padding="8,5" Visibility="Collapsed"
                        Style="{StaticResource IncognitoToolbarButtonStyle}"
                        Content="Installer le moteur Tor" Click="IncognitoTorInstallButton_Click"
                        AutomationProperties.Name="Installer le moteur Tor" />
            </StackPanel>

            <TextBlock Grid.Column="6" Text="Incognito" Foreground="{StaticResource LumoraWindowAccentBrush}"
                       FontSize="12" FontWeight="SemiBold" CharacterSpacing="30" VerticalAlignment="Center"
                       Margin="4,0,2,0" />

            <!-- Liseré de séparation discret entre la barre d'outils et les
                 onglets (2026-08-03) - remplace l'aplat sans profondeur d'avant. -->
            <Rectangle Grid.Column="0" Grid.ColumnSpan="7" Height="1" VerticalAlignment="Bottom"
                       Margin="-10,0,-10,-8" Fill="{StaticResource LumoraWindowCalloutStrokeBrush}"
                       Opacity="0.6" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                IncognitoTabs ne porte que la bande d'onglets (TabViewItem.Content
                n'est jamais utilise) : WebView2 place directement en contenu d'un
                TabViewItem ne s'affiche pas de facon fiable (verifie en conditions
                reelles - fond vide malgre une navigation reussie). Meme mecanisme
                que MainWindow (BrowserTabs pour la bande, BrowserHost pour la
                surface reelle) : un host partage, TOUJOURS dans l'arbre visuel,
                contient tous les WebView2 des onglets, seule leur Visibility
                bascule selon l'onglet actif.
            -->
            <TabView x:Name="IncognitoTabs" Grid.Row="0"
                     Background="{StaticResource LumoraWindowTabStripBrush}"
                     Foreground="{StaticResource LumoraWindowTextBrush}"
                     TabWidthMode="Equal"
                     CanReorderTabs="True"
                     AddTabButtonClick="IncognitoTabs_AddTabButtonClick"
                     SelectionChanged="IncognitoTabs_SelectionChanged"
                     TabCloseRequested="IncognitoTabs_TabCloseRequested"
                     AutomationProperties.Name="Onglets Incognito">
                <!-- Teinte violette de selection au lieu de l'accent systeme par
                     defaut (2026-08-03) - "un vrai signal" sur l'onglet actif,
                     coherent avec l'identite de la fenetre plutot qu'une couleur
                     Windows generique. Cles de ressource Fluent documentees pour
                     TabViewItem. -->
                <TabView.Resources>
                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LumoraTabSelectedBrush" />
                    <StaticResource x:Key="TabViewItemHeaderBackgroundPointerOver" ResourceKey="LumoraTabPointerOverBrush" />
                    <StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="LumoraWindowTextBrush" />
                </TabView.Resources>
            </TabView>

            <Grid x:Name="IncognitoWebViewHost" Grid.Row="1" />
            <Grid x:Name="IncognitoErrorHost" Grid.Row="1" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
