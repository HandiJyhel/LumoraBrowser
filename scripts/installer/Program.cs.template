namespace Lumora.Setup;

internal sealed record InstallerOptions(
    string InstallRoot,
    bool CleanInstalledProfile,
    bool CreateDesktopShortcut,
    bool CreateStartMenuShortcut,
    bool InstallTorEngine);

internal static class Program
{
    [STAThread]
    private static void Main()
    {
        Application.EnableVisualStyles();
        Application.SetCompatibleTextRenderingDefault(false);
        Application.SetDefaultFont(LumoraTypography.Text(10f));
        Application.Run(new InstallerForm());
    }
}

// Assistant en 3 pages (Bienvenue / Dossier+options / Terminé), 2026-08-19 -
// maquette validee par l'utilisateur : structure d'assistant Windows
// classique (bandeau lateral, etapes numerotees, Precedent/Suivant/Annuler,
// page de fin dediee) mais dans les tons reels du navigateur (LumoraPalette
// ci-dessous alignee sur les brushes NovaAppBackgroundBrush/NovaAccentBrush/
// NovaCoolAccentBrush de MainWindow.xaml) et le style de bouton "Doux
// moderne" deja utilise partout ailleurs dans l'app. Une seule Form, les 3
// pages sont des Panel dont la Visibility bascule (pas de fenetres
// separees) - logique d'installation strictement identique a l'ancienne
// version a un seul ecran, seule la presentation change.
internal sealed class InstallerForm : Form
{
    private const int FormWidth = 680;
    private const int FormHeight = 580;
    private const int TitleBarHeight = 40;
    private const int SidebarWidth = 168;
    private const int FooterHeight = 64;
    private const int WmNclButtonDown = 0xA1;
    private const int HtCaption = 0x2;

    private readonly Label _statusLabel = new();
    private readonly LumoraProgressBar _progressBar = new();
    private readonly TextBox _installPathTextBox = new();
    private readonly Button _backButton = new();
    private readonly Button _primaryButton = new();
    private readonly Button _cancelButton = new();
    private readonly Button _browseButton = new();
    private readonly LumoraOptionCheckBox _cleanProfileCheckBox = new();
    private readonly LumoraOptionCheckBox _desktopShortcutCheckBox = new();
    private readonly LumoraOptionCheckBox _startMenuShortcutCheckBox = new();
    private readonly LumoraOptionCheckBox _torCheckBox = new();
    // Mise a jour detectee (app ou profil deja presents) : adapte le titre et
    // la valeur par defaut de "_cleanProfileCheckBox" - voir le constructeur.
    private bool _isUpdate;
    // Case "Lancer maintenant" deplacee sur la page Terminee (2026-08-19) :
    // decider de lancer l'app APRES l'installation, pas avant, evite la
    // redondance de deux cases "lancer" a des moments differents.
    private readonly LumoraOptionCheckBox _launchNowCheckBox = new();

    private readonly Panel[] _pages = new Panel[3];
    private readonly Label[] _stepNumberLabels = new Label[3];
    private readonly Label[] _stepTextLabels = new Label[3];
    private int _currentPage;

    private string? _installedAppExe;
    private string? _torInstallWarning;
    private readonly Label _finishMessageLabel = new();

    [DllImport("user32.dll")]
    private static extern bool ReleaseCapture();

    [DllImport("user32.dll")]
    private static extern IntPtr SendMessage(IntPtr hWnd, int msg, int wParam, int lParam);

    // Notifie l'Explorateur qu'une association de type de fichier a change
    // (icone .lum ci-dessous) : sans cet appel, l'icone ne se met a jour
    // qu'apres une deconnexion/redemarrage - constat courant sous Windows
    // pour toute modification de HKCU\Software\Classes.
    [DllImport("shell32.dll")]
    private static extern void SHChangeNotify(int wEventId, int uFlags, IntPtr dwItem1, IntPtr dwItem2);
    private const int ShcneAssocChanged = 0x08000000;
    private const int ShcnfIdList = 0x0000;

    public InstallerForm()
    {
        StartPosition = FormStartPosition.CenterScreen;
        FormBorderStyle = FormBorderStyle.None;
        MaximizeBox = false;
        MinimizeBox = false;
        ClientSize = new Size(FormWidth, FormHeight);
        AutoScaleMode = AutoScaleMode.None;
        BackColor = LumoraPalette.AppBackground;
        ForeColor = LumoraPalette.Foreground;
        Font = LumoraTypography.Text(10f);

        var localAppDataForDetection = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
        var defaultInstallRoot = Path.Combine(localAppDataForDetection, "Programs", "Lumora");

        // Detection "mise a jour" (2026-08-30, retour utilisateur) : une
        // installation existante (l'app deja copiee) OU un profil local deja
        // present suffit - soit signale la meme chose (Lumora deja utilise ici),
        // et il ne faut jamais se fier a un seul des deux (l'app peut avoir ete
        // desinstallee sans -RemoveProfile, ou l'inverse). Purement pour adapter
        // le texte/les valeurs par defaut de l'ecran suivant - ne change aucun
        // comportement d'installation en lui-meme.
        var existingAppDetected = File.Exists(Path.Combine(defaultInstallRoot, "app", "Lumora.WinUI.exe"));
        var existingProfileDetected = Directory.Exists(Path.Combine(localAppDataForDetection, "Lumora", "profiles"))
            && Directory.EnumerateFileSystemEntries(Path.Combine(localAppDataForDetection, "Lumora", "profiles")).Any();
        _isUpdate = existingAppDetected || existingProfileDetected;

        var windowTitle = _isUpdate ? "Mise à jour de Lumora Browser" : "Installation de Lumora Browser";
        Text = windowTitle;

        BuildTitleBar(windowTitle);
        var sidebar = BuildSidebar();
        Controls.Add(sidebar);

        _pages[0] = BuildWelcomePage();
        _pages[1] = BuildOptionsPage(defaultInstallRoot);
        _pages[2] = BuildFinishPage();
        foreach (var page in _pages)
        {
            page.Location = new Point(SidebarWidth, TitleBarHeight);
            page.Size = new Size(FormWidth - SidebarWidth, FormHeight - TitleBarHeight - FooterHeight);
            page.BackColor = LumoraPalette.ContentBackground;
            Controls.Add(page);
        }

        BuildFooter();
        GoToPage(0);
    }

    private void BuildTitleBar(string windowTitle)
    {
        var titleBar = new Panel
        {
            Location = new Point(0, 0),
            Size = new Size(FormWidth, TitleBarHeight),
            BackColor = LumoraPalette.ChromeSurface
        };
        titleBar.MouseDown += (_, e) => DragWindow(e);

        var titleText = new Label
        {
            Text = windowTitle,
            AutoSize = false,
            Location = new Point(16, 11),
            Size = new Size(420, 20),
            ForeColor = LumoraPalette.MutedForeground,
            BackColor = LumoraPalette.ChromeSurface,
            Font = LumoraTypography.Text(9f)
        };
        titleText.MouseDown += (_, e) => DragWindow(e);

        // Points systeme groupes "a la Apple" (meme convention que le chrome
        // de la fenetre principale, WindowCaptionDotButtonStyle) plutot que
        // les boutons de legende Windows classiques - coherent avec le reste
        // de l'app, zone cliquable large (40x40) meme si le point visuel est petit.
        var minimizeDot = CreateCaptionDotButton(hoverColor: LumoraPalette.Accent);
        minimizeDot.Location = new Point(FormWidth - 120, 0);
        minimizeDot.Click += (_, _) => WindowState = FormWindowState.Minimized;

        var maximizeDot = CreateCaptionDotButton(hoverColor: LumoraPalette.Accent);
        maximizeDot.Location = new Point(FormWidth - 80, 0);
        maximizeDot.Enabled = false; // fenetre a taille fixe, pas de maximisation

        var closeDot = CreateCaptionDotButton(hoverColor: LumoraPalette.Danger);
        closeDot.Location = new Point(FormWidth - 40, 0);
        closeDot.Click += (_, _) => Close();

        titleBar.Controls.Add(titleText);
        titleBar.Controls.Add(minimizeDot);
        titleBar.Controls.Add(maximizeDot);
        titleBar.Controls.Add(closeDot);
        Controls.Add(titleBar);
    }

    private static Button CreateCaptionDotButton(Color hoverColor)
    {
        var button = new Button
        {
            Size = new Size(40, TitleBarHeight),
            FlatStyle = FlatStyle.Flat,
            BackColor = LumoraPalette.ChromeSurface,
            Text = "●", // point plein, dessine petit via la police
            Font = new Font("Segoe UI", 7f),
            ForeColor = LumoraPalette.MutedForeground,
            TextAlign = ContentAlignment.MiddleCenter
        };
        button.FlatAppearance.BorderSize = 0;
        button.FlatAppearance.MouseOverBackColor = LumoraPalette.ChromeSurface;
        button.MouseEnter += (_, _) => button.ForeColor = hoverColor;
        button.MouseLeave += (_, _) => button.ForeColor = LumoraPalette.MutedForeground;
        return button;
    }

    // Bandeau lateral (168px, pleine hauteur sous la barre de titre) : logo
    // dans son halo circulaire (meme motif que l'ecran de bienvenue de
    // l'app, MainWindow.xaml WelcomeStep0), nom du produit, et repere
    // d'etapes 1-2-3 pour savoir ou on en est sans avoir a compter les
    // clics sur "Suivant".
    private Panel BuildSidebar()
    {
        var sidebar = new RadialGlowPanel
        {
            Location = new Point(0, TitleBarHeight),
            Size = new Size(SidebarWidth, FormHeight - TitleBarHeight),
            BackColor = LumoraPalette.SidebarBackground
        };

        var logo = new LogoImageControl
        {
            Image = LoadInstallerLogo(),
            Location = new Point((SidebarWidth - 60) / 2, 28),
            Size = new Size(60, 60),
            BackColor = Color.Transparent
        };
        sidebar.Controls.Add(logo);

        var productLabel = new Label
        {
            Text = "Lumora Browser",
            AutoSize = false,
            TextAlign = ContentAlignment.MiddleCenter,
            Location = new Point(8, 96),
            Size = new Size(SidebarWidth - 16, 24),
            ForeColor = LumoraPalette.Foreground,
            BackColor = Color.Transparent,
            Font = LumoraTypography.Text(11.5f, FontStyle.Bold)
        };
        sidebar.Controls.Add(productLabel);

        var versionLabel = new Label
        {
            Text = "Version __PRODUCT_VERSION__",
            AutoSize = false,
            TextAlign = ContentAlignment.MiddleCenter,
            Location = new Point(8, 120),
            Size = new Size(SidebarWidth - 16, 18),
            ForeColor = LumoraPalette.SidebarMutedForeground,
            BackColor = Color.Transparent,
            Font = LumoraTypography.Text(8f)
        };
        sidebar.Controls.Add(versionLabel);

        var stepNames = new[] { "Bienvenue", "Dossier et options", "Installation" };
        var stepY = 154;
        for (var i = 0; i < stepNames.Length; i++)
        {
            var row = new Panel
            {
                Location = new Point(12, stepY),
                Size = new Size(SidebarWidth - 24, 26),
                BackColor = Color.Transparent
            };

            var number = new Label
            {
                Text = (i + 1).ToString(),
                AutoSize = false,
                TextAlign = ContentAlignment.MiddleCenter,
                Location = new Point(0, 2),
                Size = new Size(20, 20),
                Font = LumoraTypography.Text(8.5f, FontStyle.Bold),
                BackColor = Color.Transparent
            };
            var text = new Label
            {
                Text = stepNames[i],
                AutoSize = false,
                Location = new Point(26, 4),
                Size = new Size(SidebarWidth - 24 - 26, 18),
                Font = LumoraTypography.Text(8.75f),
                BackColor = Color.Transparent
            };

            row.Controls.Add(number);
            row.Controls.Add(text);
            sidebar.Controls.Add(row);
            _stepNumberLabels[i] = number;
            _stepTextLabels[i] = text;
            stepY += 30;
        }

        return sidebar;
    }

    private void UpdateStepHighlight(int activeIndex)
    {
        for (var i = 0; i < _stepNumberLabels.Length; i++)
        {
            var isActive = i == activeIndex;
            var color = isActive ? LumoraPalette.Accent : LumoraPalette.SidebarMutedForeground;
            _stepNumberLabels[i].ForeColor = color;
            _stepTextLabels[i].ForeColor = color;
            _stepTextLabels[i].Font = LumoraTypography.Text(8.75f, isActive ? FontStyle.Bold : FontStyle.Regular);
        }
    }

