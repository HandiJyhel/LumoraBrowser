internal static class LumoraTypography
{
    private const string FontFamilyName = "Segoe UI";

    public static Font Display(float size, FontStyle style = FontStyle.Regular) =>
        new(FontFamilyName, size, style, GraphicsUnit.Point);

    public static Font Text(float size, FontStyle style = FontStyle.Regular) =>
        new(FontFamilyName, size, style, GraphicsUnit.Point);
}

internal class RoundedPanel : Panel
{
    public int Radius { get; set; } = 12;
    public Color BorderColor { get; set; } = LumoraPalette.Stroke;

    public RoundedPanel()
    {
        SetStyle(ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer | ControlStyles.ResizeRedraw | ControlStyles.UserPaint, true);
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
        using var path = CreateRoundRect(new RectangleF(0.5f, 0.5f, Width - 1f, Height - 1f), Radius);
        using var fill = new SolidBrush(BackColor);
        using var border = new Pen(BorderColor, 1f);
        e.Graphics.FillPath(fill, path);
        e.Graphics.DrawPath(border, path);
    }

    public static GraphicsPath CreateRoundRect(RectangleF bounds, float radius)
    {
        var diameter = radius * 2f;
        var path = new GraphicsPath();
        path.AddArc(bounds.Left, bounds.Top, diameter, diameter, 180, 90);
        path.AddArc(bounds.Right - diameter, bounds.Top, diameter, diameter, 270, 90);
        path.AddArc(bounds.Right - diameter, bounds.Bottom - diameter, diameter, diameter, 0, 90);
        path.AddArc(bounds.Left, bounds.Bottom - diameter, diameter, diameter, 90, 90);
        path.CloseFigure();
        return path;
    }
}

// Bandeau lateral : deux lueurs douces (doree en haut-gauche, bleue en
// bas-droite) derriere le logo, meme esprit que WelcomeBlobWarm/
// WelcomeBlobCool dans l'ecran de bienvenue de l'app (MainWindow.xaml).
internal sealed class RadialGlowPanel : Panel
{
    public RadialGlowPanel()
    {
        SetStyle(ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer | ControlStyles.ResizeRedraw | ControlStyles.UserPaint, true);
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
        using var fill = new SolidBrush(BackColor);
        e.Graphics.FillRectangle(fill, ClientRectangle);

        using var warmGlow = new GraphicsPath();
        warmGlow.AddEllipse(-60, -60, 220, 220);
        using var warmBrush = new PathGradientBrush(warmGlow)
        {
            CenterColor = Color.FromArgb(36, LumoraPalette.Accent.R, LumoraPalette.Accent.G, LumoraPalette.Accent.B),
            SurroundColors = new[] { Color.Transparent }
        };
        e.Graphics.FillPath(warmBrush, warmGlow);

        using var coolGlow = new GraphicsPath();
        coolGlow.AddEllipse(Width - 140, Height - 200, 200, 200);
        using var coolBrush = new PathGradientBrush(coolGlow)
        {
            CenterColor = Color.FromArgb(30, LumoraPalette.CoolAccent.R, LumoraPalette.CoolAccent.G, LumoraPalette.CoolAccent.B),
            SurroundColors = new[] { Color.Transparent }
        };
        e.Graphics.FillPath(coolBrush, coolGlow);

        using var edge = new Pen(LumoraPalette.StrokeSoft, 1f);
        e.Graphics.DrawLine(edge, Width - 1, 0, Width - 1, Height);
    }
}

internal sealed class LogoImageControl : Control
{
    public Image? Image { get; set; }

    public LogoImageControl()
    {
        SetStyle(ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer | ControlStyles.ResizeRedraw | ControlStyles.UserPaint | ControlStyles.SupportsTransparentBackColor, true);
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        base.OnPaint(e);
        e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
        e.Graphics.InterpolationMode = InterpolationMode.HighQualityBicubic;
        e.Graphics.CompositingQuality = CompositingQuality.HighQuality;
        e.Graphics.PixelOffsetMode = PixelOffsetMode.HighQuality;

        var plateBounds = new RectangleF(2.5f, 2.5f, Width - 5f, Height - 5f);
        using var plate = RoundedPanel.CreateRoundRect(plateBounds, 18f);
        using var plateFill = new SolidBrush(Color.FromArgb(38, LumoraPalette.Accent.R, LumoraPalette.Accent.G, LumoraPalette.Accent.B));
        using var plateBorder = new Pen(Color.FromArgb(110, LumoraPalette.CoolAccent.R, LumoraPalette.CoolAccent.G, LumoraPalette.CoolAccent.B), 1.2f);
        e.Graphics.FillPath(plateFill, plate);
        e.Graphics.DrawPath(plateBorder, plate);

        if (Image is null)
        {
            return;
        }

        var imageBounds = FitImage(Image.Size, RectangleF.Inflate(plateBounds, -9f, -9f));
        e.Graphics.DrawImage(Image, imageBounds);
    }

    private static RectangleF FitImage(Size sourceSize, RectangleF target)
    {
        if (sourceSize.Width <= 0 || sourceSize.Height <= 0)
        {
            return target;
        }

        var scale = Math.Min(target.Width / sourceSize.Width, target.Height / sourceSize.Height);
        var width = sourceSize.Width * scale;
        var height = sourceSize.Height * scale;
        return new RectangleF(
            target.Left + (target.Width - width) / 2f,
            target.Top + (target.Height - height) / 2f,
            width,
            height);
    }
}

// Icone circulaire de la page "Termine" : degrade doux+bleu, cheque
// dessine a la main (memes proportions que la case a cocher cochee de
// LumoraOptionCheckBox, pour rester coherent visuellement).
internal sealed class FinishIconControl : Control
{
    public FinishIconControl()
    {
        // SupportsTransparentBackColor indispensable ici (bug reel trouve en
        // verification le 2026-08-19) : sans lui, `BackColor = Color.Transparent`
        // dans BuildFinishPage() levait une ArgumentException a la construction
        // de la Form ("Le controle ne prend pas en charge les couleurs
        // d'arriere-plan transparentes"), faisant planter l'installateur des
        // le lancement, avant meme d'afficher la 1re page.
        SetStyle(ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer | ControlStyles.ResizeRedraw | ControlStyles.UserPaint | ControlStyles.SupportsTransparentBackColor, true);
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
        var bounds = new RectangleF(0.5f, 0.5f, Width - 1f, Height - 1f);
        using var circle = new GraphicsPath();
        circle.AddEllipse(bounds);

        using var fill = new LinearGradientBrush(bounds,
            Color.FromArgb(46, LumoraPalette.CoolAccent.R, LumoraPalette.CoolAccent.G, LumoraPalette.CoolAccent.B),
            Color.FromArgb(46, LumoraPalette.Accent.R, LumoraPalette.Accent.G, LumoraPalette.Accent.B),
            LinearGradientMode.ForwardDiagonal);
        using var border = new Pen(LumoraPalette.Stroke, 1f);
        e.Graphics.FillPath(fill, circle);
        e.Graphics.DrawPath(border, circle);

        using var checkPen = new Pen(LumoraPalette.CoolAccent, 2.6f)
        {
            StartCap = LineCap.Round,
            EndCap = LineCap.Round,
            LineJoin = LineJoin.Round
        };
        var left = bounds.Left + bounds.Width * 0.26f;
        var middle = bounds.Left + bounds.Width * 0.42f;
        var right = bounds.Right - bounds.Width * 0.22f;
        var low = bounds.Top + bounds.Height * 0.56f;
        var high = bounds.Top + bounds.Height * 0.32f;
        e.Graphics.DrawLines(checkPen, new[]
        {
            new PointF(left, low - 2f),
            new PointF(middle, low + 6f),
            new PointF(right, high)
        });
    }
}

internal sealed class LumoraOptionCheckBox : Control
{
    private bool _isHovering;
    private bool _checked;

    public bool Checked
    {
        get => _checked;
        set
        {
            if (_checked == value)
            {
                return;
            }

            _checked = value;
            Invalidate();
        }
    }

    public LumoraOptionCheckBox()
    {
        SetStyle(
            ControlStyles.AllPaintingInWmPaint |
            ControlStyles.OptimizedDoubleBuffer |
            ControlStyles.ResizeRedraw |
            ControlStyles.UserPaint |
            ControlStyles.Selectable,
            true);

        BackColor = LumoraPalette.ContentBackground;
        Padding = Padding.Empty;
        TabStop = true;
        AccessibleRole = AccessibleRole.CheckButton;
    }

    protected override void OnClick(EventArgs e)
    {
        base.OnClick(e);
        Checked = !Checked;
    }

    protected override bool IsInputKey(Keys keyData)
    {
        return keyData is Keys.Space or Keys.Enter || base.IsInputKey(keyData);
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        base.OnKeyDown(e);
        if (e.KeyCode is Keys.Space or Keys.Enter)
        {
            Checked = !Checked;
            e.Handled = true;
        }
    }

    protected override void OnGotFocus(EventArgs e)
    {
        base.OnGotFocus(e);
        Invalidate();
    }

    protected override void OnLostFocus(EventArgs e)
    {
        base.OnLostFocus(e);
        Invalidate();
    }

    protected override void OnMouseEnter(EventArgs e)
    {
        base.OnMouseEnter(e);
        _isHovering = true;
        Invalidate();
    }

    protected override void OnMouseLeave(EventArgs e)
    {
        base.OnMouseLeave(e);
        _isHovering = false;
        Invalidate();
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
        e.Graphics.PixelOffsetMode = PixelOffsetMode.HighQuality;
        e.Graphics.Clear(BackColor);

        var rowBounds = new RectangleF(0.5f, 0.5f, Width - 1f, Height - 1f);
        if (_isHovering || Focused)
        {
            using var rowPath = RoundedPanel.CreateRoundRect(rowBounds, 8f);
            using var rowFill = new SolidBrush(_isHovering ? LumoraPalette.ButtonBackgroundHover : LumoraPalette.ButtonBackground);
            e.Graphics.FillPath(rowFill, rowPath);
        }

        var boxSize = Math.Min(20f, Height - 8f);
        var boxBounds = new RectangleF(4.5f, (Height - boxSize) / 2f, boxSize, boxSize);
        using var boxPath = RoundedPanel.CreateRoundRect(boxBounds, 5f);

        if (Checked)
        {
            using var checkedFill = new LinearGradientBrush(boxBounds, LumoraPalette.CoolAccent, LumoraPalette.Accent, LinearGradientMode.ForwardDiagonal);
            using var checkedBorder = new Pen(Color.FromArgb(220, 200, 224, 236), 1.4f);
            e.Graphics.FillPath(checkedFill, boxPath);
            e.Graphics.DrawPath(checkedBorder, boxPath);

            using var checkPen = new Pen(Color.FromArgb(20, 15, 10), 2.4f)
            {
                StartCap = LineCap.Round,
                EndCap = LineCap.Round,
                LineJoin = LineJoin.Round
            };
            var left = boxBounds.Left + 5f;
            var middle = boxBounds.Left + 8.6f;
            var right = boxBounds.Right - 4.2f;
            var low = boxBounds.Top + 11.6f;
            var high = boxBounds.Top + 6.6f;
            e.Graphics.DrawLines(checkPen, new[]
            {
                new PointF(left, low - 1f),
                new PointF(middle, low + 3f),
                new PointF(right, high)
            });
        }
        else
        {
            using var emptyFill = new SolidBrush(LumoraPalette.InputBackground);
            using var emptyBorder = new Pen(LumoraPalette.Stroke, 1.4f);
            e.Graphics.FillPath(emptyFill, boxPath);
            e.Graphics.DrawPath(emptyBorder, boxPath);
        }

        var textBounds = new Rectangle(boxSize > 0 ? 32 : 8, 0, Math.Max(0, Width - 34), Height);
        TextRenderer.DrawText(
            e.Graphics,
            Text,
            Font,
            textBounds,
            Enabled ? ForeColor : LumoraPalette.MutedForeground,
            TextFormatFlags.Left | TextFormatFlags.VerticalCenter | TextFormatFlags.WordBreak | TextFormatFlags.NoPrefix);

        if (Focused)
        {
            using var focusPath = RoundedPanel.CreateRoundRect(RectangleF.Inflate(rowBounds, -1.5f, -1.5f), 7f);
            using var focusPen = new Pen(Color.FromArgb(180, LumoraPalette.CoolAccent.R, LumoraPalette.CoolAccent.G, LumoraPalette.CoolAccent.B), 1.2f);
            e.Graphics.DrawPath(focusPen, focusPath);
        }
    }
}

internal sealed class LumoraProgressBar : Control
{
    private int _progress;

    public int Progress
    {
        get => _progress;
        set
        {
            _progress = Math.Max(0, Math.Min(100, value));
            Invalidate();
        }
    }

    public LumoraProgressBar()
    {
        SetStyle(ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer | ControlStyles.ResizeRedraw | ControlStyles.UserPaint, true);
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
        var bounds = new RectangleF(0.5f, 0.5f, Width - 1f, Height - 1f);
        using var background = RoundedPanel.CreateRoundRect(bounds, Height / 2f);
        using var backgroundBrush = new SolidBrush(LumoraPalette.ButtonBackground);
        using var border = new Pen(LumoraPalette.StrokeSoft, 1f);
        e.Graphics.FillPath(backgroundBrush, background);
        e.Graphics.DrawPath(border, background);

        var fillWidth = Math.Max(0f, (Width - 1f) * Progress / 100f);
        if (fillWidth < 2f)
        {
            return;
        }

        using var fillPath = RoundedPanel.CreateRoundRect(new RectangleF(0.5f, 0.5f, fillWidth, Height - 1f), Height / 2f);
        using var fill = new LinearGradientBrush(ClientRectangle, LumoraPalette.Accent, LumoraPalette.CoolAccent, LinearGradientMode.Horizontal);
        e.Graphics.FillPath(fill, fillPath);
    }
}
