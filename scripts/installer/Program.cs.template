    // Precedent/Suivant ne font que basculer la visibilite des Panel (pas de
    // nouvelle Form) : _backButton.Enabled=false sur la 1re page, le libelle
    // et le comportement du bouton principal changent selon la page
    // (Suivant -> Installer -> Terminer).
    private void GoToPage(int index)
    {
        if (index < 0 || index >= _pages.Length) return;

        _currentPage = index;
        for (var i = 0; i < _pages.Length; i++)
        {
            _pages[i].Visible = i == index;
        }
        UpdateStepHighlight(index);

        _backButton.Enabled = index > 0 && index < 2; // pas de retour depuis "Terminé"
        _backButton.Visible = index < 2;
        _cancelButton.Visible = index < 2;

        _primaryButton.Text = index switch
        {
            0 => "Suivant >",
            1 => "Installer >",
            _ => "Terminer"
        };
        _primaryButton.Enabled = true;
    }

    private async void PrimaryButton_Click(object? sender, EventArgs e)
    {
        switch (_currentPage)
        {
            case 0:
                GoToPage(1);
                return;
            case 2:
                if (_launchNowCheckBox.Checked && _installedAppExe is not null)
                {
                    Process.Start(new ProcessStartInfo
                    {
                        FileName = _installedAppExe,
                        WorkingDirectory = Path.GetDirectoryName(_installedAppExe),
                        UseShellExecute = true
                    });
                }
                Close();
                return;
        }

        // _currentPage == 1 : declenche la veritable installation.
        _primaryButton.Enabled = false;
        _backButton.Enabled = false;
        _cancelButton.Enabled = false;
        _progressBar.Visible = true;
        _statusLabel.Visible = true;

        try
        {
            var installRootInput = _installPathTextBox.Text.Trim();
            if (string.IsNullOrWhiteSpace(installRootInput))
            {
                throw new InvalidOperationException("Choisis un dossier d'installation.");
            }

            var options = new InstallerOptions(
                InstallRoot: Path.GetFullPath(installRootInput),
                CleanInstalledProfile: _cleanProfileCheckBox.Checked,
                CreateDesktopShortcut: _desktopShortcutCheckBox.Checked,
                CreateStartMenuShortcut: _startMenuShortcutCheckBox.Checked,
                InstallTorEngine: _torCheckBox.Checked);

            SetStatus("Installation en cours...", 4);
            await Task.Run(() => Install(options));
            SetStatus("Installation terminée.", 100);

            if (_torInstallWarning is not null)
            {
                _finishMessageLabel.Text += "\n\n" + _torInstallWarning;
            }

            GoToPage(2);
        }
        catch (Exception ex)
        {
            _cancelButton.Enabled = true;
            _backButton.Enabled = true;
            _primaryButton.Enabled = true;
            _progressBar.Visible = false;
            _statusLabel.Visible = false;
            MessageBox.Show(this, ex.Message, Text, MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
    }

    private void Install(InstallerOptions options)
    {
        var localAppData = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
        var appData = Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData);
        var desktopDir = Environment.GetFolderPath(Environment.SpecialFolder.DesktopDirectory);
        var installRoot = Path.GetFullPath(options.InstallRoot);
        var appDir = Path.Combine(installRoot, "app");
        var newAppDir = Path.Combine(installRoot, "_new_app");
        // Corrige 2026-08-30 : "installed-profile" n'a jamais ete le vrai dossier
        // de profil de Lumora (voir Models/ProfilePaths.cs, LumoraProfilePaths.
        // ProfilesRoot() -> "%LocalAppData%\Lumora\profiles\<id>") - ce dossier
        // n'existant jamais, "Installation propre" et le -RemoveProfile de
        // l'desinstallateur (WriteUninstaller ci-dessous, meme variable) ne
        // supprimaient jamais rien, silencieusement, depuis toujours. Vise
        // maintenant la vraie racine (tous les profils locaux, coherent avec
        // l'intention "repartir de zero" plutot qu'un seul profil suppose).
        var profileDir = Path.Combine(localAppData, "Lumora", "profiles");
        var startMenuDir = Path.Combine(appData, "Microsoft", "Windows", "Start Menu", "Programs", "Lumora");
        var startMenuShortcut = Path.Combine(startMenuDir, "Lumora.lnk");
        var desktopShortcut = Path.Combine(desktopDir, "Lumora.lnk");
        var launcherVbs = Path.Combine(installRoot, "LumoraLauncher.vbs");
        var traceLauncherCmd = Path.Combine(installRoot, "Lancer avec journal de diagnostic.cmd");
        var uninstallPs1 = Path.Combine(installRoot, "uninstall.ps1");
        var uninstallCmd = Path.Combine(installRoot, "Uninstall Lumora.cmd");
        var installInfo = Path.Combine(installRoot, "INSTALLATION.txt");
        var uninstallKey = @"Software\Microsoft\Windows\CurrentVersion\Uninstall\Lumora";

        if (IsLumoraRunning())
        {
            throw new InvalidOperationException(
                "Lumora Browser est actuellement ouvert. Ferme completement l'application, puis relance l'installateur.");
        }

        SetStatus("Préparation du dossier d'installation...", 18);
        Directory.CreateDirectory(installRoot);
        if (Directory.Exists(newAppDir))
        {
            Directory.Delete(newAppDir, recursive: true);
        }
        Directory.CreateDirectory(newAppDir);

        SetStatus("Extraction de Lumora...", 30);
        using (var payload = Assembly.GetExecutingAssembly().GetManifestResourceStream("app.zip")
            ?? throw new InvalidOperationException("Le contenu Lumora intégré à l'installateur est introuvable."))
        using (var archive = new ZipArchive(payload, ZipArchiveMode.Read))
        {
            archive.ExtractToDirectory(newAppDir, overwriteFiles: true);
        }

        SetStatus("Installation des fichiers...", 46);
        if (Directory.Exists(appDir))
        {
            Directory.Delete(appDir, recursive: true);
        }
        Directory.Move(newAppDir, appDir);

        SetStatus("Autorisation du moteur WebView2 embarqué...", 52);
        GrantFixedRuntimeAccess(appDir);

        if (options.CleanInstalledProfile && Directory.Exists(profileDir))
        {
            SetStatus("Nettoyage du profil installé précédent...", 58);
            Directory.Delete(profileDir, recursive: true);
        }

        if (options.InstallTorEngine)
        {
            EnsureTorEngine();
        }

        var appExe = Path.Combine(appDir, "Lumora.WinUI.exe");
        var iconPath = Path.Combine(appDir, "Assets", "LumoraApp.ico");
        var lumIconPath = Path.Combine(appDir, "Assets", "LumoraLum.ico");
        _installedAppExe = appExe;

        SetStatus("Nettoyage de l'ancien lanceur isolé...", 64);
        if (File.Exists(launcherVbs))
        {
            File.Delete(launcherVbs);
        }

        SetStatus("Création du lanceur de diagnostic...", 70);
        File.WriteAllLines(traceLauncherCmd, new[]
        {
            "@echo off",
            "setlocal",
            "set \"LUMORA_TRACE_STARTUP=1\"",
            "start \"\" \"%~dp0app\\Lumora.WinUI.exe\""
        });

        SetStatus("Création de la désinstallation...", 76);
        WriteUninstaller(uninstallPs1, uninstallCmd, installRoot, profileDir, startMenuShortcut, desktopShortcut);

        SetStatus("Création des raccourcis...", 84);
        UpdateShortcuts(options, startMenuDir, startMenuShortcut, desktopShortcut, appExe, appDir, iconPath);
        WriteInstallInfo(installInfo, installRoot, appExe);

        SetStatus("Enregistrement dans Windows...", 94);
        using var key = Registry.CurrentUser.CreateSubKey(uninstallKey);
        key?.SetValue("DisplayName", "Lumora Browser");
        key?.SetValue("DisplayVersion", "__PRODUCT_VERSION__");
        key?.SetValue("Publisher", "H.J.");
        key?.SetValue("InstallLocation", installRoot);
        key?.SetValue("DisplayIcon", appExe);
        key?.SetValue("UninstallString", Quote(uninstallCmd));
        key?.SetValue("NoModify", 1, RegistryValueKind.DWord);
        key?.SetValue("NoRepair", 1, RegistryValueKind.DWord);

        SetStatus("Association de l'icône des sauvegardes .lum...", 97);
        RegisterLumFileIcon(lumIconPath);

        SetStatus("Inscription comme navigateur disponible dans Windows...", 99);
        RegisterAsDefaultBrowserCandidate(appExe, iconPath);
    }

    // Inscrit Lumora comme candidat navigateur dans le sélecteur Windows
    // (Réglages > Applications > Applications par défaut > Navigateur web).
    // Sans ces clés, Windows ignore totalement que Lumora existe : il
    // retombe sur "Rechercher une autre application sur ce PC", qui force à
    // pointer soi-même vers un .exe - bug signalé par l'utilisateur le
    // 2026-08-28 (voir MEMORY.md) après avoir dû fouiller le dossier
    // d'installation à la main. Uniquement HKCU (comme le reste de cet
    // installateur, aucun privilège administrateur requis) : Windows accepte
    // une inscription StartMenuInternet par utilisateur depuis Windows 8,
    // le même mécanisme que Chrome pour une installation "cet utilisateur
    // uniquement".
    //
    // La commande "%1" transmise par Windows à un clic de lien arrive côté
    // app comme argument de ligne de commande brut - voir UrlLaunchArgs.cs
    // (Lumora.WinUI) pour la lecture de cette URL au démarrage/à la relance.
    private static void RegisterAsDefaultBrowserCandidate(string appExe, string iconPath)
    {
        const string progId = "LumoraHTML";
        const string clientKeyPath = @"Software\Clients\StartMenuInternet\Lumora";
        var icon = File.Exists(iconPath) ? iconPath : appExe;

        using (var clientKey = Registry.CurrentUser.CreateSubKey(clientKeyPath))
        {
            clientKey?.SetValue(string.Empty, "Lumora Browser");
            clientKey?.SetValue("LocalizedString", "Lumora Browser");

            using (var iconKey = clientKey?.CreateSubKey("DefaultIcon"))
            {
                iconKey?.SetValue(string.Empty, $"{icon},0");
            }

            using (var openKey = clientKey?.CreateSubKey(@"shell\open\command"))
            {
                openKey?.SetValue(string.Empty, Quote(appExe));
            }

            using var capabilitiesKey = clientKey?.CreateSubKey("Capabilities");
            capabilitiesKey?.SetValue("ApplicationName", "Lumora Browser");
            capabilitiesKey?.SetValue("ApplicationIcon", $"{icon},0");
            capabilitiesKey?.SetValue("ApplicationDescription", "Navigateur Lumora : confidentialité, sans publicité.");

            using (var fileAssocKey = capabilitiesKey?.CreateSubKey("FileAssociations"))
            {
                fileAssocKey?.SetValue(".htm", progId);
                fileAssocKey?.SetValue(".html", progId);
            }

            using (var urlAssocKey = capabilitiesKey?.CreateSubKey("URLAssociations"))
            {
                urlAssocKey?.SetValue("http", progId);
                urlAssocKey?.SetValue("https", progId);
            }
        }

        using (var registeredAppsKey = Registry.CurrentUser.CreateSubKey(@"Software\RegisteredApplications"))
        {
            registeredAppsKey?.SetValue("Lumora", $@"{clientKeyPath}\Capabilities");
        }

        using (var progIdKey = Registry.CurrentUser.CreateSubKey($@"Software\Classes\{progId}"))
        {
            progIdKey?.SetValue(string.Empty, "Document Lumora");
            using var progIdIconKey = progIdKey?.CreateSubKey("DefaultIcon");
            progIdIconKey?.SetValue(string.Empty, $"{icon},0");
            using var progIdOpenKey = progIdKey?.CreateSubKey(@"shell\open\command");
            progIdOpenKey?.SetValue(string.Empty, $"{Quote(appExe)} \"%1\"");
        }

        using (var appPathsKey = Registry.CurrentUser.CreateSubKey(
            $@"Software\Microsoft\Windows\CurrentVersion\App Paths\{Path.GetFileName(appExe)}"))
        {
            appPathsKey?.SetValue(string.Empty, appExe);
            appPathsKey?.SetValue("Path", Path.GetDirectoryName(appExe) ?? string.Empty);
        }

        SHChangeNotify(ShcneAssocChanged, ShcnfIdList, IntPtr.Zero, IntPtr.Zero);
    }

    // Icone dediee pour les fichiers de sauvegarde .lum (session "Compte et
    // ouverture", 2026-08-14, chantier 3 - voir MEMORY.md). Uniquement HKCU
    // (comme le reste de cet installateur, aucun privilege administrateur
    // requis) et uniquement l'icone : aucune commande "ouvrir" n'est
    // enregistree, ce chantier ne portait que sur la representation
    // visuelle du fichier dans l'Explorateur, pas sur un comportement au
    // double-clic (a discuter separement si voulu). Si l'icone dediee est
    // absente du build (ancien artefact propre non regenere), l'association
    // est simplement ignoree plutot que de faire echouer toute l'installation.
    private static void RegisterLumFileIcon(string lumIconPath)
    {
        if (!File.Exists(lumIconPath)) return;

        const string progId = "Lumora.LumBackup";
        using (var extKey = Registry.CurrentUser.CreateSubKey(@"Software\Classes\.lum"))
        {
            extKey?.SetValue(string.Empty, progId);
        }

        using (var progIdKey = Registry.CurrentUser.CreateSubKey($@"Software\Classes\{progId}"))
        {
            progIdKey?.SetValue(string.Empty, "Sauvegarde Lumora");
            using var iconKey = progIdKey?.CreateSubKey("DefaultIcon");
            iconKey?.SetValue(string.Empty, $"{lumIconPath},0");
        }

        SHChangeNotify(ShcneAssocChanged, ShcnfIdList, IntPtr.Zero, IntPtr.Zero);
    }

    private static void WriteUninstaller(
        string uninstallPs1,
        string uninstallCmd,
        string installRoot,
        string profileDir,
        string startMenuShortcut,
        string desktopShortcut)
    {
        File.WriteAllLines(uninstallPs1, new[]
        {
            "param([switch]$RemoveProfile)",
            "$ErrorActionPreference = \"Stop\"",
            "$installRoot = " + PsQuote(installRoot),
            "$profileDir = " + PsQuote(profileDir),
            "$startMenuShortcut = " + PsQuote(startMenuShortcut),
            "$desktopShortcut = " + PsQuote(desktopShortcut),
            "$uninstallKey = \"HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Lumora\"",
            "$lumExtKey = \"HKCU:\\Software\\Classes\\.lum\"",
            "$lumProgIdKey = \"HKCU:\\Software\\Classes\\Lumora.LumBackup\"",
            "$startMenuInternetKey = \"HKCU:\\Software\\Clients\\StartMenuInternet\\Lumora\"",
            "$htmlProgIdKey = \"HKCU:\\Software\\Classes\\LumoraHTML\"",
            "$appPathsKey = \"HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\Lumora.WinUI.exe\"",
            "Remove-Item -LiteralPath $startMenuShortcut -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $desktopShortcut -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $uninstallKey -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $lumExtKey -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $lumProgIdKey -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $startMenuInternetKey -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-ItemProperty -LiteralPath \"HKCU:\\Software\\RegisteredApplications\" -Name \"Lumora\" -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $htmlProgIdKey -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item -LiteralPath $appPathsKey -Force -ErrorAction SilentlyContinue",
            "if ($RemoveProfile -and (Test-Path $profileDir)) { Remove-Item -LiteralPath $profileDir -Recurse -Force }",
            "if (Test-Path $installRoot) { Remove-Item -LiteralPath $installRoot -Recurse -Force }"
        });

        File.WriteAllLines(uninstallCmd, new[]
        {
            "@echo off",
            "powershell -NoProfile -ExecutionPolicy Bypass -File \"%~dp0uninstall.ps1\""
        });
    }

    private static void UpdateShortcuts(
        InstallerOptions options,
        string startMenuDir,
        string startMenuShortcut,
        string desktopShortcut,
        string appExe,
        string appDir,
        string iconPath)
    {
        var shortcutIcon = File.Exists(iconPath) ? iconPath : appExe;

        if (options.CreateStartMenuShortcut)
        {
            Directory.CreateDirectory(startMenuDir);
            CreateShortcut(startMenuShortcut, appExe, string.Empty, appDir, shortcutIcon);
        }
        else if (File.Exists(startMenuShortcut))
        {
            File.Delete(startMenuShortcut);
        }

        if (options.CreateDesktopShortcut)
        {
            CreateShortcut(desktopShortcut, appExe, string.Empty, appDir, shortcutIcon);
        }
        else if (File.Exists(desktopShortcut))
        {
            File.Delete(desktopShortcut);
        }
    }

    private static void WriteInstallInfo(string installInfo, string installRoot, string appExe)
    {
        var torExePath = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
            "Lumora", "profiles", "default", "tor", "tor.exe");

        File.WriteAllText(installInfo,
            "Lumora installé localement" + Environment.NewLine + Environment.NewLine +
            "Emplacement : " + installRoot + Environment.NewLine +
            "Exécutable : " + appExe + Environment.NewLine +
            "Modules : modules Lumora intégrés à l'application." + Environment.NewLine +
            "WebView2 : moteur embarqué (Fixed Version), aucune dépendance système." + Environment.NewLine +
            "Tor : " + (File.Exists(torExePath) ? "moteur installé (bouton Tor de la fenêtre Incognito)" : "non installé - disponible à la demande depuis le bouton Tor de la fenêtre Incognito") + Environment.NewLine +
            "Profil : aucun profil imposé au lancement ; le choix se fait dans Lumora." + Environment.NewLine +
            "Vérification : " + Path.Combine(Path.GetDirectoryName(appExe)!, "VERIFICATION.txt") + Environment.NewLine + Environment.NewLine +
            "Ce programme d'installation ne copie aucun profil utilisateur." + Environment.NewLine +
            "Les raccourcis lancent directement l'application, sans variable de profil forcée." + Environment.NewLine);
    }

    // "default" : identifiant du tout premier profil cree par Lumora sur une
    // machine neuve (LumoraConfig.ActiveProfileId vaut "default" par defaut,
    // LumoraProfilePaths.ProfilesRoot() = %LocalAppData%\Lumora\profiles). Ce
    // chemin n'est donc fiable QUE pour un premier lancement sans profil
    // personnalise deja choisi - exactement le scenario que cette case couvre
    // (case a cocher pensee pour un poste vierge, pas une reinstallation).
    // Un echec ici ne bloque jamais l'installation du navigateur lui-meme :
    // Tor reste installable plus tard depuis le bouton Tor de la fenetre
    // Incognito (meme telechargement, meme verification SHA256).
    private void EnsureTorEngine()
    {
        var localAppData = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);
        var torExePath = Path.Combine(localAppData, "Lumora", "profiles", "default", "tor", "tor.exe");

        if (File.Exists(torExePath))
        {
            SetStatus("Moteur Tor déjà présent.", 60);
            return;
        }

        try
        {
            SetStatus($"Téléchargement du moteur Tor {TorTrustedRelease.Version} (dist.torproject.org)...", 60);
            TorEngineProvider.DownloadEngineAsync(torExePath, new Progress<string>(message => SetStatus(message)))
                .GetAwaiter().GetResult();
            SetStatus("Moteur Tor installé.", 62);
        }
        catch (Exception ex)
        {
            _torInstallWarning =
                "Le moteur Tor n'a pas pu être installé automatiquement (" + ex.Message + "). " +
                "Tu pourras réessayer plus tard depuis le bouton Tor de la fenêtre Incognito.";
            SetStatus("Moteur Tor non installé (voir message final).", 62);
        }
    }

    // Runtime WebView2 embarque en mode "Fixed Version" (voir WebView2Bootstrap.cs
    // cote app) : plus de telechargement/installation systeme, mais depuis la
    // v120 du runtime, une app non empaquetee doit explicitement autoriser les
    // App Containers (sandbox du processus Renderer) a lire/executer ce
    // dossier, sinon WebView2 echoue silencieusement au demarrage sur Windows 10.
    // Procedure documentee par Microsoft (ALL APPLICATION PACKAGES / ALL
    // RESTRICTED APPLICATION PACKAGES) : https://learn.microsoft.com/microsoft-edge/webview2/concepts/distribution
    private void GrantFixedRuntimeAccess(string appDir)
    {
        var fixedRuntimeDir = Path.Combine(appDir, "FixedRuntime");
        if (!Directory.Exists(fixedRuntimeDir))
        {
            throw new InvalidOperationException(
                "Le moteur WebView2 embarqué (FixedRuntime) est absent de ce build - installation impossible. " +
                "Ce build de Lumora n'a pas été packagé correctement (voir scripts/prepare-webview2-fixedversion.ps1).");
        }

        RunIcacls(fixedRuntimeDir, "*S-1-15-2-2:(OI)(CI)(RX)");
        RunIcacls(fixedRuntimeDir, "*S-1-15-2-1:(OI)(CI)(RX)");
    }

    // icacls /T imprime une ligne par fichier traite (FixedRuntime en contient
    // des milliers) : rediriger stdout/stderr SANS les lire en continu remplit
    // le tampon du pipe, bloque icacls en ecriture, et WaitForExit() n'aboutit
    // jamais (constate en reel : installation figee indefiniment sur cette
    // etape). Drainer les deux flux de facon asynchrone pendant l'attente,
    // comme le documente Microsoft pour Process.WaitForExit avec redirection.
    private static void RunIcacls(string path, string grantArgument)
    {
        var startInfo = new ProcessStartInfo
        {
            FileName = "icacls.exe",
            Arguments = $"\"{path}\" /grant {grantArgument} /T /C",
            UseShellExecute = false,
            RedirectStandardOutput = true,
            RedirectStandardError = true,
            CreateNoWindow = true
        };

        var errorOutput = new System.Text.StringBuilder();
        using var process = new Process { StartInfo = startInfo };
        process.OutputDataReceived += (_, _) => { };
        process.ErrorDataReceived += (_, e) =>
        {
            if (e.Data is not null)
            {
                errorOutput.AppendLine(e.Data);
            }
        };

        if (!process.Start())
        {
            throw new InvalidOperationException("Impossible de lancer icacls pour autoriser le moteur WebView2.");
        }

        process.BeginOutputReadLine();
        process.BeginErrorReadLine();
        process.WaitForExit();

        if (process.ExitCode != 0)
        {
            throw new InvalidOperationException($"icacls a échoué (code {process.ExitCode}) sur {path} : {errorOutput}");
        }
    }

    // Evite l'echec brut ("Access to the path '...' is denied") quand
    // l'installateur essaie d'ecraser les fichiers d'une instance de Lumora
    // encore ouverte : verifie et previent clairement avant de commencer.
    private static bool IsLumoraRunning()
    {
        foreach (var process in Process.GetProcessesByName("Lumora.WinUI"))
        {
            using (process)
            {
                return true;
            }
        }

        return false;
    }

    private static void CreateShortcut(string shortcutPath, string targetPath, string arguments, string workingDirectory, string iconLocation)
    {
        var shellType = Type.GetTypeFromProgID("WScript.Shell")
            ?? throw new InvalidOperationException("WScript.Shell indisponible.");
        dynamic shell = Activator.CreateInstance(shellType)!;
        dynamic shortcut = shell.CreateShortcut(shortcutPath);
        shortcut.TargetPath = targetPath;
        shortcut.Arguments = arguments;
        shortcut.WorkingDirectory = workingDirectory;
        shortcut.IconLocation = iconLocation;
        shortcut.Description = "Lumora Browser";
        shortcut.Save();
    }

    private void SetStatus(string text, int? progress = null)
    {
        if (InvokeRequired)
        {
            BeginInvoke(new Action<string, int?>(SetStatus), text, progress);
            return;
        }

        _statusLabel.Text = text;
        if (progress.HasValue)
        {
            _progressBar.Progress = Math.Max(0, Math.Min(100, progress.Value));
        }
    }

    private void BrowseInstallPath(string defaultInstallRoot)
    {
        using var dialog = new FolderBrowserDialog
        {
            Description = "Choisir le dossier d'installation de Lumora",
            UseDescriptionForTitle = true,
            SelectedPath = Directory.Exists(_installPathTextBox.Text) ? _installPathTextBox.Text : defaultInstallRoot
        };

        if (dialog.ShowDialog(this) == DialogResult.OK && !string.IsNullOrWhiteSpace(dialog.SelectedPath))
        {
            _installPathTextBox.Text = dialog.SelectedPath;
        }
    }

    private static string Quote(string value) => "\"" + value + "\"";

    private static string PsQuote(string value) => "'" + value.Replace("'", "''") + "'";

    private static Image? LoadInstallerLogo()
    {
        try
        {
            using var stream = Assembly.GetExecutingAssembly().GetManifestResourceStream("LumoraApp.png");
            if (stream is null)
            {
                return null;
            }

            using var image = Image.FromStream(stream);
            return new Bitmap(image);
        }
        catch
        {
            return null;
        }
    }

    private void DragWindow(MouseEventArgs e)
    {
        if (e.Button != MouseButtons.Left)
        {
            return;
        }

        ReleaseCapture();
        SendMessage(Handle, WmNclButtonDown, HtCaption, 0);
    }

    protected override void OnPaint(PaintEventArgs e)
    {
        base.OnPaint(e);
        using var border = new Pen(LumoraPalette.Stroke, 1f);
        e.Graphics.DrawRectangle(border, 0, 0, Width - 1, Height - 1);
    }

    private static void StyleAccentButton(Button button)
    {
        button.BackColor = LumoraPalette.Accent;
        button.ForeColor = LumoraPalette.AccentButtonForeground;
        button.FlatAppearance.BorderSize = 1;
        button.FlatAppearance.BorderColor = LumoraPalette.Accent;
        button.FlatAppearance.MouseOverBackColor = LumoraPalette.AccentHover;
        button.FlatAppearance.MouseDownBackColor = LumoraPalette.AccentPressed;
    }

    // "Doux moderne" (2026-08-18, meme style que NovaButtonStyle dans
    // MainWindow.xaml) : bordure fine, fond plat, AUCUN relief/degrade -
    // remplace l'ancien StyleSecondaryButton a fond degrade.
    private static void StyleSecondaryButton(Button button)
    {
        button.BackColor = LumoraPalette.ButtonBackground;
        button.ForeColor = LumoraPalette.Foreground;
        button.FlatAppearance.BorderSize = 1;
        button.FlatAppearance.BorderColor = LumoraPalette.Stroke;
        button.FlatAppearance.MouseOverBackColor = LumoraPalette.ButtonBackgroundHover;
        button.FlatAppearance.MouseDownBackColor = LumoraPalette.ChromeSurface;
    }

    private static void StyleCheckBox(LumoraOptionCheckBox checkBox)
    {
        checkBox.ForeColor = LumoraPalette.Foreground;
        checkBox.Font = LumoraTypography.Text(9.25f, FontStyle.Bold);
        checkBox.Cursor = Cursors.Hand;
    }
}

