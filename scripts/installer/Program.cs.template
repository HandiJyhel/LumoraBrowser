        parent.Controls.Add(new Label
        {
            Text = text,
            AutoSize = false,
            Location = new Point(left, top),
            Size = new Size(width ?? (FormWidth - SidebarWidth - 24 - left), height),
            ForeColor = color,
            BackColor = Color.Transparent,
            Font = LumoraTypography.Text(fontSize)
