<Window
    x:Class="PulseBrowser.WinUI.PulseAppWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="using:Microsoft.Web.WebView2.Core"
    mc:Ignorable="d"
    Title="Pulse Browser">

    <!--
        Fenêtre d'application web Pulse : volontairement minimale (pas d'onglets, pas
        de barre d'adresse), comme le mode « application » de Chrome/Edge. Le site
        occupe tout l'espace ; seule une barre discrète apparaît quand la navigation
        sort du domaine de l'application (confinement doux, jamais de blocage dur pour
        ne pas casser les redirections de connexion type Google/Microsoft).
    -->
    <Grid x:Name="RootGrid" Background="#FF22211F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ExternalDomainBar" Grid.Row="0" Visibility="Collapsed"
                Background="#FF34312D" BorderThickness="0,0,0,1" BorderBrush="#FF514C45"
                Padding="12,6">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                          Foreground="#FFF5F1EA" VerticalAlignment="Center" />
                <TextBlock x:Name="ExternalDomainText" Grid.Column="1" Foreground="#FFF5F1EA"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="ExternalDomainReturnButton" Grid.Column="2"
                        Content="Retour à l'application" Click="ExternalDomainReturnButton_Click"
                        Padding="10,2" FontSize="12" />
            </Grid>
        </Border>

        <Grid x:Name="AppWebViewHost" Grid.Row="1" />
    </Grid>
</Window>
