target/

# .NET build artifacts
**/bin/
**/obj/
*.user

# Build outputs and captures
/artifacts/*
!/artifacts/signatures/
/artifacts/signatures/*
!/artifacts/signatures/.gitkeep
Lumora.WinUI/artifacts/

